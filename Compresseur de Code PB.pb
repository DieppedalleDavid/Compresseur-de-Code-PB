; IDE Options = PureBasic 6.41 (Windows - x64)
; Folding = ---------------------------------------------------------------------------
; Optimizer
; EnableThread
; EnableXP
; DPIAware
; Compiler = PureBasic 6.41 - C Backend (Windows - x64)
; EnableCompileCount = 0
; EnableBuildCount = 0
; EnableExeConstant