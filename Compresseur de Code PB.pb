    ElseIf lc >= 48 And lc <= 57
      vv = 4
    ElseIf lc = 39
      vv = 6
    ElseIf (c / 32) % 2 = 1
      vv = 7
    Else
      vv = 0
    EndIf
    nvc = ((nvc * 8) + vv) % 16777216
    mt = 1
    If c = 40
      nic = nic + 31
    ElseIf c = 41
      nic = nic - 31
    ElseIf c = 91
      nic = nic + 11
    ElseIf c = 93
      nic = nic - 11
    ElseIf c = 123
      nic = nic + 17
    ElseIf c = 125
      nic = nic - 17
    ElseIf c = 60
      nic = nic + 23
    ElseIf c = 62
      nic = nic - 23
    Else
      mt = 0
    EndIf
    If mt: nbc = 0: Else: nbc = nbc + 1: EndIf
    If nbc > 300: nbc = 0: nic = 0: EndIf
    If c = 40 Or c = 91 Or c = 123
      opn = c
    ElseIf c = 41 Or c = 93 Or c = 125
      opn = 0
    ElseIf c = 34
      If opn = 34: opn = 0: Else: opn = 34: EndIf
    EndIf
    lt = 0
    If (c >= 48 And c <= 57) Or (c >= 65 And c <= 90) Or (c >= 97 And c <= 122) Or c = 95: lt = 1: EndIf
    If lt = 0 And wh <> 0: WPz(wh % 65536) = pos: EndIf
    For k = 0 To 136
      r = Rx(k)
      If Rv(k) = 0
        RK(r) = Rc(k): R1(r) = c: R2(r) = c: RN(r) = 1
      ElseIf R1(r) = c
        If RN(r) < 255: RN(r) = RN(r) + 1: EndIf
      Else
        R2(r) = R1(r): R1(r) = c: RN(r) = 1
      EndIf
    Next
    I1(h0) = ((I1(h0) * 256) + c) % 65536
    v = (Hi(1) * 256) + h0
    I2(v) = ((I2(v) * 256) + c) % 65536
    l1 = 0
    If (h0 >= 48 And h0 <= 57) Or (h0 >= 65 And h0 <= 90) Or (h0 >= 97 And h0 <= 122) Or h0 = 95: l1 = 1: EndIf
    If c = 10
      tk = 0
    ElseIf c <> 32 And (lt = 0 Or l1 = 0)
      tk = tk + 1
    EndIf
    For k = 7 To 1 Step -1
      Hi(k) = Hi(k - 1)
    Next
    Hi(0) = c
    If c = 10
      If fw <> 0
        LF(fw % 65536) = ls
        LE(fw % 65536) = pos
      EndIf
      p3l = ppl: ppl = pl: pl = ls: ls = pos + 1: pfw = fw: ar = 0
    Else
      a = 0
      If pl + pos - ls < ls
        If PeekA(*D + pl + pos - ls) = c: a = 1: EndIf
      EndIf
      If a: ar = ar + 1: Else: ar = 0: EndIf
    EndIf
    If c = 10: pfw = fw: fw = 0: fwf = 0: nd = 0: bd = 0: EndIf
    If zn = 0
      If c = 40 And bd < 7
        bd = bd + 1
      ElseIf c = 41 And bd > 0
        bd = bd - 1
      EndIf
    EndIf
    If lt
      If wh = 0: g1 = g0: g0 = 0: wlo = 0: EndIf
      wlo = ((((wlo + lc) + 1) * $6F4F2B) / 256) % $1000000
      t0 = ((t0 * 256) + lc) % 1099511627776
    Else
      If wh <> 0
        w4 = w3: w3 = w2: w2 = wp: wlp = wlo
        If c = 61 Or c = 58: kw = wh: EndIf
      EndIf
      If c = 10: a = 32: Else: a = c: EndIf
      g0 = (((((g0 * 256) + a) + 1) * $6F4F2B) / 256) % $1000000
    EndIf
    If lt
      If wh = 0: wc = Hi(1): EndIf
      wh = ((((wh + c) + 1) * $6F4F2B) / 256) % $1000000
    Else
      If wh <> 0: wp = wh: EndIf
      wh = 0
    EndIf
    If c = 32 And fwf = 0 And fw = 0: nd = nd + 1: EndIf
    If fwf = 0
      If lt
        fw = (((((fw * 256) + c) + 1) * $6F4F2B) / 256) % $1000000
      ElseIf fw <> 0
        fwf = 1
      EndIf
    EndIf
    If zn = 0
      If c = 59
        zn = 2
      ElseIf c = 34
        zn = 1
      EndIf
    ElseIf zn = 1
      If c = 34 Or c = 10: zn = 0: EndIf
    ElseIf c = 10
      zn = 0
    EndIf
    xlet = Bool((c >= 65 And c <= 90) Or (c >= 97 And c <= 122))
    xaln = Bool((c >= 48 And c <= 57) Or (c >= 65 And c <= 90) Or (c >= 97 And c <= 122) Or c = 95)
    If xaln
      If xwl = 0: xwgap = xgaplen: xmask2 = 0: EndIf
      xwl = xwl + 1
      If xwl > 31: xwl = 31: EndIf
      xgaplen = 0
    Else
      If xwl <> 0: xwl1 = xwl: xmask2 = 0: EndIf
      xwl = 0
      xgaplen = xgaplen + 1
      If xgaplen > 255: xgaplen = 255: EndIf
    EndIf
    xlc = c
    If c >= 65 And c <= 90: xlc = c + 32: EndIf
    If xlet
      If xlc = 101: xt = 101: ElseIf xlc = 97 Or xlc = 105 Or xlc = 111 Or xlc = 117: xt = 97: ElseIf xlc = 121: xt = 121: Else: xt = 98: EndIf
    ElseIf c >= 48 And c <= 57
      If c = 48: xt = 48: Else: xt = 49: EndIf
    ElseIf c = 46 Or c = 33 Or c = 63
      xt = 33
    ElseIf c = 44 Or c = 59 Or c = 58
      xt = 44
    ElseIf c = 40 Or c = 91 Or c = 123
      xt = 40
    ElseIf c = 41 Or c = 93 Or c = 125
      xt = 41
    Else
      xt = c
    EndIf
    xmask2 = ((xmask2 * 256) + xt) % 4294967296
    If xlet
      xe0 = (((((xe0 * 256) + xlc) + 1) * $6F4F2B) / 256) % $1000000
      xelen = xelen + 1
      If xelen > 31: xelen = 31: EndIf
      xec4 = ((xec4 * 256) + xlc) % 4294967296
    Else
      xelen = 0: xec4 = 0
      If (c = 32 Or c = 10) And ((Hi(1) >= 65 And Hi(1) <= 90) Or (Hi(1) >= 97 And Hi(1) <= 122))
        xe4 = xe3: xe3 = xe2: xe2 = xe1: xe1 = xe0: xe0 = 0
      ElseIf c = 39 Or c = 34 Or c = 13 Or (c = 32 And Hi(1) = 10)
        xe4 = xe4
      Else
        xe0 = 0: xe1 = 0: xe2 = 0: xe3 = 0: xe4 = 0
      EndIf
    EndIf
    If c >= 65 And c <= 90: xlastup = 0: ElseIf xlastup < 255: xlastup = xlastup + 1: EndIf
    If pos + 1 - ls = 1
      xfch = c
      If c >= 128
        If c >= 240: xfch = 1: ElseIf c >= 224: xfch = 2: ElseIf c >= 192: xfch = 3: Else: xfch = 4: EndIf
      ElseIf c >= 48 And c <= 57
        xfch = 48
      ElseIf c >= 97 And c <= 122
        xfch = 97
      ElseIf c >= 65 And c <= 90
        xfch = 65
      ElseIf c < 32 And c <> 10
        xfch = 6
      EndIf
    EndIf
    xa = c
    If c >= 128
      If c >= 240: xa = 1: ElseIf c >= 224: xa = 2: ElseIf c >= 192: xa = 3: Else: xa = 4: EndIf
    ElseIf c >= 48 And c <= 57
      xa = 48
    ElseIf c >= 97 And c <= 122
      xa = 97
    ElseIf c >= 65 And c <= 90
      xa = 65
    ElseIf c < 32 And c <> 10
      xa = 6
    EndIf
    xgr = ((xgr * 256) + xa) % 72057594037927936
    xa = 0
    If c <> 32: xa = c / 16: EndIf
    xf4 = ((xf4 * 16) + xa) % 4294967296
    xfl = 0
    If c <> 0
      If xlet
        xfl = 1
      ElseIf (c >= 33 And c <= 47) Or (c >= 58 And c <= 64) Or (c >= 91 And c <= 96) Or (c >= 123 And c <= 126)
        xfl = 2
      ElseIf c = 32 Or (c >= 9 And c <= 13)
        xfl = 3
      ElseIf c = 255
        xfl = 4
      ElseIf c < 16
        xfl = 5
      ElseIf c < 64
        xfl = 6
      Else
        xfl = 7
      EndIf
    EndIf
    xmk = ((xmk * 8) + xfl) % 281474976710656
    If wh <> 0: xa = wh: Else: xa = g0 + 7: EndIf
    xhtok = XTI(xa % 1048576)
    a = c
    If c >= 48 And c <= 57
      a = 48
    ElseIf c >= 65 And c <= 90
      a = 65
    ElseIf c >= 97 And c <= 122
      a = 97
    ElseIf c >= 128
      a = 128
    EndIf
    cgtc = 0
    If (a = 48 Or a = 65 Or a = 97) And a = cg1 % 256: cgtc = 1: EndIf
    If cgtc = 0
      cg3 = ((cg3 * 256) + (cg2 / 16777216)) % 4294967296
      cg2 = ((cg2 * 256) + (cg1 / 16777216)) % 4294967296
      cg1 = ((cg1 * 256) + a) % 4294967296
    EndIf
    If c >= 48 And c <= 57
      tld = 0
      tnh = (((((tnh * 256) + c) + 1) * $6F4F2B) / 256) % $1000000
      tnl = tnl + 1
      If tnl > 19: tnl = 19: EndIf
    Else
      If tld < 255: tld = tld + 1: EndIf
      tnh = 0: tnl = 0
    EndIf
    If c = 44 Or c = 59 Or c = 58 Or c = 46 Or c = 33 Or c = 63: tlp = 0: ElseIf tlp < 63: tlp = tlp + 1: EndIf
    If c = 44: tcom = tcom + 1: EndIf
    If c = 10: tcom = 0: EndIf
    tsp = ((tsp * 2) + Bool(c = 32 Or c = 9 Or c = 13 Or c = 10)) % 4294967296
    xa = 0
    If xlet: xa = 1: ElseIf c = 44 Or c = 59 Or c = 58 Or c = 46 Or c = 33 Or c = 63: xa = 2: ElseIf c = 32 Or c = 9 Or c = 13 Or c = 10: xa = 3: EndIf
    tm1 = ((tm1 * 4) + xa) % 4294967296
    xd = 0
    If xlet
      xd = 1 + Bool(xlc = 97 Or xlc = 101 Or xlc = 105 Or xlc = 111 Or xlc = 117)
    ElseIf c = 46 Or c = 33 Or c = 63
      xd = 3
    ElseIf c = 44 Or c = 59 Or c = 58
      xd = 4
    ElseIf c = 32 Or c = 10 Or c = 13 Or c = 9
      xd = 5
    ElseIf c = 40
      xd = 6
    ElseIf c >= 48 And c <= 57
      xd = 7
    EndIf
    tm3 = ((tm3 * 8) + xd) % 1073741824
    If c = 40: tnest = tnest + 31: ElseIf c = 41: tnest = tnest - 31: ElseIf c = 91: tnest = tnest + 11: ElseIf c = 93: tnest = tnest - 11: ElseIf c = 123: tnest = tnest + 17: ElseIf c = 125: tnest = tnest - 17: ElseIf c = 60: tnest = tnest + 23: ElseIf c = 62: tnest = tnest - 23: EndIf
    If xaln And xwl = 1: tfl = xlc: EndIf
    If c >= 65 And c <= 90 And dprev >= 97 And dprev <= 122
      dlen = 0: dnmaj = 0: dnmin = 0: dpc3 = 0
      dlo0 = 0: dhi0 = DicoNb0
      dlo1 = 0: dhi1 = DicoNb1
    EndIf
    dprev = c
    If (c >= 65 And c <= 90) Or (c >= 97 And c <= 122) Or c >= 128
      dlc = c
      If c >= 65 And c <= 90
        dlc = c + 32
        dnmaj = dnmaj + 1
      ElseIf c >= 97 And c <= 122
        dnmin = dnmin + 1
      ElseIf dpc3 <> 0 And c >= 128 And c <= 158 And c <> 151
        dlc = c + 32
      EndIf
      dpc3 = Bool(c = 195)
      If dlen < 60 And dlo0 < dhi0
        dsa = dlo0
        dsb = dhi0
        While dsa < dsb
          dsm = dsa + ((dsb - dsa) / 2)
          If DicoLong0(dsm) > dlen: dkey = PeekA(*DicoTexte0 + DicoDebut0(dsm) + dlen): Else: dkey = -1: EndIf
          If dkey < dlc: dsa = dsm + 1: Else: dsb = dsm: EndIf
        Wend
        dra = dsa
        dsa = dra
        dsb = dhi0
        While dsa < dsb
          dsm = dsa + ((dsb - dsa) / 2)
          If DicoLong0(dsm) > dlen: dkey = PeekA(*DicoTexte0 + DicoDebut0(dsm) + dlen): Else: dkey = -1: EndIf
          If dkey < (dlc + 1): dsa = dsm + 1: Else: dsb = dsm: EndIf
        Wend
        drb = dsa
        dlo0 = dra: dhi0 = drb
      Else
        dlo0 = 0: dhi0 = 0
      EndIf
      If dlen < 60 And dlo1 < dhi1
        dsa = dlo1
        dsb = dhi1
        While dsa < dsb
          dsm = dsa + ((dsb - dsa) / 2)
          If DicoLong1(dsm) > dlen: dkey = PeekA(*DicoTexte1 + DicoDebut1(dsm) + dlen): Else: dkey = -1: EndIf
          If dkey < dlc: dsa = dsm + 1: Else: dsb = dsm: EndIf
        Wend
        dra = dsa
        dsa = dra
        dsb = dhi1
        While dsa < dsb
          dsm = dsa + ((dsb - dsa) / 2)
          If DicoLong1(dsm) > dlen: dkey = PeekA(*DicoTexte1 + DicoDebut1(dsm) + dlen): Else: dkey = -1: EndIf
          If dkey < (dlc + 1): dsa = dsm + 1: Else: dsb = dsm: EndIf
        Wend
        drb = dsa
        dlo1 = dra: dhi1 = drb
      Else
        dlo1 = 0: dhi1 = 0
      EndIf
      dlen = dlen + 1
    Else
      dlen = 0: dnmaj = 0: dnmin = 0: dpc3 = 0
      dlo0 = 0: dhi0 = DicoNb0
      dlo1 = 0: dhi1 = DicoNb1
    EndIf
  Next

  ProcedureReturn chk
EndProcedure
EnableDebugger

; ----------------------------------------------------------------------------
;  Décodeur de la méthode Methode: 7 = Maximal v5 (PBC9 à PBC15), 8 = v6 aux
;  niveaux 1 et 2, 9 = v6 au niveau 3 (voir MethodeNiveau)
; ----------------------------------------------------------------------------
Procedure.q DecoderMethode(Methode, *C, Z.q, T.q, *D, P.q, Reseau.q)
  Select Methode
    Case 9
      ProcedureReturn DecoderCM9(*C, Z, T, *D, P, Reseau)
    Case 8
      ProcedureReturn DecoderCM8(*C, Z, T, *D, P, Reseau)
  EndSelect
  ProcedureReturn DecoderCM7(*C, Z, T, *D, P, Reseau)
EndProcedure


; ----------------------------------------------------------------------------
;  Y a-t-il assez de mémoire libre pour la méthode v4 ?
; ----------------------------------------------------------------------------
Procedure MemoireMethode4()
  Protected *Essai

  *Essai = AllocateMemory(#MemoireMethode4, #PB_Memory_NoClear)
  If *Essai
    FreeMemory(*Essai)
    ProcedureReturn #True
  EndIf
  ProcedureReturn #False
EndProcedure


; ----------------------------------------------------------------------------
;  Méthode d'un niveau de la v7.3 (1 à 3): 8 = Maximal v6 aux niveaux 1 et 2
;  (55 contextes et les listes de mots), 9 = Maximal v6 au niveau 3 (137
;  contextes et les listes de mots). La méthode 7 (Maximal v5) ne sert plus
;  qu'à relire les blocs PBC9 à PBC15.
; ----------------------------------------------------------------------------
Procedure MethodeNiveau(Niveau)
  If Niveau >= 3
    ProcedureReturn 9
  EndIf
  ProcedureReturn 8
EndProcedure

; Unités de la barre de progression pour un octet lu par la méthode (voir
; VitesseCM)
Procedure PoidsMethode(Methode)
  Select Methode
    Case 8
      ProcedureReturn #PoidsMethode8
    Case 9
      ProcedureReturn #PoidsMethode9
  EndSelect
  ProcedureReturn #PoidsMethode5
EndProcedure

; Mémoire demandée par un modèle de la méthode (octets)
Procedure.q MemoireDeMethode(Methode)
  If Methode = 9
    ProcedureReturn #MemoireMethode9
  EndIf
  ProcedureReturn #MemoireMethode5
EndProcedure

; Mémoire d'un modèle de la méthode, ou de deux (vérification en même temps
; que la compression), en Go, pour l'affichage
Procedure.d GoMethode(Methode, Modeles = 1)
  If Methode = 9
    If Modeles = 2
      ProcedureReturn 2.5
    EndIf
    ProcedureReturn 1.2
  EndIf
  If Modeles = 2
    ProcedureReturn 3.5
  EndIf
  ProcedureReturn 1.7
EndProcedure

; Y a-t-il assez de mémoire libre pour la méthode v5 ou v6 (environ 1,7 Go ;
; 1,2 Go pour la v6 au niveau 3) ?
Procedure MemoireMethode5(Methode = 7)
  Protected *Essai

  *Essai = AllocateMemory(MemoireDeMethode(Methode), #PB_Memory_NoClear)
  If *Essai
    FreeMemory(*Essai)
    ProcedureReturn #True
  EndIf
  ProcedureReturn #False
EndProcedure


; ----------------------------------------------------------------------------
;  Y a-t-il assez de mémoire pour deux modèles v4 à la fois (compression et
;  vérification en parallèle) ? Seulement si le programme est compilé avec
;  l'option « thread-safe ». Essai = #False: estimation rapide pour
;  l'affichage, sans essayer de réserver la mémoire.
; ----------------------------------------------------------------------------
Procedure ParalleleDisponible(Essai)
  Protected Ok
  CompilerIf #PB_Compiler_Thread
    Protected *Essai

    If MutexCM4 And MemoryStatus(#PB_System_FreePhysical) >= (2 * #MemoireMethode4) + (200 * 1024 * 1024)
      Ok = #True
      If Essai
        *Essai = AllocateMemory(2 * #MemoireMethode4, #PB_Memory_NoClear)
        If *Essai
          FreeMemory(*Essai)
        Else
          Ok = #False
        EndIf
      EndIf
    EndIf
  CompilerEndIf
  ProcedureReturn Ok
EndProcedure


; ----------------------------------------------------------------------------
;  Fichiers de l'état du modèle v4: un par niveau (de Moyen à Maximal), dans
;  les données locales de l'utilisateur (pas dans le profil itinérant de
;  Windows, à cause de leur taille). Au niveau Faible, relire le petit texte de
;  référence est plus rapide que relire 670 Mo: rien n'est gardé.
; ----------------------------------------------------------------------------
Procedure.s DossierEtat()
  Protected Dossier$

  Dossier$ = GetEnvironmentVariable("LOCALAPPDATA")
  If Dossier$ = ""
    Dossier$ = GetUserDirectory(#PB_Directory_ProgramData)
  EndIf
  If Right(Dossier$, 1) <> #PS$
    Dossier$ = Dossier$ + #PS$
  EndIf
  ProcedureReturn Dossier$ + "CompresseurPB" + #PS$
EndProcedure


Procedure.s FichierEtat(Niveau)
  ProcedureReturn DossierEtat() + "etat_v4_niveau" + Str(Niveau) + ".bin"
EndProcedure


; Le réglage est coché et le niveau est assez grand pour qu'un état serve
Procedure EtatUtile(Niveau)
  ProcedureReturn Bool(GarderEtat And Niveau >= #NiveauMoyen And Niveau <= #NiveauMaximal)
EndProcedure


; Empreinte du texte de référence d'un niveau (sommes de contrôle et tailles de
; ses segments), écrite dans l'en-tête
Procedure.q SignatureReference(Niveau)
  Protected Liste$, i, n
  Protected.q S

  LireTableReference()
  Liste$ = CompositionNiveau(Niveau)
  For i = 1 To CountString(Liste$, ",") + 1
    n = Val(StringField(Liste$, i, ","))
    S = ((S * 33) + SegmentControle(n)) % 1000000007
    S = ((S * 33) + (SegmentTaille(n) % 1000000007)) % 1000000007
  Next
  ProcedureReturn S
EndProcedure


Procedure.q TailleFichierEtat(Niveau)
  ProcedureReturn #TailleEnTeteEtat + TailleNiveau(Niveau) + #TailleEtatModele4
EndProcedure


; Lit et vérifie l'en-tête d'un fichier d'état ouvert (le fichier se trouve
; ensuite au début du texte de référence)
Procedure EnTeteEtatValide(Fichier, Niveau)
  If Lof(Fichier) <> TailleFichierEtat(Niveau)
    ProcedureReturn #False
  EndIf
  If ReadQuad(Fichier) <> #MagiqueEtat4
    ProcedureReturn #False
  EndIf
  If ReadQuad(Fichier) <> #VersionEtat4
    ProcedureReturn #False
  EndIf
  If ReadQuad(Fichier) <> #SignatureModele4
    ProcedureReturn #False
  EndIf
  If ReadQuad(Fichier) <> Niveau
    ProcedureReturn #False
  EndIf
  If ReadQuad(Fichier) <> TailleNiveau(Niveau)
    ProcedureReturn #False
  EndIf
  If ReadQuad(Fichier) <> SignatureReference(Niveau)
    ProcedureReturn #False
  EndIf
  If ReadQuad(Fichier) <> TailleFichierEtat(Niveau)
    ProcedureReturn #False
  EndIf
  If ReadQuad(Fichier) <> 0
    ProcedureReturn #False
  EndIf
  ProcedureReturn #True
EndProcedure


; Un état gardé et valable existe-t-il pour ce niveau ? (en-tête et taille)
Procedure EtatDisponible(Niveau)
  Protected Fichier, Ok

  If EtatUtile(Niveau) = #False
    ProcedureReturn #False
  EndIf
  If FileSize(FichierEtat(Niveau)) <> TailleFichierEtat(Niveau)
    ProcedureReturn #False
  EndIf
  Fichier = ReadFile(#PB_Any, FichierEtat(Niveau), #PB_File_SharedRead)
  If Fichier
    Ok = EnTeteEtatValide(Fichier, Niveau)
    CloseFile(Fichier)
  EndIf
  ProcedureReturn Ok
EndProcedure


; ----------------------------------------------------------------------------
;  Ouvre l'état d'un niveau pour le lire, et se place juste après le texte de
;  référence. Provisoire = #True: l'état tout juste écrit, pas encore contrôlé
;  (voir ValiderEtat). Si *Reference ne contient pas déjà ce niveau, le texte
;  de référence du fichier y est lu, et vérifié segment par segment avec les
;  sommes de contrôle du programme: il évite de décompresser les segments.
;  Renvoie le numéro du fichier, ou 0 (le fichier est effacé s'il est abîmé).
; ----------------------------------------------------------------------------
Procedure OuvrirEtat(Niveau, Provisoire = #False)
  Protected Fichier, Liste$, i, n, Ok, Abime, Nom$
  Protected.q P, Position
  Protected *Texte

  If EtatUtile(Niveau) = #False
    ProcedureReturn 0
  EndIf
  Nom$ = FichierEtat(Niveau)
  If Provisoire
    Nom$ = Nom$ + ".tmp"
  EndIf
  If FileSize(Nom$) <> TailleFichierEtat(Niveau)
    ProcedureReturn 0
  EndIf
  Fichier = ReadFile(#PB_Any, Nom$, #PB_File_SharedRead)
  If Fichier = 0
    ProcedureReturn 0
  EndIf
  If EnTeteEtatValide(Fichier, Niveau) = #False
    CloseFile(Fichier)
    ProcedureReturn 0
  EndIf

  P = TailleNiveau(Niveau)
  EtatOctets = 0
  If *Reference And NiveauReference = Niveau
    FileSeek(Fichier, #TailleEnTeteEtat + P)
    ProcedureReturn Fichier
  EndIf

  AfficherEtape(TrF("lectureTexteGarde", Str((P + 524288) / 1048576)))
  *Texte = AllocateMemory(P + 16)
  If *Texte
    Abime = #True
    If ReadData(Fichier, *Texte, P) = P
      Abime = #False
      Liste$ = CompositionNiveau(Niveau)
      For i = 1 To CountString(Liste$, ",") + 1
        n = Val(StringField(Liste$, i, ","))
        If Controle(*Texte + Position, SegmentTaille(n)) <> SegmentControle(n)
          Abime = #True
        EndIf
        Position = Position + SegmentTaille(n)
      Next
    EndIf
    Ok = Bool(Abime = #False)
  EndIf

  If Ok = #False
    CloseFile(Fichier)
    If *Texte
      FreeMemory(*Texte)
    EndIf
    If Abime
      DeleteFile(Nom$)
    EndIf
    ProcedureReturn 0
  EndIf

  If *Reference
    FreeMemory(*Reference)
  EndIf
  *Reference = *Texte
  TailleReference = P
  NiveauReference = Niveau
  ProcedureReturn Fichier
EndProcedure


; ----------------------------------------------------------------------------
;  Crée le fichier provisoire (.tmp) où la méthode v4 écrira l'état, avec
;  l'en-tête et le texte de référence du niveau (*Texte, Taille octets).
;  Renvoie le numéro du fichier, ou 0.
; ----------------------------------------------------------------------------
Procedure CreerEtatAvec(Niveau, *Texte, Taille.q, Message$)
  Protected Fichier, Ok, Nom$

  If EtatUtile(Niveau) = #False Or *Texte = 0 Or Taille <> TailleNiveau(Niveau)
    ProcedureReturn 0
  EndIf
  Nom$ = FichierEtat(Niveau) + ".tmp"
  CreateDirectory(DossierEtat())           ; (s'il existe déjà, rien ne change)
  Fichier = CreateFile(#PB_Any, Nom$)
  If Fichier = 0
    ProcedureReturn 0
  EndIf
  EtatOctets = 0
  AfficherEtape(Message$)
  Ok = #True
  If WriteQuad(Fichier, #MagiqueEtat4) = 0
    Ok = #False
  EndIf
  If WriteQuad(Fichier, #VersionEtat4) = 0
    Ok = #False
  EndIf
  If WriteQuad(Fichier, #SignatureModele4) = 0
    Ok = #False
  EndIf
  If WriteQuad(Fichier, Niveau) = 0
    Ok = #False
  EndIf
  If WriteQuad(Fichier, TailleNiveau(Niveau)) = 0
    Ok = #False
  EndIf
  If WriteQuad(Fichier, SignatureReference(Niveau)) = 0
    Ok = #False
  EndIf
  If WriteQuad(Fichier, TailleFichierEtat(Niveau)) = 0
    Ok = #False
  EndIf
  If WriteQuad(Fichier, 0) = 0
    Ok = #False
  EndIf
  If WriteData(Fichier, *Texte, Taille) <> Taille
    Ok = #False
  EndIf
  If Ok = #False
    CloseFile(Fichier)
    DeleteFile(Nom$)
    ProcedureReturn 0
  EndIf
  EcritureEtatRatee = #False
  ProcedureReturn Fichier
EndProcedure


; Fichier provisoire de l'état d'un niveau, avec le texte de référence en mémoire
; (*Reference doit contenir ce niveau)
Procedure CreerEtat(Niveau)
  If *Reference = 0 Or NiveauReference <> Niveau
    ProcedureReturn 0
  EndIf
  ProcedureReturn CreerEtatAvec(Niveau, *Reference, TailleReference, TrF("ecritureTexteRef", Str((TailleReference + 524288) / 1048576)))
EndProcedure


; Ferme le fichier provisoire écrit par la méthode v4. Renvoie #True s'il est
; complet ; sinon (disque plein...) il est effacé.
Procedure FermerEtatEcrit(Fichier, Niveau)
  CloseFile(Fichier)
  If EcritureEtatRatee = #False And FileSize(FichierEtat(Niveau) + ".tmp") = TailleFichierEtat(Niveau)
    ProcedureReturn #True
  EndIf
  DeleteFile(FichierEtat(Niveau) + ".tmp")
  ProcedureReturn #False
EndProcedure


; Ferme un état lu ; s'il s'est révélé abîmé, il est effacé (l'opération, elle,
; est repartie du texte de référence et reste juste). Renvoie #True si l'état
; a bien été relu.
Procedure FermerEtatLu(Fichier, Niveau)
  CloseFile(Fichier)
  If EtatAbime
    AfficherEtape(Tr("etatAbimeEfface"))
    DeleteFile(FichierEtat(Niveau))
    EtatAbime = #False
    ProcedureReturn #False
  EndIf
  ProcedureReturn #True
EndProcedure


; ----------------------------------------------------------------------------
;  Contrôle de l'état tout juste écrit (fichier provisoire): la méthode v4 le
;  relit et refait la décompression de *C (Z octets). Il n'est gardé que si
;  elle redonne exactement *Attendu (T octets). Un état gardé a donc toujours
;  donné au moins une fois le même résultat que la lecture du texte de
;  référence. Renvoie 1 si la décompression est juste, 0 si elle est fausse,
;  -1 si l'état n'a pas pu être relu (dans les deux derniers cas, il est effacé).
; ----------------------------------------------------------------------------
Procedure ValiderEtat(Niveau, *C, Z.q, T.q, *Attendu, Etape$)
  Protected Fichier, Resultat, Mesurable
  Protected.q Debut
  Protected *D

  Resultat = -1
  EtatAbime = #False
  Fichier = OuvrirEtat(Niveau, #True)
  If Fichier
    *D = AllocateMemory(TailleReference + T + 16)
    If *D
      CopyMemory(*Reference, *D, TailleReference)
      ; (ce contrôle ne compte pas dans la mesure de la vitesse de ce PC)
      Mesurable = ProgresMesurable
      Debut = ElapsedMilliseconds()
      CommencerPasse(Etape$, 4, TailleReference)
      DecoderCM4(*C, Z, T, *D, TailleReference, Fichier, 0)
      TerminerPasse(T)
      ProgresMesurable = Mesurable
      ProgresHorsTemps = ProgresHorsTemps + (ElapsedMilliseconds() - Debut)
      ProgresHorsUnites = ProgresHorsUnites + (T * 4)
      If EtatAbime = #False
        Resultat = Bool(CompareMemory(*D + TailleReference, *Attendu, T))
      EndIf
      FreeMemory(*D)
    EndIf
    CloseFile(Fichier)
  EndIf
  EtatAbime = #False
  If Resultat = 1
    DeleteFile(FichierEtat(Niveau))        ; un ancien état (abîmé, ou d'une autre version)
    If RenameFile(FichierEtat(Niveau) + ".tmp", FichierEtat(Niveau))
      EtatCree = #True
      ProcedureReturn 1
    EndIf
  EndIf
  DeleteFile(FichierEtat(Niveau) + ".tmp")
  ProcedureReturn Resultat
EndProcedure


; ----------------------------------------------------------------------------
;  Texte de référence (depuis la v6.4): fichier de référence à côté du
;  programme, et texte décompressé gardé sur le disque.
;  Le fichier contient tous les segments dans l'ordre du niveau Maximal
;  (CompositionNiveau), le segment 0 en premier: le niveau Faible et les
;  formats PBC2 et PBC3 n'ont besoin que de son début.
; ----------------------------------------------------------------------------

; Texte décompressé gardé sur le disque: en-tête de 32 octets (marque, version,
; empreinte et taille du texte), puis le texte, dans l'ordre du niveau Maximal
Procedure.s FichierTexteReference()
  ProcedureReturn DossierEtat() + "texte_reference_v4.bin"
EndProcedure


Procedure.q TailleTexteGarde()
  ProcedureReturn 32 + TailleNiveau(#NiveauMaximal)
EndProcedure


; Le texte décompressé est-il gardé sur le disque ? (taille et en-tête)
Procedure TexteGardeDisponible()
  Protected Fichier, Ok

  If FileSize(FichierTexteReference()) <> TailleTexteGarde()
    ProcedureReturn #False
  EndIf
  Fichier = ReadFile(#PB_Any, FichierTexteReference(), #PB_File_SharedRead)
  If Fichier
    Ok = #True
    If ReadQuad(Fichier) <> #MagiqueTexteReference
      Ok = #False
    EndIf
    If ReadQuad(Fichier) <> #VersionReference
      Ok = #False
    EndIf
    If ReadQuad(Fichier) <> SignatureReference(#NiveauMaximal)
      Ok = #False
    EndIf
    If ReadQuad(Fichier) <> TailleNiveau(#NiveauMaximal)
      Ok = #False
    EndIf
    CloseFile(Fichier)
  EndIf
  ProcedureReturn Ok
EndProcedure


; Vérifie les Nombre premiers segments d'un texte rangé dans l'ordre du niveau
; Maximal, puis les met à disposition (SegmentAdresse pointe dans *Texte, qui
; reste en mémoire jusqu'à la fin du programme). Renvoie #False si un segment ne
; correspond pas à sa somme de contrôle (rien n'est alors changé).
Procedure RangerSegments(*Texte, Nombre)
  Protected Liste$, i, n
  Protected.q Position

  Liste$ = CompositionNiveau(#NiveauMaximal)
  For i = 1 To Nombre
    n = Val(StringField(Liste$, i, ","))
    If Controle(*Texte + Position, SegmentTaille(n)) <> SegmentControle(n)
      ProcedureReturn #False
    EndIf
    Position = Position + SegmentTaille(n)
  Next
  Position = 0
  For i = 1 To Nombre
    n = Val(StringField(Liste$, i, ","))
    If SegmentAdresse(n) = 0
      SegmentAdresse(n) = *Texte + Position
    EndIf
    Position = Position + SegmentTaille(n)
  Next
  ProcedureReturn #True
EndProcedure


; Relit le texte gardé sur le disque (environ 11 Mo, en une seconde). Renvoie
; #True si tous les segments sont alors en mémoire. Un texte abîmé est effacé.
Procedure LireTexteGarde()
  Protected Fichier, Ok, Lu
  Protected.q T
  Protected *Texte

  If TexteGardeDisponible() = #False
    ProcedureReturn #False
  EndIf
  T = TailleNiveau(#NiveauMaximal)
  Fichier = ReadFile(#PB_Any, FichierTexteReference(), #PB_File_SharedRead)
  If Fichier = 0
    ProcedureReturn #False
  EndIf
  AfficherEtape(TrF("lectureTexteGarde", Str((T + 524288) / 1048576)))
  *Texte = AllocateMemory(T + 16)
  If *Texte
    FileSeek(Fichier, 32)
    If ReadData(Fichier, *Texte, T) = T
      Lu = #True
      Ok = RangerSegments(*Texte, #NbSegments)
    EndIf
  EndIf
  CloseFile(Fichier)
  If Ok = #False
    If *Texte
      FreeMemory(*Texte)
    EndIf
    If Lu
      DeleteFile(FichierTexteReference())    ; abîmé: il sera refait
    EndIf
  EndIf
  ProcedureReturn Ok
EndProcedure


; Garde sur le disque le texte qui vient d'être décompressé (et vérifié)
Procedure EcrireTexteGarde(*Texte, T.q)
  Protected Fichier, Ok, Nom$

  Nom$ = FichierTexteReference() + ".tmp"
  CreateDirectory(DossierEtat())
  Fichier = CreateFile(#PB_Any, Nom$)
  If Fichier = 0
    ProcedureReturn #False
  EndIf
  AfficherEtape(TrF("ecritureTexteDec", Str((T + 524288) / 1048576)))
  Ok = #True
  If WriteQuad(Fichier, #MagiqueTexteReference) = 0
    Ok = #False
  EndIf
  If WriteQuad(Fichier, #VersionReference) = 0
    Ok = #False
  EndIf
  If WriteQuad(Fichier, SignatureReference(#NiveauMaximal)) = 0
    Ok = #False
  EndIf
  If WriteQuad(Fichier, T) = 0
    Ok = #False
  EndIf
  If WriteData(Fichier, *Texte, T) <> T
    Ok = #False
  EndIf
  CloseFile(Fichier)
  If Ok And FileSize(Nom$) = TailleTexteGarde()
    DeleteFile(FichierTexteReference())
    Ok = Bool(RenameFile(Nom$, FichierTexteReference()) <> 0)
  Else
    Ok = #False
  EndIf
  If Ok = #False
    DeleteFile(Nom$)
  EndIf
  ProcedureReturn Ok
EndProcedure


; L'état gardé du niveau Maximal (fait par la v6.3 ou plus tard) contient aussi
; tout le texte, juste après son en-tête: le relire évite de décompresser le
; fichier de référence. Cet état est-il là (taille et en-tête) ?
Procedure TexteDansEtatMaximal()
  Protected Fichier, Ok

  If FileSize(FichierEtat(#NiveauMaximal)) <> TailleFichierEtat(#NiveauMaximal)
    ProcedureReturn #False
  EndIf
  Fichier = ReadFile(#PB_Any, FichierEtat(#NiveauMaximal), #PB_File_SharedRead)
  If Fichier
    Ok = EnTeteEtatValide(Fichier, #NiveauMaximal)
    CloseFile(Fichier)
  EndIf
  ProcedureReturn Ok
EndProcedure


; Relit le texte dans l'état gardé du niveau Maximal, le vérifie, et le garde
; aussi à part pour les fois suivantes. Renvoie #True si tous les segments sont
; alors en mémoire.
Procedure LireTexteDepuisEtatMaximal()
  Protected Fichier, Ok
  Protected.q T
  Protected *Texte

  If TexteDansEtatMaximal() = #False
    ProcedureReturn #False
  EndIf
  Fichier = ReadFile(#PB_Any, FichierEtat(#NiveauMaximal), #PB_File_SharedRead)
  If Fichier = 0
    ProcedureReturn #False
  EndIf
  If EnTeteEtatValide(Fichier, #NiveauMaximal)
    T = TailleNiveau(#NiveauMaximal)
    AfficherEtape(TrF("lectureTexteEtatMax", Str((T + 524288) / 1048576)))
    *Texte = AllocateMemory(T + 16)
    If *Texte
      If ReadData(Fichier, *Texte, T) = T
        Ok = RangerSegments(*Texte, #NbSegments)
      EndIf
    EndIf
  EndIf
  CloseFile(Fichier)
  If Ok
    EcrireTexteGarde(*Texte, T)
  ElseIf *Texte
    FreeMemory(*Texte)
  EndIf
  ProcedureReturn Ok
EndProcedure


; Où est le fichier de référence ? À côté du programme ; sinon à côté du code
; source compilé (avec F5, le programme est lancé depuis un dossier temporaire) ;
; sinon là où l'utilisateur l'a indiqué une fois. "" s'il est introuvable.
Procedure.s TrouverFichierReference()
  Protected Chemin$

  Chemin$ = GetPathPart(ProgramFilename()) + #NomFichierReference$
  If FileSize(Chemin$) > 0
    ProcedureReturn Chemin$
  EndIf
  Chemin$ = #PB_Compiler_FilePath
  If Right(Chemin$, 1) <> #PS$
    Chemin$ = Chemin$ + #PS$
  EndIf
  Chemin$ = Chemin$ + #NomFichierReference$
  If FileSize(Chemin$) > 0
    ProcedureReturn Chemin$
  EndIf
  If CheminReferenceChoisi$ <> ""
    If FileSize(CheminReferenceChoisi$) > 0
      ProcedureReturn CheminReferenceChoisi$
    EndIf
  EndIf
  ProcedureReturn ""
EndProcedure


; Demande où se trouve le fichier de référence (le chemin est gardé dans les réglages)
Procedure.s ChoisirFichierReference()
  Protected Chemin$

  Chemin$ = OpenFileRequester(TrF("choisirReference", Guillemets(#NomFichierReference$)), #NomFichierReference$, Tr("filtreReference"), 0)
  If Chemin$ <> ""
    CheminReferenceChoisi$ = Chemin$
  EndIf
  ProcedureReturn Chemin$
EndProcedure


; ----------------------------------------------------------------------------
;  Réseaux de neurones des niveaux 2 et 3 (depuis la v7.0): rangés dans le
;  fichier de référence, juste après le texte compressé. Cette section contient:
;  une marque, sa version, le nombre de réseaux, puis pour chacun son numéro, sa
;  taille et sa somme de contrôle (Controle), puis les réseaux eux-mêmes, l'un
;  après l'autre (nombres entiers, voir NNChargerModele). Le programme connaît
;  la taille et la somme de contrôle exactes de chaque réseau: un bloc
;  compressé avec un réseau ne se décompresse qu'avec exactement le même.
; ----------------------------------------------------------------------------
#MagiqueReseaux   = 724295903062409808
#VersionReseaux   = 1
#TailleReseau1    = 1672268          ; niveau 2
#ControleReseau1  = 174689806
#TailleReseau2    = 3627092          ; niveau 3
#ControleReseau2  = 733559260
#DebutReseau1     = 765          ; octets refaits avant chaque morceau de la compression (L x 255)
#DebutReseau2     = 1020
Global ReseauCalibre            ; #True si l'opération a mesuré la vitesse du réseau sur ce PC

; Charge le réseau Modele (1 = niveau 2, 2 = niveau 3) depuis le fichier de
; référence, s'il n'est pas déjà en mémoire. Renvoie #False en cas d'échec
; (raison dans ErreurReference$).
Procedure ChargerReseau(Modele)
  Protected Chemin$, Fichier, Nb, i, Trouve, Raison$
  Protected.q Magique, Version, Z, Position, Taille, Attendu, Id, T, Ck, Debut, DebutTrouve, TailleTrouvee, CkTrouve
  Protected *m

  If Modele = NNModele And Modele > 0
    ProcedureReturn #True
  EndIf
  NNModele = 0
  If Modele = 2
    Taille = #TailleReseau2
    Attendu = #ControleReseau2
  Else
    Taille = #TailleReseau1
    Attendu = #ControleReseau1
  EndIf
  Chemin$ = TrouverFichierReference()
  If Chemin$ = ""
    Chemin$ = ChoisirFichierReference()
  EndIf
  If Chemin$ = ""
    ErreurReference$ = TrF("refIntrouvable", Guillemets(#NomFichierReference$))
    ProcedureReturn #False
  EndIf
  Fichier = ReadFile(#PB_Any, Chemin$, #PB_File_SharedRead)
  If Fichier = 0
    ErreurReference$ = TrF("refOuverture", Chemin$)
    ProcedureReturn #False
  EndIf
  ; La taille du texte compressé (en-tête du fichier, voir
  ; DecompresserFichierReference) donne la place de la section des réseaux
  Magique = ReadQuad(Fichier)
  For i = 1 To 4
    ReadQuad(Fichier)
  Next
  Z = ReadQuad(Fichier)
  Position = #TailleEnTeteReference + (24 * #NbSegments) + Z
  Raison$ = TrF("refSansReseaux", Guillemets(GetFilePart(Chemin$)))
  If Magique = #MagiqueReference And Z > 0 And Lof(Fichier) >= Position + 24
    FileSeek(Fichier, Position)
    Magique = ReadQuad(Fichier)
    Version = ReadQuad(Fichier)
    Nb = ReadQuad(Fichier)
    If Magique = #MagiqueReseaux And Version = #VersionReseaux And Nb >= 1 And Nb <= 100
      Debut = Position + 24 + (Nb * 24)
      For i = 1 To Nb
        Id = ReadQuad(Fichier)
        T = ReadQuad(Fichier)
        Ck = ReadQuad(Fichier)
        If Id = Modele And Trouve = #False
          Trouve = #True
          DebutTrouve = Debut
          TailleTrouvee = T
          CkTrouve = Ck
        EndIf
        If T > 0
          Debut = Debut + T
        EndIf
      Next
      If Trouve
        Raison$ = TrF("refReseauFaux", Str(Modele + 1), Guillemets(GetFilePart(Chemin$)))
        If TailleTrouvee = Taille And CkTrouve = Attendu And Lof(Fichier) >= DebutTrouve + Taille
          *m = AllocateMemory(Taille + 16)
          If *m = 0
            Raison$ = Tr("memoireReseau")
          Else
            FileSeek(Fichier, DebutTrouve)
            If ReadData(Fichier, *m, Taille) = Taille
              If Controle(*m, Taille) = Attendu
                If NNChargerModele(*m, Taille, Modele) = ""
                  Raison$ = ""
                EndIf
              EndIf
            EndIf
            FreeMemory(*m)
          EndIf
        EndIf
      EndIf
    EndIf
  EndIf
  CloseFile(Fichier)
  If Raison$ <> ""
    NNModele = 0
    ErreurReference$ = Raison$
    ProcedureReturn #False
  EndIf
  ProcedureReturn #True
EndProcedure

; ----------------------------------------------------------------------------
;  Listes de mots de la méthode v6 (v7.3): rangées dans le fichier de
;  référence, juste après les réseaux. Cette section contient: une marque, sa
;  version, le nombre de listes, puis pour chacune son numéro (0 = française,
;  1 = anglaise), sa taille et sa somme de contrôle (Controle), puis les listes
;  elles-mêmes, l'une après l'autre. Comme pour les réseaux, le programme
;  connaît la taille et la somme de contrôle exactes de chaque liste: un bloc
;  compressé avec ces listes ne se décompresse qu'avec exactement les mêmes.
;  Elles viennent de wordfreq (Robyn Speer), sous licence CC BY-SA 4.0: voir
;  les crédits en fin de fichier.
;  Une liste, telle qu'elle est rangée (octets, nombres en petit-boutiste):
;    « PBDICO01 » (8 octets), nombre de mots (4 octets), puis 1 001 poids
;    (4 octets chacun: le poids d'un mot de fréquence 10^(-c/100), pour c de 0
;    à 1 000), puis pour chaque mot, dans l'ordre: le nombre d'octets en commun
;    avec le mot d'avant (1 octet), le nombre d'octets qui suivent (1 octet),
;    ces octets, et c (2 octets).
; ----------------------------------------------------------------------------
#MagiqueDicos  = 724295877208064592
#VersionDicos  = 1
#TailleDico0   = 908980          ; liste française
#ControleDico0 = 197747105
#TailleDico1   = 871313          ; liste anglaise
#ControleDico1 = 729764997

; Lit une liste (*Mem, T octets) et remplit les tableaux de la liste 0 (ou 1).
; Tout est contrôlé (marque, nombre de mots, longueurs, ordre strictement
; croissant des mots, taille exacte). Renvoie 1 si tout est correct, sinon 0
; (DicoNb0 reste alors à 0).
DisableDebugger
Procedure LireDictionnaire0(*Mem, T.q)
  Protected.q ok, nmots, i, a, pos, lp, total, p, l, cb, kk, tt

  Dim DicoWT.q(1000)
  Dim DicoPrec.a(63)
  ok = 0
  nmots = 0
  If T >= 4020
    If PeekA(*Mem + 0) = 80 And PeekA(*Mem + 1) = 66 And PeekA(*Mem + 2) = 68 And PeekA(*Mem + 3) = 73 And PeekA(*Mem + 4) = 67 And PeekA(*Mem + 5) = 79 And PeekA(*Mem + 6) = 48 And PeekA(*Mem + 7) = 49
      nmots = PeekA(*Mem + 8) + (PeekA(*Mem + 9) * 256) + (PeekA(*Mem + 10) * 65536) + (PeekA(*Mem + 11) * 16777216)
      ok = Bool(nmots >= 1 And nmots <= 1000000)
    EndIf
  EndIf
  If ok
    For i = 0 To 1000
      a = 12 + (i * 4)
      DicoWT(i) = PeekA(*Mem + a) + (PeekA(*Mem + a + 1) * 256) + (PeekA(*Mem + a + 2) * 65536) + (PeekA(*Mem + a + 3) * 16777216)
    Next
    pos = 4016
    lp = 0
    total = 0
    i = 0
    While ok And i < nmots
      If pos + 4 > T
        ok = 0
      Else
        p = PeekA(*Mem + pos)
        l = PeekA(*Mem + pos + 1)
        If p > lp Or l < 1 Or p + l > 60 Or pos + 4 + l > T
          ok = 0
        Else
          cb = PeekA(*Mem + pos + 2 + l) + (PeekA(*Mem + pos + 3 + l) * 256)
          If cb > 1000
            ok = 0
          ElseIf p < lp
            If PeekA(*Mem + pos + 2) <= DicoPrec(p): ok = 0: EndIf
          EndIf
          If ok
            For kk = 0 To l - 1
              DicoPrec(p + kk) = PeekA(*Mem + pos + 2 + kk)
            Next
            lp = p + l
            total = total + lp
            pos = pos + 4 + l
            i = i + 1
          EndIf
        EndIf
      EndIf
    Wend
    If pos <> T: ok = 0: EndIf
  EndIf
  If ok
    *DicoTexte0 = AllocateMemory(total + 16)
    If *DicoTexte0 = 0: ok = 0: EndIf
  EndIf
  If ok
    Dim DicoDebut0.l(nmots)
    Dim DicoLong0.a(nmots)
    Dim DicoCumul0.q(nmots)
    pos = 4016
    tt = 0
    For i = 0 To nmots - 1
      p = PeekA(*Mem + pos)
      l = PeekA(*Mem + pos + 1)
      For kk = 0 To l - 1
        DicoPrec(p + kk) = PeekA(*Mem + pos + 2 + kk)
      Next
      lp = p + l
      DicoDebut0(i) = tt
      DicoLong0(i) = lp
      For kk = 0 To lp - 1
        PokeA(*DicoTexte0 + tt + kk, DicoPrec(kk))
      Next
      tt = tt + lp
      cb = PeekA(*Mem + pos + 2 + l) + (PeekA(*Mem + pos + 3 + l) * 256)
      DicoCumul0(i + 1) = DicoCumul0(i) + DicoWT(cb)
      pos = pos + 4 + l
    Next
    DicoNb0 = nmots
  EndIf
  ProcedureReturn ok
EndProcedure
EnableDebugger

DisableDebugger
Procedure LireDictionnaire1(*Mem, T.q)
  Protected.q ok, nmots, i, a, pos, lp, total, p, l, cb, kk, tt

  Dim DicoWT.q(1000)
  Dim DicoPrec.a(63)
  ok = 0
  nmots = 0
  If T >= 4020
    If PeekA(*Mem + 0) = 80 And PeekA(*Mem + 1) = 66 And PeekA(*Mem + 2) = 68 And PeekA(*Mem + 3) = 73 And PeekA(*Mem + 4) = 67 And PeekA(*Mem + 5) = 79 And PeekA(*Mem + 6) = 48 And PeekA(*Mem + 7) = 49
      nmots = PeekA(*Mem + 8) + (PeekA(*Mem + 9) * 256) + (PeekA(*Mem + 10) * 65536) + (PeekA(*Mem + 11) * 16777216)
      ok = Bool(nmots >= 1 And nmots <= 1000000)
    EndIf
  EndIf
  If ok
    For i = 0 To 1000
      a = 12 + (i * 4)
      DicoWT(i) = PeekA(*Mem + a) + (PeekA(*Mem + a + 1) * 256) + (PeekA(*Mem + a + 2) * 65536) + (PeekA(*Mem + a + 3) * 16777216)
    Next
    pos = 4016
    lp = 0
    total = 0
    i = 0
    While ok And i < nmots
      If pos + 4 > T
        ok = 0
      Else
        p = PeekA(*Mem + pos)
        l = PeekA(*Mem + pos + 1)
        If p > lp Or l < 1 Or p + l > 60 Or pos + 4 + l > T
          ok = 0
        Else
          cb = PeekA(*Mem + pos + 2 + l) + (PeekA(*Mem + pos + 3 + l) * 256)
          If cb > 1000
            ok = 0
          ElseIf p < lp
            If PeekA(*Mem + pos + 2) <= DicoPrec(p): ok = 0: EndIf
          EndIf
          If ok
            For kk = 0 To l - 1
              DicoPrec(p + kk) = PeekA(*Mem + pos + 2 + kk)
            Next
            lp = p + l
            total = total + lp
            pos = pos + 4 + l
            i = i + 1
          EndIf
        EndIf
      EndIf
    Wend
    If pos <> T: ok = 0: EndIf
  EndIf
  If ok
    *DicoTexte1 = AllocateMemory(total + 16)
    If *DicoTexte1 = 0: ok = 0: EndIf
  EndIf
  If ok
    Dim DicoDebut1.l(nmots)
    Dim DicoLong1.a(nmots)
    Dim DicoCumul1.q(nmots)
    pos = 4016
    tt = 0
    For i = 0 To nmots - 1
      p = PeekA(*Mem + pos)
      l = PeekA(*Mem + pos + 1)
      For kk = 0 To l - 1
        DicoPrec(p + kk) = PeekA(*Mem + pos + 2 + kk)
      Next
      lp = p + l
      DicoDebut1(i) = tt
      DicoLong1(i) = lp
      For kk = 0 To lp - 1
        PokeA(*DicoTexte1 + tt + kk, DicoPrec(kk))
      Next
      tt = tt + lp
      cb = PeekA(*Mem + pos + 2 + l) + (PeekA(*Mem + pos + 3 + l) * 256)
      DicoCumul1(i + 1) = DicoCumul1(i) + DicoWT(cb)
      pos = pos + 4 + l
    Next
    DicoNb1 = nmots
  EndIf
  ProcedureReturn ok
EndProcedure
EnableDebugger

; Les deux listes sont oubliées (mémoire rendue)
Procedure LibererDictionnaires()
  If *DicoTexte0
    FreeMemory(*DicoTexte0)
    *DicoTexte0 = 0
  EndIf
  If *DicoTexte1
    FreeMemory(*DicoTexte1)
    *DicoTexte1 = 0
  EndIf
  DicoNb0 = 0
  DicoNb1 = 0
  Dim DicoDebut0.l(0)
  Dim DicoLong0.a(0)
  Dim DicoCumul0.q(0)
  Dim DicoDebut1.l(0)
  Dim DicoLong1.a(0)
  Dim DicoCumul1.q(0)
  DicosCharges = #False
EndProcedure

; Lit la liste Numero rangée dans le fichier ouvert (Debut, Taille octets),
; vérifie sa somme de contrôle et remplit ses tableaux. Renvoie 1 si tout va
; bien, 0 si la liste n'est pas celle attendue (abîmée), -1 si la mémoire
; manque.
Procedure ChargerUnDictionnaire(Fichier, Numero, Debut.q, Taille.q, Attendu.q)
  Protected *m, Etat

  *m = AllocateMemory(Taille + 16)
  If *m = 0
    ProcedureReturn -1
  EndIf
  FileSeek(Fichier, Debut)
  If ReadData(Fichier, *m, Taille) = Taille
    If Controle(*m, Taille) = Attendu
      ; c'est exactement la liste attendue: un refus ne peut plus venir que
      ; d'un manque de mémoire
      Etat = -1
      If Numero = 0
        If LireDictionnaire0(*m, Taille)
          Etat = 1
        EndIf
      ElseIf LireDictionnaire1(*m, Taille)
        Etat = 1
      EndIf
    EndIf
  EndIf
  FreeMemory(*m)
  ProcedureReturn Etat
EndProcedure

; Charge les deux listes de mots depuis le fichier de référence, si elles ne
; sont pas déjà en mémoire. Renvoie #False en cas d'échec (raison dans
; ErreurReference$).
Procedure ChargerDictionnaires()
  Protected Chemin$, Fichier, Nb, i, Raison$, Trouve0, Trouve1, Etat0, Etat1
  Protected.q Magique, Version, Z, Position, Debut, Id, T, Ck, Debut0, Debut1

  If DicosCharges
    ProcedureReturn #True
  EndIf
  LibererDictionnaires()
  Chemin$ = TrouverFichierReference()
  If Chemin$ = ""
    Chemin$ = ChoisirFichierReference()
  EndIf
  If Chemin$ = ""
    ErreurReference$ = TrF("refIntrouvable", Guillemets(#NomFichierReference$))
    ProcedureReturn #False
  EndIf
  Fichier = ReadFile(#PB_Any, Chemin$, #PB_File_SharedRead)
  If Fichier = 0
    ErreurReference$ = TrF("refOuverture", Chemin$)
    ProcedureReturn #False
  EndIf
  ; La section des listes suit celle des réseaux, qui suit le texte compressé
  ; (sa taille est dans l'en-tête du fichier, voir ChargerReseau)
  Raison$ = TrF("refSansDicos", Guillemets(GetFilePart(Chemin$)))
  Magique = ReadQuad(Fichier)
  For i = 1 To 4
    ReadQuad(Fichier)
  Next
  Z = ReadQuad(Fichier)
  Position = #TailleEnTeteReference + (24 * #NbSegments) + Z
  If Magique = #MagiqueReference And Z > 0 And Lof(Fichier) >= Position + 24
    FileSeek(Fichier, Position)
    Magique = ReadQuad(Fichier)
    Version = ReadQuad(Fichier)
    Nb = ReadQuad(Fichier)
    If Magique = #MagiqueReseaux And Version = #VersionReseaux And Nb >= 1 And Nb <= 100
      ; fin de la section des réseaux
      Debut = Position + 24 + (Nb * 24)
      For i = 1 To Nb
        ReadQuad(Fichier)
        T = ReadQuad(Fichier)
        ReadQuad(Fichier)
        If T > 0
          Debut = Debut + T
        EndIf
      Next
      If Lof(Fichier) >= Debut + 24
        FileSeek(Fichier, Debut)
        Magique = ReadQuad(Fichier)
        Version = ReadQuad(Fichier)
        Nb = ReadQuad(Fichier)
        If Magique = #MagiqueDicos And Version = #VersionDicos And Nb >= 1 And Nb <= 100
          Raison$ = TrF("refDicoFaux", Guillemets(GetFilePart(Chemin$)))
          Position = Debut + 24 + (Nb * 24)
          For i = 1 To Nb
            Id = ReadQuad(Fichier)
            T = ReadQuad(Fichier)
            Ck = ReadQuad(Fichier)
            If Id = 0 And Trouve0 = #False
              Trouve0 = Bool(T = #TailleDico0 And Ck = #ControleDico0)
              Debut0 = Position
            ElseIf Id = 1 And Trouve1 = #False
              Trouve1 = Bool(T = #TailleDico1 And Ck = #ControleDico1)
              Debut1 = Position
            EndIf
            If T > 0
              Position = Position + T
            EndIf
          Next
          If Trouve0 And Trouve1 And Lof(Fichier) >= Debut0 + #TailleDico0 And Lof(Fichier) >= Debut1 + #TailleDico1
            Etat0 = ChargerUnDictionnaire(Fichier, 0, Debut0, #TailleDico0, #ControleDico0)
            If Etat0 = 1
              Etat1 = ChargerUnDictionnaire(Fichier, 1, Debut1, #TailleDico1, #ControleDico1)
            EndIf
            If Etat0 = 1 And Etat1 = 1
              Raison$ = ""
            ElseIf Etat0 = -1 Or Etat1 = -1
              Raison$ = Tr("memoireInsuffisante")
            EndIf
          EndIf
        EndIf
      EndIf
    EndIf
  EndIf
  CloseFile(Fichier)
  If Raison$ <> ""
    LibererDictionnaires()
    ErreurReference$ = Raison$
    ProcedureReturn #False
  EndIf
  DicosCharges = #True
  ProcedureReturn #True
EndProcedure


; Le réseau Modele a-t-il déjà été mesuré sur ce PC ? (calibrage gardé dans les
; réglages, refait si le nombre de cœurs a changé)
Procedure ReseauMesure(Modele)
  If NNCoeurs < 1
    NNCoeursPhysiques()
  EndIf
  If NNCalCoeurs(Modele) <> NNCoeurs Or NNCalVitesse(Modele) < 1 Or NNCalCoeur(Modele) < 1 Or NNCalFils(Modele) < 1 Or NNCalFils(Modele) > NNCoeurs Or NNCalVariante(Modele) < 0 Or NNCalVariante(Modele) > 1
    ProcedureReturn #False
  EndIf
  ProcedureReturn #True
EndProcedure


; Réseau prêt pour une opération: chargé, et mesuré sur ce PC (une seule fois:
; le résultat est gardé dans les réglages). Le temps de la mesure n'entre pas
; dans la mesure de la vitesse de la méthode.
Procedure PreparerReseau(Modele)
  Protected.q Debut

  If ChargerReseau(Modele) = #False
    ProcedureReturn #False
  EndIf
  If ReseauMesure(Modele) = #False
    Debut = ElapsedMilliseconds()
    CalibrerReseau(Modele)
    ProgresHorsTemps = ProgresHorsTemps + (ElapsedMilliseconds() - Debut)
    ReseauCalibre = #True
    SauverReglages()
  EndIf
  ProcedureReturn #True
EndProcedure


; Vitesse de la décompression du réseau sur ce PC (octets par seconde): celle
; du calibrage, sinon une valeur prudente
Procedure.q VitesseReseauDec(Modele)
  If ReseauMesure(Modele)
    ProcedureReturn NNCalVitesse(Modele)
  EndIf
  If Modele = 2
    ProcedureReturn 700
  EndIf
  ProcedureReturn 1500
EndProcedure


; Vitesse du réseau pendant la compression d'un code de T octets (octets par
; seconde): un fil par cœur physique, chacun refait quelques centaines
; d'octets avant son morceau (voir ReseauMorceaux)
Procedure.q VitesseReseauComp(Modele, T.q)
  Protected.q Coeur, Fils, Morceau, Nb, Avant

  If NNCoeurs < 1
    NNCoeursPhysiques()
  EndIf
  If ReseauMesure(Modele)
    Coeur = NNCalCoeur(Modele)
  ElseIf Modele = 2
    Coeur = 350
  Else
    Coeur = 750
  EndIf
  If Modele = 2
    Avant = #DebutReseau2
  Else
    Avant = #DebutReseau1
  EndIf
  Fils = NNCoeurs
  CompilerIf #PB_Compiler_Thread = 0
    Fils = 1
  CompilerEndIf
  If Fils > #ReseauMaxFils
    Fils = #ReseauMaxFils
  EndIf
  If Fils < 1
    Fils = 1
  EndIf
  If T < 1
    T = 1
  EndIf
  Morceau = (T + (2 * Fils) - 1) / (2 * Fils)
  If Morceau < 2048
    Morceau = 2048
  EndIf
  Nb = (T + Morceau - 1) / Morceau
  If Fils > Nb
    Fils = Nb
  EndIf
  ProcedureReturn (((Coeur * Fils * Morceau) / (Morceau + Avant)) * 85) / 100
EndProcedure


; Unités de la barre de progression par octet passé dans le réseau
Procedure.q PoidsReseau(Vitesse.q)
  Protected.q Poids

  If Vitesse < 1
    Vitesse = 1
  EndIf
  Poids = VitesseCM / Vitesse
  If Poids < 1
    Poids = 1
  EndIf
  ProcedureReturn Poids
EndProcedure


; Termine l'état du niveau Maximal écrit à la fin de la décompression du fichier
; de référence: le texte est écrit à sa place (juste après l'en-tête), puis
; l'état n'est gardé que s'il est complet et que sa somme de contrôle est
; exactement celle calculée à la fabrication du fichier (#ControleEtatMaximal).
Procedure FinirEtatPrepare(Fichier, *Texte, T.q)
  Protected Ok, Nom$, Lecture

  Nom$ = FichierEtat(#NiveauMaximal) + ".tmp"
  Ok = Bool(EcritureEtatRatee = #False)
  FileSeek(Fichier, #TailleEnTeteEtat)
  If WriteData(Fichier, *Texte, T) <> T
    Ok = #False
  EndIf
  CloseFile(Fichier)
  If Ok
    Ok = #False
    If FileSize(Nom$) = TailleFichierEtat(#NiveauMaximal)
      Lecture = ReadFile(#PB_Any, Nom$, #PB_File_SharedRead)
      If Lecture
        If EnTeteEtatValide(Lecture, #NiveauMaximal)
          FileSeek(Lecture, TailleFichierEtat(#NiveauMaximal) - 8)
          Ok = Bool(ReadQuad(Lecture) = #ControleEtatMaximal)
          If Ok = #False
            EtatMaximalRefuse = #True
          EndIf
        EndIf
        CloseFile(Lecture)
      EndIf
    EndIf
  EndIf
  If Ok
    DeleteFile(FichierEtat(#NiveauMaximal))
    Ok = Bool(RenameFile(Nom$, FichierEtat(#NiveauMaximal)) <> 0)
  EndIf
  If Ok = #False
    DeleteFile(Nom$)
  EndIf
  ProcedureReturn Ok
EndProcedure


; ----------------------------------------------------------------------------
;  Décompresse le fichier de référence: en entier (Tout = #True), ou seulement
;  son début (segment 0). En entier, le modèle a lu tout le texte du niveau
;  Maximal: son état est écrit au passage (si le réglage le permet) et gardé
;  s'il est exact (FinirEtatPrepare), et le texte est gardé sur le disque.
;  Renvoie #False en cas d'échec (raison dans ErreurReference$).
; ----------------------------------------------------------------------------
Procedure DecompresserFichierReference(Tout)
  Protected Chemin$, Fichier, FichierFin, i, n, Ok, Liste$, Etape$
  Protected.q Z, T, Taille
  Protected *C, *D

  If MemoireMethode4() = #False
    ErreurReference$ = Tr("memoireRefV4")
    ProcedureReturn #False
  EndIf
  Chemin$ = TrouverFichierReference()
  If Chemin$ = ""
    Chemin$ = ChoisirFichierReference()
  EndIf
  If Chemin$ = ""
    ErreurReference$ = TrF("refIntrouvable", Guillemets(#NomFichierReference$))
    ProcedureReturn #False
  EndIf
  Fichier = ReadFile(#PB_Any, Chemin$, #PB_File_SharedRead)
  If Fichier = 0
    ErreurReference$ = TrF("refOuverture", Chemin$)
    ProcedureReturn #False
  EndIf

  ; En-tête: tout doit correspondre à ce programme (méthode, segments, tailles,
  ; sommes de contrôle)
  LireTableReference()
  Liste$ = CompositionNiveau(#NiveauMaximal)
  Taille = TailleNiveau(#NiveauMaximal)
  Ok = #True
  If ReadQuad(Fichier) <> #MagiqueReference
    Ok = #False
  EndIf
  If ReadQuad(Fichier) <> #VersionReference
    Ok = #False
  EndIf
  If ReadQuad(Fichier) <> #SignatureModele4
    Ok = #False
  EndIf
  If ReadQuad(Fichier) <> #NbSegments
    Ok = #False
  EndIf
  If ReadQuad(Fichier) <> Taille
    Ok = #False
  EndIf
  Z = ReadQuad(Fichier)
  If ReadQuad(Fichier) <> SignatureReference(#NiveauMaximal)
    Ok = #False
  EndIf
  ReadQuad(Fichier)
  For i = 1 To #NbSegments
    n = Val(StringField(Liste$, i, ","))
    If ReadQuad(Fichier) <> n
      Ok = #False
    EndIf
    If ReadQuad(Fichier) <> SegmentTaille(n)
      Ok = #False
    EndIf
    If ReadQuad(Fichier) <> SegmentControle(n)
      Ok = #False
    EndIf
  Next
  ; (depuis la v7.0, la section des réseaux suit le texte compressé)
  If Z <= 0 Or Lof(Fichier) < #TailleEnTeteReference + (24 * #NbSegments) + Z
    Ok = #False
  EndIf
  If Ok
    *C = AllocateMemory(Z + 16)
    If *C
      If ReadData(Fichier, *C, Z) <> Z
        Ok = #False
      EndIf
    EndIf
  EndIf
  CloseFile(Fichier)
  If Ok = #False
    If *C
      FreeMemory(*C)
    EndIf
    ErreurReference$ = TrF("refMauvaiseVersion", Guillemets(GetFilePart(Chemin$)))
    ProcedureReturn #False
  EndIf

  ; Décompression: tout, ou seulement le segment 0 (le premier du fichier)
  T = Taille
  If Tout = #False
    T = SegmentTaille(Val(StringField(Liste$, 1, ",")))
  EndIf
  *D = AllocateMemory(T + 16)
  If *C = 0 Or *D = 0
    If *C
      FreeMemory(*C)
    EndIf
    If *D
      FreeMemory(*D)
    EndIf
    ErreurReference$ = Tr("memoireTexteRef")
    ProcedureReturn #False
  EndIf
  ; En entier, l'état du niveau Maximal est préparé au passage: le fichier
  ; provisoire reçoit d'abord l'en-tête et la place du texte (encore vide), la
  ; méthode v4 y écrit l'état à la fin, puis le texte est écrit à sa place
  FichierFin = 0
  If Tout And EtatUtile(#NiveauMaximal)
    If EtatDisponible(#NiveauMaximal) = #False
      FichierFin = CreerEtatAvec(#NiveauMaximal, *D, T, Tr("preparationEtatMax"))
    EndIf
  EndIf
  If Tout
    Etape$ = Tr("etapeDecRefTout")
  Else
    Etape$ = Tr("etapeDecRefDebut")
  EndIf
  CommencerPasse(Etape$, 4)
  DecoderReferenceCM4(*C, Z, T, *D, 0, 0, 0, FichierFin)
  TerminerPasse(T)
  FreeMemory(*C)
  ReferenceDecompressee = 1 + Bool(Tout)
  If Tout
    Ok = RangerSegments(*D, #NbSegments)
  Else
    Ok = RangerSegments(*D, 1)
  EndIf
  If FichierFin
    If Ok
      EtatMaximalPrepare = FinirEtatPrepare(FichierFin, *D, T)
    Else
      CloseFile(FichierFin)
      DeleteFile(FichierEtat(#NiveauMaximal) + ".tmp")
    EndIf
  EndIf
  If Ok = #False
    FreeMemory(*D)
    If ArretDemande: ErreurReference$ = Tr("operationArretee"): Else: ErreurReference$ = Tr("refAbime"): EndIf
    ProcedureReturn #False
  EndIf
  If Tout
    EcrireTexteGarde(*D, T)
  EndIf
  ProcedureReturn #True
EndProcedure


; Ce qui manque en mémoire pour une liste de segments: 0 = rien, 1 = seulement
; le segment 0 (le début du fichier suffit), 2 = d'autres segments
Procedure BesoinSegments(Liste$)
  Protected i, n, Besoin

  LireTableReference()
  For i = 1 To CountString(Liste$, ",") + 1
    n = Val(StringField(Liste$, i, ","))
    If SegmentAdresse(n) = 0
      If n = 0
        If Besoin = 0
          Besoin = 1
        EndIf
      Else
        Besoin = 2
      EndIf
    EndIf
  Next
  ProcedureReturn Besoin
EndProcedure


; Met en mémoire les segments d'une liste: depuis le texte gardé sur le disque
; (à part, ou dans l'état gardé du niveau Maximal), sinon en décompressant le
; fichier de référence (son début, ou tout)
Procedure ChargerSegments(Liste$)
  Protected Besoin

  Besoin = BesoinSegments(Liste$)
  If Besoin = 0
    ProcedureReturn #True
  EndIf
  If LireTexteGarde()
    ProcedureReturn #True
  EndIf
  If LireTexteDepuisEtatMaximal()
    ProcedureReturn #True
  EndIf
  ProcedureReturn DecompresserFichierReference(Bool(Besoin = 2))
EndProcedure


; ----------------------------------------------------------------------------
;  Assemble le texte de référence d'un niveau dans *Reference (TailleReference
;  octets). Renvoie #False si le texte ne peut pas être lu (raison dans
;  ErreurReference$) ou si la mémoire manque.
;  Les formats PBC2 et PBC3 utilisent le niveau Faible (l'ancien texte seul).
; ----------------------------------------------------------------------------
Procedure ConstruireReference(Niveau)
  Protected Liste$, i, n
  Protected.q Position

  If *Reference And NiveauReference = Niveau
    ProcedureReturn #True
  EndIf
  ErreurReference$ = ""
  Liste$ = CompositionNiveau(Niveau)
  If ChargerSegments(Liste$) = #False
    If ErreurReference$ = ""
      ErreurReference$ = Tr("refIllisible")
    EndIf
    ProcedureReturn #False
  EndIf

  If *Reference
    FreeMemory(*Reference)
  EndIf
  NiveauReference = -1
  TailleReference = 0
  *Reference = AllocateMemory(TailleNiveau(Niveau) + 16)
  If *Reference = 0
    ErreurReference$ = TrF("memoireTexteRefNiveau", NomNiveau(Niveau))
    ProcedureReturn #False
  EndIf
  For i = 1 To CountString(Liste$, ",") + 1
    n = Val(StringField(Liste$, i, ","))
    CopyMemory(SegmentAdresse(n), *Reference + Position, SegmentTaille(n))
    Position = Position + SegmentTaille(n)
  Next
  TailleReference = Position
  NiveauReference = Niveau
  ProcedureReturn #True
EndProcedure


; ----------------------------------------------------------------------------
;  Travail prévu (unités de la barre de progression) pour avoir en mémoire le
;  texte de référence d'un niveau: 0 s'il y est déjà ou s'il est gardé sur le
;  disque, sinon la décompression du fichier de référence (son début, ou tout).
; ----------------------------------------------------------------------------
Procedure.q TravailReference(Niveau)
  Protected Besoin

  Besoin = BesoinSegments(CompositionNiveau(Niveau))
  If Besoin = 0
    ProcedureReturn 0
  EndIf
  If TexteGardeDisponible() Or TexteDansEtatMaximal()
    ProcedureReturn 0
  EndIf
  If Besoin = 1
    ProcedureReturn SegmentTaille(0) * 4
  EndIf
  ProcedureReturn TailleNiveau(#NiveauMaximal) * 4
EndProcedure


; Le modèle relira-t-il un état pour ce niveau ? Soit un état gardé, soit celui
; du niveau Maximal, préparé en décompressant tout le fichier de référence.
Procedure EtatPrevu(Niveau)
  If EtatDisponible(Niveau)
    ProcedureReturn #True
  EndIf
  If Niveau = #NiveauMaximal And EtatUtile(Niveau)
    ProcedureReturn Bool(TravailReference(Niveau) > 0)
  EndIf
  ProcedureReturn #False
EndProcedure


; Travail avant une passe qui relit l'état prévu: la décompression du fichier
; de référence, quand c'est elle qui prépare cet état
Procedure.q TravailAvant(Niveau)
  If EtatDisponible(Niveau)
    ProcedureReturn 0
  EndIf
  ProcedureReturn TravailReference(Niveau)
EndProcedure


; ----------------------------------------------------------------------------
;  Prépare une opération de la méthode v4: le texte de référence du niveau et,
;  si le réglage le permet, l'état du modèle à relire (FichierEtatLu) ou, à
;  défaut, à écrire (FichierEtatEcrit, fichier provisoire). Renvoie #False si
;  le texte de référence ne peut pas être préparé (raison dans
;  ErreurReference$).
; ----------------------------------------------------------------------------
Procedure PreparerNiveau(Niveau)
  FichierEtatLu = 0
  FichierEtatEcrit = 0
  EtatAbime = #False
  If EtatUtile(Niveau)
    FichierEtatLu = OuvrirEtat(Niveau)
  EndIf
  If FichierEtatLu = 0
    If ConstruireReference(Niveau) = #False
      ProcedureReturn #False
    EndIf
    ; La décompression du fichier de référence vient peut-être de préparer l'état
    ; de ce niveau (niveau Maximal)
    If EtatUtile(Niveau)
      FichierEtatLu = OuvrirEtat(Niveau)
    EndIf
    If FichierEtatLu = 0
      FichierEtatEcrit = CreerEtat(Niveau)
    EndIf
  EndIf
  ProcedureReturn #True
EndProcedure


; ----------------------------------------------------------------------------
;  Travail prévu (en unités de la barre de progression) pour une passe de la
;  méthode v4 qui relit l'état (Relu = #True) ou le texte de référence.
; ----------------------------------------------------------------------------
Procedure.q TravailPasse4(T.q, Niveau, Relu)
  If Relu
    ProcedureReturn T * 4
  EndIf
  ProcedureReturn TravailReference(Niveau) + TravailMethode4(T, Niveau)
EndProcedure


; ----------------------------------------------------------------------------
;  Méthodes v5 et v6 (niveaux 1 à 3): travail prévu pour une décompression
;  (unités de la barre de progression), et temps estimé sur ce PC (secondes).
;  Le texte de référence est le segment 0 (décompressé depuis le début du
;  fichier de référence s'il n'est pas déjà en mémoire ou gardé sur le disque).
;  Methode: 7, 8 ou 9 (0 = celle de la v7.3 pour ce niveau).
; ----------------------------------------------------------------------------
Procedure.q TravailDecompression5(T.q, Niveau, Methode = 0)
  Protected.q Travail

  If Methode = 0
    Methode = MethodeNiveau(Niveau)
  EndIf
  LireTableReference()
  Travail = TravailReference(#NiveauFaible) + ((SegmentTaille(0) + T) * PoidsMethode(Methode))
  If Niveau >= 2
    Travail = Travail + (T * PoidsReseau(VitesseReseauDec(Niveau - 1)))
  EndIf
  ProcedureReturn Travail
EndProcedure


; Temps de la mesure du réseau, faite une seule fois sur chaque PC (secondes)
#DureeCalibrage = 5

Procedure.q DureeDecompression5(T.q, Niveau)
  Protected.q Secondes

  Secondes = TravailDecompression5(T, Niveau) / VitesseCM
  If Niveau >= 2
    If ReseauMesure(Niveau - 1) = #False
      Secondes = Secondes + #DureeCalibrage
    EndIf
  EndIf
  ProcedureReturn Secondes
EndProcedure


; ----------------------------------------------------------------------------
;  Le texte est-il un nombre entier positif (uniquement des chiffres) ?
; ----------------------------------------------------------------------------
Procedure EstNombre(Texte$)
  Protected i

  If Texte$ = "" Or Len(Texte$) > 12
    ProcedureReturn #False
  EndIf
  For i = 1 To Len(Texte$)
    If FindString("0123456789", Mid(Texte$, i, 1)) = 0
      ProcedureReturn #False
    EndIf
  Next
  ProcedureReturn #True
EndProcedure


; ----------------------------------------------------------------------------
;  Le texte (qui commence par PBC1; à PBC11;) est-il un en-tête complet et
;  bien formé ? Évite de prendre pour un bloc un simple "PBC1;" écrit dans un
;  code source ou un message.
; ----------------------------------------------------------------------------
Procedure EnTeteTexteValide(Texte$)
  Protected Methode$, Encodage$

  Methode$  = StringField(Texte$, 2, ";")
  Encodage$ = StringField(Texte$, 3, ";")
  If (Methode$ = "L" Or Methode$ = "M") And (Encodage$ = "U" Or Encodage$ = "B")
    If EstNombre(StringField(Texte$, 4, ";")) And EstNombre(StringField(Texte$, 5, ";")) And EstNombre(StringField(Texte$, 6, ";"))
      ProcedureReturn #True
    EndIf
  EndIf
  ProcedureReturn #False
EndProcedure


; ----------------------------------------------------------------------------
;  Lit un bloc "données seules" et renvoie le code d'origine ("" si échec,
;  avec la raison dans ErreurDecompression$).
;  Deux présentations possibles:
;  - Format compact: uniquement des caractères Unicode (voir #MarqueCompacte).
;  - Format texte:  PBCx;Méthode;Encodage;Taille;TailleCompressée;Contrôle;données;FIN
;      PBC1: Méthode L = LZMA, ou M = Maximal (version 1)
;      PBC2: Méthode M = Maximal version 2 (avec le texte de référence)
;      PBC3: Méthode M = Maximal version 3 (avec le texte de référence)
;      PBC4 à PBC8: Méthode M = Maximal version 4, niveaux Moyen (4), Faible (5),
;                    Normal (6), Élevé (7), Maximal (8)
;      PBC9 à PBC11: Méthode M = Maximal version 5 (v7.0), niveaux 1 à 3
;      PBC12: projet (v7.2), méthode L ; PBC13 à PBC15: projet, méthode M,
;             Maximal version 5, niveaux 1 à 3. Les octets obtenus sont alors
;             un paquet (voir PROJETS), gardés dans *OctetsBloc.
;      PBC16 à PBC18: Méthode M = Maximal version 6 (v7.3), niveaux 1 à 3
;      PBC19 à PBC21: projet, méthode M, Maximal version 6, niveaux 1 à 3
;      Encodage: U = Unicode, B = Base64
; ----------------------------------------------------------------------------
Procedure LibererOctetsBloc()
  If *OctetsBloc
    FreeMemory(*OctetsBloc)
    *OctetsBloc = 0
  EndIf
  TailleOctetsBloc = 0
EndProcedure

Procedure.s DecompresserBloc(Texte$)
  Protected Position, Debut, Version, TailleTampon, Methode$, Encodage$, Donnees$, Resultat$, Candidat$, Protection, Attendu
  Protected PropreProgression, Etape$, Niveau, Raccourci, Pret, Reussi, EtatEcrit, PlusRecent, Reseau, Modele, MethodeV
  Protected.q T, Z, K, N, Decalage, Origine
  Protected *C, *D

  ErreurDecompression$ = ""
  BlocReconnu = #False
  BlocProtege = #False
  BlocProjet = #False
  LibererOctetsBloc()

  ; Format texte: on cherche un PBC1; à PBC21; suivi d'un en-tête bien formé
  ; (un numéro plus grand vient d'une version plus récente du programme)
  Position = 0
  Debut = FindString(Texte$, "PBC")
  While Debut
    Candidat$ = StringField(Mid(Texte$, Debut + 3, 3), 1, ";")
    If (Len(Candidat$) = 1 Or Len(Candidat$) = 2) And EstNombre(Candidat$) And Mid(Texte$, Debut + 3 + Len(Candidat$), 1) = ";"
      If Val(Candidat$) >= 1 And EnTeteTexteValide(Mid(Texte$, Debut, 200))
        If Val(Candidat$) <= 21
          Position = Debut
          Version = Val(Candidat$)
          Break
        EndIf
        PlusRecent = #True
      EndIf
    EndIf
    Debut = FindString(Texte$, "PBC", Debut + 1)
  Wend
  If Position = 0 And PlusRecent
    BlocReconnu = #True
    ErreurDecompression$ = Tr("errPlusRecent")
    ProcedureReturn ""
  EndIf

  If Position = 0
    ; Pas d'en-tête PBC texte: format compact, uniquement des caractères Unicode
    Donnees$ = GarderCaracteresUnicode(Texte$)

    ; Bloc protégé contre les erreurs: on le répare d'abord (s'il le faut)
    If Len(Donnees$) > 8 And ValeurUnicode(Asc(Left(Donnees$, 1))) <> #MarqueCompacte
      Protection = EstBlocProtege(Donnees$)
      If Protection = 2
        BlocReconnu = #True
        ErreurDecompression$ = Tr("errProt53")
        ProcedureReturn ""
      ElseIf Protection = 1
        BlocReconnu = #True
        BlocProtege = #True
        Donnees$ = ReparerBloc(Donnees$)
        If Donnees$ = ""
          ProcedureReturn ""
        EndIf
      EndIf
    EndIf

    If Len(Donnees$) <= 8 Or ValeurUnicode(Asc(Left(Donnees$, 1))) <> #MarqueCompacte
      If FindString(#LF$ + Texte$, #LF$ + "; Code PureBasic compressé - lancez-le") Or FindString(#LF$ + Texte$, #LF$ + "; Compressed PureBasic code - run it") Or FindString(#LF$ + Texte$, #LF$ + "; Komprimierter PureBasic-Code - starte ihn")
        ErreurDecompression$ = Tr("errLanceur")
      Else
        ErreurDecompression$ = Tr("errPasUnBloc")
      EndIf
      ProcedureReturn ""
    EndIf
    BlocReconnu = #True
    Select ValeurUnicode(Asc(Mid(Donnees$, 2, 1)))
      Case 1
        Methode$ = "L"
        Version = 1
      Case 2
        Methode$ = "M"
        Version = 2
      Case 3
        Methode$ = "M"
        Version = 3
      Case 4, 5, 6, 7, 8, 9, 10, 11
        Methode$ = "M"
        Version = ValeurUnicode(Asc(Mid(Donnees$, 2, 1)))
      Case 12
        Methode$ = "L"
        Version = 12
      Case 13, 14, 15, 16, 17, 18, 19, 20, 21
        Methode$ = "M"
        Version = ValeurUnicode(Asc(Mid(Donnees$, 2, 1)))
      Default
        If ValeurUnicode(Asc(Mid(Donnees$, 2, 1))) > 21 And ValeurUnicode(Asc(Mid(Donnees$, 2, 1))) < 100
          ErreurDecompression$ = Tr("errPlusRecent")
          ProcedureReturn ""
        EndIf
        Methode$ = "?"
    EndSelect
    Encodage$ = "U"
    T = (ValeurUnicode(Asc(Mid(Donnees$, 3, 1))) * 32768) + ValeurUnicode(Asc(Mid(Donnees$, 4, 1)))
    Z = (ValeurUnicode(Asc(Mid(Donnees$, 5, 1))) * 32768) + ValeurUnicode(Asc(Mid(Donnees$, 6, 1)))
    K = (ValeurUnicode(Asc(Mid(Donnees$, 7, 1))) * 32768) + ValeurUnicode(Asc(Mid(Donnees$, 8, 1)))
    Donnees$ = Mid(Donnees$, 9)
  Else
    BlocReconnu = #True
    Texte$    = Mid(Texte$, Position)
    Methode$  = StringField(Texte$, 2, ";")
    Encodage$ = StringField(Texte$, 3, ";")
    T = Val(StringField(Texte$, 4, ";"))
    Z = Val(StringField(Texte$, 5, ";"))
    K = Val(StringField(Texte$, 6, ";"))
    Donnees$ = StringField(Texte$, 7, ";")
    Donnees$ = RemoveString(Donnees$, #CR$)
    Donnees$ = RemoveString(Donnees$, #LF$)
    Donnees$ = RemoveString(Donnees$, " ")
    Donnees$ = RemoveString(Donnees$, #TAB$)
  EndIf

  If (Methode$ <> "L" And Methode$ <> "M") Or (Encodage$ <> "U" And Encodage$ <> "B") Or T <= 0 Or T > 500000000 Or Z <= 0 Or Donnees$ = ""
    ErreurDecompression$ = Tr("errEnTete")
    ProcedureReturn ""
  EndIf
  ; Projet (v7.2): PBC12 se lit comme PBC1 (LZMA), PBC13 à PBC15 comme PBC9 à
  ; PBC11 (Maximal v5, niveaux 1 à 3), et PBC19 à PBC21 comme PBC16 à PBC18
  ; (Maximal v6, v7.3) ; seuls les octets obtenus changent
  If (Version >= 12 And Version <= 15) Or Version >= 19
    BlocProjet = #True
    If Version = 12 And Methode$ = "L"
      Version = 1
    ElseIf Version >= 19 And Methode$ = "M"
      Version = Version - 3
    ElseIf Version >= 13 And Methode$ = "M"
      Version = Version - 4
    Else
      ErreurDecompression$ = Tr("errEnTete")
      ProcedureReturn ""
    EndIf
  EndIf
  If Version >= 2 And Methode$ <> "M"
    ErreurDecompression$ = TrF("errEnTetePBC", Str(Version))
    ProcedureReturn ""
  EndIf

  ; Barre de progression (méthodes v3, v4 et v5). Pendant une compression, elle
  ; est déjà prévue: cette décompression est alors la vérification.
  Etape$ = Tr("etapeVerification")
  ; Formats PBC4 à PBC8: méthode v4, au niveau indiqué par le bloc. Formats
  ; PBC9 à PBC11: méthode v5 (7), niveaux 1 à 3 (réseau 1 ou 2 aux niveaux 2
  ; et 3). Formats PBC16 à PBC18: méthode v6 (8 aux niveaux 1 et 2, 9 au
  ; niveau 3), avec les listes de mots
  Niveau = #NiveauFaible
  MethodeV = 7
  If Version >= 4 And Version <= 8
    Niveau = NiveauDuCode(Version)
  EndIf
  If Version >= 9
    If Version >= 16
      Niveau = Version - 15
      MethodeV = MethodeNiveau(Niveau)
    Else
      Niveau = Version - 8
    EndIf
    Reseau = Bool(Niveau >= 2)
    Modele = Niveau - 1
  EndIf
  ; Pendant une compression dont la méthode v5 a déjà été vérifiée (VerifOctets):
  ; seul le texte du bloc reste à contrôler, sans tout décompresser une seconde fois
  Raccourci = Bool(Version >= 9 And *VerifOctets <> 0 And Z = VerifZ And T = VerifT And Version = VerifVersion)
  If ProgresEnCours = #False And Version >= 3
    PropreProgression = #True
    Etape$ = Tr("etapeDecompression")
    If Version >= 9
      Etape$ = Etape$ + TrF("etapeNiveau", Str(Niveau))
      DebutProgression(TravailDecompression5(T, Niveau, MethodeV))
    ElseIf Version >= 4
      Etape$ = Etape$ + TrF("etapeNiveau", NomNiveau(Niveau))
      If EtatPrevu(Niveau)
        DebutProgression(TravailAvant(Niveau) + TravailPasse4(T, Niveau, #True))
      ElseIf EtatUtile(Niveau)
        ; Première fois à ce niveau: décompression, puis contrôle de l'état écrit
        DebutProgression(TravailPasse4(T, Niveau, #False) + TravailPasse4(T, Niveau, #True))
      Else
        DebutProgression(TravailPasse4(T, Niveau, #False))
      EndIf
    Else
      DebutProgression(TravailReference(Niveau) + #TailleReferenceCourte + T)
    EndIf
  EndIf

  ; Méthodes v4 et v5: la mémoire est vérifiée avant de lire le texte de référence
  If Version >= 9 And Raccourci = #False
    If MemoireMethode5(MethodeV) = #False
      ErreurDecompression$ = TrF("errMemoireV5", Decimal(GoMethode(MethodeV), 1))
      If PropreProgression
        FinProgression()
      EndIf
      ProcedureReturn ""
    EndIf
  ElseIf Version >= 4 And Version <= 8
    If MemoireMethode4() = #False
      ErreurDecompression$ = Tr("errMemoireV4")
      If PropreProgression
        FinProgression()
      EndIf
      ProcedureReturn ""
    EndIf
  EndIf

  ; Formats PBC2 à PBC18: le texte de référence du niveau (l'ancien texte seul,
  ; le segment 0, pour PBC2, PBC3 et PBC9 à PBC18) est placé devant la sortie.
  ; Méthode v4: avec l'état du modèle gardé sur le disque s'il existe (sinon,
  ; il sera écrit cette fois). Méthode v6: les listes de mots. Niveaux 2 et 3:
  ; le réseau de neurones, chargé depuis le fichier de référence (et mesuré sur
  ; ce PC la première fois).
  FichierEtatLu = 0
  FichierEtatEcrit = 0
  If Version >= 2 And Raccourci = #False
    If Version >= 9
      Pret = ConstruireReference(#NiveauFaible)
      If Pret And MethodeV >= 8
        Pret = ChargerDictionnaires()
      EndIf
      If Pret And Reseau
        AfficherEtape(TrF("chargementReseau", Str(Niveau)))
        Pret = PreparerReseau(Modele)
        If Pret And PropreProgression
          ; le travail qui reste, d'après les vitesses (peut-être tout juste mesurées)
          ProgresTotal = ProgresFait + TravailDecompression5(T, Niveau, MethodeV)
        EndIf
      EndIf
    ElseIf Version >= 4
      Pret = PreparerNiveau(Niveau)
    Else
      Pret = ConstruireReference(Niveau)
    EndIf
    If Pret = #False
      ErreurDecompression$ = ErreurReference$
      If PropreProgression
        FinProgression()
      EndIf
      ProcedureReturn ""
    EndIf
    Decalage = TailleReference
  EndIf

  TailleTampon = Len(Donnees$) * 2 + 64
  *C = AllocateMemory(TailleTampon)
  *D = AllocateMemory(Decalage + T + 16)

  If *C = 0 Or *D = 0
    ErreurDecompression$ = Tr("memoireInsuffisante")
  Else
    ; 1. Texte -> octets compressés
    If Encodage$ = "U"
      N = DecoderUnicode(Donnees$, *C, TailleTampon)
    Else
      N = Base64Decoder(Donnees$, *C, TailleTampon)
    EndIf

    ; Format compact: nombre de caractères de données attendu
    Attendu = ((Z * 8) + 14) / 15
    If N < Z
      If Encodage$ = "U" And Position = 0 And Len(Donnees$) < Attendu
        ErreurDecompression$ = TrF("errIncomplet", Str(Attendu - Len(Donnees$)))
      Else
        ErreurDecompression$ = Tr("errAbime")
      EndIf
    Else
      ; 2. Décompression
      If Methode$ = "L"
        If UncompressMemory(*C, Z, *D, T, #PB_PackerPlugin_Lzma) <> T
          ErreurDecompression$ = Tr("errLZMA")
        EndIf
      ElseIf Version = 2
        CopyMemory(*Reference, *D, Decalage)
        DecoderCM2(*C, Z, T, *D, Decalage)
      ElseIf Version = 3
        CopyMemory(*Reference, *D, Decalage)
        CommencerPasse(Etape$, 1)
        DecoderCM3(*C, Z, T, *D, Decalage)
        TerminerPasse(Decalage + T)
      ElseIf Version >= 9
        If Raccourci
          ; Ces octets ont déjà été décompressés et vérifiés pendant la compression:
          ; le texte du bloc doit les redonner exactement, puis le contrôle final
          ; porte sur le code qu'ils donnent
          If CompareMemory(*C, *VerifOctets, Z)
            CopyMemory(*VerifCode, *D, T)
          Else
            ErreurDecompression$ = Tr("errOctetsVerifies")
          EndIf
        Else
          CopyMemory(*Reference, *D, Decalage)
          If Reseau
            ; le réseau calcule chaque octet avec plusieurs fils (nombre et façon
            ; choisis par la mesure faite sur ce PC)
            NNDemarrerFils(NNCalFils(Modele), NNCalVariante(Modele))
            CommencerPasseReseau(TrF("etapeFils", Etape$, Str(NNFILS), Str(NNCoeurs)), PoidsMethode(MethodeV), Decalage, PoidsReseau(VitesseReseauDec(Modele)))
          Else
            CommencerPasse(Etape$, PoidsMethode(MethodeV))
          EndIf
          DecoderMethode(MethodeV, *C, Z, T, *D, Decalage, Reseau)
          TerminerPasse(Decalage + T)
          If Reseau
            NNArreterFils()
          EndIf
        EndIf
      ElseIf Version >= 4
        CopyMemory(*Reference, *D, Decalage)
        Origine = 0
        If FichierEtatLu
          Origine = Decalage
        EndIf
        CommencerPasse(Etape$, 4, Origine)
        DecoderCM4(*C, Z, T, *D, Decalage, FichierEtatLu, FichierEtatEcrit)
        TerminerPasse(Decalage + T - Origine)
      Else
        DecoderCM(*C, Z, T, *D)
      EndIf

      If ArretDemande And ErreurDecompression$ = ""
        ErreurDecompression$ = Tr("operationArretee")
      EndIf
      ; 3. Contrôle final: on ne rend le code que s'il est intact
      If ErreurDecompression$ = ""
        If Controle(*D + Decalage, T) = K
          If BlocProjet
            ; un projet: le paquet est gardé tel quel (ce n'est pas un code)
            *OctetsBloc = AllocateMemory(T)
            If *OctetsBloc
              CopyMemory(*D + Decalage, *OctetsBloc, T)
              TailleOctetsBloc = T
              Reussi = #True
              Resultat$ = #ProjetMarque$
            Else
              ErreurDecompression$ = Tr("memoireInsuffisante")
            EndIf
          Else
            Reussi = #True
            Resultat$ = PeekS(*D + Decalage, T, #PB_UTF8 | #PB_ByteLength)
          EndIf
        Else
          If Encodage$ = "U" And Position = 0 And Len(Donnees$) > Attendu
            ErreurDecompression$ = TrF("errEnTrop", Str(Len(Donnees$) - Attendu))
          Else
            ErreurDecompression$ = Tr("errControleFinal")
          EndIf
        EndIf
      EndIf
    EndIf
  EndIf

  ; 4. État du modèle de cette opération (méthode v4): un état relu et abîmé
  ;    est effacé ; un état tout juste écrit n'est gardé que s'il redonne la
  ;    même décompression
  If FichierEtatLu
    EtatRelu = FermerEtatLu(FichierEtatLu, Niveau)
    FichierEtatLu = 0
  EndIf
  If FichierEtatEcrit
    EtatEcrit = FermerEtatEcrit(FichierEtatEcrit, Niveau)
    FichierEtatEcrit = 0
    If EtatEcrit
      If Reussi
        ValiderEtat(Niveau, *C, Z, T, *D + Decalage, Tr("etapeControleEtat"))
      Else
        DeleteFile(FichierEtat(Niveau) + ".tmp")
      EndIf
    EndIf
  EndIf

  If *C
    FreeMemory(*C)
  EndIf
  If *D
    FreeMemory(*D)
  EndIf

  If PropreProgression
    FinProgression()
  EndIf
  ProcedureReturn Resultat$
EndProcedure

; ============================================================================
;  FIN DE LA PARTIE DÉCOMPRESSION
; ============================================================================



; ----------------------------------------------------------------------------
;  Méthode "Maximal": compresseur. Modèle strictement identique au
;  décompresseur ci-dessus ; seules changent les lignes de codage.
;  *D = code d'origine (T octets), *O = sortie. Renvoie la taille compressée.
; ----------------------------------------------------------------------------
DisableDebugger
Procedure.q EncoderCM(*D, T.q, *O)
  Protected.q i, u, v, no, x1, x2, wh, ls, pl, ml, mp, chk, pos, h, k, hm, ab, ma, c, c0, j, ws, dot, pb, e, pm, px, s, aw, ai, xm, y, er, g

  Dim T33.q(32)
  Restore Sq33
  For i = 0 To 32
    Read.q u
    T33(i) = u
  Next
  Dim Sq.q(4094)
  For i = 0 To 4094
    u = (i + 1) % 128
    v = (i + 1) / 128
    Sq(i) = ((T33(v) * (128 - u)) + (T33(v + 1) * u) + 64) / 128
  Next
  Dim St.q(4095)
  v = 0
  For i = 0 To 4094
    While v <= Sq(i)
      St(v) = i - 2047
      v = v + 1
    Wend
  Next
  While v <= 4095
    St(v) = 2047
    v = v + 1
  Wend
  Dim Kr.q(255)
  For i = 0 To 255
    Kr(i) = 8192 / ((2 * i) + 3)
  Next
  Dim P2.q(8)
  P2(0) = 1
  For i = 1 To 8
    P2(i) = P2(i - 1) * 2
  Next
  Dim M.l(12582911)
  For i = 0 To 12582911
    M(i) = 8388608
  Next
  Dim MT.l(1048575)
  Dim MS.q(63)
  For i = 0 To 63
    MS(i) = 8388608
  Next
  Dim W.q(2047)
  For i = 0 To 2047
    W(i) = 16384
  Next
  Dim Ap.q(2162687)
  For i = 0 To 2162687
    u = ((i % 33) * 128) - 1
    If u < 0: u = 0: EndIf
    If u > 4094: u = 4094: EndIf
    Ap(i) = Sq(u) * 16
  Next
  Dim Hi.q(4)
  Dim Hc.q(5)
  Dim Ix.q(6)
  Dim Sv.q(6)
  no = 0
  x1 = 0: x2 = 4294967295: wh = 0: ls = 0: pl = 0: ml = 0: mp = 0: chk = 0
  For pos = 0 To T - 1
    h = 0
    For k = 0 To 4
      h = ((((h + Hi(k)) + 1) * $6F4F2B) / 256) % $1000000
      If k < 4: Hc(k) = h: EndIf
    Next
    hm = h % $100000
    Hc(4) = (((((wh * 256) + Hi(0)) + 1) * $6F4F2B) / 256) % $1000000
    ab = 0
    If pl + pos - ls < ls: ab = PeekA(*D + pl + pos - ls): EndIf
    Hc(5) = (((((ab * 256) + Hi(0)) + 1048577) * $6F4F2B) / 256) % $1000000
    If ml > 0 And PeekA(*D + mp) = Hi(0)
      If ml < 65535: ml = ml + 1: EndIf
      mp = mp + 1
    Else
      ml = 0
    EndIf
    If ml = 0 And pos >= 5
      mp = MT(hm)
      While mp > 0 And ml < 124 And ml < mp
        If PeekA(*D + mp - ml - 1) <> PeekA(*D + pos - ml - 1): Break: EndIf
        ml = ml + 1
      Wend
    EndIf
    MT(hm) = pos
    ma = Bool(ml > 0)
    c = PeekA(*D + pos)
    c0 = 1
    For j = 0 To 7
      ws = c0 * 8
      dot = 0
      For k = 0 To 5
        Ix(k) = (((((((Hc(k) * 256) + c0) * $2E8BA3) / 1024) % $200000)) + (k * $200000))
        Sv(k) = St(M(Ix(k)) / 4096)
        dot = dot + (W(ws + k) * Sv(k))
      Next
      Sv(6) = 0
      If ma
        pb = PeekA(*D + mp) + 256
        If pb / P2(8 - j) = c0
          u = ml
          If u > 31: u = 31: EndIf
          Ix(6) = (u * 2) + ((pb / P2(7 - j)) % 2)
          Sv(6) = St(MS(Ix(6)) / 4096)
        Else
          ma = 0
        EndIf
      EndIf
