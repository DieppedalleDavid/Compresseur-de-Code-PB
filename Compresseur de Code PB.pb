Global Dim Icone16(#NbIcones)      ; icônes à 16 pixels (à l'échelle)
Global Dim Icone32(#NbIcones)      ; icônes à 32 pixels (onglets vides, dialogues)

Procedure Maxi(A, B)
  If A > B
    ProcedureReturn A
  EndIf
  ProcedureReturn B
EndProcedure

Procedure Mini(A, B)
  If A < B
    ProcedureReturn A
  EndIf
  ProcedureReturn B
EndProcedure

; Pixels à 100 % -> pixels de l'écran
Procedure Pix(Valeur.d)
  ProcedureReturn Round(Valeur * Ech, #PB_Round_Nearest)
EndProcedure

; Épaisseur d'un trait d'un pixel à 100 % (comme le navigateur: jamais flou)
Procedure Bord()
  ProcedureReturn Maxi(1, Int(Ech))
EndProcedure

; Pixels de l'écran -> unités des gadgets de PureBasic (arrondi au-dessus)
Procedure Logique(Pixels)
  ProcedureReturn Round(Pixels / Ech, #PB_Round_Up)
EndProcedure

Procedure CreerPolice(Nom$, Pixels.d, Graisse)
  ; Hauteur négative: taille du caractère lui-même, comme « font-size » en CSS
  ProcedureReturn CreateFont_(-Pix(Pixels), 0, 0, 0, Graisse, 0, 0, 0, 1, 4, 0, 5, 0, Nom$)
EndProcedure

Procedure CreerPolices()
  PoliceBase        = CreerPolice("Segoe UI", 12, 400)
  PoliceBaseGras    = CreerPolice("Segoe UI", 12, 600)
  PolicePetite      = CreerPolice("Segoe UI", 11, 400)
  PolicePetiteGras  = CreerPolice("Segoe UI", 11, 600)
  PoliceMini        = CreerPolice("Segoe UI", 10, 400)
  PoliceIcone       = CreerPolice("Segoe UI", 10, 600)
  PoliceGrandTitre  = CreerPolice("Segoe UI", 15, 600)
  PoliceCode        = CreerPolice("Consolas", 12, 400)
EndProcedure

; Position de la souris dans un gadget, en pixels de l'écran (toujours juste,
; quelle que soit l'échelle)
Procedure SourisDans(Gadget, *P.POINT)
  GetCursorPos_(*P)
  ScreenToClient_(GadgetID(Gadget), *P)
EndProcedure

; Taille d'un gadget en pixels de l'écran
Procedure LargeurPixels(Gadget)
  Protected r.RECT
  GetClientRect_(GadgetID(Gadget), @r)
  ProcedureReturn r\right - r\left
EndProcedure

Procedure HauteurPixels(Gadget)
  Protected r.RECT
  GetClientRect_(GadgetID(Gadget), @r)
  ProcedureReturn r\bottom - r\top
EndProcedure

; Le bouton principal de la souris est-il enfoncé en ce moment ? (sert à
; terminer un glissement dont on n'a pas reçu le relâchement, par exemple
; après un Alt+Tab)
Procedure BoutonGaucheEnfonce()
  Protected Bouton = 1                      ; VK_LBUTTON
  If GetSystemMetrics_(23)                  ; boutons inversés (gaucher)
    Bouton = 2
  EndIf
  ProcedureReturn Bool(GetAsyncKeyState_(Bouton) & $8000)
EndProcedure

Procedure DansRect(X, Y, RX, RY, RL, RH)
  ProcedureReturn Bool(X >= RX And X < RX + RL And Y >= RY And Y < RY + RH)
EndProcedure

; ----------------------------------------------------------------------------
;  Petites procédures de dessin (entre StartDrawing et StopDrawing)
; ----------------------------------------------------------------------------

; Dégradé vertical, comme « linear-gradient(to bottom, Haut, Bas) »
Procedure Degrade(X, Y, L, H, Haut, Bas)
  If L <= 0 Or H <= 0
    ProcedureReturn
  EndIf
  DrawingMode(#PB_2DDrawing_Gradient)
  BackColor(Haut)
  FrontColor(Bas)
  LinearGradient(X, Y, X, Y + H)
  Box(X, Y, L, H)
  DrawingMode(#PB_2DDrawing_Default)
EndProcedure

Procedure Rectangle(X, Y, L, H, Couleur)
  If L > 0 And H > 0
    DrawingMode(#PB_2DDrawing_Default)
    Box(X, Y, L, H, Couleur)
  EndIf
EndProcedure

; Fond « survolé » des menus: dégradé jaune dans un cadre arrondi
Procedure FondSurvol(X, Y, L, H)
  Protected R = Pix(3)
  If L <= 0 Or H <= 0
    ProcedureReturn
  EndIf
  DrawingMode(#PB_2DDrawing_Gradient)
  BackColor(#C_SurvolHaut)
  FrontColor(#C_SurvolBas)
  LinearGradient(X, Y, X, Y + H)
  RoundBox(X, Y, L, H, R, R)
  DrawingMode(#PB_2DDrawing_Outlined)
  RoundBox(X, Y, L, H, R, R, #C_SurvolBordure)
  DrawingMode(#PB_2DDrawing_Default)
EndProcedure

; Cadre d'un pixel (à l'échelle) d'épaisseur
Procedure Cadre(X, Y, L, H, Couleur)
  Protected E = Bord()
  If L <= 0 Or H <= 0
    ProcedureReturn
  EndIf
  DrawingMode(#PB_2DDrawing_Default)
  Box(X, Y, L, E, Couleur)
  Box(X, Y + H - E, L, E, Couleur)
  Box(X, Y, E, H, Couleur)
  Box(X + L - E, Y, E, H, Couleur)
EndProcedure

; Rectangle de couleur semi-transparente (Opacite de 0 à 255)
Procedure RectangleAlpha(X, Y, L, H, Couleur, Opacite)
  If L > 0 And H > 0
    DrawingMode(#PB_2DDrawing_AlphaBlend)
    Box(X, Y, L, H, RGBA(Red(Couleur), Green(Couleur), Blue(Couleur), Opacite))
    DrawingMode(#PB_2DDrawing_Default)
  EndIf
EndProcedure

Procedure CadreAlpha(X, Y, L, H, Couleur, Opacite)
  Protected E = Bord()
  RectangleAlpha(X, Y, L, E, Couleur, Opacite)
  RectangleAlpha(X, Y + H - E, L, E, Couleur, Opacite)
  RectangleAlpha(X, Y + E, E, H - (2 * E), Couleur, Opacite)
  RectangleAlpha(X + L - E, Y + E, E, H - (2 * E), Couleur, Opacite)
EndProcedure

; Cadre en pointillés (focus clavier, comme « outline: 1px dotted »)
Procedure CadrePointille(X, Y, L, H, Couleur)
  Protected i
  DrawingMode(#PB_2DDrawing_Default)
  For i = 0 To L - 1 Step 2
    Plot(X + i, Y, Couleur)
    Plot(X + i, Y + H - 1, Couleur)
  Next
  For i = 0 To H - 1 Step 2
    Plot(X, Y + i, Couleur)
    Plot(X + L - 1, Y + i, Couleur)
  Next
EndProcedure

Procedure DessinerTexte(X, Y, Texte$, Couleur)
  DrawingMode(#PB_2DDrawing_Transparent)
  ProcedureReturn DrawText(X, Y, Texte$, Couleur)
EndProcedure

; Texte coupé avec « … » s'il dépasse la largeur Max (police en cours)
Procedure.s Tronquer(Texte$, Max)
  Protected n
  If TextWidth(Texte$) <= Max
    ProcedureReturn Texte$
  EndIf
  n = Len(Texte$)
  While n > 0 And TextWidth(Left(Texte$, n) + "…") > Max
    n = n - 1
  Wend
  ProcedureReturn Left(Texte$, n) + "…"
EndProcedure

; Coupe un texte en lignes de largeur Max (police en cours). Renvoie le nombre
; de lignes ; elles sont dans la liste.
Procedure CouperLignes(Texte$, Max, List Lignes.s())
  Protected Para$, Ligne$, Mot$, Essai$, i, j, NbParas, NbMots

  ClearList(Lignes())
  NbParas = CountString(Texte$, #LF$) + 1
  For i = 1 To NbParas
    Para$ = StringField(Texte$, i, #LF$)
    Ligne$ = ""
    NbMots = CountString(Para$, " ") + 1
    For j = 1 To NbMots
      Mot$ = StringField(Para$, j, " ")
      If Ligne$ = ""
        Essai$ = Mot$
      Else
        Essai$ = Ligne$ + " " + Mot$
      EndIf
      If TextWidth(Essai$) > Max And Ligne$ <> ""
        AddElement(Lignes())
        Lignes() = Ligne$
        Ligne$ = Mot$
      Else
        Ligne$ = Essai$
      EndIf
    Next
    AddElement(Lignes())
    Lignes() = Ligne$
  Next
  ProcedureReturn ListSize(Lignes())
EndProcedure

; Icône (DrawAlphaImage), avec une opacité pour les boutons grisés
Procedure DessinerIco(Numero, X, Y, Opacite = 255, Grande = #False)
  If Grande
    If IsImage(Icone32(Numero))
      DrawingMode(#PB_2DDrawing_AlphaBlend)
      DrawAlphaImage(ImageID(Icone32(Numero)), X, Y, Opacite)
    EndIf
  Else
    If IsImage(Icone16(Numero))
      DrawingMode(#PB_2DDrawing_AlphaBlend)
      DrawAlphaImage(ImageID(Icone16(Numero)), X, Y, Opacite)
    EndIf
  EndIf
  DrawingMode(#PB_2DDrawing_Default)
EndProcedure

; ----------------------------------------------------------------------------
;  Icônes: dessinées en vectoriel dans un carré de 16 unités (comme les SVG de
;  la maquette du compresseur), puis gardées en images à la bonne taille.
; ----------------------------------------------------------------------------

; Couleur RGB -> couleur du dessin vectoriel (opaque)
Procedure CV(Couleur)
  ProcedureReturn RGBA(Red(Couleur), Green(Couleur), Blue(Couleur), 255)
EndProcedure

Procedure RemplirTracer(Fond, Contour, Epaisseur.d = 1.0)
  VectorSourceColor(CV(Fond))
  FillPath(#PB_Path_Preserve)
  VectorSourceColor(CV(Contour))
  StrokePath(Epaisseur, #PB_Path_RoundCorner)
EndProcedure

Procedure Trait(X1.d, Y1.d, X2.d, Y2.d, Couleur, Epaisseur.d = 1.0, Rond = #False)
  MovePathCursor(X1, Y1)
  AddPathLine(X2, Y2)
  VectorSourceColor(CV(Couleur))
  If Rond
    StrokePath(Epaisseur, #PB_Path_RoundEnd)
  Else
    StrokePath(Epaisseur)
  EndIf
EndProcedure

Procedure Carre(X.d, Y.d, L.d, H.d, Fond, Contour)
  AddPathBox(X, Y, L, H)
  RemplirTracer(Fond, Contour)
EndProcedure

Procedure DessinerIcone(Numero)
  Select Numero
    Case #IcoOuvrir
      MovePathCursor(1.5, 13.5) : AddPathLine(1.5, 3.5) : AddPathLine(5.5, 3.5) : AddPathLine(7, 5) : AddPathLine(13, 5) : AddPathLine(13, 7)
      RemplirTracer($49B9E9, $227AA5)
      MovePathCursor(1.5, 13.5) : AddPathLine(3.7, 7.5) : AddPathLine(14.7, 7.5) : AddPathLine(12.5, 13.5) : ClosePath()
      RemplirTracer($7AD3F7, $227AA5)
    Case #IcoColler
      Carre(2.5, 2.5, 11, 12, $5A93C9, $2B5A8A)
      Carre(4.5, 4.5, 7, 8.5, $FFFFFF, $B8A69A)
      Carre(5.5, 1.5, 5, 2.5, $D2C9C3, $82766E)
      Trait(6, 7.5, 10, 7.5, $99877A)
      Trait(6, 9.5, 10, 9.5, $99877A)
      Trait(6, 11.5, 8.5, 11.5, $99877A)
    Case #IcoCompresser
      MovePathCursor(4.5, 2.5) : AddPathLine(4.5, 13.5) : AddPathLine(13.5, 8) : ClosePath()
      RemplirTracer($4DA33F, $3A7726)
    Case #IcoDecompresser
      ; carton ouvert, et flèche bleue qui en sort
      MovePathCursor(2.5, 8.5) : AddPathLine(13.5, 8.5) : AddPathLine(13.5, 14.5) : AddPathLine(2.5, 14.5) : ClosePath()
      RemplirTracer($87B8DE, $345E8B)
      Trait(2.5, 8.5, 1, 6.5, $345E8B)
      Trait(13.5, 8.5, 15, 6.5, $345E8B)
      MovePathCursor(8, 1.5) : AddPathLine(12, 5.5) : AddPathLine(9.5, 5.5) : AddPathLine(9.5, 11) : AddPathLine(6.5, 11) : AddPathLine(6.5, 5.5) : AddPathLine(4, 5.5) : ClosePath()
      RemplirTracer($D4762E, $A0501E)
    Case #IcoArreter
      ; carré rouge
      Carre(3.5, 3.5, 9, 9, $323CDC, $191EA0)
    Case #IcoCopier
      MovePathCursor(2.5, 1.5) : AddPathLine(8, 1.5) : AddPathLine(10, 3.5) : AddPathLine(10, 11.5) : AddPathLine(2.5, 11.5) : ClosePath()
      RemplirTracer($FFFFFF, $967C6A)
      MovePathCursor(5.5, 4.5) : AddPathLine(11, 4.5) : AddPathLine(13, 6.5) : AddPathLine(13, 14.5) : AddPathLine(5.5, 14.5) : ClosePath()
      RemplirTracer($FFFFFF, $805A3E)
      Trait(7.5, 8.5, 11.5, 8.5, $BFA38F)
      Trait(7.5, 10.5, 11.5, 10.5, $BFA38F)
      Trait(7.5, 12.5, 10, 12.5, $BFA38F)
    Case #IcoEnregistrer
      MovePathCursor(2.5, 2.5) : AddPathLine(11.5, 2.5) : AddPathLine(13.5, 4.5) : AddPathLine(13.5, 13.5) : AddPathLine(2.5, 13.5) : ClosePath()
      RemplirTracer($B56D3E, $824A24)
      Carre(5.5, 2.5, 5, 4, $F7EEE8, $824A24)
      Carre(4.5, 9, 7, 4.5, $FFFFFF, $824A24)
    Case #IcoGlobe
      AddPathCircle(8, 8, 6.5)
      RemplirTracer($FAE8D9, $B56D3E)
      Trait(1.5, 8, 14.5, 8, $B56D3E)
      MovePathCursor(8, 1.5) : AddPathCurve(5.6, 3.5, 5.6, 12.5, 8, 14.5)
      MovePathCursor(8, 1.5) : AddPathCurve(10.4, 3.5, 10.4, 12.5, 8, 14.5)
      VectorSourceColor(CV($B56D3E)) : StrokePath(1)
      Trait(2.6, 4.8, 13.4, 4.8, $B56D3E)
      Trait(2.6, 11.2, 13.4, 11.2, $B56D3E)
    Case #IcoEffacer
      Trait(4, 4, 12, 12, $2E35C8, 2, #True)
      Trait(12, 4, 4, 12, $2E35C8, 2, #True)
    Case #IcoAide
      AddPathCircle(8, 8, 6.5)
      RemplirTracer($B56D3E, $824A24)
      MovePathCursor(6, 6.3) : AddPathCurve(6, 5.1, 6.9, 4.3, 8, 4.3) : AddPathCurve(9.1, 4.3, 10, 5.1, 10, 6.2) : AddPathCurve(10, 7.8, 8, 7.8, 8, 9.4)
      VectorSourceColor(CV($FFFFFF)) : StrokePath(1.4, #PB_Path_RoundEnd)
      AddPathCircle(8, 11.6, 0.9) : VectorSourceColor(CV($FFFFFF)) : FillPath()
    Case #IcoInfo
      AddPathCircle(8, 8, 6.5)
      RemplirTracer($B56D3E, $824A24)
      Trait(8, 7, 8, 11.5, $FFFFFF, 1.6, #True)
      AddPathCircle(8, 4.6, 0.95) : VectorSourceColor(CV($FFFFFF)) : FillPath()
    Case #IcoCoche
      MovePathCursor(3.5, 8.5) : AddPathLine(6.5, 11.5) : AddPathLine(12.5, 4.5)
      VectorSourceColor(CV(#C_TextePrincipal)) : StrokePath(1.6, #PB_Path_RoundEnd | #PB_Path_RoundCorner)
    Case #IcoCocheVerte
      MovePathCursor(3.5, 8.5) : AddPathLine(6.5, 11.5) : AddPathLine(12.5, 4.5)
      VectorSourceColor(CV(#C_OkTexte)) : StrokePath(1.6, #PB_Path_RoundEnd | #PB_Path_RoundCorner)
    Case #IcoPoint
      AddPathCircle(8, 8, 2.6) : VectorSourceColor(CV(#C_TextePrincipal)) : FillPath()
    Case #IcoDoc
      MovePathCursor(3.5, 1.5) : AddPathLine(9.5, 1.5) : AddPathLine(12.5, 4.5) : AddPathLine(12.5, 14.5) : AddPathLine(3.5, 14.5) : ClosePath()
      RemplirTracer($FFFFFF, $967C6A)
      MovePathCursor(9.5, 1.5) : AddPathLine(9.5, 4.5) : AddPathLine(12.5, 4.5)
      VectorSourceColor(CV($967C6A)) : StrokePath(1)
      Trait(5.5, 7.5, 10.5, 7.5, $BFA38F)
      Trait(5.5, 9.5, 10.5, 9.5, $BFA38F)
      Trait(5.5, 11.5, 9, 11.5, $BFA38F)
    Case #IcoAttention
      MovePathCursor(8, 1.5) : AddPathLine(15, 14) : AddPathLine(1, 14) : ClosePath()
      RemplirTracer($4EC1F2, $0B86B8)
      Trait(8, 6, 8, 10, $00435A, 1.6, #True)
      AddPathCircle(8, 12, 0.9) : VectorSourceColor(CV($00435A)) : FillPath()
    Case #IcoErreur
      AddPathCircle(8, 8, 6.5)
      RemplirTracer($4145D6, $262AA1)
      Trait(5.5, 5.5, 10.5, 10.5, $FFFFFF, 1.6, #True)
      Trait(10.5, 5.5, 5.5, 10.5, $FFFFFF, 1.6, #True)
    Case #IcoFleche
      ; petit triangle ▾ de 7 x 4 (listes déroulantes), centré
      MovePathCursor(4.5, 6) : AddPathLine(11.5, 6) : AddPathLine(8, 10) : ClosePath()
      VectorSourceColor(CV(#C_TextePrincipal)) : FillPath()
    Case #IcoTriangleBas
      MovePathCursor(4, 6) : AddPathLine(12, 6) : AddPathLine(8, 11) : ClosePath()
      VectorSourceColor(CV(#C_TextePrincipal)) : FillPath()
    Case #IcoTriangleDroite
      MovePathCursor(6, 4) : AddPathLine(11, 8) : AddPathLine(6, 12) : ClosePath()
      VectorSourceColor(CV(#C_TextePrincipal)) : FillPath()
    Case #IcoTriangleDroiteGris
      MovePathCursor(6.5, 5) : AddPathLine(10.5, 8) : AddPathLine(6.5, 11) : ClosePath()
      VectorSourceColor(CV(#C_TexteGris)) : FillPath()
    Case #IcoFenMin
      Trait(3.5, 8.5, 12.5, 8.5, $FFFFFF)
    Case #IcoFenMax
      AddPathBox(4.5, 4.5, 7, 7)
      VectorSourceColor(CV($FFFFFF)) : StrokePath(1)
    Case #IcoFenRestaurer
      AddPathBox(4.5, 6.5, 6, 6)
      VectorSourceColor(CV($FFFFFF)) : StrokePath(1)
      MovePathCursor(6.5, 6.5) : AddPathLine(6.5, 4.5) : AddPathLine(12.5, 4.5) : AddPathLine(12.5, 10.5) : AddPathLine(10.5, 10.5)
      VectorSourceColor(CV($FFFFFF)) : StrokePath(1)
    Case #IcoFenFermer
      Trait(4.5, 4.5, 11.5, 11.5, $FFFFFF, 1.2)
      Trait(11.5, 4.5, 4.5, 11.5, $FFFFFF, 1.2)
    Case #IcoDossier, #IcoDossierRecreer
      ; dossier fermé (couleurs de l'icône « Ouvrir »)
      MovePathCursor(1.5, 13.5) : AddPathLine(1.5, 3.5) : AddPathLine(5.5, 3.5) : AddPathLine(7, 5) : AddPathLine(14.5, 5) : AddPathLine(14.5, 13.5) : ClosePath()
      RemplirTracer($49B9E9, $227AA5)
      MovePathCursor(1.5, 13.5) : AddPathLine(1.5, 7) : AddPathLine(14.5, 7) : AddPathLine(14.5, 13.5) : ClosePath()
      RemplirTracer($7AD3F7, $227AA5)
      If Numero = #IcoDossierRecreer
        ; petite flèche verte qui entre dans le dossier
        MovePathCursor(11, 7.5) : AddPathLine(15, 11.25) : AddPathLine(11, 15) : AddPathLine(11, 12.75) : AddPathLine(7, 12.75) : AddPathLine(7, 9.75) : AddPathLine(11, 9.75) : ClosePath()
        RemplirTracer($4DA33F, $3A7726)
      EndIf
  EndSelect
EndProcedure

Procedure CreerIconeImage(Numero, Taille)
  Protected Image

  Image = CreateImage(#PB_Any, Taille, Taille, 32, #PB_Image_Transparent)
  If Image
    If StartVectorDrawing(ImageVectorOutput(Image))
      ScaleCoordinates(Taille / 16.0, Taille / 16.0)
      DessinerIcone(Numero)
      StopVectorDrawing()
    EndIf
  EndIf
  ProcedureReturn Image
EndProcedure

Procedure CreerIcones()
  Protected i
  For i = 0 To #NbIcones - 1
    If IsImage(Icone16(i))
      FreeImage(Icone16(i))
    EndIf
    If IsImage(Icone32(i))
      FreeImage(Icone32(i))
    EndIf
    Icone16(i) = CreerIconeImage(i, Pix(16))
    Icone32(i) = CreerIconeImage(i, Pix(32))
  Next
EndProcedure

; ----------------------------------------------------------------------------
;  Ombres portées des menus et des dialogues, comme « box-shadow » en CSS:
;  une fenêtre transparente (« layered ») placée juste derrière, dont chaque
;  pixel a sa propre opacité. L'ombre d'un rectangle flou se calcule
;  exactement: produit de deux profils (horizontal et vertical) faits avec la
;  fonction d'erreur erf.
; ----------------------------------------------------------------------------
Prototype.i ProtoUpdateLayeredWindow(hWnd, hdcDst, *pptDst, *psize, hdcSrc, *pptSrc, crKey, *pblend, dwFlags)
Prototype.i ProtoSetLayeredWindowAttributes(hWnd, crKey, bAlpha, dwFlags)
Global UpdateLayeredWindow.ProtoUpdateLayeredWindow
Global SetLayeredWindowAttributes.ProtoSetLayeredWindowAttributes
Global BibliothequeUser32

Structure TailleXY
  cx.l
  cy.l
EndStructure

Procedure ChargerFonctionsWindows()
  BibliothequeUser32 = OpenLibrary(#PB_Any, "user32.dll")
  If BibliothequeUser32
    UpdateLayeredWindow = GetFunction(BibliothequeUser32, "UpdateLayeredWindow")
    SetLayeredWindowAttributes = GetFunction(BibliothequeUser32, "SetLayeredWindowAttributes")
  EndIf
EndProcedure

; Fonction d'erreur (Abramowitz et Stegun 7.1.26, précision 1,5e-7)
Procedure.d Erf(x.d)
  Protected t.d, y.d, Signe.d = 1.0
  If x < 0
    Signe = -1.0
    x = -x
  EndIf
  t = 1.0 / (1.0 + 0.3275911 * x)
  y = 1.0 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * Exp(-x * x)
  ProcedureReturn Signe * y
EndProcedure

; Profil d'une ombre floue sur une ligne: Debut et Fin du rectangle, Sigma flou
Procedure ProfilOmbre(Array P.d(1), Taille, Debut.d, Fin.d, Sigma.d)
  Protected i, x.d, k.d = 1.0 / (Sigma * Sqr(2.0))
  For i = 0 To Taille - 1
    x = i + 0.5
    P(i) = 0.5 * (Erf((x - Debut) * k) - Erf((x - Fin) * k))
  Next
EndProcedure

; Crée la fenêtre de l'ombre (une fois, au démarrage)
Procedure CreerFenetreOmbre(Fenetre)
  If OpenWindow(Fenetre, 0, 0, 10, 10, "", #PB_Window_BorderLess | #PB_Window_Invisible, WindowID(#FenetrePrincipale))
    SetWindowLongPtr_(WindowID(Fenetre), #W_GWL_EXSTYLE, GetWindowLongPtr_(WindowID(Fenetre), #W_GWL_EXSTYLE) | #W_WS_EX_LAYERED | #W_WS_EX_TRANSPARENT | #W_WS_EX_NOACTIVATE | #W_WS_EX_TOOLWINDOW)
  EndIf
EndProcedure

; Montre l'ombre de la fenêtre Cible (Genre 0: menu, 1: dialogue)
Procedure MontrerOmbre(Fenetre, Cible, Genre)
  Protected r.RECT, L, H, Marge, LO, HO, i, j, Image, a.d, b.d, Opacite
  Protected Sigma1.d, Sigma2.d, dx1.d, dy1.d, dy2.d, Op1.d, Op2.d
  Protected hdcEcran, hdcMemoire, Ancien, Fusion.l
  Protected Pos.POINT, PointSource.POINT, Taille.TailleXY

  If IsWindow(Fenetre) = 0 Or IsWindow(Cible) = 0 Or UpdateLayeredWindow = 0
    ProcedureReturn
  EndIf
  GetWindowRect_(WindowID(Cible), @r)
  L = r\right - r\left
  H = r\bottom - r\top
  If Genre = 0
    ; menus: box-shadow 2px 4px 12px rgba(0,0,0,0.25)
    Marge = Pix(18)
    dx1 = Pix(2) : dy1 = Pix(4) : Sigma1 = Pix(12) / 2.0 : Op1 = 0.25
  Else
    ; dialogues: 0 4px 16px rgba(0,0,0,0.3), 0 1px 4px rgba(0,0,0,0.15)
    Marge = Pix(22)
    dx1 = 0 : dy1 = Pix(4) : Sigma1 = Pix(16) / 2.0 : Op1 = 0.30
    dy2 = Pix(1) : Sigma2 = Pix(4) / 2.0 : Op2 = 0.15
  EndIf
  LO = L + (2 * Marge)
  HO = H + (2 * Marge)
  Dim PX1.d(LO) : Dim PY1.d(HO)
  ProfilOmbre(PX1(), LO, Marge + dx1, Marge + dx1 + L, Sigma1)
  ProfilOmbre(PY1(), HO, Marge + dy1, Marge + dy1 + H, Sigma1)
  If Genre = 1
    Dim PX2.d(LO) : Dim PY2.d(HO)
    ProfilOmbre(PX2(), LO, Marge, Marge + L, Sigma2)
    ProfilOmbre(PY2(), HO, Marge + dy2, Marge + dy2 + H, Sigma2)
  EndIf

  Image = CreateImage(#PB_Any, LO, HO, 32, #PB_Image_Transparent)
  If Image = 0
    ProcedureReturn
  EndIf
  If StartDrawing(ImageOutput(Image))
    DrawingMode(#PB_2DDrawing_AllChannels)
    ; UpdateLayeredWindow attend des couleurs « prémultipliées » par
    ; l'opacité: un pixel transparent doit être NOIR transparent. Une image
    ; transparente neuve est en blanc transparent, que Windows ajoute au fond
    ; (zone blanche autour des menus et des dialogues): on la vide d'abord.
    Box(0, 0, LO, HO, RGBA(0, 0, 0, 0))
    For j = 0 To HO - 1
      For i = 0 To LO - 1
        a = Op1 * PX1(i) * PY1(j)
        If Genre = 1
          b = Op2 * PX2(i) * PY2(j)
          a = 1.0 - ((1.0 - a) * (1.0 - b))
        EndIf
        Opacite = Round(a * 255, #PB_Round_Nearest)
        If Opacite > 0
          Plot(i, j, RGBA(0, 0, 0, Opacite))
        EndIf
      Next
    Next
    StopDrawing()
  EndIf

  hdcEcran = GetDC_(0)
  hdcMemoire = CreateCompatibleDC_(hdcEcran)
  Ancien = SelectObject_(hdcMemoire, ImageID(Image))
  Pos\x = r\left - Marge
  Pos\y = r\top - Marge
  Taille\cx = LO
  Taille\cy = HO
  Fusion = $01FF0000             ; AC_SRC_OVER, opacité 255, AC_SRC_ALPHA
  UpdateLayeredWindow(WindowID(Fenetre), hdcEcran, @Pos, @Taille, hdcMemoire, @PointSource, 0, @Fusion, #W_ULW_ALPHA)
  SelectObject_(hdcMemoire, Ancien)
  DeleteDC_(hdcMemoire)
  ReleaseDC_(0, hdcEcran)
  FreeImage(Image)

  ; juste derrière la fenêtre Cible, sans l'activer
  SetWindowPos_(WindowID(Fenetre), WindowID(Cible), 0, 0, 0, 0, #W_SWP_NOMOVE | #W_SWP_NOSIZE | #W_SWP_NOACTIVATE)
  ShowWindow_(WindowID(Fenetre), #W_SW_SHOWNOACTIVATE)
EndProcedure

Procedure CacherOmbre(Fenetre)
  If IsWindow(Fenetre)
    ShowWindow_(WindowID(Fenetre), 0)
  EndIf
EndProcedure

; ============================================================================
;  INTERFACE (v7.1) - 2. Composants de la fenêtre
;  Barre de titre, barre de menus, barre d'outils, onglets, barre d'état,
;  séparateurs, barres de défilement, éditeurs Scintilla, sortie.
; ============================================================================

; Mélange de deux couleurs (Proportion de C2, de 0 à 1): sert à griser
Procedure Melange(C1, C2, Proportion.d)
  ProcedureReturn RGB(Red(C1) + (Red(C2) - Red(C1)) * Proportion, Green(C1) + (Green(C2) - Green(C1)) * Proportion, Blue(C1) + (Blue(C2) - Blue(C1)) * Proportion)
EndProcedure

; Raccourci clavier écrit à la façon de la langue (Strg en allemand...)
Procedure.s TexteRaccourci(Touches$)
  Touches$ = ReplaceString(Touches$, "Ctrl", Tr("toucheCtrl"))
  Touches$ = ReplaceString(Touches$, "Shift", Tr("toucheShift"))
  Touches$ = ReplaceString(Touches$, "Esc", Tr("toucheEchap"))
  ProcedureReturn Touches$
EndProcedure

; ----------------------------------------------------------------------------
;  Barre de titre (la fenêtre n'a pas celle de Windows, voir RappelFenetre)
; ----------------------------------------------------------------------------
Global TitreSurvol                 ; bouton survolé: 1 réduire, 2 agrandir, 3 fermer
Global TitreAppui                  ; bouton enfoncé
Global TitreFenetre$               ; texte affiché

Procedure BoutonTitreX(Numero, Largeur)
  ; de droite à gauche: fermer (3), agrandir (2), réduire (1)
  ProcedureReturn Largeur - Pix(10) - Pix(28) - ((3 - Numero) * (Pix(28) + Pix(2)))
EndProcedure

Procedure BoutonTitreSous(X, Y, Largeur, Hauteur)
  Protected i, BY = (Hauteur - Bord() - Pix(18)) / 2
  For i = 1 To 3
    If DansRect(X, Y, BoutonTitreX(i, Largeur), BY, Pix(28), Pix(18))
      ProcedureReturn i
    EndIf
  Next
  ProcedureReturn 0
EndProcedure

Procedure DessinerTitre()
  Protected L, H, B, X, Y, i, BX, BY, Icone, Max

  If StartDrawing(CanvasOutput(#CanvasTitre))
    L = OutputWidth()
    H = OutputHeight()
    B = Bord()
    Degrade(0, 0, L, H, #C_TitreHaut, #C_TitreBas)
    Rectangle(0, H - B, L, B, #C_TitreBordure)

    ; Icône: carré blanc à 20 %, « PB »
    X = Pix(10)
    Y = (H - B - Pix(16)) / 2
    DrawingMode(#PB_2DDrawing_AlphaBlend)
    RoundBox(X, Y, Pix(16), Pix(16), Pix(2), Pix(2), RGBA(255, 255, 255, 51))
    DrawingFont(PoliceIcone)
    DessinerTexte(X + (Pix(16) - TextWidth("PB")) / 2, Y + (Pix(16) - TextHeight("PB")) / 2, "PB", #C_Blanc)

    ; Texte, avec son ombre (text-shadow: 0 1px 2px rgba(0,0,0,0.3))
    DrawingFont(PoliceBase)
    X = Pix(36)
    Y = (H - B - TextHeight("Ag")) / 2
    Max = BoutonTitreX(1, L) - Pix(10) - X
    DrawingMode(#PB_2DDrawing_AlphaBlend | #PB_2DDrawing_Transparent)
    DrawText(X, Y + Pix(1), Tronquer(TitreFenetre$, Max), RGBA(0, 0, 0, 60))
    DessinerTexte(X, Y, Tronquer(TitreFenetre$, Max), #C_Blanc)

    ; Boutons ─ □ ✕
    BY = (H - B - Pix(18)) / 2
    For i = 1 To 3
      BX = BoutonTitreX(i, L)
      If TitreSurvol = i Or TitreAppui = i
        RectangleAlpha(BX, BY, Pix(28), Pix(18), #C_Blanc, 51)
        CadreAlpha(BX, BY, Pix(28), Pix(18), #C_Blanc, 77)
      Else
        RectangleAlpha(BX, BY, Pix(28), Pix(18), #C_Blanc, 20)
        CadreAlpha(BX, BY, Pix(28), Pix(18), #C_Blanc, 38)
      EndIf
      Select i
        Case 1
          Icone = #IcoFenMin
        Case 2
          If GetWindowState(#FenetrePrincipale) = #PB_Window_Maximize
            Icone = #IcoFenRestaurer
          Else
            Icone = #IcoFenMax
          EndIf
        Default
          Icone = #IcoFenFermer
      EndSelect
      DessinerIco(Icone, BX + (Pix(28) - Pix(16)) / 2, BY + (Pix(18) - Pix(16)) / 2)
    Next
    StopDrawing()
  EndIf
EndProcedure

Procedure ChangerTitre(Texte$)
  TitreFenetre$ = Texte$
  SetWindowTitle(#FenetrePrincipale, Texte$)
  DessinerTitre()
EndProcedure

Procedure BasculerAgrandi()
  If GetWindowState(#FenetrePrincipale) = #PB_Window_Maximize
    SetWindowState(#FenetrePrincipale, #PB_Window_Normal)
  Else
    SetWindowState(#FenetrePrincipale, #PB_Window_Maximize)
  EndIf
EndProcedure

; Zone de redimensionnement du haut (la barre de titre couvre le bord)
Procedure BordHaut(X, Y, Largeur)
  If GetWindowState(#FenetrePrincipale) = #PB_Window_Maximize
    ProcedureReturn 0
  EndIf
  If Y < Pix(4)
    If X < Pix(8)
      ProcedureReturn #W_HTTOPLEFT
    ElseIf X >= Largeur - Pix(8)
      ProcedureReturn #W_HTTOPRIGHT
    EndIf
    ProcedureReturn #W_HTTOP
  EndIf
  ProcedureReturn 0
EndProcedure

; Appelée directement par PureBasic (BindGadgetEvent): marche aussi pendant
; un long calcul, comme une vraie barre de titre
Procedure EvenementTitre()
  Protected p.POINT, L, H, Bouton, Zone, Menu, Cmd

  SourisDans(#CanvasTitre, @p)
  L = LargeurPixels(#CanvasTitre)
  H = HauteurPixels(#CanvasTitre)
  Bouton = BoutonTitreSous(p\x, p\y, L, H)
  Select EventType()
    Case #PB_EventType_MouseMove
      Zone = BordHaut(p\x, p\y, L)
      Select Zone
        Case #W_HTTOPLEFT
          SetGadgetAttribute(#CanvasTitre, #PB_Canvas_Cursor, #PB_Cursor_LeftUpRightDown)
        Case #W_HTTOPRIGHT
          SetGadgetAttribute(#CanvasTitre, #PB_Canvas_Cursor, #PB_Cursor_LeftDownRightUp)
        Case #W_HTTOP
          SetGadgetAttribute(#CanvasTitre, #PB_Canvas_Cursor, #PB_Cursor_UpDown)
        Default
          SetGadgetAttribute(#CanvasTitre, #PB_Canvas_Cursor, #PB_Cursor_Default)
      EndSelect
      If Bouton <> TitreSurvol
        TitreSurvol = Bouton
        DessinerTitre()
      EndIf
    Case #PB_EventType_MouseLeave
      TitreSurvol = 0
      TitreAppui = 0
      DessinerTitre()
    Case #PB_EventType_LeftButtonDown
      FermerPopups()
      If Bouton
        TitreAppui = Bouton
        DessinerTitre()
      Else
        Zone = BordHaut(p\x, p\y, L)
        ReleaseCapture_()
        If Zone
          SendMessage_(WindowID(#FenetrePrincipale), #W_WM_NCLBUTTONDOWN, Zone, 0)
        Else
          SendMessage_(WindowID(#FenetrePrincipale), #W_WM_NCLBUTTONDOWN, #W_HTCAPTION, 0)
        EndIf
      EndIf
    Case #PB_EventType_LeftButtonUp
      If TitreAppui And TitreAppui = Bouton
        Select Bouton
          Case 1
            SetWindowState(#FenetrePrincipale, #PB_Window_Minimize)
          Case 2
            BasculerAgrandi()
          Case 3
            PostEvent(#PB_Event_CloseWindow, #FenetrePrincipale, 0)
        EndSelect
      EndIf
      TitreAppui = 0
      DessinerTitre()
    Case #PB_EventType_LeftDoubleClick
      If Bouton = 0 And BordHaut(p\x, p\y, L) = 0
        BasculerAgrandi()
      EndIf
    Case #PB_EventType_RightButtonUp
      If Bouton = 0
        ; menu système de Windows (Restaurer, Déplacer, Fermer...)
        GetCursorPos_(@p)
        Menu = GetSystemMenu_(WindowID(#FenetrePrincipale), 0)
        Cmd = TrackPopupMenu_(Menu, #W_TPM_RETURNCMD, p\x, p\y, 0, WindowID(#FenetrePrincipale), 0)
        If Cmd
          SendMessage_(WindowID(#FenetrePrincipale), #W_WM_SYSCOMMAND, Cmd, 0)
        EndIf
      EndIf
  EndSelect
EndProcedure

; ----------------------------------------------------------------------------
;  Barre de menus
; ----------------------------------------------------------------------------
#NbMenus = 5
Global Dim MenuX(#NbMenus - 1)
Global Dim MenuL(#NbMenus - 1)
Global MenuSurvol = -1             ; menu survolé
Global MenuOuvert = -1             ; menu dont la liste est ouverte

Procedure.s TitreMenu(i)
  Select i
    Case 0
      ProcedureReturn Tr("menuFichier")
    Case 1
      ProcedureReturn Tr("menuEdition")
    Case 2
      ProcedureReturn Tr("menuCompression")
    Case 3
      ProcedureReturn Tr("menuOutils")
  EndSelect
  ProcedureReturn Tr("menuAide")
EndProcedure

Procedure DessinerMenus()
  Protected L, H, B, X, i, LT

  If StartDrawing(CanvasOutput(#CanvasMenus))
    L = OutputWidth()
    H = OutputHeight()
    B = Bord()
    Degrade(0, 0, L, H, #C_MenuHaut, #C_MenuBas)
    Rectangle(0, H - B, L, B, #C_MenuBordure)
    DrawingFont(PoliceBase)
    X = Pix(4)
    For i = 0 To #NbMenus - 1
      LT = TextWidth(TitreMenu(i))
      MenuX(i) = X
      MenuL(i) = Pix(11) + LT + Pix(11)
      If i = MenuSurvol Or i = MenuOuvert
        Degrade(X, 0, MenuL(i), Pix(24), #C_SurvolHaut, #C_SurvolBas)
        Cadre(X, 0, MenuL(i), Pix(24), #C_SurvolBordure)
      EndIf
      DessinerTexte(X + Pix(11), (Pix(24) - TextHeight("Ag")) / 2, TitreMenu(i), #C_MenuTexte)
      X = X + MenuL(i)
    Next
    StopDrawing()
  EndIf
EndProcedure

Procedure MenuSous(X, Y)
  Protected i
  If Y >= 0 And Y < Pix(24)
    For i = 0 To #NbMenus - 1
      If X >= MenuX(i) And X < MenuX(i) + MenuL(i)
        ProcedureReturn i
      EndIf
    Next
  EndIf
  ProcedureReturn -1
EndProcedure

; ----------------------------------------------------------------------------
;  Barre d'outils
; ----------------------------------------------------------------------------
#NbOutils = 14
Enumeration GenresOutil
  #OutilBouton
  #OutilSeparateur
  #OutilLarge
  #OutilEtiquette
  #OutilListe
EndEnumeration
Global Dim OutilGenre(#NbOutils - 1)
Global Dim OutilIcone(#NbOutils - 1)
Global Dim OutilCmd(#NbOutils - 1)
Global Dim OutilTexte$(#NbOutils - 1)      ; clé du texte affiché
Global Dim OutilBulle$(#NbOutils - 1)      ; clé de l'infobulle
Global Dim OutilTouches$(#NbOutils - 1)
Global Dim OutilX(#NbOutils - 1)
Global Dim OutilY(#NbOutils - 1)
Global Dim OutilL(#NbOutils - 1)
Global Dim OutilH(#NbOutils - 1)
Global OutilSurvol = -1
Global OutilAppui = -1

Procedure DefinirOutil(i, Genre, Icone, Cmd, Texte$, Bulle$, Touches$)
  OutilGenre(i) = Genre
  OutilIcone(i) = Icone
  OutilCmd(i) = Cmd
  OutilTexte$(i) = Texte$
  OutilBulle$(i) = Bulle$
  OutilTouches$(i) = Touches$
EndProcedure

Procedure InitialiserOutils()
  DefinirOutil(0, #OutilBouton, #IcoOuvrir, #CmdOuvrir, "", "bulleOuvrir", "Ctrl+O")
  DefinirOutil(1, #OutilBouton, #IcoDossier, #CmdOuvrirDossier, "", "bulleOuvrirDossier", "Ctrl+Shift+O")
  DefinirOutil(2, #OutilBouton, #IcoEnregistrer, #CmdEnregistrer, "", "bulleEnregistrer", "Ctrl+S")
  DefinirOutil(3, #OutilSeparateur, -1, 0, "", "", "")
  DefinirOutil(4, #OutilBouton, #IcoCopier, #CmdCopierOnglet, "", "bulleCopierOnglet", "Ctrl+Shift+C")
  DefinirOutil(5, #OutilBouton, #IcoColler, #CmdColler, "", "bulleColler", "Ctrl+V")
  DefinirOutil(6, #OutilSeparateur, -1, 0, "", "", "")
  DefinirOutil(7, #OutilLarge, #IcoCompresser, #CmdCompresser, "outilCompresser", "bulleCompresser", "F5")
  DefinirOutil(8, #OutilSeparateur, -1, 0, "", "", "")
  DefinirOutil(9, #OutilLarge, #IcoDecompresser, #CmdDecompresser, "outilDecompresser", "bulleDecompresser", "F6")
  DefinirOutil(10, #OutilLarge, #IcoArreter, #CmdArreter, "outilArreter", "bulleArreter", "Esc")
  DefinirOutil(11, #OutilSeparateur, -1, 0, "", "", "")
  DefinirOutil(12, #OutilEtiquette, -1, 0, "outilNiveau", "", "")
  DefinirOutil(13, #OutilListe, -1, 0, "", "bulleNiveau", "")
EndProcedure

Declare.s NomNiveauListe(Niveau)
Declare NiveauActif()

; Rien à enregistrer: onglet vide, ou projet chargé (ce n'est pas un code ;
; un projet décompressé, lui, s'enregistre en le recréant)
Procedure EnregistrementImpossible()
  ProcedureReturn Bool(OngletEstVide(OngletActif) Or (OngletActif = 0 And ProjetCharge))
EndProcedure

Procedure OutilInactif(i)
  If OutilCmd(i) = #CmdArreter
    ; Stop: seulement pendant une opération (et une seule fois)
    ProcedureReturn Bool(Occupe = #False Or ArretDemande)
  EndIf
  If Occupe
    ProcedureReturn #True
  EndIf
  If OutilGenre(i) = #OutilListe
    ProcedureReturn Bool(NiveauActif() = #False)
  EndIf
  Select OutilCmd(i)
    Case #CmdCompresser
      ProcedureReturn Bool(CodeOriginal$ = "")         ; rien à compresser
    Case #CmdCopierOnglet
      ProcedureReturn OngletEstVide(OngletActif)       ; rien à copier
    Case #CmdEnregistrer
      ProcedureReturn EnregistrementImpossible()
  EndSelect
  ProcedureReturn #False
EndProcedure

Procedure DessinerOutils()
  Protected L, H, B, X, Y, i, Inactif, Opacite, CouleurTexte, Texte$, AX

  If StartDrawing(CanvasOutput(#CanvasOutils))
    L = OutputWidth()
    H = OutputHeight()
    B = Bord()
    Degrade(0, 0, L, H, #C_OutilsHaut, #C_OutilsBas)
    Rectangle(0, H - B, L, B, #C_OutilsBordure)
    X = Pix(6)
    For i = 0 To #NbOutils - 1
      Inactif = OutilInactif(i)
      If Inactif
        Opacite = 102
      Else
        Opacite = 255
      EndIf
      Select OutilGenre(i)
        Case #OutilBouton, #OutilLarge
          OutilH(i) = Pix(22)
          OutilY(i) = Pix(2) + (Pix(23) - Pix(22)) / 2
          If OutilGenre(i) = #OutilBouton
            OutilL(i) = Pix(24)
          Else
            DrawingFont(PoliceBase)
            OutilL(i) = Pix(5) + Pix(16) + Pix(4) + TextWidth(Tr(OutilTexte$(i))) + Pix(7)
          EndIf
          OutilX(i) = X
          If Inactif = #False And OutilAppui = i And OutilSurvol = i
            Degrade(X, OutilY(i), OutilL(i), OutilH(i), #C_ActifHaut, #C_ActifBas)
            Cadre(X, OutilY(i), OutilL(i), OutilH(i), #C_ActifBordure)
          ElseIf Inactif = #False And OutilSurvol = i
            Degrade(X, OutilY(i), OutilL(i), OutilH(i), #C_SurvolHaut, #C_SurvolBas)
            Cadre(X, OutilY(i), OutilL(i), OutilH(i), #C_SurvolBordure)
          EndIf
          If OutilGenre(i) = #OutilBouton
            DessinerIco(OutilIcone(i), X + (Pix(24) - Pix(16)) / 2, OutilY(i) + (Pix(22) - Pix(16)) / 2, Opacite)
          Else
            DessinerIco(OutilIcone(i), X + Pix(5), OutilY(i) + (Pix(22) - Pix(16)) / 2, Opacite)
            DrawingFont(PoliceBase)
            CouleurTexte = #C_MenuTexte
            If Inactif
              CouleurTexte = Melange(#C_OutilsBas, #C_MenuTexte, 0.4)
            EndIf
            DessinerTexte(X + Pix(25), OutilY(i) + (Pix(22) - TextHeight("Ag")) / 2, Tr(OutilTexte$(i)), CouleurTexte)
          EndIf
        Case #OutilSeparateur
          OutilX(i) = X
          OutilL(i) = Pix(7)
          Rectangle(X + Pix(3), Pix(2) + (Pix(23) - Pix(18)) / 2, Bord(), Pix(18), #C_OutilsSeparateur)
        Case #OutilEtiquette
          DrawingFont(PolicePetite)
          OutilX(i) = X
          OutilL(i) = Pix(4) + TextWidth(Tr(OutilTexte$(i))) + Pix(4)
          DessinerTexte(X + Pix(4), (H - B - TextHeight("Ag")) / 2, Tr(OutilTexte$(i)), #C_TexteSecondaire)
        Case #OutilListe
          DrawingFont(PolicePetite)
          Texte$ = NomNiveauListe(Reglage\Niveau)
          OutilH(i) = Pix(20)
          OutilY(i) = Pix(2) + (Pix(23) - Pix(20)) / 2
          OutilX(i) = X
          OutilL(i) = Maxi(Pix(150), Pix(6) + TextWidth(Texte$) + Pix(6) + Pix(15) + Pix(1))
          Y = OutilY(i)
          Rectangle(X, Y, OutilL(i), OutilH(i), #C_Contenu)
          AX = X + OutilL(i) - Pix(1) - Pix(15)
          If Inactif = #False And (OutilSurvol = i Or Pop(0)\Cible = -2)
            Degrade(AX, Y + B, Pix(15), OutilH(i) - (2 * B), #C_SurvolHaut, #C_SurvolBas)
            Rectangle(AX, Y, B, OutilH(i), #C_SurvolBordure)
            Cadre(X, Y, OutilL(i), OutilH(i), #C_SurvolBordure)
          Else
            Cadre(X, Y, OutilL(i), OutilH(i), #C_MenuBordure)
          EndIf
          CouleurTexte = #C_TextePrincipal
          If Inactif
            CouleurTexte = Melange(#C_Contenu, #C_TextePrincipal, 0.4)
          EndIf
          DessinerTexte(X + Pix(6), Y + (OutilH(i) - TextHeight("Ag")) / 2, Texte$, CouleurTexte)
          DessinerIco(#IcoFleche, AX + (Pix(15) - Pix(16)) / 2, Y + (OutilH(i) - Pix(16)) / 2, Opacite)
      EndSelect
      X = X + OutilL(i) + Pix(1)
    Next
    StopDrawing()
  EndIf
EndProcedure

Procedure OutilSous(X, Y)
  Protected i
  For i = 0 To #NbOutils - 1
    Select OutilGenre(i)
      Case #OutilBouton, #OutilLarge, #OutilListe
        If DansRect(X, Y, OutilX(i), OutilY(i), OutilL(i), OutilH(i))
          ProcedureReturn i
        EndIf
    EndSelect
  Next
  ProcedureReturn -1
EndProcedure

Procedure BulleOutil(i)
  Protected Bulle$
  If i >= 0
    If OutilBulle$(i) <> ""
      Bulle$ = Tr(OutilBulle$(i))
      If OutilCmd(i) = #CmdEnregistrer And OngletActif = 2 And *PaquetLu
        Bulle$ = Tr("bulleRecreerProjet")       ; un projet décompressé
      EndIf
      If OutilTouches$(i) <> ""
        Bulle$ = Bulle$ + " (" + TexteRaccourci(OutilTouches$(i)) + ")"
      EndIf
    EndIf
  EndIf
  GadgetToolTip(#CanvasOutils, Bulle$)
EndProcedure

; ----------------------------------------------------------------------------
;  Barres d'onglets des panneaux
; ----------------------------------------------------------------------------
Global Dim OngletDocX(2)
Global Dim OngletDocL(2)
Global OngletSurvol = -1

; Dessine une barre d'onglets. Titres$: titres séparés par Chr(10). Renvoie
; les positions dans les tableaux PosX() et PosL() s'ils sont donnés.
Procedure DessinerBarreOnglets(Gadget, Titres$, Actif, Survol, Array PosX(1), Array PosL(1))
  Protected L, H, B, X, i, Nb, Titre$, LT, Haut, HO

  If StartDrawing(CanvasOutput(Gadget))
    L = OutputWidth()
    H = OutputHeight()
    B = Bord()
    Degrade(0, 0, L, H, #C_EnteteHaut, #C_EnteteBas)
    Rectangle(0, H - B, L, B, #C_EnteteBordure)
    HO = Pix(21.63)
    Haut = H - HO
    X = Pix(4)
    Nb = CountString(Titres$, Chr(10)) + 1
    For i = 0 To Nb - 1
      Titre$ = StringField(Titres$, i + 1, Chr(10))
      If i = Actif
        DrawingFont(PolicePetiteGras)
      Else
        DrawingFont(PolicePetite)
      EndIf
      LT = B + Pix(12) + TextWidth(Titre$) + Pix(12) + B
      If i <= ArraySize(PosX())
        PosX(i) = X
        PosL(i) = LT
      EndIf
      If i = Actif
        Rectangle(X, Haut, LT, HO, #C_Contenu)
        Rectangle(X, Haut, B, HO, #C_PanneauBordure)
        Rectangle(X + LT - B, Haut, B, HO, #C_PanneauBordure)
        Rectangle(X, Haut, LT, Pix(2), #C_OngletActifDessus)
        DessinerTexte(X + B + Pix(12), Haut + Pix(2) + Pix(2), Titre$, #C_OngletActifTexte)
      Else
        If i = Survol
          Degrade(X, Haut, LT, HO, #C_SurvolHaut, #C_SurvolBas)
        Else
          Degrade(X, Haut, LT, HO, #C_OngletInactifHaut, #C_OngletInactifBas)
        EndIf
        Rectangle(X, Haut, LT, B, #C_PanneauBordure)
        Rectangle(X, Haut, B, HO, #C_PanneauBordure)
        Rectangle(X + LT - B, Haut, B, HO, #C_PanneauBordure)
        DessinerTexte(X + B + Pix(12), Haut + B + Pix(3), Titre$, #C_OngletInactifTexte)
      EndIf
      ; coins arrondis de 2 pixels (border-radius: 2px 2px 0 0)
      Rectangle(X, Haut, B, B, #C_EnteteHaut)
      Rectangle(X + LT - B, Haut, B, B, #C_EnteteHaut)
      X = X + LT + Pix(1)
    Next
    StopDrawing()
  EndIf
EndProcedure

Procedure DessinerOngletsDoc()
  Protected Titres$ = Tr("ongletOrigine") + Chr(10) + Tr("ongletResultat") + Chr(10) + Tr("ongletDecompresse")
  DessinerBarreOnglets(#CanvasOngletsDoc, Titres$, OngletActif, OngletSurvol, OngletDocX(), OngletDocL())
EndProcedure

Global Dim PasDePosition(0)

Procedure DessinerOngletsFixes()
  DessinerBarreOnglets(#CanvasOngletsProp, Tr("panneauProprietes"), 0, -1, PasDePosition(), PasDePosition())
  DessinerBarreOnglets(#CanvasOngletsSortie, Tr("panneauSortie"), 0, -1, PasDePosition(), PasDePosition())
EndProcedure

Procedure OngletDocSous(X, Y)
  Protected i
  For i = 0 To 2
    If X >= OngletDocX(i) And X < OngletDocX(i) + OngletDocL(i) And Y >= HauteurPixels(#CanvasOngletsDoc) - Pix(21.63)
      ProcedureReturn i
    EndIf
  Next
  ProcedureReturn -1
EndProcedure

; ----------------------------------------------------------------------------
;  Barre d'état
; ----------------------------------------------------------------------------
Global EtatPourcent                ; progression pendant une opération
Global EtatTexte$
Global CaretLigne = 1, CaretColonne = 1

Declare.s TexteEtat(Numero)

Procedure DessinerEtat()
  Protected L, H, B, X, Y, i, Element$, LT, XD, NbDroite
  Protected Dim Droite$(2)

  If StartDrawing(CanvasOutput(#CanvasEtat))
    L = OutputWidth()
    H = OutputHeight()
    B = Bord()
    Degrade(0, 0, L, H, #C_EtatHaut, #C_EtatBas)
    Rectangle(0, 0, L, B, #C_EtatBordure)
    DrawingFont(PolicePetite)
    Y = B + (H - B - TextHeight("Ag")) / 2
    X = Pix(8)

    ; « Prêt » ou « Occupé » (fond blanc à 8 %, padding 2px 12px)
    If Occupe
      Element$ = Tr("etatOccupe")
    Else
      Element$ = Tr("etatPret")
    EndIf
    LT = Pix(12) + TextWidth(Element$) + Pix(12)
    RectangleAlpha(X, B + (H - B - (TextHeight("Ag") + Pix(4))) / 2, LT, TextHeight("Ag") + Pix(4), #C_Blanc, 20)
    DessinerTexte(X + Pix(12), Y, Element$, #C_Blanc)
    X = X + LT

    If Occupe
      ; barre de progression
      X = X + Pix(8)
      CadreAlpha(X, (H - Pix(12)) / 2, Pix(140), Pix(12), #C_Blanc, 140)
      RectangleAlpha(X + B, (H - Pix(12)) / 2 + B, Pix(140) - (2 * B), Pix(12) - (2 * B), #C_Noir, 36)
      If EtatPourcent > 0
        DrawingMode(#PB_2DDrawing_Gradient)
        BackColor(RGB(255, 255, 255))
        FrontColor(RGB(214, 228, 247))
        LinearGradient(0, (H - Pix(12)) / 2, 0, (H + Pix(12)) / 2)
        Box(X + B, (H - Pix(12)) / 2 + B, ((Pix(140) - (2 * B)) * Mini(EtatPourcent, 100)) / 100, Pix(12) - (2 * B))
        DrawingMode(#PB_2DDrawing_Default)
      EndIf
      X = X + Pix(140) + Pix(4)
      DessinerTexte(X + Pix(8), Y, Tronquer(EtatTexte$, L - X - Pix(320)), #C_Blanc)
    Else
      For i = 1 To 2
        Element$ = TexteEtat(i)
        If Element$ <> ""
          RectangleAlpha(X, B + (H - B - Pix(14)) / 2, B, Pix(14), #C_Blanc, 64)
          DessinerTexte(X + Pix(8), Y, Element$, #C_Blanc)
          X = X + Pix(8) + TextWidth(Element$) + Pix(8)
        EndIf
      Next
    EndIf

    ; À droite: limite du forum, niveau, ligne et colonne
    Droite$(0) = TexteEtat(3)
    Droite$(1) = TexteEtat(4)
    Droite$(2) = TexteEtat(5)
    XD = L - Pix(8)
    For i = 2 To 0 Step -1
      If Droite$(i) <> ""
        XD = XD - Pix(8) - TextWidth(Droite$(i)) - Pix(8)
        DessinerTexte(XD + Pix(8), Y, Droite$(i), #C_Blanc)
        If i > 0
          RectangleAlpha(XD - B, B + (H - B - Pix(14)) / 2, B, Pix(14), #C_Blanc, 64)
        EndIf
      EndIf
    Next
    StopDrawing()
  EndIf
EndProcedure

Procedure InterfaceOccupee(Etat)
  If Etat <> Occupe
    ArretDemande = #False             ; début ou fin d'une opération
    If IsWindow(#FenetrePrincipale)
      ; Échap = Stop, seulement pendant une opération (sinon, Échap ferme les menus)
      If Etat
        AddKeyboardShortcut(#FenetrePrincipale, #PB_Shortcut_Escape, #CmdArreter)
      Else
        RemoveKeyboardShortcut(#FenetrePrincipale, #PB_Shortcut_Escape)
      EndIf
    EndIf
  EndIf
  Occupe = Etat
  If Etat = #False
    EtatPourcent = 0
    EtatTexte$ = ""
  EndIf
  If IsGadget(#CanvasOutils)
    DessinerOutils()
    DessinerGrille()
    DessinerEtat()
  EndIf
EndProcedure

Procedure BarreEtatProgression(Pourcent, Texte$)
  EtatPourcent = Pourcent
  EtatTexte$ = Texte$
  If IsGadget(#CanvasEtat)
    DessinerEtat()
  EndIf
EndProcedure

Procedure BarreEtatTexte(Texte$)
  EtatTexte$ = Texte$
  If IsGadget(#CanvasEtat)
    DessinerEtat()
  EndIf
EndProcedure

Procedure BarreEtatPrete()
  EtatPourcent = 0
  EtatTexte$ = ""
  If IsGadget(#CanvasEtat)
    DessinerEtat()
  EndIf
EndProcedure

; ----------------------------------------------------------------------------
;  Séparateurs (élargir les propriétés, agrandir la sortie)
; ----------------------------------------------------------------------------
Global LargeurProprietes = 340     ; unités des gadgets (taille voulue, gardée dans les réglages)
Global HauteurSortie = 150
Global LargeurProprietesAffichee = 340   ; taille affichée (la fenêtre peut être trop petite)
Global HauteurSortieAffichee = 150

; Tailles possibles des panneaux pour la taille actuelle de la fenêtre
Procedure LimiterLargeurProprietes(Valeur)
  ProcedureReturn Maxi(240, Mini(Valeur, Mini(640, WindowWidth(#FenetrePrincipale) - 320)))
EndProcedure

Procedure LimiterHauteurSortie(Valeur)
  ProcedureReturn Maxi(80, Mini(Valeur, Mini(420, WindowHeight(#FenetrePrincipale) - 263)))
EndProcedure
Global SeparateurSurvol = -1       ; 0 droit, 1 bas
Global SeparateurGlisse = -1
Global SeparateurDebutSouris, SeparateurDebutTaille

Procedure DessinerSeparateur(Gadget, Survol)
  If StartDrawing(CanvasOutput(Gadget))
    If Survol
      Box(0, 0, OutputWidth(), OutputHeight(), #C_SeparateurSurvol)
    Else
      Box(0, 0, OutputWidth(), OutputHeight(), #C_Separateur)
    EndIf
    StopDrawing()
  EndIf
EndProcedure

Procedure EvenementSeparateur()
  Protected Gadget = EventGadget(), Numero, p.POINT, Nouveau

  If Gadget = #SeparateurDroit
    Numero = 0
  Else
    Numero = 1
  EndIf
  GetCursorPos_(@p)
  Select EventType()
    Case #PB_EventType_MouseEnter
      SeparateurSurvol = Numero
      DessinerSeparateur(Gadget, #True)
    Case #PB_EventType_MouseLeave
      SeparateurSurvol = -1
      If SeparateurGlisse <> Numero
        DessinerSeparateur(Gadget, #False)
      EndIf
    Case #PB_EventType_LeftButtonDown
      FermerPopups()
      SeparateurGlisse = Numero
      If Numero = 0
        SeparateurDebutSouris = p\x
        SeparateurDebutTaille = LargeurProprietesAffichee
      Else
        SeparateurDebutSouris = p\y
        SeparateurDebutTaille = HauteurSortieAffichee
      EndIf
      DessinerSeparateur(Gadget, #True)
    Case #PB_EventType_MouseMove
      If SeparateurGlisse = Numero And BoutonGaucheEnfonce() = #False
        SeparateurGlisse = -1               ; relâchement perdu (Alt+Tab...)
        DessinerSeparateur(Gadget, Bool(SeparateurSurvol = Numero))
      EndIf
      If SeparateurGlisse = Numero
        If Numero = 0
          Nouveau = LimiterLargeurProprietes(SeparateurDebutTaille - Round((p\x - SeparateurDebutSouris) / Ech, #PB_Round_Nearest))
          If Nouveau <> LargeurProprietes
            LargeurProprietes = Nouveau
            Disposer()
          EndIf
        Else
          Nouveau = LimiterHauteurSortie(SeparateurDebutTaille - Round((p\y - SeparateurDebutSouris) / Ech, #PB_Round_Nearest))
          If Nouveau <> HauteurSortie
            HauteurSortie = Nouveau
            Disposer()
          EndIf
        EndIf
      EndIf
    Case #PB_EventType_LeftButtonUp
      SeparateurGlisse = -1
      DessinerSeparateur(Gadget, Bool(SeparateurSurvol = Numero))
  EndSelect
EndProcedure

; ----------------------------------------------------------------------------
;  Éditeurs Scintilla: réglages, coloration PureBasic
; ----------------------------------------------------------------------------
Global NewMap MotCle()             ; mots-clés de PureBasic (en minuscules)

Procedure InitialiserMotsCles()
  Protected Liste$, i, Mot$
  Liste$ = "If Else ElseIf EndIf For ForEach To Step Next While Wend Repeat Until ForEver Procedure ProcedureC ProcedureDLL ProcedureCDLL ProcedureReturn EndProcedure "
  Liste$ = Liste$ + "Protected Global Define Shared Static Threaded Select Case Default EndSelect Structure EndStructure StructureUnion EndStructureUnion Enumeration EnumerationBinary EndEnumeration "
  Liste$ = Liste$ + "Macro EndMacro DataSection EndDataSection Data Declare DeclareC DeclareDLL DeclareCDLL DeclareModule EndDeclareModule Module EndModule UseModule UnuseModule IncludeFile XIncludeFile IncludeBinary IncludePath "
  Liste$ = Liste$ + "Break Continue End And Or Not XOr With EndWith NewList NewMap Dim ReDim CompilerIf CompilerElse CompilerElseIf CompilerEndIf CompilerSelect CompilerCase CompilerDefault CompilerEndSelect CompilerError CompilerWarning "
  Liste$ = Liste$ + "Import ImportC EndImport Prototype PrototypeC EnableExplicit DisableExplicit EnableDebugger DisableDebugger Debug Goto Gosub Return FakeReturn Swap Restore Read Interface EndInterface Extends Array List Map EnableASM DisableASM Runtime"
  For i = 1 To CountString(Liste$, " ") + 1
    Mot$ = LCase(StringField(Liste$, i, " "))
    If Mot$ <> ""
      MotCle(Mot$) = 1
    EndIf
  Next
EndProcedure

; Envoie un texte (Nom de police) à Scintilla, qui l'attend en UTF-8
Procedure SciTexteMessage(Gadget, NumeroMessage, Param, Texte$)
  Protected *u = UTF8(Texte$)
  If *u
    ScintillaSendMessage(Gadget, NumeroMessage, Param, *u)
    FreeMemory(*u)
  EndIf
EndProcedure

Declare RappelScintilla(Gadget, *n.SCNotification)

; Retire le cadre en creux (3D) que Windows met autour d'un gadget
Procedure SansBordure(Gadget)
  Protected h = GadgetID(Gadget)
  SetWindowLongPtr_(h, #W_GWL_EXSTYLE, GetWindowLongPtr_(h, #W_GWL_EXSTYLE) & ~(#W_WS_EX_CLIENTEDGE | #W_WS_EX_STATICEDGE))
  SetWindowLongPtr_(h, #W_GWL_STYLE, GetWindowLongPtr_(h, #W_GWL_STYLE) & ~#W_WS_BORDER)
  SetWindowPos_(h, 0, 0, 0, 0, 0, #W_SWP_FRAMECHANGED | #W_SWP_NOMOVE | #W_SWP_NOSIZE | #W_SWP_NOZORDER | #W_SWP_NOACTIVATE)
EndProcedure

; Genre 0: code (numéros de ligne) ; 1: bloc compressé (retour à la ligne)
; Genre 2: sortie
Procedure ConfigurerEditeur(Gadget, Genre)
  SansBordure(Gadget)
  ScintillaSendMessage(Gadget, #Scin_SetTechnology, 1)             ; DirectWrite: polices de secours (idéogrammes)
  ScintillaSendMessage(Gadget, #Scin_SetCodePage, 65001)
  SciTexteMessage(Gadget, #Scin_StyleSetFont, #Scin_StyleDefault, "Consolas")
  If Genre = 2
    ScintillaSendMessage(Gadget, #Scin_StyleSetSizeFractional, #Scin_StyleDefault, 825)    ; 11 px
  Else
    ScintillaSendMessage(Gadget, #Scin_StyleSetSizeFractional, #Scin_StyleDefault, 975)    ; 13 px
  EndIf
  ScintillaSendMessage(Gadget, #Scin_StyleSetFore, #Scin_StyleDefault, #C_CodeTexte)
  ScintillaSendMessage(Gadget, #Scin_StyleSetBack, #Scin_StyleDefault, #C_Contenu)
  ScintillaSendMessage(Gadget, #Scin_StyleClearAll)
  ScintillaSendMessage(Gadget, #Scin_SetFontQuality, 3)
  ; couleurs du code (comme l'éditeur de VS2010)
  ScintillaSendMessage(Gadget, #Scin_StyleSetFore, 1, #C_CodeMot)
  ScintillaSendMessage(Gadget, #Scin_StyleSetFore, 2, #C_CodeCommentaire)
  ScintillaSendMessage(Gadget, #Scin_StyleSetFore, 3, #C_CodeChaine)
  ScintillaSendMessage(Gadget, #Scin_StyleSetFore, 4, #C_CodeConstante)
  ; couleurs de la sortie
  ScintillaSendMessage(Gadget, #Scin_StyleSetFore, 10, #C_ConsoleHeure)
  ScintillaSendMessage(Gadget, #Scin_StyleSetFore, 11, #C_TextePrincipal)
  ScintillaSendMessage(Gadget, #Scin_StyleSetFore, 12, #C_ConsoleOk)
  ScintillaSendMessage(Gadget, #Scin_StyleSetFore, 13, #C_ConsoleAttention)
  ScintillaSendMessage(Gadget, #Scin_StyleSetFore, 14, #C_ConsoleErreur)
  ScintillaSendMessage(Gadget, #Scin_StyleSetFore, #Scin_StyleLineNumber, #C_CodeNumero)
  ScintillaSendMessage(Gadget, #Scin_StyleSetBack, #Scin_StyleLineNumber, #C_Contenu)
  ; sélection (::selection de la maquette), curseur
  ScintillaSendMessage(Gadget, #Scin_SetSelBack, 1, #C_Selection)
  ScintillaSendMessage(Gadget, #Scin_SetSelFore, 1, #C_Blanc)
  ScintillaSendMessage(Gadget, #Scin_SetCaretFore, #C_CodeTexte)
  ; marges: 0 numéros, 1 trait d'un pixel, 2 rien
  ScintillaSendMessage(Gadget, #Scin_SetMarginTypeN, 0, 1)
  ScintillaSendMessage(Gadget, #Scin_SetMarginTypeN, 1, 6)
  ScintillaSendMessage(Gadget, #Scin_SetMarginBackN, 1, #C_CodeMarge)
  ScintillaSendMessage(Gadget, #Scin_SetMarginMaskN, 1, 0)
  ScintillaSendMessage(Gadget, #Scin_SetMarginWidthN, 2, 0)
  If Genre = 0
    ScintillaSendMessage(Gadget, #Scin_SetMarginWidthN, 1, Bord())
  Else
    ScintillaSendMessage(Gadget, #Scin_SetMarginWidthN, 0, 0)
    ScintillaSendMessage(Gadget, #Scin_SetMarginWidthN, 1, 0)
  EndIf
  ScintillaSendMessage(Gadget, #Scin_SetMarginLeft, 0, Pix(8))
  ScintillaSendMessage(Gadget, #Scin_SetMarginRight, 0, Pix(8))
  ; lecture seule, sans annulation, sans menu de Scintilla
  ScintillaSendMessage(Gadget, #Scin_SetReadOnly, 1)
  ScintillaSendMessage(Gadget, #Scin_SetUndoCollection, 0)
  ScintillaSendMessage(Gadget, #Scin_UsePopup, 0)
  ScintillaSendMessage(Gadget, #Scin_SetTabWidth, 2)
  ; barres de défilement dessinées par le programme (voir DessinerDefil)
  ScintillaSendMessage(Gadget, #Scin_SetVScrollBar, 0)
  ScintillaSendMessage(Gadget, #Scin_SetHScrollBar, 0)
  ScintillaSendMessage(Gadget, #Scin_SetScrollWidth, 1)
  ScintillaSendMessage(Gadget, #Scin_SetScrollWidthTracking, 0)   ; sans sa barre, Scintilla ne suit pas la largeur: voir LargeurLignes
  ScintillaSendMessage(Gadget, #Scin_SetEndAtLastLine, 1)
  Select Genre
    Case 1
      ScintillaSendMessage(Gadget, #Scin_SetWrapMode, 2)
      ScintillaSendMessage(Gadget, #Scin_SetExtraAscent, Pix(2))
      ScintillaSendMessage(Gadget, #Scin_SetExtraDescent, Pix(2))
    Case 2
      ScintillaSendMessage(Gadget, #Scin_SetWrapMode, 1)
      ScintillaSendMessage(Gadget, #Scin_SetWrapIndentMode, 0)
      ScintillaSendMessage(Gadget, #Scin_SetWrapStartIndent, 9)
      ScintillaSendMessage(Gadget, #Scin_SetExtraAscent, Pix(2))
      ScintillaSendMessage(Gadget, #Scin_SetExtraDescent, Pix(3))
      ScintillaSendMessage(Gadget, #Scin_SetCaretWidth, 0)
    Default
      ScintillaSendMessage(Gadget, #Scin_SetExtraAscent, Pix(1))
      ScintillaSendMessage(Gadget, #Scin_SetExtraDescent, Pix(1))
  EndSelect
EndProcedure

; Largeur de la marge des numéros de ligne (padding 10 et 8 de la maquette)
Procedure MargeNumeros(Gadget)
  Protected *u, Largeur
  *u = UTF8("_" + Str(Maxi(ScintillaSendMessage(Gadget, #Scin_GetLineCount), 9)))
  If *u
    Largeur = ScintillaSendMessage(Gadget, #Scin_TextWidth, #Scin_StyleLineNumber, *u)
    FreeMemory(*u)
  EndIf
  ScintillaSendMessage(Gadget, #Scin_SetMarginWidthN, 0, Largeur + Pix(10))
EndProcedure

; Coloration d'un code PureBasic: commentaires, chaînes, #constantes, mots-clés
Procedure ColorerCode(Gadget)
  Protected Longueur, *t, *s, i, j, c, d, Mot$, Precedent

  Longueur = ScintillaSendMessage(Gadget, #Scin_GetLength)
  If Longueur <= 0
    ProcedureReturn
  EndIf
  *t = ScintillaSendMessage(Gadget, #Scin_GetCharacterPointer)
  *s = AllocateMemory(Longueur + 1)
  If *t = 0 Or *s = 0
    If *s
      FreeMemory(*s)
    EndIf
    ProcedureReturn
  EndIf
  i = 0
  While i < Longueur
    c = PeekA(*t + i)
    If c = 59                                   ; ; commentaire jusqu'à la fin de la ligne
      j = i
      While j < Longueur
        d = PeekA(*t + j)
        If d = 10 Or d = 13
          Break
        EndIf
        j = j + 1
      Wend
      FillMemory(*s + i, j - i, 2)
      i = j
    ElseIf c = 34 Or (c = 126 And i + 1 < Longueur And PeekA(*t + i + 1) = 34)   ; "chaîne" ou ~"chaîne"
      j = i + 1
      If c = 126
        j = i + 2
      EndIf
      While j < Longueur
        d = PeekA(*t + j)
        If d = 10 Or d = 13
          Break
        EndIf
        If c = 126 And d = 92 And j + 1 < Longueur   ; \" dans une chaîne ~"..."
          j = j + 2
          Continue
        EndIf
        If d = 34
          j = j + 1
          Break
        EndIf
        j = j + 1
      Wend
      FillMemory(*s + i, j - i, 3)
      i = j
    ElseIf c = 35 And i + 1 < Longueur                ; #constante
      d = PeekA(*t + i + 1)
      If (d >= 65 And d <= 90) Or (d >= 97 And d <= 122) Or d = 95
        j = i + 1
        While j < Longueur
          d = PeekA(*t + j)
          If (d >= 48 And d <= 57) Or (d >= 65 And d <= 90) Or (d >= 97 And d <= 122) Or d = 95 Or d = 36
            j = j + 1
          Else
            Break
          EndIf
        Wend
        FillMemory(*s + i, j - i, 4)
        i = j
      Else
        i = i + 1
      EndIf
    ElseIf (c >= 65 And c <= 90) Or (c >= 97 And c <= 122) Or c = 95
      j = i
      While j < Longueur
        d = PeekA(*t + j)
        If (d >= 48 And d <= 57) Or (d >= 65 And d <= 90) Or (d >= 97 And d <= 122) Or d = 95
          j = j + 1
        Else
          Break
        EndIf
      Wend
      If j < Longueur And PeekA(*t + j) = 36
        j = j + 1
      EndIf
      Precedent = 0
      If i > 0
        Precedent = PeekA(*t + i - 1)
      EndIf
      If Precedent <> 92 And Precedent <> 46 And Precedent <> 42 And j - i <= 20
        Mot$ = LCase(PeekS(*t + i, j - i, #PB_Ascii))
        If FindMapElement(MotCle(), Mot$)
          FillMemory(*s + i, j - i, 1)
        EndIf
      EndIf
      i = j
    ElseIf c >= 48 And c <= 57
      ; nombre: on avance sans colorer (évite de prendre 1e3 pour un mot)
      j = i
      While j < Longueur
        d = PeekA(*t + j)
        If (d >= 48 And d <= 57) Or (d >= 65 And d <= 90) Or (d >= 97 And d <= 122) Or d = 95
          j = j + 1
        Else
          Break
        EndIf
      Wend
      i = j
    Else
      i = i + 1
    EndIf
  Wend
  ScintillaSendMessage(Gadget, #Scin_StartStyling, 0, 0)
  ScintillaSendMessage(Gadget, #Scin_SetStylingEx, Longueur, *s)
  FreeMemory(*s)
EndProcedure

; Proportion (en %) de caractères « larges » (idéogrammes, syllabes coréennes
; et tout ce qui est au-delà de U+2E80) parmi ceux qui ne sont pas des
; blancs. Un bloc compressé en Unicode en est fait à 100 %, un code à presque 0.
Procedure ProportionLarge(Texte$)
  Protected *c.Character, n, Total, Larges

  If Texte$ = ""
    ProcedureReturn 0
  EndIf
  *c = @Texte$
  While *c\c
    n = *c\c
    If n <> 32 And n <> 9 And n <> 10 And n <> 13
      Total = Total + 1
      If n >= $2E80
        Larges = Larges + 1
      EndIf
    EndIf
    *c + SizeOf(Character)
  Wend
  If Total = 0
    ProcedureReturn 0
  EndIf
  ProcedureReturn (Larges * 100) / Total
EndProcedure

Global Dim TexteBloc(#CanvasDialogue)      ; l'éditeur montre un bloc compressé
Global Dim TexteTronque(#CanvasDialogue)   ; l'éditeur ne montre que le début du texte

; Largeur de la plus longue ligne (pixels), donnée à Scintilla pour la barre
; de défilement horizontale. (Scintilla ne la suit lui-même que si sa propre
; barre est affichée.) Au-delà de 4 000 lignes, seules les 400 plus longues
; (en octets) sont mesurées.
Structure LongueurLigne
  Ligne.i
  Octets.i
EndStructure

Procedure MesurerLigne(Gadget, Ligne)
  Protected Debut, Fin
  Debut = ScintillaSendMessage(Gadget, #Scin_PositionFromLine, Ligne)
  Fin = ScintillaSendMessage(Gadget, #Scin_GetLineEndPosition, Ligne)
  If Fin <= Debut
    ProcedureReturn 0
  EndIf
  ProcedureReturn ScintillaSendMessage(Gadget, #Scin_PointXFromPosition, 0, Fin) - ScintillaSendMessage(Gadget, #Scin_PointXFromPosition, 0, Debut)
EndProcedure

Procedure LargeurLignes(Gadget)
  Protected Nb, i, Max
  Protected Dim Lignes.LongueurLigne(0)

  If ScintillaSendMessage(Gadget, #Scin_GetWrapMode) <> 0
    ; retour à la ligne: jamais de défilement horizontal
    ScintillaSendMessage(Gadget, #Scin_SetScrollWidth, 1)
    ProcedureReturn
  EndIf
  Nb = ScintillaSendMessage(Gadget, #Scin_GetLineCount)
  If Nb <= 4000
    For i = 0 To Nb - 1
      Max = Maxi(Max, MesurerLigne(Gadget, i))
    Next
  Else
    Dim Lignes.LongueurLigne(Nb - 1)
    For i = 0 To Nb - 1
      Lignes(i)\Ligne = i
      Lignes(i)\Octets = ScintillaSendMessage(Gadget, #Scin_LineLength, i)
    Next
    SortStructuredArray(Lignes(), #PB_Sort_Descending, OffsetOf(LongueurLigne\Octets), #PB_Integer)
    For i = 0 To 399
      Max = Maxi(Max, MesurerLigne(Gadget, Lignes(i)\Ligne))
    Next
  EndIf
  ScintillaSendMessage(Gadget, #Scin_SetScrollWidth, Maxi(1, Max + Pix(8)))
EndProcedure

; Met un texte dans un éditeur (Code: #True pour colorer comme du code)
#AffichageMax = 100000

Procedure EditeurTexte(Gadget, Texte$, Code)
  Protected *u

  ; Un texte énorme écrit sur très peu de lignes (un bloc de plusieurs
  ; centaines de milliers de caractères) ralentirait beaucoup l'affichage:
  ; on n'en montre alors que le début (« Copier tout l'onglet » le copie en entier)
  TexteBloc(Gadget) = Bool(ProportionLarge(Texte$) >= 80)
  TexteTronque(Gadget) = #False
  If Len(Texte$) > #AffichageMax And CountString(Texte$, #LF$) < Len(Texte$) / 2000
    Texte$ = Left(Texte$, 3000) + #CRLF$ + #CRLF$ + TrF("texteTropLong", FormaterNombre(Len(Texte$)))
    TexteTronque(Gadget) = #True
  EndIf
  *u = UTF8(Texte$)
  ScintillaSendMessage(Gadget, #Scin_SetReadOnly, 0)
  If *u
    ScintillaSendMessage(Gadget, #Scin_SetText, 0, *u)
    FreeMemory(*u)
  EndIf
  ScintillaSendMessage(Gadget, #Scin_SetReadOnly, 1)
  ScintillaSendMessage(Gadget, #Scin_SetXOffset, 0)
  ScintillaSendMessage(Gadget, #Scin_SetFirstVisibleLine, 0)
  If Code
    MargeNumeros(Gadget)
    ColorerCode(Gadget)
  EndIf
  LargeurLignes(Gadget)
EndProcedure

; ----------------------------------------------------------------------------
;  Sortie (journal de la séance, avec l'heure)
; ----------------------------------------------------------------------------
Procedure Journal(Type, Texte$)
  Protected Ligne$, *u, Debut, TailleHeure, Taille

  If IsGadget(#EditeurJournal) = 0
    ProcedureReturn
  EndIf
  Texte$ = ReplaceString(Texte$, #CRLF$, " ")
  Texte$ = ReplaceString(Texte$, #LF$, " ")
  Ligne$ = FormatDate("%hh:%ii:%ss", Date()) + " "
  TailleHeure = StringByteLength(Ligne$, #PB_UTF8)
  Ligne$ = Ligne$ + Texte$
  Debut = ScintillaSendMessage(#EditeurJournal, #Scin_GetLength)
  If Debut > 0
    Ligne$ = #LF$ + Ligne$
    Debut = Debut + 1
  EndIf
  Taille = StringByteLength(Ligne$, #PB_UTF8)
  *u = UTF8(Ligne$)
  If *u
    ScintillaSendMessage(#EditeurJournal, #Scin_SetReadOnly, 0)
    ScintillaSendMessage(#EditeurJournal, #Scin_AppendText, Taille, *u)
    ScintillaSendMessage(#EditeurJournal, #Scin_SetReadOnly, 1)
    FreeMemory(*u)
    ScintillaSendMessage(#EditeurJournal, #Scin_StartStyling, Debut, 0)
    ScintillaSendMessage(#EditeurJournal, #Scin_SetStyling, TailleHeure, 10)
    ScintillaSendMessage(#EditeurJournal, #Scin_SetStyling, ScintillaSendMessage(#EditeurJournal, #Scin_GetLength) - Debut - TailleHeure, 11 + Type)
    ScintillaSendMessage(#EditeurJournal, #Scin_GotoPos, ScintillaSendMessage(#EditeurJournal, #Scin_GetLength))
    ScintillaSendMessage(#EditeurJournal, #Scin_ScrollCaret)
  EndIf
EndProcedure

; ----------------------------------------------------------------------------
;  Barres de défilement dessinées (style de la maquette, comme ::-webkit-scrollbar)
; ----------------------------------------------------------------------------
Procedure EditeurDeOnglet(Onglet)
  Select Onglet
    Case 1
      ProcedureReturn #EditeurSortie
    Case 2
      ProcedureReturn #EditeurDec
  EndSelect
  ProcedureReturn #EditeurEntree
EndProcedure

; Lit l'état de défilement de l'éditeur relié
Procedure LireDefilement(i)
  Protected G = Defil(i)\Cible, Marges, k

  If IsGadget(G) = 0
    Defil(i)\Visible = #False
    ProcedureReturn
  EndIf
  If Defil(i)\Vertical
    Defil(i)\Total = ScintillaSendMessage(G, #Scin_VisibleFromDocLine, ScintillaSendMessage(G, #Scin_GetLineCount))
    Defil(i)\Page = ScintillaSendMessage(G, #Scin_LinesOnScreen)
    Defil(i)\Position = ScintillaSendMessage(G, #Scin_GetFirstVisibleLine)
  Else
    For k = 0 To 2
      Marges = Marges + ScintillaSendMessage(G, #Scin_GetMarginWidthN, k)
    Next
    Defil(i)\Total = ScintillaSendMessage(G, #Scin_GetScrollWidth)
    Defil(i)\Page = LargeurPixels(G) - Marges - Pix(16)
    Defil(i)\Position = ScintillaSendMessage(G, #Scin_GetXOffset)
  EndIf
  Defil(i)\Visible = Bool(Defil(i)\Total > Defil(i)\Page And Defil(i)\Page > 0)
EndProcedure

; ----------------------------------------------------------------------------
;  Barres de défilement dans le style de VS2010: piste en dégradé, une flèche
;  à chaque bout, pouce en dégradé avec trois traits au milieu ; en jaune
;  quand la souris passe dessus (comme les menus et la barre d'outils), en
;  orangé quand on appuie. Une flèche (ou la piste) maintenue enfoncée fait
;  défiler en continu. Barres 0 à 2: canevas à côté des éditeurs ; barre 3:
;  celle de la grille de propriétés, dessinée dans le canevas de la grille.
; ----------------------------------------------------------------------------

; Début et longueur du pouce (pixels, depuis le début de la barre)
Procedure PouceDefil(i, *Debut.Integer, *Taille.Integer)
  Protected Piste, MaxPos

  Piste = Defil(i)\Longueur - (2 * Defil(i)\Epaisseur)
  *Debut\i = Defil(i)\Epaisseur
  If Piste <= 0
    *Taille\i = 0
    ProcedureReturn
  EndIf
  If Defil(i)\Total <= 0 Or Defil(i)\Page >= Defil(i)\Total
    *Taille\i = Piste
    ProcedureReturn
  EndIf
  *Taille\i = Mini(Piste, Maxi(Pix(18), (Piste * Defil(i)\Page) / Defil(i)\Total))
  MaxPos = Defil(i)\Total - Defil(i)\Page
  *Debut\i = Defil(i)\Epaisseur + ((Piste - *Taille\i) * Maxi(0, Mini(Defil(i)\Position, MaxPos))) / MaxPos
EndProcedure

; Partie de la barre à la coordonnée Coord (pixels le long de la barre)
Procedure ZoneDefil(i, Coord)
  Protected Debut, Taille

  If Coord < 0 Or Coord >= Defil(i)\Longueur
    ProcedureReturn 0
  EndIf
  If Coord < Defil(i)\Epaisseur
    ProcedureReturn #ZoneFlecheDebut
  EndIf
  If Coord >= Defil(i)\Longueur - Defil(i)\Epaisseur
    ProcedureReturn #ZoneFlecheFin
  EndIf
  PouceDefil(i, @Debut, @Taille)
  If Coord < Debut
    ProcedureReturn #ZonePageAvant
  ElseIf Coord < Debut + Taille
    ProcedureReturn #ZonePouce
  EndIf
  ProcedureReturn #ZonePageApres
EndProcedure

; Petit triangle plein centré en CX, CY (Sens: 0 haut, 1 bas, 2 gauche, 3 droite)
Procedure TracerFleche(CX, CY, Sens, Couleur)
  Protected k, h = Maxi(3, Pix(5))

  DrawingMode(#PB_2DDrawing_Default)
  For k = 0 To h - 1
    Select Sens
      Case 0
        Box(CX - k, CY - (h / 2) + k, (2 * k) + 1, 1, Couleur)
      Case 1
        Box(CX - k, CY + (h / 2) - k, (2 * k) + 1, 1, Couleur)
      Case 2
        Box(CX - (h / 2) + k, CY - k, 1, (2 * k) + 1, Couleur)
      Default
        Box(CX + (h / 2) - k, CY - k, 1, (2 * k) + 1, Couleur)
    EndSelect
  Next
EndProcedure

; Rectangle arrondi en dégradé (en travers de la barre), avec son bord
Procedure TracerBoutonDefil(X, Y, L, H, Vertical, Clair, Fonce, Bordure)
  Protected R = Pix(3)

  If L <= 0 Or H <= 0
    ProcedureReturn
  EndIf
  DrawingMode(#PB_2DDrawing_Gradient)
  BackColor(Clair)
  FrontColor(Fonce)
  If Vertical
    LinearGradient(X, Y, X + L, Y)
  Else
    LinearGradient(X, Y, X, Y + H)
  EndIf
  RoundBox(X, Y, L, H, R, R)
  DrawingMode(#PB_2DDrawing_Outlined)
  RoundBox(X, Y, L, H, R, R, Bordure)
  DrawingMode(#PB_2DDrawing_Default)
EndProcedure

; État d'une partie: 0 normal, 1 survolée, 2 enfoncée
Procedure EtatZoneDefil(i, Zone)
  If Defil(i)\Appui = Zone
    ProcedureReturn 2
  ElseIf Defil(i)\Survol = Zone And Defil(i)\Appui = 0
    ProcedureReturn 1
  EndIf
  ProcedureReturn 0
EndProcedure

; Dessine la barre i dans le dessin en cours, dans le rectangle X, Y, L, H
Procedure TracerDefil(i, X, Y, L, H)
  Protected V = Defil(i)\Vertical, E, B = Bord(), M = Pix(1), Debut, Taille, Etat, k, Milieu, Couleur
  Protected PX, PY, PL, PH

  If V
    E = L
    Defil(i)\Longueur = H
  Else
    E = H
    Defil(i)\Longueur = L
  EndIf
  Defil(i)\Epaisseur = E
  Defil(i)\TotalDessine = Defil(i)\Total
  Defil(i)\PageDessinee = Defil(i)\Page
  Defil(i)\PositionDessinee = Defil(i)\Position

  ; piste: léger dégradé en travers, trait du côté du contenu
  DrawingMode(#PB_2DDrawing_Gradient)
  BackColor(#C_DefilPisteA)
  FrontColor(#C_DefilPisteB)
  If V
    LinearGradient(X, Y, X + L, Y)
  Else
    LinearGradient(X, Y, X, Y + H)
  EndIf
  Box(X, Y, L, H)
  DrawingMode(#PB_2DDrawing_Default)
  If V
    Box(X, Y, B, H, #C_DefilBordure)
  Else
    Box(X, Y, L, B, #C_DefilBordure)
  EndIf

  ; une flèche à chaque bout
  For k = 0 To 1
    If k = 0
      Etat = EtatZoneDefil(i, #ZoneFlecheDebut)
    Else
      Etat = EtatZoneDefil(i, #ZoneFlecheFin)
    EndIf
    If V
      PX = X + B + M
      PL = E - B - (2 * M)
      PH = E - (2 * M)
      If k = 0
        PY = Y + M
      Else
        PY = Y + H - E + M
      EndIf
    Else
      PY = Y + B + M
      PH = E - B - (2 * M)
      PL = E - (2 * M)
      If k = 0
        PX = X + M
      Else
        PX = X + L - E + M
      EndIf
    EndIf
    Select Etat
      Case 1
        TracerBoutonDefil(PX, PY, PL, PH, V, #C_SurvolHaut, #C_SurvolBas, #C_SurvolBordure)
      Case 2
        TracerBoutonDefil(PX, PY, PL, PH, V, #C_ActifHaut, #C_ActifBas, #C_ActifBordure)
    EndSelect
    If V
      TracerFleche(PX + (PL / 2), PY + (PH / 2), k, #C_DefilFleche)
    Else
      TracerFleche(PX + (PL / 2), PY + (PH / 2), 2 + k, #C_DefilFleche)
    EndIf
  Next

  ; pouce
  PouceDefil(i, @Debut, @Taille)
  If Taille > Pix(6)
    If V
      PX = X + B + Pix(2)
      PL = E - B - Pix(4)
      PY = Y + Debut + M
      PH = Taille - (2 * M)
    Else
      PY = Y + B + Pix(2)
      PH = E - B - Pix(4)
      PX = X + Debut + M
      PL = Taille - (2 * M)
    EndIf
    Select EtatZoneDefil(i, #ZonePouce)
      Case 1
        TracerBoutonDefil(PX, PY, PL, PH, V, #C_SurvolHaut, #C_SurvolBas, #C_SurvolBordure)
        Couleur = #C_ActifBordure
      Case 2
        TracerBoutonDefil(PX, PY, PL, PH, V, #C_ActifHaut, #C_ActifBas, #C_ActifBordure)
        Couleur = #C_ActifBordure
      Default
        TracerBoutonDefil(PX, PY, PL, PH, V, #C_DefilPouceA, #C_DefilPouceB, #C_DefilPouceTrait)
        Couleur = #C_DefilGrip
    EndSelect
    ; trois traits au milieu (la « prise »)
    If Taille >= Pix(26)
      For k = -1 To 1
        If V
          Milieu = PY + (PH / 2) + (k * Pix(3))
          Box(PX + (PL / 2) - Pix(3), Milieu, Pix(6), B, Couleur)
        Else
          Milieu = PX + (PL / 2) + (k * Pix(3))
          Box(Milieu, PY + (PH / 2) - Pix(3), B, Pix(6), Couleur)
        EndIf
      Next
    EndIf
  EndIf
EndProcedure

Procedure DessinerDefil(i)
  If i = 3
    DessinerGrille()                  ; la barre de la grille est dans son canevas
    ProcedureReturn
  EndIf
  If IsGadget(Defil(i)\Gadget) = 0
    ProcedureReturn
  EndIf
  If StartDrawing(CanvasOutput(Defil(i)\Gadget))
    TracerDefil(i, 0, 0, OutputWidth(), OutputHeight())
    StopDrawing()
  EndIf
EndProcedure

Procedure DessinerCoin()
  If StartDrawing(CanvasOutput(#CoinDoc))
    Box(0, 0, OutputWidth(), OutputHeight(), #C_DefilPisteB)
    StopDrawing()
  EndIf
EndProcedure

Procedure DefilerA(i, Position)
  Protected G = Defil(i)\Cible

  Position = Maxi(0, Mini(Position, Defil(i)\Total - Defil(i)\Page))
  If i = 3
    DefilerGrille(Position)
    ProcedureReturn
  EndIf
  If Defil(i)\Vertical
    ScintillaSendMessage(G, #Scin_SetFirstVisibleLine, Position)
  Else
    ScintillaSendMessage(G, #Scin_SetXOffset, Position)
  EndIf
  LireDefilement(i)
  DessinerDefil(i)
EndProcedure

; Un clic sur une flèche ou sur la piste
Procedure PasDefil(i, Zone)
  Select Zone
    Case #ZoneFlecheDebut
      DefilerA(i, Defil(i)\Position - Defil(i)\Pas)
    Case #ZoneFlecheFin
      DefilerA(i, Defil(i)\Position + Defil(i)\Pas)
    Case #ZonePageAvant
      DefilerA(i, Defil(i)\Position - Defil(i)\Page)
    Case #ZonePageApres
      DefilerA(i, Defil(i)\Position + Defil(i)\Page)
  EndSelect
EndProcedure

; Position de la souris le long de la barre (renvoyée) et en travers (*Travers)
Procedure SourisSurDefil(i, *Travers.Integer)
  Protected p.POINT
  SourisDans(Defil(i)\Gadget, @p)
  If Defil(i)\Vertical
    *Travers\i = p\x - Defil(i)\OrigineX
    ProcedureReturn p\y - Defil(i)\OrigineY
  EndIf
  *Travers\i = p\y - Defil(i)\OrigineY
  ProcedureReturn p\x - Defil(i)\OrigineX
EndProcedure

; Flèche ou piste maintenue enfoncée: défilement continu (minuterie)
Global DefilRepete = -1            ; barre concernée (-1: aucune)
Global DefilTics

Procedure ArreterRepetition()
  If DefilRepete >= 0
    RemoveWindowTimer(#FenetrePrincipale, #MinuterieDefil)
    DefilRepete = -1
  EndIf
EndProcedure

Procedure DemarrerRepetition(i)
  ArreterRepetition()
  DefilRepete = i
  DefilTics = 0
  AddWindowTimer(#FenetrePrincipale, #MinuterieDefil, 40)
EndProcedure

Procedure EvenementMinuterie()
  Protected i = DefilRepete, Coord, Travers

  If EventTimer() <> #MinuterieDefil Or i < 0
    ProcedureReturn
  EndIf
  If BoutonGaucheEnfonce() = #False
    ArreterRepetition()                     ; bouton relâché sans qu'on le voie
    Defil(i)\Appui = 0
    DessinerDefil(i)
    ProcedureReturn
  EndIf
  DefilTics = DefilTics + 1
  If DefilTics < 9                          ; environ 350 ms avant de répéter
    ProcedureReturn
  EndIf
  Coord = SourisSurDefil(i, @Travers)
  If ZoneDefil(i, Coord) = Defil(i)\Appui
    PasDefil(i, Defil(i)\Appui)
  EndIf
EndProcedure

; La souris sur la barre i (Coord le long de la barre, Travers en travers).
; Renvoie #True si l'événement concernait la barre.
Procedure SourisDefil(i, Type, Coord, Travers)
  Protected Zone, Debut, Taille, Piste

  If Travers >= 0 And Travers < Defil(i)\Epaisseur
    Zone = ZoneDefil(i, Coord)
  EndIf
  Select Type
    Case #PB_EventType_MouseMove
      If Defil(i)\Appui And BoutonGaucheEnfonce() = #False
        Defil(i)\Appui = 0                  ; relâchement perdu (Alt+Tab...)
        ArreterRepetition()
      EndIf
      If Defil(i)\Appui = #ZonePouce
        PouceDefil(i, @Debut, @Taille)
        Piste = Defil(i)\Longueur - (2 * Defil(i)\Epaisseur)
        If Piste > Taille
          DefilerA(i, Defil(i)\DebutPosition + ((Coord - Defil(i)\DebutSouris) * (Defil(i)\Total - Defil(i)\Page)) / (Piste - Taille))
        EndIf
      ElseIf Defil(i)\Appui = 0 And Zone <> Defil(i)\Survol
        Defil(i)\Survol = Zone
        DessinerDefil(i)
      EndIf
    Case #PB_EventType_MouseLeave
      If Defil(i)\Survol And Defil(i)\Appui = 0
        Defil(i)\Survol = 0
        DessinerDefil(i)
      EndIf
    Case #PB_EventType_LeftButtonDown
      If Zone = 0
        ProcedureReturn #False
      EndIf
      FermerPopups()
      Defil(i)\Appui = Zone
      If Zone = #ZonePouce
        Defil(i)\DebutSouris = Coord
        Defil(i)\DebutPosition = Defil(i)\Position
      Else
        PasDefil(i, Zone)
        DemarrerRepetition(i)
      EndIf
      DessinerDefil(i)
    Case #PB_EventType_LeftButtonUp
      If Defil(i)\Appui = 0
        ProcedureReturn #False
      EndIf
      Defil(i)\Appui = 0
      ArreterRepetition()
      Defil(i)\Survol = Zone
      DessinerDefil(i)
    Default
      ProcedureReturn #False
  EndSelect
  ProcedureReturn #True
EndProcedure

; Barres 0 à 2 (canevas à côté des éditeurs): appelée directement par
; PureBasic (BindGadgetEvent), elle marche aussi pendant un long calcul
Procedure EvenementDefil()
  Protected Gadget = EventGadget(), i, Coord, Travers

  For i = 0 To 2
    If Defil(i)\Gadget = Gadget
      Break
    EndIf
  Next
  If i > 2
    ProcedureReturn
  EndIf
  Coord = SourisSurDefil(i, @Travers)
  If EventType() = #PB_EventType_MouseWheel
    If Defil(i)\Vertical
      DefilerA(i, Defil(i)\Position - (3 * GetGadgetAttribute(Gadget, #PB_Canvas_WheelDelta)))
    Else
      DefilerA(i, Defil(i)\Position - (3 * Defil(i)\Pas * GetGadgetAttribute(Gadget, #PB_Canvas_WheelDelta)))
    EndIf
    ProcedureReturn
  EndIf
  SourisDefil(i, EventType(), Coord, Travers)
EndProcedure

; ============================================================================
;  INTERFACE (v7.1) - 3. Grille de propriétés, description, bandeau du forum,
;  onglet vide, dépôt d'un fichier
; ============================================================================

Global Dim ProCategorie(#NbProprietes - 1)
Global Dim ProGenre(#NbProprietes - 1)
Global Dim ProCle$(#NbProprietes - 1)
Global Dim CatCle$(#NbCategories - 1)
Global Dim CatRepliee(#NbCategories - 1)
Global Dim EstimationTexte$(#NbProprietes - 1)     ; valeurs des lignes « Estimation » et « Place utilisée »

Global ProSelection = #ProNiveau   ; propriété choisie (décrite en bas)

; Lignes visibles de la grille (calculées au dessin)
#MaxLignesGrille = 32
Global Dim GrilleProp(#MaxLignesGrille)        ; propriété, ou -(catégorie + 1)
Global Dim GrilleY(#MaxLignesGrille)
Global GrilleNbLignes
Global GrilleDefil                 ; décalage vertical (pixels)
Global GrilleTotal                 ; hauteur de tout le contenu (pixels)
Global GrilleSurvol = -1           ; ligne survolée
Global GrilleSurvolZone            ; 1 flèche de liste, 2 case, 3 bouton
Global GrilleLargeurLibelle        ; largeur de la colonne des noms (pixels)
Global GrilleLargeurUtile          ; largeur sans la barre de défilement

Procedure DefinirPropriete(p, Categorie, Genre, Cle$)
  ProCategorie(p) = Categorie
  ProGenre(p) = Genre
  ProCle$(p) = Cle$
EndProcedure

Procedure InitialiserProprietes()
  DefinirPropriete(#ProFormat, #CatFormat, #TypeListe, "format")
  DefinirPropriete(#ProEncodage, #CatFormat, #TypeListe, "encodage")
  DefinirPropriete(#ProLangue, #CatFormat, #TypeListe, "langue")
  DefinirPropriete(#ProIDE, #CatFormat, #TypeCase, "ide")
  DefinirPropriete(#ProMethode, #CatCompression, #TypeListe, "methode")
  DefinirPropriete(#ProNiveau, #CatCompression, #TypeListe, "niveau")
  DefinirPropriete(#ProProtection, #CatCompression, #TypeListe, "protection")
  DefinirPropriete(#ProLimite, #CatForum, #TypeNombre, "limite")
  DefinirPropriete(#ProEstTaille, #CatEstimation, #TypeLecture, "estTaille")
  DefinirPropriete(#ProEstComp, #CatEstimation, #TypeLecture, "estComp")
  DefinirPropriete(#ProEstMemComp, #CatEstimation, #TypeLecture, "estMemComp")
  DefinirPropriete(#ProEstDec, #CatEstimation, #TypeLecture, "estDec")
  DefinirPropriete(#ProEstMem, #CatEstimation, #TypeLecture, "estMem")
  DefinirPropriete(#ProEstReseau, #CatEstimation, #TypeLecture, "estReseau")
  DefinirPropriete(#ProGarderEtat, #CatDisque, #TypeCase, "garderEtat")
  DefinirPropriete(#ProPlace, #CatDisque, #TypeBouton, "place")
  CatCle$(#CatFormat) = "catFormat"
  CatCle$(#CatCompression) = "catCompression"
  CatCle$(#CatForum) = "catForum"
  CatCle$(#CatEstimation) = "catEstimation"
  CatCle$(#CatDisque) = "catDisque"
EndProcedure

; Format de la prochaine compression: un projet se compresse toujours en
; données seules (le réglage, lui, ne change pas)
Procedure FormatEffectif()
  If ProjetCharge
    ProcedureReturn #FormatBloc
  EndIf
  ProcedureReturn Reglage\Format
EndProcedure

; Le niveau ne sert qu'en données seules, méthode Maximal ou Automatique
Procedure NiveauActif()
  ProcedureReturn Bool(FormatEffectif() = #FormatBloc And Reglage\Methode <> #MethodeLZMA)
EndProcedure

; La protection ne sert qu'en données seules + Unicode
Procedure ProtectionActive()
  ProcedureReturn Bool(FormatEffectif() = #FormatBloc And Reglage\Encodage = #EncodageUnicode)
EndProcedure

Procedure ProprieteActive(p)
  If Occupe
    ProcedureReturn #False
  EndIf
  Select p
    Case #ProFormat
      ProcedureReturn Bool(ProjetCharge = #False)     ; un projet: données seules
    Case #ProNiveau
      ProcedureReturn NiveauActif()
    Case #ProProtection
      ProcedureReturn ProtectionActive()
  EndSelect
  ProcedureReturn #True
EndProcedure

Procedure.s NomNiveauListe(Niveau)
  ProcedureReturn Tr("niveau" + Str(Niveau))
EndProcedure

; Choix d'une liste: valeurs et textes, séparés par Chr(10)
Procedure.s ChoixListe(p)
  Select p
    Case #ProFormat
      ProcedureReturn Str(#FormatBloc) + Chr(9) + Tr("optBloc") + Chr(10) + Str(#FormatLanceur) + Chr(9) + Tr("optLanceur")
    Case #ProEncodage
      ProcedureReturn Str(#EncodageUnicode) + Chr(9) + Tr("optUnicode") + Chr(10) + Str(#EncodageBase64) + Chr(9) + Tr("optBase64")
    Case #ProLangue
      ProcedureReturn "0" + Chr(9) + "Français" + Chr(10) + "1" + Chr(9) + "English" + Chr(10) + "2" + Chr(9) + "Deutsch"
    Case #ProMethode
      ProcedureReturn Str(#MethodeAuto) + Chr(9) + Tr("optAuto") + Chr(10) + Str(#MethodeLZMA) + Chr(9) + "LZMA" + Chr(10) + Str(#MethodeMaximal) + Chr(9) + Tr("optMaximal")
    Case #ProNiveau
      ProcedureReturn "1" + Chr(9) + NomNiveauListe(1) + Chr(10) + "2" + Chr(9) + NomNiveauListe(2) + Chr(10) + "3" + Chr(9) + NomNiveauListe(3)
    Case #ProProtection
      ProcedureReturn "0" + Chr(9) + Tr("prot0") + Chr(10) + "1" + Chr(9) + Tr("protL1") + Chr(10) + "2" + Chr(9) + Tr("protL2") + Chr(10) + "3" + Chr(9) + Tr("protL3") + Chr(10) + "4" + Chr(9) + Tr("protL4") + Chr(10) + "5" + Chr(9) + Tr("protL5")
  EndSelect
  ProcedureReturn ""
EndProcedure

Procedure ValeurPropriete(p)
  Select p
    Case #ProFormat
      ProcedureReturn FormatEffectif()
    Case #ProEncodage
      ProcedureReturn Reglage\Encodage
    Case #ProLangue
      ProcedureReturn Reglage\LangueResultat
    Case #ProIDE
      ProcedureReturn Reglage\GarderIDE
    Case #ProMethode
      ProcedureReturn Reglage\Methode
    Case #ProNiveau
      ProcedureReturn Reglage\Niveau
    Case #ProProtection
      ProcedureReturn Reglage\Protection
    Case #ProLimite
      ProcedureReturn Reglage\Limite
    Case #ProGarderEtat
      ProcedureReturn GarderEtat
  EndSelect
  ProcedureReturn 0
EndProcedure

; Texte du choix actuel d'une liste
Procedure.s TexteValeur(p)
  Protected Choix$, i, Ligne$
  Choix$ = ChoixListe(p)
  For i = 1 To CountString(Choix$, Chr(10)) + 1
    Ligne$ = StringField(Choix$, i, Chr(10))
    If Val(StringField(Ligne$, 1, Chr(9))) = ValeurPropriete(p)
      ProcedureReturn StringField(Ligne$, 2, Chr(9))
    EndIf
  Next
  ProcedureReturn ""
EndProcedure

; ----------------------------------------------------------------------------
;  Dessin de la grille
; ----------------------------------------------------------------------------

; Case à cocher (comme celles de Chrome sous Windows, 13 x 13)
Procedure DessinerCase(X, Y, Cochee, Survol, Inactive)
  Protected Taille = Pix(13), Fond, Bordure, Opacite = 255
  If Inactive
    Opacite = 110
  EndIf
  If Cochee
    If Survol
      Fond = #C_CaseCocheeSurvol
    Else
      Fond = #C_CaseCochee
    EndIf
    DrawingMode(#PB_2DDrawing_AlphaBlend)
    RoundBox(X, Y, Taille, Taille, Pix(2), Pix(2), RGBA(Red(Fond), Green(Fond), Blue(Fond), Opacite))
    ; coche blanche
    DrawingMode(#PB_2DDrawing_AlphaBlend)
    LineXY(X + Pix(3), Y + Pix(6.5), X + Pix(5.5), Y + Pix(9), RGBA(255, 255, 255, Opacite))
    LineXY(X + Pix(5.5), Y + Pix(9), X + Pix(10), Y + Pix(3.5), RGBA(255, 255, 255, Opacite))
    LineXY(X + Pix(3), Y + Pix(7.5), X + Pix(5.5), Y + Pix(10), RGBA(255, 255, 255, Opacite))
    LineXY(X + Pix(5.5), Y + Pix(10), X + Pix(10), Y + Pix(4.5), RGBA(255, 255, 255, Opacite))
  Else
    If Survol
      Bordure = #C_CaseBordureSurvol
    Else
      Bordure = #C_CaseBordure
    EndIf
    DrawingMode(#PB_2DDrawing_AlphaBlend)
    RoundBox(X, Y, Taille, Taille, Pix(2), Pix(2), RGBA(255, 255, 255, Opacite))
    DrawingMode(#PB_2DDrawing_AlphaBlend | #PB_2DDrawing_Outlined)
    RoundBox(X, Y, Taille, Taille, Pix(2), Pix(2), RGBA(Red(Bordure), Green(Bordure), Blue(Bordure), Opacite))
  EndIf
  DrawingMode(#PB_2DDrawing_Default)
EndProcedure

; Hauteur de tout le contenu de la grille (pixels)
Procedure HauteurGrille()
  Protected c, p, H
  For c = 0 To #NbCategories - 1
    H = H + Pix(#LigneGrille)
    If CatRepliee(c) = #False
      For p = 0 To #NbProprietes - 1
        If ProCategorie(p) = c
          H = H + Pix(#LigneGrille)
        EndIf
      Next
    EndIf
  Next
  ProcedureReturn H
EndProcedure

; Rectangle du champ de la limite (pixels dans la grille), s'il est visible
Global ChampX, ChampY, ChampL, ChampH, ChampVisible
Global ChampFond = #C_Contenu      ; fond de la ligne (le champ est transparent, comme dans la maquette)
Global ChampFondActuel = -1        ; couleur déjà donnée au champ

Procedure DessinerGrille()
  Protected L, H, B, c, p, Y, Index, Ligne, LH, WL, X, Fond, Couleur, Texte$, LT, Active, Survol
  Protected FX, FY, BX, BL, Unite$, Max

  If IsGadget(#CanvasGrille) = 0
    ProcedureReturn
  EndIf
  If StartDrawing(CanvasOutput(#CanvasGrille))
    L = OutputWidth()
    H = OutputHeight()
    B = Bord()
    LH = Pix(#LigneGrille)
    GrilleTotal = HauteurGrille()
    If GrilleTotal > H
      GrilleLargeurUtile = L - Pix(#LargeurDefil)
    Else
      GrilleLargeurUtile = L
      GrilleDefil = 0
    EndIf
    Max = Maxi(0, GrilleTotal - H)
    If GrilleDefil > Max
      GrilleDefil = Max
    EndIf
    WL = GrilleLargeurUtile / 2
    GrilleLargeurLibelle = WL
    Box(0, 0, L, H, #C_Contenu)
    ChampVisible = #False

    Y = -GrilleDefil
    Ligne = 0
    Index = 0
    For c = 0 To #NbCategories - 1
      Index = Index + 1
      ; Catégorie
      If Ligne <= #MaxLignesGrille
        GrilleProp(Ligne) = -(c + 1)
        GrilleY(Ligne) = Y
      EndIf
      If GrilleSurvol = Ligne And Occupe = #False
        Degrade(0, Y, GrilleLargeurUtile, LH, #C_CategorieSurvolHaut, #C_CategorieSurvolBas)
      Else
        Degrade(0, Y, GrilleLargeurUtile, LH, #C_CategorieHaut, #C_CategorieBas)
      EndIf
      Rectangle(0, Y, GrilleLargeurUtile, B, #C_GrilleBordure)
      Rectangle(0, Y + LH - B, GrilleLargeurUtile, B, #C_GrilleBordure)
      If CatRepliee(c)
        DessinerIco(#IcoTriangleDroite, Pix(4), Y + (LH - Pix(16)) / 2)
      Else
        DessinerIco(#IcoTriangleBas, Pix(4), Y + (LH - Pix(16)) / 2)
      EndIf
      DrawingFont(PolicePetiteGras)
      DessinerTexte(Pix(22), Y + (LH - TextHeight("Ag")) / 2, Tr(CatCle$(c)), #C_TextePrincipal)
      Y = Y + LH
      Ligne = Ligne + 1
      If CatRepliee(c)
        Continue
      EndIf

      For p = 0 To #NbProprietes - 1
        If ProCategorie(p) <> c
          Continue
        EndIf
        Index = Index + 1
        If Ligne <= #MaxLignesGrille
          GrilleProp(Ligne) = p
          GrilleY(Ligne) = Y
        EndIf
        Active = ProprieteActive(p)
        Survol = Bool(GrilleSurvol = Ligne And Occupe = #False)
        ; fond: lignes paires grises (nth-child(even), catégories comprises)
        If Survol
          Fond = #C_LigneSurvol
        ElseIf Index % 2 = 0
          Fond = #C_LigneAlternee
        Else
          Fond = #C_Contenu
        EndIf
        Rectangle(0, Y, GrilleLargeurUtile, LH, Fond)
        If ProSelection = p
          Rectangle(0, Y, WL, LH - B, #C_LigneSelection)
        EndIf
        Rectangle(0, Y + LH - B, GrilleLargeurUtile, B, #C_LigneBordure)
        Rectangle(WL - B, Y, B, LH - B, #C_GrilleBordure)
        If Active
          Couleur = #C_TextePrincipal
        Else
          Couleur = #C_TexteGris
        EndIf
        ; nom de la propriété
        DrawingFont(PolicePetite)
        DessinerTexte(Pix(6), Y + (LH - B - TextHeight("Ag")) / 2, Tronquer(Tr("p_" + ProCle$(p)) + Tr("deuxPoints"), WL - Pix(12)), Couleur)

        ; valeur
        X = WL + Pix(4)
        Select ProGenre(p)
          Case #TypeListe
            Texte$ = TexteValeur(p)
            BX = GrilleLargeurUtile - Pix(5) - Pix(15)
            DessinerTexte(X + Pix(4), Y + (LH - B - TextHeight("Ag")) / 2, Tronquer(Texte$, BX - X - Pix(8)), Couleur)
            If Active And (Survol Or ProSelection = p)
              If Survol And GrilleSurvolZone = 1
                Degrade(BX, Y + (LH - B - Pix(15)) / 2, Pix(15), Pix(15), #C_SurvolHaut, #C_SurvolBas)
                Cadre(BX, Y + (LH - B - Pix(15)) / 2, Pix(15), Pix(15), #C_SurvolBordure)
              EndIf
              DessinerIco(#IcoFleche, BX + (Pix(15) - Pix(16)) / 2, Y + (LH - B - Pix(16)) / 2)
            EndIf
          Case #TypeCase
            DessinerCase(WL + (GrilleLargeurUtile - WL - Pix(13)) / 2, Y + (LH - B - Pix(13)) / 2, ValeurPropriete(p), Bool(Survol And GrilleSurvolZone = 2), Bool(Active = #False))
          Case #TypeNombre
            DrawingFont(PolicePetite)
            Unite$ = Tr("unitCaracteres")
            LT = TextWidth(Unite$)
            DessinerTexte(GrilleLargeurUtile - Pix(4) - LT, Y + (LH - B - TextHeight("Ag")) / 2, Unite$, #C_TexteSecondaire)
            ChampX = X
            ChampL = GrilleLargeurUtile - Pix(4) - LT - Pix(4) - X
            ChampH = Pix(19)
            ChampY = Y + (LH - B - ChampH) / 2
            ChampFond = Fond
            ChampVisible = Bool(Y >= 0 And Y + LH <= H)
            If GetActiveGadget() = #ChampLimite
              Rectangle(ChampX, ChampY, ChampL, ChampH, #C_Contenu)
              Cadre(ChampX, ChampY, ChampL, ChampH, #C_SaisieFocus)
            EndIf
          Case #TypeLecture
            DrawingFont(PolicePetite)
            DessinerTexte(X + Pix(3), Y + (LH - B - TextHeight("Ag")) / 2, Tronquer(EstimationTexte$(p), GrilleLargeurUtile - X - Pix(7)), #C_TexteSecondaire)
          Case #TypeBouton
            DrawingFont(PolicePetite)
            Texte$ = Tr("boutonEffacer")
            BL = Pix(8) + TextWidth(Texte$) + Pix(8) + (2 * B)
            BX = GrilleLargeurUtile - Pix(4) - BL
            DessinerTexte(X + Pix(3), Y + (LH - B - TextHeight("Ag")) / 2, Tronquer(EstimationTexte$(p), BX - X - Pix(7)), #C_TexteSecondaire)
            FY = Y + (LH - B - Pix(18)) / 2
            If PlaceEtats() > 0 And Occupe = #False
              If Survol And GrilleSurvolZone = 3
                Degrade(BX, FY, BL, Pix(18), #C_SurvolHaut, #C_SurvolBas)
                Cadre(BX, FY, BL, Pix(18), #C_SurvolBordure)
              Else
                Degrade(BX, FY, BL, Pix(18), #C_BoutonHaut, #C_BoutonBas)
                Cadre(BX, FY, BL, Pix(18), #C_BoutonBordure)
              EndIf
              DessinerTexte(BX + B + Pix(8), FY + (Pix(18) - TextHeight("Ag")) / 2, Texte$, #C_TextePrincipal)
            Else
              Degrade(BX, FY, BL, Pix(18), Melange(#C_BoutonHaut, Fond, 0.5), Melange(#C_BoutonBas, Fond, 0.5))
              Cadre(BX, FY, BL, Pix(18), Melange(#C_BoutonBordure, Fond, 0.5))
              DessinerTexte(BX + B + Pix(8), FY + (Pix(18) - TextHeight("Ag")) / 2, Texte$, Melange(#C_TextePrincipal, Fond, 0.5))
            EndIf
        EndSelect
        Y = Y + LH
        Ligne = Ligne + 1
      Next
    Next
    GrilleNbLignes = Mini(Ligne, #MaxLignesGrille + 1)

    ; barre de défilement (barre 3, la même que celles des éditeurs)
    Defil(3)\Visible = Bool(GrilleTotal > H)
    If Defil(3)\Visible
      FX = L - Pix(#LargeurDefil)
      Defil(3)\Total = GrilleTotal
      Defil(3)\Page = H
      Defil(3)\Position = GrilleDefil
      Defil(3)\OrigineX = FX
      Defil(3)\OrigineY = 0
      TracerDefil(3, FX, 0, Pix(#LargeurDefil), H)
    Else
      Defil(3)\Survol = 0
      Defil(3)\Appui = 0
    EndIf
    StopDrawing()
  EndIf

  ; Champ de la limite du forum, posé sur la grille
  If IsGadget(#ChampLimite)
    If ChampVisible And CatRepliee(#CatForum) = #False
      ; (le champ de Windows écrit son texte 2 pixels plus haut que DrawText:
      ; il est descendu d'autant pour être aligné sur les autres valeurs)
      ResizeGadget(#ChampLimite, (ChampX + Pix(4)) / Ech, (ChampY + Pix(4)) / Ech, (ChampL - Pix(6)) / Ech, (ChampH - Pix(4)) / Ech)
      If GetActiveGadget() = #ChampLimite
        Couleur = #C_Contenu
      Else
        Couleur = ChampFond
      EndIf
      If Couleur <> ChampFondActuel
        ChampFondActuel = Couleur
        SetGadgetColor(#ChampLimite, #PB_Gadget_BackColor, Couleur)
      EndIf
      DisableGadget(#ChampLimite, Occupe)
      HideGadget(#ChampLimite, #False)
    Else
      HideGadget(#ChampLimite, #True)
    EndIf
  EndIf
EndProcedure

; Ligne de la grille sous la souris (-1 si aucune)
Procedure LigneGrilleSous(Y)
  Protected i
  For i = 0 To GrilleNbLignes - 1
    If Y >= GrilleY(i) And Y < GrilleY(i) + Pix(#LigneGrille)
      ProcedureReturn i
    EndIf
  Next
  ProcedureReturn -1
EndProcedure

; Zone survolée dans une ligne: 1 flèche de liste, 2 case, 3 bouton
Procedure ZoneGrilleSous(Ligne, X, Y)
  Protected p, LH = Pix(#LigneGrille), RY, WL = GrilleLargeurLibelle, BL
  If Ligne < 0
    ProcedureReturn 0
  EndIf
  p = GrilleProp(Ligne)
  If p < 0
    ProcedureReturn 0
  EndIf
  RY = GrilleY(Ligne)
  Select ProGenre(p)
    Case #TypeListe
      If X >= WL
        ProcedureReturn 1
      EndIf
    Case #TypeCase
      If DansRect(X, Y, WL + (GrilleLargeurUtile - WL - Pix(13)) / 2 - Pix(3), RY, Pix(19), LH)
        ProcedureReturn 2
      EndIf
    Case #TypeBouton
      If StartDrawing(ImageOutput(ImageMesure))
        DrawingFont(PolicePetite)
        BL = Pix(8) + TextWidth(Tr("boutonEffacer")) + Pix(8) + (2 * Bord())
        StopDrawing()
      EndIf
      If DansRect(X, Y, GrilleLargeurUtile - Pix(4) - BL, RY + (LH - Pix(18)) / 2, BL, Pix(18))
        ProcedureReturn 3
      EndIf
  EndSelect
  ProcedureReturn 0
EndProcedure

Declare OuvrirListe(Cible, AncrageX, AncrageY, AncrageL, AncrageH, Choix$, Courant)

; Ouvre la liste d'une propriété, sous sa valeur
Procedure OuvrirListePropriete(Ligne)
  Protected p = GrilleProp(Ligne), r.RECT, X, Y, L, H
  GetWindowRect_(GadgetID(#CanvasGrille), @r)
  X = r\left + GrilleLargeurLibelle + Pix(4)
  L = GrilleLargeurUtile - GrilleLargeurLibelle - Pix(8)
  Y = r\top + GrilleY(Ligne) + Pix(2)
  H = Pix(#LigneGrille) - Pix(4)
  OuvrirListe(p, X, Y, L, H, ChoixListe(p), ValeurPropriete(p))
EndProcedure

Declare ChangerPropriete(p, Valeur)

Procedure DefilerGrille(Position)
  GrilleDefil = Position
  DessinerGrille()
EndProcedure

Procedure EvenementGrille(Type)
  Protected pt.POINT, Ligne, Zone, p, H, Max, Travers

  SourisDans(#CanvasGrille, @pt)
  H = HauteurPixels(#CanvasGrille)

  ; barre de défilement de la grille
  If Defil(3)\Visible And Type <> #PB_EventType_MouseWheel
    Travers = pt\x - Defil(3)\OrigineX
    If Defil(3)\Appui
      SourisDefil(3, Type, pt\y, Travers)    ; glissement, flèche maintenue
      ProcedureReturn
    EndIf
    If Travers >= 0
      If GrilleSurvol <> -1
        GrilleSurvol = -1
        GrilleSurvolZone = 0
        DessinerGrille()
      EndIf
      SourisDefil(3, Type, pt\y, Travers)
      ProcedureReturn
    ElseIf Defil(3)\Survol
      Defil(3)\Survol = 0                   ; la souris a quitté la barre
      DessinerGrille()
    EndIf
  EndIf

  Select Type
    Case #PB_EventType_MouseMove
      If pt\x >= GrilleLargeurUtile
        Ligne = -1
      Else
        Ligne = LigneGrilleSous(pt\y)
      EndIf
      Zone = ZoneGrilleSous(Ligne, pt\x, pt\y)
      If Ligne <> GrilleSurvol Or Zone <> GrilleSurvolZone
        GrilleSurvol = Ligne
        GrilleSurvolZone = Zone
        DessinerGrille()
      EndIf
    Case #PB_EventType_MouseLeave
      If GrilleSurvol <> -1
        GrilleSurvol = -1
        GrilleSurvolZone = 0
        DessinerGrille()
      EndIf
    Case #PB_EventType_LeftButtonDown
      FermerPopups()
      If Occupe
        ProcedureReturn
      EndIf
      Ligne = LigneGrilleSous(pt\y)
      If Ligne < 0
        ProcedureReturn
      EndIf
      p = GrilleProp(Ligne)
      If p < 0
        ; catégorie: replier ou déplier
        CatRepliee(-p - 1) = Bool(CatRepliee(-p - 1) = #False)
        DessinerGrille()
        ProcedureReturn
      EndIf
      If ProSelection <> p
        ProSelection = p
        DessinerGrille()
        DessinerDescription()
        Disposer()
      EndIf
      Zone = ZoneGrilleSous(Ligne, pt\x, pt\y)
      If ProprieteActive(p) = #False
        ProcedureReturn
      EndIf
      Select ProGenre(p)
        Case #TypeListe
          If pt\x >= GrilleLargeurLibelle
            OuvrirListePropriete(Ligne)
          EndIf
        Case #TypeCase
          If Zone = 2 Or pt\x >= GrilleLargeurLibelle
            ChangerPropriete(p, Bool(ValeurPropriete(p) = #False))
          EndIf
        Case #TypeNombre
          SetActiveGadget(#ChampLimite)
          DessinerGrille()
        Case #TypeBouton
          If Zone = 3 And PlaceEtats() > 0
            ExecuterCommande(#CmdEffacerDisque)
          EndIf
      EndSelect
    Case #PB_EventType_MouseWheel
      Max = Maxi(0, GrilleTotal - H)
      GrilleDefil = Maxi(0, Mini(Max, GrilleDefil - (GetGadgetAttribute(#CanvasGrille, #PB_Canvas_WheelDelta) * Pix(#LigneGrille) * 3)))
      DessinerGrille()
  EndSelect
EndProcedure

; ----------------------------------------------------------------------------
;  Description de la propriété choisie (en bas du panneau)
; ----------------------------------------------------------------------------
Procedure.s TexteDescription()
  Protected Texte$
  Select ProSelection
    Case #ProEstMemComp
      Texte$ = Tr("d_estMemComp")
    Case #ProEstMem
      Texte$ = Tr("d_estMem")
    Case #ProEstTaille, #ProEstComp, #ProEstDec, #ProEstReseau
      Texte$ = Tr("d_estimation")
      If ProSelection = #ProEstReseau
        CompilerIf #PB_Compiler_Backend <> #PB_Backend_C Or #PB_Compiler_Optimizer = 0
          Texte$ = Texte$ + " " + Tr("d_conseilCompilateur")
        CompilerEndIf
      EndIf
    Default
      Texte$ = Tr("d_" + ProCle$(ProSelection))
      If ProSelection = #ProFormat And ProjetCharge
        Texte$ = Tr("d_formatProjet")
      EndIf
  EndSelect
  ProcedureReturn Texte$
EndProcedure

; Hauteur nécessaire (pixels) pour une largeur donnée
Procedure HauteurDescription(Largeur)
  Protected NewList Lignes.s(), Nb, H
  If StartDrawing(ImageOutput(ImageMesure))
    DrawingFont(PolicePetite)
    Nb = CouperLignes(TexteDescription(), Largeur - Pix(16), Lignes())
    StopDrawing()
  EndIf
  H = Pix(6) + Pix(15) + Pix(2) + (Nb * Pix(16)) + Pix(8) + Bord()
  ProcedureReturn Maxi(Pix(72), H)
EndProcedure

Procedure DessinerDescription()
  Protected NewList Lignes.s(), L, H, Y, B

  If StartDrawing(CanvasOutput(#CanvasDescription))
    L = OutputWidth()
    H = OutputHeight()
    B = Bord()
    Box(0, 0, L, H, #C_Panneau)
    Rectangle(0, 0, L, B, #C_PanneauBordure)
    DrawingFont(PolicePetiteGras)
    DessinerTexte(Pix(8), B + Pix(6), Tr("p_" + ProCle$(ProSelection)), #C_TextePrincipal)
    Y = B + Pix(6) + Pix(15) + Pix(2)
    DrawingFont(PolicePetite)
    CouperLignes(TexteDescription(), L - Pix(16), Lignes())
    ForEach Lignes()
      DessinerTexte(Pix(8), Y, Lignes(), #C_TexteSecondaire)
      Y = Y + Pix(16)
    Next
    StopDrawing()
  EndIf
EndProcedure

; ----------------------------------------------------------------------------
;  Bandeau du forum (en haut de l'onglet Résultat): le résultat passe-t-il ?
; ----------------------------------------------------------------------------
Procedure DessinerBandeau()
  Protected L, H, B, X, Y, Gras$, Texte$, Fond, Bordure, Couleur, Icone, Limite

  If StartDrawing(CanvasOutput(#CanvasBandeau))
    L = OutputWidth()
    H = OutputHeight()
    B = Bord()
    Limite = Reglage\Limite
    If DerniereTailleForum = 0
      Fond = #C_Panneau : Bordure = #C_PanneauBordure : Couleur = #C_TexteSecondaire : Icone = -1
    ElseIf Limite <= 0
      Fond = #C_Panneau : Bordure = #C_PanneauBordure : Couleur = #C_TexteSecondaire : Icone = -1
      Texte$ = Tr("bandeauAucun")
    ElseIf DerniereTailleForum <= Limite
      Fond = #C_OkFond : Bordure = #C_OkBordure : Couleur = #C_OkTexte : Icone = #IcoCocheVerte
      Gras$ = Tr("bandeauOk")
      Texte$ = TrF("bandeauOkTexte", FormaterNombre(DerniereTailleForum), FormaterNombre(Limite), FormaterNombre(Limite - DerniereTailleForum))
    Else
      Fond = #C_KoFond : Bordure = #C_KoBordure : Couleur = #C_KoTexte : Icone = #IcoEffacer
      Gras$ = Tr("bandeauKo")
      Texte$ = TrF("bandeauKoTexte", FormaterNombre(DerniereTailleForum), FormaterNombre(DerniereTailleForum - Limite))
      If DernierModeBase64
        Texte$ = Texte$ + " " + Tr("bandeauConseilUnicode")
      ElseIf DernierFormat = #FormatLanceur
        Texte$ = Texte$ + " " + Tr("bandeauConseilBloc")
      EndIf
    EndIf
    Box(0, 0, L, H, Fond)
    Rectangle(0, H - B, L, B, Bordure)
    X = Pix(10)
    DrawingFont(PoliceBase)
    Y = (H - B - TextHeight("Ag")) / 2
    If Icone >= 0
      DessinerIco(Icone, X, (H - B - Pix(16)) / 2)
      X = X + Pix(16) + Pix(8)
    EndIf
    If Gras$ <> ""
      DrawingFont(PoliceBaseGras)
      X = DessinerTexte(X, Y, Gras$ + " ", Couleur)
    EndIf
    DrawingFont(PoliceBase)
    DessinerTexte(X, Y, Tronquer(Texte$, L - X - Pix(10)), Couleur)
    StopDrawing()
  EndIf
EndProcedure

; ----------------------------------------------------------------------------
;  Onglet vide: une icône et l'aide pour commencer
; ----------------------------------------------------------------------------
Procedure DessinerVide()
  Protected NewList Lignes.s(), L, H, Y, Nb, Icone, Texte$

  If IsGadget(#CanvasVide) = 0
    ProcedureReturn
  EndIf
  Select OngletActif
    Case 1
      Icone = #IcoCompresser
      Texte$ = Tr("videResultat")
    Case 2
      Icone = #IcoDoc
      Texte$ = TrF("videDecompresse", TexteRaccourci("Ctrl+V"), "F6")
    Default
      Icone = #IcoOuvrir
      Texte$ = TrF("videOrigine", TexteRaccourci("Ctrl+V"), TexteRaccourci("Ctrl+O"))
  EndSelect
  If StartDrawing(CanvasOutput(#CanvasVide))
    L = OutputWidth()
    H = OutputHeight()
    Box(0, 0, L, H, #C_Contenu)
    DrawingFont(PoliceBase)
    Nb = CouperLignes(Texte$, Mini(Pix(305), L - Pix(48)), Lignes())
    Y = (H - (Pix(32) + Pix(10) + (Nb * Pix(18)))) / 2
    DessinerIco(Icone, (L - Pix(32)) / 2, Y, 204, #True)
    Y = Y + Pix(32) + Pix(10)
    ForEach Lignes()
      DessinerTexte((L - TextWidth(Lignes())) / 2, Y + (Pix(18) - TextHeight("Ag")) / 2, Lignes(), #C_TexteSecondaire)
      Y = Y + Pix(18)
    Next
    StopDrawing()
  EndIf
EndProcedure

; ----------------------------------------------------------------------------
;  Dépôt d'un fichier: zone bleue et message (pendant le glisser-déposer)
; ----------------------------------------------------------------------------
Procedure DessinerDepot()
  Protected L, H, BL, BH, X, Y, Texte$

  If StartDrawing(CanvasOutput(#CanvasDepot))
    L = OutputWidth()
    H = OutputHeight()
    Box(0, 0, L, H, #C_DepotFond)
    Cadre(0, 0, L, H, #C_DepotBordure)
    Cadre(Bord(), Bord(), L - (2 * Bord()), H - (2 * Bord()), #C_DepotBordure)
    DrawingFont(PoliceBase)
    Texte$ = Tr("deposerIci")
    BL = Pix(16) + Pix(16) + Pix(8) + TextWidth(Texte$) + Pix(16)
    BH = Pix(10) + Pix(18) + Pix(10)
    X = (L - BL) / 2
    Y = (H - BH) / 2
    RectangleAlpha(X + Pix(2), Y + Pix(4), BL, BH, #C_Noir, 40)
    Box(X, Y, BL, BH, #C_Contenu)
    Cadre(X, Y, BL, BH, #C_PanneauBordure)
    DessinerIco(#IcoOuvrir, X + Pix(16), Y + (BH - Pix(16)) / 2)
    DessinerTexte(X + Pix(16) + Pix(16) + Pix(8), Y + (BH - TextHeight("Ag")) / 2, Texte$, #C_TextePrincipal)
    StopDrawing()
  EndIf
EndProcedure

; ============================================================================
;  INTERFACE (v7.1) - 4. Menus, menu contextuel, listes déroulantes, dialogues
;  Ce sont de petites fenêtres sans bordure, dessinées comme dans la maquette,
;  avec leur ombre. Tant qu'un menu est ouvert, il « capture » la souris: un
;  clic ailleurs le ferme, et glisser sur la barre de menus passe d'un menu à
;  l'autre, comme dans Windows.
; ============================================================================

Global PopupClavier                ; raccourcis de navigation ajoutés (menu ouvert)

Procedure ViderPopup(n)
  ClearList(Pop(n)\Elements())
EndProcedure

Procedure AjouterElement(n, Texte$, Touches$, Icone, Commande, Inactif = #False, SousMenu = 0, Valeur = 0)
  AddElement(Pop(n)\Elements())
  Pop(n)\Elements()\Texte$ = Texte$
  Pop(n)\Elements()\Raccourci$ = TexteRaccourci(Touches$)
  Pop(n)\Elements()\Icone = Icone
  Pop(n)\Elements()\Commande = Commande
  Pop(n)\Elements()\Inactif = Inactif
  Pop(n)\Elements()\SousMenu = SousMenu
  Pop(n)\Elements()\Valeur = Valeur
  Pop(n)\Elements()\Separateur = #False
EndProcedure

Procedure AjouterSeparateur(n)
  AddElement(Pop(n)\Elements())
  Pop(n)\Elements()\Separateur = #True
  Pop(n)\Elements()\Icone = -1
EndProcedure

; Contenu des menus de la barre de menus
Procedure ConstruireMenu(Numero)
  Protected Vide = OngletEstVide(OngletActif)
  ViderPopup(0)
  Pop(0)\Genre = 0
  Pop(0)\Cible = -1
  Select Numero
    Case 0
      AjouterElement(0, Tr("mOuvrir"), "Ctrl+O", #IcoOuvrir, #CmdOuvrir)
      AjouterElement(0, Tr("mOuvrirDossier"), "Ctrl+Shift+O", #IcoDossier, #CmdOuvrirDossier)
      AjouterElement(0, Tr("mEnregistrer"), "Ctrl+S", #IcoEnregistrer, #CmdEnregistrer, EnregistrementImpossible())
      AjouterElement(0, Tr("mRecreerProjet"), "", #IcoDossierRecreer, #CmdRecreerProjet, Bool(*PaquetLu = 0))
      AjouterSeparateur(0)
      AjouterElement(0, Tr("mQuitter"), "Alt+F4", -1, #CmdQuitter)
    Case 1
      AjouterElement(0, Tr("mColler"), "Ctrl+V", #IcoColler, #CmdColler)
      AjouterElement(0, Tr("mCopierSelection"), "Ctrl+C", -1, #CmdCopierSelection, Vide)
      AjouterElement(0, Tr("mCopierOnglet"), "Ctrl+Shift+C", #IcoCopier, #CmdCopierOnglet, Vide)
      AjouterSeparateur(0)
      AjouterElement(0, Tr("mToutSelectionner"), "Ctrl+A", -1, #CmdToutSelectionner, Vide)
    Case 2
      AjouterElement(0, Tr("mCompresser"), "F5", #IcoCompresser, #CmdCompresser, Bool(CodeOriginal$ = ""))
      AjouterElement(0, Tr("mDecompresser"), "F6", #IcoDecompresser, #CmdDecompresser)
      AjouterSeparateur(0)
      AjouterElement(0, Tr("mNiveau"), "", -1, 0, Bool(NiveauActif() = #False), 1)
    Case 3
      AjouterElement(0, Tr("mLangue"), "", #IcoGlobe, 0, #False, 2)
      AjouterElement(0, Tr("mEffacerSortie"), "", -1, #CmdEffacerSortie)
      AjouterSeparateur(0)
      AjouterElement(0, Tr("mEffacerDisque"), "", #IcoEffacer, #CmdEffacerDisque, Bool(PlaceEtats() <= 0))
    Default
      AjouterElement(0, Tr("mAide"), "F1", #IcoAide, #CmdAide)
      AjouterElement(0, Tr("mCredits"), "", -1, #CmdCredits)
      AjouterSeparateur(0)
      AjouterElement(0, Tr("mAPropos"), "", #IcoInfo, #CmdAPropos)
  EndSelect
EndProcedure

Procedure ConstruireSousMenu(Numero)
  Protected i, Icone
  ViderPopup(1)
  Pop(1)\Genre = 0
  Pop(1)\Cible = -1
  If Numero = 1
    For i = 1 To 3
      Icone = -1
      If Reglage\Niveau = i
        Icone = #IcoPoint
      EndIf
      AjouterElement(1, NomNiveauListe(i), "", Icone, #CmdNiveau1 + i - 1)
    Next
  Else
    For i = 0 To 2
      Icone = -1
      If Langue = i
        Icone = #IcoCoche
      EndIf
      Select i
        Case 0
          AjouterElement(1, "Français", "", Icone, #CmdLangueFr)
        Case 1
          AjouterElement(1, "English", "", Icone, #CmdLangueEn)
        Default
          AjouterElement(1, "Deutsch", "", Icone, #CmdLangueDe)
      EndSelect
    Next
  EndIf
EndProcedure

; Menu contextuel d'un éditeur (PourSortie: celui de la sortie, en bas)
Procedure ConstruireContexte(PourSortie)
  Protected Vide = OngletEstVide(OngletActif)
  ViderPopup(0)
  Pop(0)\Genre = 1
  Pop(0)\Cible = -1
  If PourSortie
    AjouterElement(0, Tr("mCopierSelection"), "Ctrl+C", -1, #CmdCopierSelection)
    AjouterElement(0, Tr("mToutSelectionner"), "Ctrl+A", -1, #CmdToutSelectionner)
    AjouterSeparateur(0)
    AjouterElement(0, Tr("mEffacerSortie"), "", -1, #CmdEffacerSortie)
    ProcedureReturn
  EndIf
  AjouterElement(0, Tr("mCopierSelection"), "Ctrl+C", -1, #CmdCopierSelection, Vide)
  AjouterElement(0, Tr("mColler"), "Ctrl+V", #IcoColler, #CmdColler)
  AjouterElement(0, Tr("mToutSelectionner"), "Ctrl+A", -1, #CmdToutSelectionner, Vide)
  AjouterSeparateur(0)
  AjouterElement(0, Tr("mCopierOnglet"), "Ctrl+Shift+C", #IcoCopier, #CmdCopierOnglet, Vide)
  AjouterSeparateur(0)
  AjouterElement(0, Tr("mCompresser"), "F5", #IcoCompresser, #CmdCompresser, Bool(CodeOriginal$ = ""))
  AjouterElement(0, Tr("mDecompresser"), "F6", #IcoDecompresser, #CmdDecompresser)
EndProcedure

; ----------------------------------------------------------------------------
;  Mesure et dessin d'un menu
; ----------------------------------------------------------------------------
Procedure MesurerPopup(n, LargeurMin)
  Protected L, Y, LT, B = Bord(), AvecFleche

  If StartDrawing(ImageOutput(ImageMesure))
    L = LargeurMin
    Y = B + Pix(2)
    ForEach Pop(n)\Elements()
      If Pop(n)\Elements()\Separateur
        Pop(n)\Elements()\Y = Y
        Pop(n)\Elements()\H = Pix(7)
      Else
        If Pop(n)\Genre = 2 And Pop(n)\Elements()\Valeur = Pop(n)\Courant
          DrawingFont(PolicePetiteGras)
        Else
          DrawingFont(PolicePetite)
        EndIf
        LT = B + Pix(8) + Pix(16) + Pix(8) + TextWidth(Pop(n)\Elements()\Texte$)
        If Pop(n)\Elements()\Raccourci$ <> ""
          DrawingFont(PoliceMini)
          LT = LT + Pix(8) + Pix(20) + TextWidth(Pop(n)\Elements()\Raccourci$)
        EndIf
        If Pop(n)\Elements()\SousMenu
          LT = LT + Pix(8) + Pix(6)
        EndIf
        If Pop(n)\Genre = 2
          LT = LT + Pix(16) + B
        Else
          LT = LT + Pix(28) + B
        EndIf
        L = Maxi(L, LT)
        Pop(n)\Elements()\Y = Y
        Pop(n)\Elements()\H = Pix(#LigneMenu)
      EndIf
      Y = Y + Pop(n)\Elements()\H
    Next
    StopDrawing()
  EndIf
  Pop(n)\L = L
  Pop(n)\H = Y + Pix(2) + B
EndProcedure

Procedure DessinerPopup(n)
  Protected Canvas, L, H, B, i, X, Couleur, Droite, Y

  If n = 0
    Canvas = #CanvasPopup0
  Else
    Canvas = #CanvasPopup1
  EndIf
  If StartDrawing(CanvasOutput(Canvas))
    L = OutputWidth()
    H = OutputHeight()
    B = Bord()
    Box(0, 0, L, H, #C_Contenu)
    Cadre(0, 0, L, H, #C_PanneauBordure)
    i = 0
    ForEach Pop(n)\Elements()
      Y = Pop(n)\Elements()\Y
      If Pop(n)\Elements()\Separateur
        Rectangle(B + Pix(4), Y + Pix(3), L - (2 * B) - Pix(8), B, #C_PanneauBordure)
      Else
        If i = Pop(n)\Survol And Pop(n)\Elements()\Inactif = #False
          FondSurvol(B + Pix(2), Y + Pix(1), L - (2 * B) - Pix(4), Pop(n)\Elements()\H - Pix(2))
        EndIf
        If Pop(n)\Elements()\Inactif
          Couleur = #C_TexteGris
        Else
          Couleur = #C_TextePrincipal
        EndIf
        If Pop(n)\Elements()\Icone >= 0
          If Pop(n)\Elements()\Inactif
            DessinerIco(Pop(n)\Elements()\Icone, B + Pix(8), Y + (Pop(n)\Elements()\H - Pix(16)) / 2, 102)
          Else
            DessinerIco(Pop(n)\Elements()\Icone, B + Pix(8), Y + (Pop(n)\Elements()\H - Pix(16)) / 2)
          EndIf
        EndIf
        If Pop(n)\Genre = 2 And Pop(n)\Elements()\Valeur = Pop(n)\Courant
          DrawingFont(PolicePetiteGras)
        Else
          DrawingFont(PolicePetite)
        EndIf
        DessinerTexte(B + Pix(32), Y + (Pop(n)\Elements()\H - TextHeight("Ag")) / 2, Pop(n)\Elements()\Texte$, Couleur)
        If Pop(n)\Genre = 2
          Droite = L - B - Pix(16)
        Else
          Droite = L - B - Pix(28)
        EndIf
        If Pop(n)\Elements()\SousMenu
          DessinerIco(#IcoTriangleDroiteGris, Droite - Pix(11), Y + (Pop(n)\Elements()\H - Pix(16)) / 2)
          Droite = Droite - Pix(6) - Pix(8)
        EndIf
        If Pop(n)\Elements()\Raccourci$ <> ""
          DrawingFont(PoliceMini)
          DessinerTexte(Droite - TextWidth(Pop(n)\Elements()\Raccourci$), Y + (Pop(n)\Elements()\H - TextHeight("Ag")) / 2, Pop(n)\Elements()\Raccourci$, #C_TexteGris)
        EndIf
      EndIf
      i = i + 1
    Next
    StopDrawing()
  EndIf
EndProcedure

; Zone de travail de l'écran où est la fenêtre (pour que le menu n'en sorte pas)
Structure InfoEcran
  cbSize.l
  rcMonitor.RECT
  rcWork.RECT
  dwFlags.l
EndStructure
Prototype.i ProtoMonitorFromWindow(hWnd, dwFlags)
Prototype.i ProtoGetMonitorInfo(hMonitor, *Info)

Procedure ZoneEcran(*Zone.RECT)
  Protected MonitorFromWindow.ProtoMonitorFromWindow, GetMonitorInfo.ProtoGetMonitorInfo, Ecran, Info.InfoEcran
  *Zone\left = 0
  *Zone\top = 0
  *Zone\right = GetSystemMetrics_(0)
  *Zone\bottom = GetSystemMetrics_(1)
  If BibliothequeUser32
    MonitorFromWindow = GetFunction(BibliothequeUser32, "MonitorFromWindow")
    GetMonitorInfo = GetFunction(BibliothequeUser32, "GetMonitorInfoW")
    If MonitorFromWindow And GetMonitorInfo
      Ecran = MonitorFromWindow(WindowID(#FenetrePrincipale), 2)
      Info\cbSize = SizeOf(InfoEcran)
      If Ecran And GetMonitorInfo(Ecran, @Info)
        CopyMemory(@Info\rcWork, *Zone, SizeOf(RECT))
      EndIf
    EndIf
  EndIf
EndProcedure

; Ouvre le popup n à la position X, Y de l'écran (pixels). Si le bas ou la
; droite de l'écran est atteint, il s'ouvre au-dessus ou à gauche (Haut et
; Gauche: autre position possible).
Procedure AfficherPopup(n, X, Y, AutreY, AutreX)
  Protected Fenetre, Canvas, Ombre, Zone.RECT

  If n = 0
    Fenetre = #FenetrePopup0 : Canvas = #CanvasPopup0 : Ombre = #FenetreOmbre0
  Else
    Fenetre = #FenetrePopup1 : Canvas = #CanvasPopup1 : Ombre = #FenetreOmbre1
  EndIf
  ZoneEcran(@Zone)
  If Y + Pop(n)\H > Zone\bottom
    Y = Maxi(Zone\top, AutreY - Pop(n)\H)
  EndIf
  If X + Pop(n)\L > Zone\right
    X = Maxi(Zone\left, AutreX - Pop(n)\L)
  EndIf
  ResizeWindow(Fenetre, #PB_Ignore, #PB_Ignore, Logique(Pop(n)\L), Logique(Pop(n)\H))
  ResizeGadget(Canvas, 0, 0, Logique(Pop(n)\L), Logique(Pop(n)\H))
  SetWindowPos_(WindowID(Fenetre), 0, X, Y, 0, 0, #W_SWP_NOSIZE | #W_SWP_NOZORDER | #W_SWP_NOACTIVATE)
  Pop(n)\X = X
  Pop(n)\Y = Y
  Pop(n)\Survol = -1
  Pop(n)\Ouvert = #True
  DessinerPopup(n)
  ShowWindow_(WindowID(Fenetre), #W_SW_SHOWNOACTIVATE)
  SetWindowPos_(WindowID(Fenetre), 0, 0, 0, 0, 0, #W_SWP_NOMOVE | #W_SWP_NOSIZE | #W_SWP_NOACTIVATE)
  MontrerOmbre(Ombre, Fenetre, 0)
EndProcedure

Procedure AjouterRaccourcisMenu()
  If PopupClavier = #False
    AddKeyboardShortcut(#FenetrePrincipale, #PB_Shortcut_Up, #CmdMenuHaut)
    AddKeyboardShortcut(#FenetrePrincipale, #PB_Shortcut_Down, #CmdMenuBas)
    AddKeyboardShortcut(#FenetrePrincipale, #PB_Shortcut_Left, #CmdMenuGauche)
    AddKeyboardShortcut(#FenetrePrincipale, #PB_Shortcut_Right, #CmdMenuDroite)
    AddKeyboardShortcut(#FenetrePrincipale, #PB_Shortcut_Return, #CmdMenuEntree)
    AddKeyboardShortcut(#FenetrePrincipale, #PB_Shortcut_Escape, #CmdMenuEchap)
    PopupClavier = #True
  EndIf
EndProcedure

Procedure RetirerRaccourcisMenu()
  If PopupClavier
    RemoveKeyboardShortcut(#FenetrePrincipale, #PB_Shortcut_Up)
    RemoveKeyboardShortcut(#FenetrePrincipale, #PB_Shortcut_Down)
    RemoveKeyboardShortcut(#FenetrePrincipale, #PB_Shortcut_Left)
    RemoveKeyboardShortcut(#FenetrePrincipale, #PB_Shortcut_Right)
    RemoveKeyboardShortcut(#FenetrePrincipale, #PB_Shortcut_Return)
    RemoveKeyboardShortcut(#FenetrePrincipale, #PB_Shortcut_Escape)
    PopupClavier = #False
  EndIf
EndProcedure

Procedure FermerSousMenu()
  If Pop(1)\Ouvert
    Pop(1)\Ouvert = #False
    HideWindow(#FenetrePopup1, #True)
    CacherOmbre(#FenetreOmbre1)
  EndIf
EndProcedure

Procedure FermerPopups()
  Protected Toolbar
  FermerSousMenu()
  If Pop(0)\Ouvert
    Toolbar = Bool(Pop(0)\Cible = -2)
    Pop(0)\Ouvert = #False
    Pop(0)\Cible = -1
    HideWindow(#FenetrePopup0, #True)
    CacherOmbre(#FenetreOmbre0)
    ReleaseCapture_()
    RetirerRaccourcisMenu()
    If MenuOuvert >= 0
      MenuOuvert = -1
      DessinerMenus()
    EndIf
    If Toolbar
      DessinerOutils()
    EndIf
  EndIf
EndProcedure

; Ouvre le menu Numero de la barre de menus
Procedure OuvrirMenu(Numero)
  Protected r.RECT
  FermerPopups()
  ConstruireMenu(Numero)
  MesurerPopup(0, Pix(220))
  MenuOuvert = Numero
  MenuSurvol = Numero
  DessinerMenus()
  GetWindowRect_(GadgetID(#CanvasMenus), @r)
  AfficherPopup(0, r\left + MenuX(Numero), r\top + Pix(24), r\top, r\left + MenuX(Numero) + MenuL(Numero))
  SetCapture_(GadgetID(#CanvasPopup0))
  AjouterRaccourcisMenu()
EndProcedure

; Ouvre un menu au clavier (Alt + lettre): son premier élément est choisi
Declare ElementVoisin(n, Depart, Sens)

Procedure OuvrirMenuClavier(Numero)
  OuvrirMenu(Numero)
  Pop(0)\Survol = ElementVoisin(0, -1, 1)
  DessinerPopup(0)
EndProcedure

; Ouvre le sous-menu de l'élément i du menu (1 niveaux, 2 langues)
Procedure OuvrirSousMenu(i)
  Protected Numero, Y
  If SelectElement(Pop(0)\Elements(), i) = 0
    ProcedureReturn
  EndIf
  Numero = Pop(0)\Elements()\SousMenu
  Y = Pop(0)\Elements()\Y
  FermerSousMenu()
  ConstruireSousMenu(Numero)
  MesurerPopup(1, Pix(190))
  AfficherPopup(1, Pop(0)\X + Pop(0)\L - Bord(), Pop(0)\Y + Y - Pix(3), Pop(0)\Y + Y + Pix(#LigneMenu) + Pix(3), Pop(0)\X + Bord())
  Pop(1)\Ouvert = #True
EndProcedure

Procedure OuvrirContexte(X, Y, PourSortie)
  FermerPopups()
  ConstruireContexte(PourSortie)
  MesurerPopup(0, Pix(200))
  AfficherPopup(0, X, Y, Y, X)
  SetCapture_(GadgetID(#CanvasPopup0))
  AjouterRaccourcisMenu()
EndProcedure

; Liste déroulante (grille de propriétés: Cible = propriété ; barre d'outils:
; Cible = -2), sous le rectangle d'ancrage (pixels de l'écran)
Procedure OuvrirListe(Cible, AncrageX, AncrageY, AncrageL, AncrageH, Choix$, Courant)
  Protected i, Ligne$, Icone
  FermerPopups()
  ViderPopup(0)
  Pop(0)\Genre = 2
  Pop(0)\Courant = Courant
  For i = 1 To CountString(Choix$, Chr(10)) + 1
    Ligne$ = StringField(Choix$, i, Chr(10))
    Icone = -1
    If Val(StringField(Ligne$, 1, Chr(9))) = Courant
      Icone = #IcoCoche
    EndIf
    AjouterElement(0, StringField(Ligne$, 2, Chr(9)), "", Icone, 0, #False, 0, Val(StringField(Ligne$, 1, Chr(9))))
  Next
  MesurerPopup(0, Maxi(Pix(160), AncrageL))
  Pop(0)\Cible = Cible
  AfficherPopup(0, AncrageX, AncrageY + AncrageH + Bord(), AncrageY - Bord(), AncrageX + AncrageL)
  Pop(0)\Cible = Cible
  SetCapture_(GadgetID(#CanvasPopup0))
  AjouterRaccourcisMenu()
  If Cible = -2
    DessinerOutils()
  EndIf
EndProcedure

; Élément du popup n sous le point (pixels de l'écran), -1 sinon
Procedure ElementSous(n, X, Y)
  Protected i
  If Pop(n)\Ouvert = #False Or DansRect(X, Y, Pop(n)\X, Pop(n)\Y, Pop(n)\L, Pop(n)\H) = #False
    ProcedureReturn -2
  EndIf
  i = 0
  ForEach Pop(n)\Elements()
    If Y - Pop(n)\Y >= Pop(n)\Elements()\Y And Y - Pop(n)\Y < Pop(n)\Elements()\Y + Pop(n)\Elements()\H
      If Pop(n)\Elements()\Separateur
        ProcedureReturn -1
      EndIf
      ProcedureReturn i
    EndIf
    i = i + 1
  Next
  ProcedureReturn -1
EndProcedure

; Exécute l'élément i du popup n (clic ou touche Entrée)
Procedure ActiverElement(n, i)
  Protected Commande, Valeur, Cible, SousMenu
  If i < 0 Or SelectElement(Pop(n)\Elements(), i) = 0
    ProcedureReturn
  EndIf
  If Pop(n)\Elements()\Inactif Or Pop(n)\Elements()\Separateur
    ProcedureReturn
  EndIf
  SousMenu = Pop(n)\Elements()\SousMenu
  If SousMenu
    If n = 0
      OuvrirSousMenu(i)
    EndIf
    ProcedureReturn
  EndIf
  Commande = Pop(n)\Elements()\Commande
  Valeur = Pop(n)\Elements()\Valeur
  Cible = Pop(0)\Cible
  If Pop(0)\Genre = 2
    FermerPopups()
    ChoisirDansListe(Cible, Valeur)
  Else
    FermerPopups()
    If Commande
      ExecuterCommande(Commande)
    EndIf
  EndIf
EndProcedure

Procedure EvenementPopup(Type)
  Protected p.POINT, n, i, rm.RECT, Survol0, Survol1, Menu

  GetCursorPos_(@p)
  i = ElementSous(1, p\x, p\y)
  If i <> -2
    n = 1
  Else
    i = ElementSous(0, p\x, p\y)
    If i <> -2
      n = 0
    Else
      n = -1
    EndIf
  EndIf
  Survol0 = Pop(0)\Survol
  Survol1 = Pop(1)\Survol

  Select Type
    Case #PB_EventType_MouseMove
      If n = 0
        Pop(0)\Survol = i
        If i >= 0
          SelectElement(Pop(0)\Elements(), i)
          If Pop(0)\Elements()\SousMenu And Pop(0)\Elements()\Inactif = #False
            If Pop(1)\Ouvert = #False Or Survol0 <> i
              OuvrirSousMenu(i)
            EndIf
          Else
            FermerSousMenu()
          EndIf
        EndIf
      ElseIf n = 1
        Pop(1)\Survol = i
      Else
        If Pop(1)\Ouvert = #False
          Pop(0)\Survol = -1
        EndIf
        Pop(1)\Survol = -1
        ; glisser sur la barre de menus: passer à un autre menu
        If MenuOuvert >= 0
          GetWindowRect_(GadgetID(#CanvasMenus), @rm)
          Menu = MenuSous(p\x - rm\left, p\y - rm\top)
          If Menu >= 0 And Menu <> MenuOuvert
            OuvrirMenu(Menu)
            ProcedureReturn
          EndIf
        EndIf
      EndIf
      If Pop(0)\Survol <> Survol0 And Pop(0)\Ouvert
        DessinerPopup(0)
      EndIf
      If Pop(1)\Survol <> Survol1 And Pop(1)\Ouvert
        DessinerPopup(1)
      EndIf
    Case #PB_EventType_LeftButtonDown, #PB_EventType_RightButtonDown
      If n = -1
        ; clic hors du menu: il se ferme (un clic sur son titre aussi)
        If MenuOuvert >= 0
          GetWindowRect_(GadgetID(#CanvasMenus), @rm)
          Menu = MenuSous(p\x - rm\left, p\y - rm\top)
          If Menu >= 0 And Menu <> MenuOuvert
            OuvrirMenu(Menu)
            ProcedureReturn
          EndIf
        EndIf
        FermerPopups()
      EndIf
    Case #PB_EventType_LeftButtonUp, #PB_EventType_RightButtonUp
      If n >= 0 And i >= 0
        ActiverElement(n, i)
      EndIf
      ; le canevas relâche la souris après un clic: le menu la reprend
      If Pop(0)\Ouvert
        SetCapture_(GadgetID(#CanvasPopup0))
      EndIf
  EndSelect
EndProcedure

; Élément suivant (Sens = 1) ou précédent (Sens = -1) qu'on peut choisir
Procedure ElementVoisin(n, Depart, Sens)
  Protected Nb = ListSize(Pop(n)\Elements()), k, i
  If Nb = 0
    ProcedureReturn -1
  EndIf
  i = Depart
  For k = 1 To Nb
    i = i + Sens
    If i >= Nb
      i = 0
    ElseIf i < 0
      i = Nb - 1
    EndIf
    SelectElement(Pop(n)\Elements(), i)
    If Pop(n)\Elements()\Separateur = #False And Pop(n)\Elements()\Inactif = #False
      ProcedureReturn i
    EndIf
  Next
  ProcedureReturn -1
EndProcedure

; Navigation au clavier dans un menu ouvert
Procedure ClavierPopup(Commande)
  Protected n = 0, i
  If Pop(1)\Ouvert And Pop(1)\Survol >= 0
    n = 1
  EndIf
  Select Commande
    Case #CmdMenuHaut, #CmdMenuBas
      If Commande = #CmdMenuHaut
        i = ElementVoisin(n, Pop(n)\Survol, -1)
      Else
        i = ElementVoisin(n, Pop(n)\Survol, 1)
      EndIf
      Pop(n)\Survol = i
      DessinerPopup(n)
    Case #CmdMenuDroite
      If n = 0 And Pop(0)\Survol >= 0
        SelectElement(Pop(0)\Elements(), Pop(0)\Survol)
        If Pop(0)\Elements()\SousMenu And Pop(0)\Elements()\Inactif = #False
          OuvrirSousMenu(Pop(0)\Survol)
          Pop(1)\Survol = ElementVoisin(1, -1, 1)
          DessinerPopup(1)
          ProcedureReturn
        EndIf
      EndIf
      If MenuOuvert >= 0
        OuvrirMenu((MenuOuvert + 1) % #NbMenus)
        Pop(0)\Survol = ElementVoisin(0, -1, 1)
        DessinerPopup(0)
      EndIf
    Case #CmdMenuGauche
      If n = 1
        FermerSousMenu()
        DessinerPopup(0)
      ElseIf MenuOuvert >= 0
        OuvrirMenu((MenuOuvert + #NbMenus - 1) % #NbMenus)
        Pop(0)\Survol = ElementVoisin(0, -1, 1)
        DessinerPopup(0)
      EndIf
    Case #CmdMenuEntree
      ActiverElement(n, Pop(n)\Survol)
      If n = 0 And Pop(1)\Ouvert
        Pop(1)\Survol = ElementVoisin(1, -1, 1)
        DessinerPopup(1)
      EndIf
    Case #CmdMenuEchap
      If Pop(1)\Ouvert
        FermerSousMenu()
        DessinerPopup(0)
      Else
        FermerPopups()
      EndIf
  EndSelect
EndProcedure

Procedure CreerFenetresPopups()
  Protected i, Fenetre, Canvas
  For i = 0 To 1
    If i = 0
      Fenetre = #FenetrePopup0 : Canvas = #CanvasPopup0
    Else
      Fenetre = #FenetrePopup1 : Canvas = #CanvasPopup1
    EndIf
    If OpenWindow(Fenetre, 0, 0, 100, 100, "", #PB_Window_BorderLess | #PB_Window_Invisible, WindowID(#FenetrePrincipale))
      SetWindowLongPtr_(WindowID(Fenetre), #W_GWL_EXSTYLE, GetWindowLongPtr_(WindowID(Fenetre), #W_GWL_EXSTYLE) | #W_WS_EX_NOACTIVATE | #W_WS_EX_TOOLWINDOW)
      CanvasGadget(Canvas, 0, 0, 100, 100)
    EndIf
    Pop(i)\Survol = -1
    Pop(i)\Cible = -1
  Next
  CreerFenetreOmbre(#FenetreOmbre0)
  CreerFenetreOmbre(#FenetreOmbre1)
  CreerFenetreOmbre(#FenetreOmbreDialogue)
  ; voile sombre derrière les dialogues (rgba(20, 35, 60, 0.28))
  If OpenWindow(#FenetreVoile, 0, 0, 100, 100, "", #PB_Window_BorderLess | #PB_Window_Invisible, WindowID(#FenetrePrincipale))
    SetWindowColor(#FenetreVoile, #C_Voile)
    ; WS_EX_TRANSPARENT: les clics traversent le voile et arrivent à la fenêtre
    ; principale (désactivée), et Windows ramène alors le dialogue devant. Sans
    ; lui, un clic sur le voile le faisait passer devant le dialogue: tout
    ; restait grisé et plus rien ne répondait.
    SetWindowLongPtr_(WindowID(#FenetreVoile), #W_GWL_EXSTYLE, GetWindowLongPtr_(WindowID(#FenetreVoile), #W_GWL_EXSTYLE) | #W_WS_EX_LAYERED | #W_WS_EX_TRANSPARENT | #W_WS_EX_NOACTIVATE | #W_WS_EX_TOOLWINDOW)
    If SetLayeredWindowAttributes
      SetLayeredWindowAttributes(WindowID(#FenetreVoile), 0, 71, #W_LWA_ALPHA)
    EndIf
  EndIf
  UseGadgetList(WindowID(#FenetrePrincipale))
EndProcedure

; ----------------------------------------------------------------------------
;  Dialogues (À propos, messages, questions), dans le cadre des fenêtres
;  flottantes de la maquette: en-tête bleu, contenu blanc, boutons en bas.
;  Corps$: une ligne par paragraphe ; « #T » titre, « #M » texte discret,
;  « #C » adresse ou code, « #1 » élément d'une liste numérotée.
; ----------------------------------------------------------------------------
Global DlgTitre$, DlgCorps$, DlgGenre
Global Dim DlgBouton$(3)
Global DlgNbBoutons, DlgFocus, DlgSurvol = -1, DlgAppui = -1, DlgFermerSurvol
Global Dim DlgBoutonX(3)
Global DlgBoutonY, DlgBoutonL, DlgBoutonH
Global DlgResultat, DlgFini

; Hauteur du contenu, ou dessin (Dessiner = #True) à partir de Y0
Procedure CorpsDialogue(L, Y0, Dessiner)
  Protected NewList Lignes.s(), i, Ligne$, Genre$, Y, X, Largeur, Numero, Nb, LH, Premier = #True, Couleur, Police

  X = Pix(16)
  If DlgGenre <> #DlgSimple
    X = Pix(16) + Pix(32) + Pix(12)
    If Dessiner
      Select DlgGenre
        Case #DlgInfo
          DessinerIco(#IcoInfo, Pix(16), Y0 + Pix(14), 255, #True)
        Case #DlgQuestion
          DessinerIco(#IcoAide, Pix(16), Y0 + Pix(14), 255, #True)
        Case #DlgAttention
          DessinerIco(#IcoAttention, Pix(16), Y0 + Pix(14), 255, #True)
        Case #DlgErreur
          DessinerIco(#IcoErreur, Pix(16), Y0 + Pix(14), 255, #True)
      EndSelect
    EndIf
  EndIf
  Largeur = L - X - Pix(16)
  Y = Y0 + Pix(14)
  For i = 1 To CountString(DlgCorps$, #LF$) + 1
    Ligne$ = StringField(DlgCorps$, i, #LF$)
    Genre$ = Left(Ligne$, 3)
    If Genre$ = "#T " Or Genre$ = "#M " Or Genre$ = "#C " Or Genre$ = "#1 "
      Ligne$ = Mid(Ligne$, 4)
    Else
      Genre$ = ""
    EndIf
    If Ligne$ = ""
      Continue
    EndIf
    If Premier = #False
      Y = Y + Pix(8)
    EndIf
    Premier = #False
    Couleur = #C_TextePrincipal
    Select Genre$
      Case "#T "
        Police = PoliceGrandTitre : LH = Pix(23)
      Case "#M "
        Police = PolicePetite : LH = Pix(17) : Couleur = #C_TexteSecondaire
      Case "#C "
        Police = PoliceCode : LH = Pix(19)
      Default
        Police = PoliceBase : LH = Pix(19)
    EndSelect
    DrawingFont(Police)
    If Genre$ = "#1 "
      Numero = Numero + 1
      If Dessiner
        DessinerTexte(X, Y + (LH - TextHeight("Ag")) / 2, Str(Numero) + ".", Couleur)
      EndIf
      Nb = CouperLignes(Ligne$, Largeur - Pix(18), Lignes())
      ForEach Lignes()
        If Dessiner
          DessinerTexte(X + Pix(18), Y + (LH - TextHeight("Ag")) / 2, Lignes(), Couleur)
        EndIf
        Y = Y + LH
      Next
      Y = Y - Pix(4)
    Else
      Nb = CouperLignes(Ligne$, Largeur, Lignes())
      ForEach Lignes()
        If Dessiner
          DessinerTexte(X, Y + (LH - TextHeight("Ag")) / 2, Lignes(), Couleur)
        EndIf
        Y = Y + LH
      Next
    EndIf
  Next
  Y = Y + Pix(14)
  If DlgGenre <> #DlgSimple
    Y = Maxi(Y, Y0 + Pix(14) + Pix(32) + Pix(14))
  EndIf
  ProcedureReturn Y - Y0
EndProcedure

Procedure DessinerDialogue()
  Protected L, H, B, Y, i, X, Corps, Bordure

  If StartDrawing(CanvasOutput(#CanvasDialogue))
    L = OutputWidth()
    H = OutputHeight()
    B = Bord()
    Box(0, 0, L, H, #C_Contenu)
    ; en-tête (comme celui des fenêtres flottantes de la maquette)
    Degrade(B, B, L - (2 * B), Pix(22), #C_TitreHaut, #C_TitreBas)
    Rectangle(B, B + Pix(22) - B, L - (2 * B), B, #C_TitreBordure)
    DrawingFont(PolicePetiteGras)
    DrawingMode(#PB_2DDrawing_AlphaBlend | #PB_2DDrawing_Transparent)
    DrawText(B + Pix(8), B + (Pix(22) - TextHeight("Ag")) / 2 + Pix(1), DlgTitre$, RGBA(0, 0, 0, 77))
    DessinerTexte(B + Pix(8), B + (Pix(22) - TextHeight("Ag")) / 2, DlgTitre$, #C_Blanc)
    X = L - B - Pix(8) - Pix(18)
    If DlgFermerSurvol
      RectangleAlpha(X, B + Pix(2), Pix(18), Pix(18), #C_Blanc, 38)
      CadreAlpha(X, B + Pix(2), Pix(18), Pix(18), #C_Blanc, 77)
    EndIf
    DessinerIco(#IcoFenFermer, X + (Pix(18) - Pix(16)) / 2, B + Pix(2) + (Pix(18) - Pix(16)) / 2, 230)

    ; contenu
    Corps = CorpsDialogue(L, B + Pix(22), #True)

    ; pied: boutons à droite
    Y = B + Pix(22) + Corps
    Rectangle(B, Y, L - (2 * B), H - Y - B, #C_Panneau)
    Rectangle(B, Y, L - (2 * B), B, #C_PanneauBordure)
    DrawingFont(PoliceBase)
    DlgBoutonY = Y + B + Pix(8)
    DlgBoutonH = Pix(23)
    X = L - B - Pix(10)
    For i = DlgNbBoutons - 1 To 0 Step -1
      DlgBoutonL = Maxi(Pix(75), Pix(16) + TextWidth(DlgBouton$(i)) + Pix(16))
      X = X - DlgBoutonL
      DlgBoutonX(i) = X
      If DlgAppui = i And DlgSurvol = i
        Bordure = #C_ActifBordure
        Degrade(X, DlgBoutonY, DlgBoutonL, DlgBoutonH, #C_ActifHaut, #C_ActifBas)
      ElseIf DlgSurvol = i
        Degrade(X, DlgBoutonY, DlgBoutonL, DlgBoutonH, #C_SurvolHaut, #C_SurvolBas)
        Bordure = #C_SurvolBordure
      Else
        Degrade(X, DlgBoutonY, DlgBoutonL, DlgBoutonH, #C_BoutonHaut, #C_BoutonBas)
        Bordure = #C_BoutonBordure
      EndIf
      Cadre(X, DlgBoutonY, DlgBoutonL, DlgBoutonH, Bordure)
      DessinerTexte(X + (DlgBoutonL - TextWidth(DlgBouton$(i))) / 2, DlgBoutonY + (DlgBoutonH - TextHeight("Ag")) / 2, DlgBouton$(i), #C_TextePrincipal)
      If DlgFocus = i
        CadrePointille(X + Pix(3), DlgBoutonY + Pix(3), DlgBoutonL - Pix(6), DlgBoutonH - Pix(6), #C_TextePrincipal)
      EndIf
      X = X - Pix(6)
    Next
    ; cadre de la fenêtre
    Cadre(0, 0, L, H, #C_FlottantBordure)
    StopDrawing()
  EndIf
EndProcedure

Procedure BoutonDialogueSous(X, Y)
  Protected i
  For i = 0 To DlgNbBoutons - 1
    If DansRect(X, Y, DlgBoutonX(i), DlgBoutonY, DlgBoutonL, DlgBoutonH)
      ProcedureReturn i
    EndIf
  Next
  ProcedureReturn -1
EndProcedure

; L'ombre du dialogue le suit quand on le déplace
Procedure RappelDialogue(hWnd, uMsg, wParam, lParam)
  Protected r.RECT
  If uMsg = $3 And IsWindow(#FenetreOmbreDialogue)      ; WM_MOVE
    GetWindowRect_(hWnd, @r)
    SetWindowPos_(WindowID(#FenetreOmbreDialogue), hWnd, r\left - Pix(22), r\top - Pix(22), 0, 0, #W_SWP_NOSIZE | #W_SWP_NOACTIVATE)
  EndIf
  ProcedureReturn #PB_ProcessPureBasicEvents
EndProcedure

; Montre un dialogue et attend un bouton. Boutons$: textes séparés par Chr(10)
; (le premier est le bouton par défaut, le dernier celui d'Échap).
; Renvoie le numéro du bouton (0 = premier).
Procedure Dialogue(Genre, Titre$, Corps$, Boutons$)
  Protected L, H, Corps, i, Evenement, p.POINT, Bouton, rp.RECT, X, Y, Fermer

  FermerPopups()
  DlgGenre = Genre
  DlgTitre$ = Titre$
  DlgCorps$ = Corps$
  DlgNbBoutons = Mini(CountString(Boutons$, Chr(10)) + 1, 4)
  For i = 0 To DlgNbBoutons - 1
    DlgBouton$(i) = StringField(Boutons$, i + 1, Chr(10))
  Next
  DlgFocus = 0
  DlgSurvol = -1
  DlgAppui = -1
  DlgFermerSurvol = #False
  DlgFini = #False
  DlgResultat = DlgNbBoutons - 1

  ; taille
  L = Pix(#LargeurDialogue)
  If StartDrawing(ImageOutput(ImageMesure))
    Corps = CorpsDialogue(L, 0, #False)
    StopDrawing()
  EndIf
  H = Bord() + Pix(22) + Corps + Bord() + Pix(8) + Pix(23) + Pix(8) + Bord()

  ; fenêtre, centrée sur la fenêtre principale
  If OpenWindow(#FenetreDialogue, 0, 0, Logique(L), Logique(H), Titre$, #PB_Window_BorderLess | #PB_Window_Invisible, WindowID(#FenetrePrincipale)) = 0
    ProcedureReturn DlgResultat
  EndIf
  CanvasGadget(#CanvasDialogue, 0, 0, Logique(L), Logique(H))
  UseGadgetList(WindowID(#FenetrePrincipale))
  If GetWindowState(#FenetrePrincipale) = #PB_Window_Minimize
    ZoneEcran(@rp)                    ; fenêtre réduite: au milieu de l'écran
  Else
    GetWindowRect_(WindowID(#FenetrePrincipale), @rp)
  EndIf
  X = rp\left + ((rp\right - rp\left) - L) / 2
  Y = rp\top + ((rp\bottom - rp\top) - H) / 2
  SetWindowPos_(WindowID(#FenetreDialogue), 0, X, Y, 0, 0, #W_SWP_NOSIZE | #W_SWP_NOZORDER | #W_SWP_NOACTIVATE)
  DessinerDialogue()

  ; voile sur la fenêtre principale, qui est désactivée pendant le dialogue
  If IsWindow(#FenetreVoile) And GetWindowState(#FenetrePrincipale) <> #PB_Window_Minimize
    SetWindowPos_(WindowID(#FenetreVoile), 0, rp\left, rp\top, rp\right - rp\left, rp\bottom - rp\top, #W_SWP_NOACTIVATE | #W_SWP_SHOWWINDOW)
  EndIf
  DisableWindow(#FenetrePrincipale, #True)
  HideWindow(#FenetreDialogue, #False)
  MontrerOmbre(#FenetreOmbreDialogue, #FenetreDialogue, 1)
  SetWindowCallback(@RappelDialogue(), #FenetreDialogue)
  AddKeyboardShortcut(#FenetreDialogue, #PB_Shortcut_Return, #CmdDialogueEntree)
  AddKeyboardShortcut(#FenetreDialogue, #PB_Shortcut_Escape, #CmdDialogueEchap)
  AddKeyboardShortcut(#FenetreDialogue, #PB_Shortcut_Left, #CmdDialogueGauche)
  AddKeyboardShortcut(#FenetreDialogue, #PB_Shortcut_Right, #CmdDialogueDroite)
  AddKeyboardShortcut(#FenetreDialogue, #PB_Shortcut_Tab, #CmdDialogueDroite)
  AddKeyboardShortcut(#FenetreDialogue, #PB_Shortcut_Space, #CmdDialogueEntree)
  SetActiveWindow(#FenetreDialogue)

  Repeat
    Evenement = WaitWindowEvent()
    Select Evenement
      Case #PB_Event_Menu
        If EventWindow() = #FenetreDialogue
          Select EventMenu()
            Case #CmdDialogueEntree
              DlgResultat = DlgFocus
              DlgFini = #True
            Case #CmdDialogueEchap
              DlgResultat = DlgNbBoutons - 1
              DlgFini = #True
            Case #CmdDialogueGauche
              DlgFocus = (DlgFocus + DlgNbBoutons - 1) % DlgNbBoutons
              DessinerDialogue()
            Case #CmdDialogueDroite
              DlgFocus = (DlgFocus + 1) % DlgNbBoutons
              DessinerDialogue()
          EndSelect
        EndIf
      Case #PB_Event_Gadget
        If EventGadget() = #CanvasDialogue
          SourisDans(#CanvasDialogue, @p)
          Bouton = BoutonDialogueSous(p\x, p\y)
          Fermer = DansRect(p\x, p\y, L - Bord() - Pix(8) - Pix(18), Bord() + Pix(2), Pix(18), Pix(18))
          Select EventType()
            Case #PB_EventType_MouseMove, #PB_EventType_MouseEnter
              If Bouton <> DlgSurvol Or Fermer <> DlgFermerSurvol
                DlgSurvol = Bouton
                DlgFermerSurvol = Fermer
                DessinerDialogue()
              EndIf
            Case #PB_EventType_MouseLeave
              DlgSurvol = -1
              DlgFermerSurvol = #False
              DessinerDialogue()
            Case #PB_EventType_LeftButtonDown
              If Bouton >= 0
                DlgAppui = Bouton
                DlgFocus = Bouton
                DessinerDialogue()
              ElseIf Fermer = #False And p\y < Bord() + Pix(22)
                ; déplacer le dialogue par son en-tête
                ReleaseCapture_()
                SendMessage_(WindowID(#FenetreDialogue), #W_WM_NCLBUTTONDOWN, #W_HTCAPTION, 0)
              EndIf
            Case #PB_EventType_LeftButtonUp
              If DlgAppui >= 0 And DlgAppui = Bouton
                DlgResultat = Bouton
                DlgFini = #True
              ElseIf Fermer
                DlgResultat = DlgNbBoutons - 1
                DlgFini = #True
              EndIf
              DlgAppui = -1
              If DlgFini = #False
                DessinerDialogue()
              EndIf
          EndSelect
        EndIf
      Case #PB_Event_CloseWindow
        If EventWindow() = #FenetreDialogue
          DlgFini = #True
        EndIf
      Case #PB_Event_ActivateWindow
        ; une autre fenêtre du programme ne doit jamais passer devant le dialogue
        If EventWindow() <> #FenetreDialogue
          SetActiveWindow(#FenetreDialogue)
        EndIf
    EndSelect
  Until DlgFini

  DisableWindow(#FenetrePrincipale, #False)
  CacherOmbre(#FenetreOmbreDialogue)
  If IsWindow(#FenetreVoile)
    HideWindow(#FenetreVoile, #True)
  EndIf
  CloseWindow(#FenetreDialogue)
  SetActiveWindow(#FenetrePrincipale)
  ProcedureReturn DlgResultat
EndProcedure

; Message simple (remplace MessageRequester)
Procedure MessageDialogue(Genre, Titre$, Texte$)
  Dialogue(Genre, Titre$, Texte$, Tr("boutonOK"))
EndProcedure

; ============================================================================
;  PROJETS (v7.2): un dossier entier, sous-dossiers compris, en un seul bloc
; ============================================================================
;  Tout le dossier est parcouru ; seuls les fichiers texte (code, .txt, .ini,
;  .json...) sont gardés, octet pour octet: marque UTF-8 et bloc « IDE
;  Options » compris, chaque fichier revient exactement comme il était. Les
;  autres (images, programmes...) sont laissés de côté et signalés.
;  Les fichiers gardés sont mis bout à bout dans un « paquet », compressé
;  comme un code ordinaire:
;
;    PBPROJET1                     marque et version du paquet
;    <nom du dossier>
;    <nombre d'entrées>
;    <taille><TAB><chemin>         une ligne par fichier
;    D<TAB><chemin>                une ligne par dossier vide
;    <contenu des fichiers, à la suite, dans l'ordre des lignes>
;
;  Lignes terminées par LF, textes en UTF-8, chemins relatifs au dossier,
;  séparés par « / ». Le bloc d'un projet a son propre numéro de format
;  (PBC12 avec LZMA, PBC19 à PBC21 avec Maximal v6 aux niveaux 1 à 3, et
;  PBC13 à PBC15 avec Maximal v5 jusqu'à la v7.2.1): une version plus
;  ancienne du programme dit alors que le bloc vient d'une version plus
;  récente, au lieu de montrer le paquet comme un code.
;
;  Pour recréer le projet, chaque nom est contrôlé (pas de « .. », pas de
;  lecteur, aucun caractère interdit par Windows, aucun nom réservé comme CON
;  ou NUL, aucun doublon), et tout est écrit dans un dossier NEUF: un bloc
;  trouvé sur un forum ne peut rien écrire en dehors du dossier choisi, ni
;  écraser un fichier qui existe déjà.
; ============================================================================

#ProjetMaxEntrees     = 20000       ; fichiers et dossiers vides gardés
#ProjetMaxVus         = 100000      ; fichiers et dossiers examinés (un disque entier déposé par erreur)
#ProjetMaxOctets      = 200000000   ; 200 Mo de texte au plus
#ProjetMaxProfondeur  = 40          ; dossiers les uns dans les autres
#ProjetMaxNom         = 255         ; caractères d'un nom de fichier ou de dossier
#ProjetMaxChemin      = 1000        ; caractères d'un chemin dans le projet
#ProjetMaxLigne       = 4096        ; octets d'une ligne de l'en-tête du paquet
#ProjetEchantillon    = 65536       ; octets lus d'abord pour savoir si c'est du texte
#ProjetMaxIgnores     = 200         ; fichiers laissés de côté montrés dans la liste

; Pourquoi un fichier ou un dossier est laissé de côté
Enumeration RaisonsIgnore
  #IgnoreBinaire        ; pas du texte
  #IgnoreIllisible      ; impossible à lire
  #IgnoreDepot          ; dossier d'un gestionnaire de versions (.git, .svn, .hg)
  #IgnoreNom            ; nom ou chemin que Windows ne pourrait pas recréer
EndEnumeration

Structure EntreeProjet
  Chemin$          ; relatif au dossier du projet, séparé par « / »
  Cle$             ; pour le tri: chemin en minuscules, « / » remplacé par Chr(1)
  Taille.q         ; octets du fichier, -1 pour un dossier vide
  *Contenu         ; octets lus (lecture d'un dossier), sinon 0
  Position.q       ; début du contenu dans le paquet (lecture d'un paquet)
EndStructure

Structure IgnoreProjet
  Chemin$
  Raison.i
EndStructure

Structure NoeudProjet
  Profondeur.i     ; 1 = directement dans le dossier du projet
  Nom$
  Dossier.i        ; #True pour un dossier
  Taille.q         ; octets d'un fichier
  Dernier.i        ; dernier élément de son dossier
EndStructure

Global NewList EntreesProjet.EntreeProjet()
Global NewList IgnoresProjet.IgnoreProjet()
Global ErreurProjet$                ; raison d'un échec ("" si tout va bien)
Global OctetsLusProjet.q            ; octets des fichiers gardés pendant la lecture d'un dossier
Global VusProjet                    ; fichiers et dossiers examinés pendant la lecture
Global PositionPaquet.q             ; lecture de l'en-tête d'un paquet
Global LigneLuePaquet               ; la dernière ligne lue était complète
Global NomPaquet$                   ; nom du dossier du projet, lu dans le paquet
Global TailleNouveauPaquet.q        ; taille du dernier paquet construit
Global NbFichiersProjet             ; fichiers et dossiers vides de la liste en cours
Global NbVidesProjet
Global OctetsProjet.q

; ----------------------------------------------------------------------------
;  Le contenu est-il du texte ? Aucun octet nul (sauf UTF-16 avec sa marque),
;  et au plus 1 % de caractères de contrôle autres que tabulation, retours à
;  la ligne, saut de page, fin de fichier (Ctrl+Z) et échappement.
; ----------------------------------------------------------------------------
Procedure EstTexteProjet(*Octets, Taille.q)
  Protected c
  Protected.q i, Controles

  If Taille <= 0
    ProcedureReturn #True
  EndIf
  If Taille >= 2 And Taille % 2 = 0
    If (PeekA(*Octets) = $FF And PeekA(*Octets + 1) = $FE) Or (PeekA(*Octets) = $FE And PeekA(*Octets + 1) = $FF)
      ProcedureReturn #True
    EndIf
  EndIf
  For i = 0 To Taille - 1
    c = PeekA(*Octets + i)
    If c < 32
      If c = 0
        ProcedureReturn #False
      EndIf
      If c <> 9 And c <> 10 And c <> 12 And c <> 13 And c <> 26 And c <> 27
        Controles = Controles + 1
      EndIf
    EndIf
  Next
  ProcedureReturn Bool(Controles * 100 <= Taille)
EndProcedure

; ----------------------------------------------------------------------------
;  Un nom de fichier ou de dossier que Windows peut créer sans surprise
; ----------------------------------------------------------------------------
Procedure NomProjetValide(Nom$)
  Protected i, c, Base$, Fin$

  If Nom$ = "" Or Len(Nom$) > #ProjetMaxNom Or Nom$ = "." Or Nom$ = ".."
    ProcedureReturn #False
  EndIf
  ; Windows retire les points et les espaces à la fin d'un nom: deux noms
  ; différents désigneraient le même fichier
  Fin$ = Right(Nom$, 1)
  If Fin$ = "." Or Fin$ = " "
    ProcedureReturn #False
  EndIf
  For i = 1 To Len(Nom$)
    c = Asc(Mid(Nom$, i, 1))
    If c < 32 Or c = 127
      ProcedureReturn #False
    EndIf
    If FindString("<>:" + Chr(34) + "/\|?*", Chr(c))
      ProcedureReturn #False
    EndIf
  Next
  ; noms réservés par Windows, avec ou sans extension
  Base$ = RTrim(UCase(StringField(Nom$, 1, ".")))
  Select Base$
    Case "CON", "PRN", "AUX", "NUL", "CONIN$", "CONOUT$", "CLOCK$"
      ProcedureReturn #False
  EndSelect
  If Len(Base$) = 4
    If Left(Base$, 3) = "COM" Or Left(Base$, 3) = "LPT"
      If FindString("0123456789¹²³", Right(Base$, 1))
        ProcedureReturn #False
      EndIf
    EndIf
  EndIf
  ProcedureReturn #True
EndProcedure

; Un chemin du projet: des noms valables séparés par « / », sans « / » au
; début ni à la fin, ni deux « / » de suite
Procedure CheminProjetValide(Chemin$)
  Protected i, n

  If Chemin$ = "" Or Len(Chemin$) > #ProjetMaxChemin
    ProcedureReturn #False
  EndIf
  n = CountString(Chemin$, "/") + 1
  If n > #ProjetMaxProfondeur
    ProcedureReturn #False
  EndIf
  For i = 1 To n
    If NomProjetValide(StringField(Chemin$, i, "/")) = #False
      ProcedureReturn #False
    EndIf
  Next
  ProcedureReturn #True
EndProcedure

Procedure AjouterIgnore(Chemin$, Raison)
  AddElement(IgnoresProjet())
  IgnoresProjet()\Chemin$ = Chemin$
  IgnoresProjet()\Raison = Raison
EndProcedure

Procedure LibererEntreesProjet()
  ForEach EntreesProjet()
    If EntreesProjet()\Contenu
      FreeMemory(EntreesProjet()\Contenu)
    EndIf
  Next
  ClearList(EntreesProjet())
EndProcedure

; Dossiers d'un gestionnaire de versions: ce n'est pas le projet lui-même
Procedure DossierDeDepot(Nom$)
  Select LCase(Nom$)
    Case ".git", ".svn", ".hg", ".bzr"
      ProcedureReturn #True
  EndSelect
  ProcedureReturn #False
EndProcedure

; ----------------------------------------------------------------------------
;  Lit un fichier du dossier. Renvoie 1 s'il est gardé (ajouté à la liste),
;  0 s'il est laissé de côté, -1 si la lecture du projet doit s'arrêter
;  (ErreurProjet$ dit pourquoi).
; ----------------------------------------------------------------------------
Procedure LireFichierProjet(Complet$, Relatif$)
  Protected Fichier, *Octets, *Plus
  Protected.q Taille, Debut, Lu

  If CheminProjetValide(Relatif$) = #False
    AjouterIgnore(Relatif$, #IgnoreNom)
    ProcedureReturn 0
  EndIf
  Fichier = ReadFile(#PB_Any, Complet$, #PB_File_SharedRead | #PB_File_SharedWrite)
  If Fichier = 0
    AjouterIgnore(Relatif$, #IgnoreIllisible)
    ProcedureReturn 0
  EndIf
  Taille = Lof(Fichier)
  If Taille > 0
    ; d'abord le début seulement: un gros fichier qui n'est pas du texte
    ; (vidéo, archive...) n'est pas lu en entier
    Debut = Taille
    If Debut > #ProjetEchantillon
      Debut = #ProjetEchantillon
    EndIf
    *Octets = AllocateMemory(Debut, #PB_Memory_NoClear)
    If *Octets = 0
      CloseFile(Fichier)
      ErreurProjet$ = Tr("memoireInsuffisante")
      ProcedureReturn -1
    EndIf
    Lu = ReadData(Fichier, *Octets, Debut)
    If Lu <> Debut
      FreeMemory(*Octets)
      CloseFile(Fichier)
      AjouterIgnore(Relatif$, #IgnoreIllisible)
      ProcedureReturn 0
    EndIf
    If EstTexteProjet(*Octets, Debut) = #False
      FreeMemory(*Octets)
      CloseFile(Fichier)
      AjouterIgnore(Relatif$, #IgnoreBinaire)
      ProcedureReturn 0
    EndIf
    If Taille > #ProjetMaxOctets - OctetsLusProjet
      FreeMemory(*Octets)
      CloseFile(Fichier)
      ErreurProjet$ = TrF("projetTropGros", FormaterNombre(#ProjetMaxOctets / 1000000))
      ProcedureReturn -1
    EndIf
    If Taille > Debut
      ; c'est du texte: le reste du fichier
      *Plus = ReAllocateMemory(*Octets, Taille, #PB_Memory_NoClear)
      If *Plus = 0
        FreeMemory(*Octets)              ; (ReAllocateMemory ratée le garde)
        CloseFile(Fichier)
        ErreurProjet$ = Tr("memoireInsuffisante")
        ProcedureReturn -1
      EndIf
      *Octets = *Plus
      Lu = ReadData(Fichier, *Octets + Debut, Taille - Debut)
      If Lu <> Taille - Debut Or EstTexteProjet(*Octets, Taille) = #False
        FreeMemory(*Octets)
        CloseFile(Fichier)
        If Lu <> Taille - Debut
          AjouterIgnore(Relatif$, #IgnoreIllisible)
        Else
          AjouterIgnore(Relatif$, #IgnoreBinaire)
        EndIf
        ProcedureReturn 0
      EndIf
    EndIf
  EndIf
  CloseFile(Fichier)
  If ListSize(EntreesProjet()) >= #ProjetMaxEntrees
    If *Octets
      FreeMemory(*Octets)
    EndIf
    ErreurProjet$ = TrF("projetTropDeFichiers", FormaterNombre(#ProjetMaxEntrees))
    ProcedureReturn -1
  EndIf
  AddElement(EntreesProjet())
  EntreesProjet()\Chemin$ = Relatif$
  EntreesProjet()\Taille = Taille
  EntreesProjet()\Contenu = *Octets
  OctetsLusProjet = OctetsLusProjet + Taille
  ProcedureReturn 1
EndProcedure

; ----------------------------------------------------------------------------
;  Parcourt un dossier et ses sous-dossiers. Dossier$: chemin complet, avec
;  le séparateur à la fin ; Relatif$: "" pour le dossier du projet, sinon
;  « a/b/ ». Renvoie le nombre d'entrées gardées dans ce dossier et en
;  dessous, ou -1 si la lecture doit s'arrêter (ErreurProjet$).
;  Un sous-dossier où rien n'est gardé devient une entrée « dossier vide »:
;  il sera recréé lui aussi.
; ----------------------------------------------------------------------------
Procedure LireDossierProjet(Dossier$, Relatif$, Profondeur)
  Protected Rep, Nom$, n, Gardes

  Rep = ExamineDirectory(#PB_Any, Dossier$, "*.*")
  If Rep = 0
    If Relatif$ = ""
      ErreurProjet$ = TrF("projetDossierIllisible", Dossier$)
      ProcedureReturn -1
    EndIf
    AjouterIgnore(Relatif$, #IgnoreIllisible)
    ProcedureReturn 0
  EndIf
  While NextDirectoryEntry(Rep)
    Nom$ = DirectoryEntryName(Rep)
    If Nom$ = "." Or Nom$ = ".."
      Continue
    EndIf
    VusProjet = VusProjet + 1
    If VusProjet > #ProjetMaxVus
      ErreurProjet$ = TrF("projetTropDeFichiers", FormaterNombre(#ProjetMaxEntrees))
      n = -1
    ElseIf DirectoryEntryType(Rep) = #PB_DirectoryEntry_Directory
      If DossierDeDepot(Nom$)
        AjouterIgnore(Relatif$ + Nom$ + "/", #IgnoreDepot)
        n = 0
      ElseIf CheminProjetValide(Relatif$ + Nom$) = #False
        AjouterIgnore(Relatif$ + Nom$ + "/", #IgnoreNom)
        n = 0
      ElseIf Profondeur + 1 >= #ProjetMaxProfondeur
        ErreurProjet$ = TrF("projetTropProfond", Str(#ProjetMaxProfondeur))
        n = -1
      Else
        n = LireDossierProjet(Dossier$ + Nom$ + #PS$, Relatif$ + Nom$ + "/", Profondeur + 1)
        If n = 0
          If ListSize(EntreesProjet()) >= #ProjetMaxEntrees
            ErreurProjet$ = TrF("projetTropDeFichiers", FormaterNombre(#ProjetMaxEntrees))
            n = -1
          Else
            ; rien de gardé dedans: un dossier vide, recréé tel quel
            AddElement(EntreesProjet())
            EntreesProjet()\Chemin$ = Relatif$ + Nom$
            EntreesProjet()\Taille = -1
            n = 1
          EndIf
        EndIf
      EndIf
    Else
      n = LireFichierProjet(Dossier$ + Nom$, Relatif$ + Nom$)
    EndIf
    If n < 0
      FinishDirectory(Rep)
      ProcedureReturn -1
    EndIf
    Gardes = Gardes + n
  Wend
  FinishDirectory(Rep)
  ProcedureReturn Gardes
EndProcedure

; Ligne de l'en-tête du paquet pour l'entrée en cours
Procedure.s LigneEntreeProjet()
  If EntreesProjet()\Taille < 0
    ProcedureReturn "D" + #TAB$ + EntreesProjet()\Chemin$ + #LF$
  EndIf
  ProcedureReturn Str(EntreesProjet()\Taille) + #TAB$ + EntreesProjet()\Chemin$ + #LF$
EndProcedure

; ----------------------------------------------------------------------------
;  Noms qui ne diffèrent que par les majuscules (« Data.pb » et « DATA.pb »,
;  ou un fichier « data » et un dossier « Data »): possible sur un disque ou
;  un dossier qui distingue les majuscules, mais Windows ne pourrait pas les
;  recréer tous. Le second est laissé de côté: tout paquet construit ici
;  passe donc le contrôle de LirePaquet. La liste doit être triée.
; ----------------------------------------------------------------------------
Procedure RetirerConflitsProjet()
  Protected Chemin$, Cle$, k, n, Conflit
  Protected NewMap Genre.s()        ; chemin en minuscules -> "F" fichier, "D" dossier

  ForEach EntreesProjet()
    Chemin$ = EntreesProjet()\Chemin$
    Conflit = #False
    n = CountString(Chemin$, "/")
    Cle$ = ""
    For k = 1 To n
      If k > 1
        Cle$ = Cle$ + "/"
      EndIf
      Cle$ = Cle$ + LCase(StringField(Chemin$, k, "/"))
      If FindMapElement(Genre(), Cle$)
        If Genre() = "F"
          Conflit = #True
          Break
        EndIf
      Else
        Genre(Cle$) = "D"
      EndIf
    Next
    Cle$ = LCase(Chemin$)
    If Conflit = #False And FindMapElement(Genre(), Cle$)
      Conflit = #True
    EndIf
    If Conflit
      If EntreesProjet()\Taille < 0
        AjouterIgnore(Chemin$ + "/", #IgnoreNom)
      Else
        AjouterIgnore(Chemin$, #IgnoreNom)
      EndIf
      If EntreesProjet()\Contenu
        FreeMemory(EntreesProjet()\Contenu)
      EndIf
      DeleteElement(EntreesProjet())
    ElseIf EntreesProjet()\Taille < 0
      Genre(Cle$) = "D"
    Else
      Genre(Cle$) = "F"
    EndIf
  Next
EndProcedure

; ----------------------------------------------------------------------------
;  Construit le paquet à partir de la liste (triée ici, par chemin). Renvoie
;  sa mémoire (taille dans TailleNouveauPaquet), 0 si la mémoire manque.
;  Le contenu des fichiers reste dans la liste: LibererEntreesProjet ensuite.
; ----------------------------------------------------------------------------
Procedure ConstruirePaquet(Nom$)
  Protected *Paquet, Entete$
  Protected.q Taille, Position

  ; Tri par chemin, majuscules ignorées, le contenu d'un dossier juste après
  ; lui (Chr(1) passe avant tout autre caractère): chaque dossier reste d'un
  ; seul tenant, l'arbre affiché le suppose
  ForEach EntreesProjet()
    EntreesProjet()\Cle$ = ReplaceString(LCase(EntreesProjet()\Chemin$), "/", Chr(1))
  Next
  SortStructuredList(EntreesProjet(), #PB_Sort_Ascending, OffsetOf(EntreeProjet\Cle$), #PB_String)
  RetirerConflitsProjet()
  Entete$ = #ProjetMarque$ + #LF$ + Nom$ + #LF$ + Str(ListSize(EntreesProjet())) + #LF$
  Taille = StringByteLength(Entete$, #PB_UTF8)
  ForEach EntreesProjet()
    Taille = Taille + StringByteLength(LigneEntreeProjet(), #PB_UTF8)
    If EntreesProjet()\Taille > 0
      Taille = Taille + EntreesProjet()\Taille
    EndIf
  Next
  TailleNouveauPaquet = 0
  *Paquet = AllocateMemory(Taille + 16)
  If *Paquet = 0
    ProcedureReturn 0
  EndIf
  Position = PokeS(*Paquet, Entete$, -1, #PB_UTF8 | #PB_String_NoZero)
  ForEach EntreesProjet()
    Position = Position + PokeS(*Paquet + Position, LigneEntreeProjet(), -1, #PB_UTF8 | #PB_String_NoZero)
  Next
  ForEach EntreesProjet()
    If EntreesProjet()\Taille > 0
      CopyMemory(EntreesProjet()\Contenu, *Paquet + Position, EntreesProjet()\Taille)
      Position = Position + EntreesProjet()\Taille
    EndIf
  Next
  If Position <> Taille
    FreeMemory(*Paquet)            ; ne devrait jamais arriver
    ProcedureReturn 0
  EndIf
  TailleNouveauPaquet = Taille
  ProcedureReturn *Paquet
EndProcedure

; ----------------------------------------------------------------------------
;  Lecture d'un paquet: la ligne qui commence à PositionPaquet (sans le LF).
;  LigneLuePaquet = #False si la ligne est trop longue, sans fin, ou contient
;  un caractère de contrôle autre que la tabulation.
; ----------------------------------------------------------------------------
Procedure.s LigneSuivantePaquet(*Paquet, Taille.q)
  Protected c, Ligne$
  Protected.q i, Fin

  LigneLuePaquet = #False
  Fin = PositionPaquet + #ProjetMaxLigne
  If Fin > Taille
    Fin = Taille
  EndIf
  i = PositionPaquet
  While i < Fin
    c = PeekA(*Paquet + i)
    If c = 10
      If i > PositionPaquet
        Ligne$ = PeekS(*Paquet + PositionPaquet, i - PositionPaquet, #PB_UTF8 | #PB_ByteLength)
      EndIf
      PositionPaquet = i + 1
      LigneLuePaquet = #True
      ProcedureReturn Ligne$
    EndIf
    If c < 32 And c <> 9
      ProcedureReturn ""
    EndIf
    i = i + 1
  Wend
  ProcedureReturn ""
EndProcedure

; ----------------------------------------------------------------------------
;  Lit et contrôle tout l'en-tête d'un paquet: la liste des entrées est
;  remplie (chemin, taille, position du contenu), NomPaquet$ aussi. Renvoie
;  #False si le paquet est abîmé ou dangereux (ErreurProjet$ dit pourquoi):
;  alors rien ne doit être écrit.
; ----------------------------------------------------------------------------
Procedure LirePaquet(*Paquet, Taille.q)
  Protected Ligne$, Champ$, Chemin$, Cle$, i, k, n, Nb
  Protected.q Octets, Total, Position
  Protected NewMap Genre.s()        ; chemin en minuscules -> "F" fichier, "D" dossier

  LibererEntreesProjet()
  ErreurProjet$ = ""
  NomPaquet$ = ""
  PositionPaquet = 0
  If *Paquet = 0 Or Taille < 1
    ErreurProjet$ = Tr("projetAbime")
    ProcedureReturn #False
  EndIf

  Ligne$ = LigneSuivantePaquet(*Paquet, Taille)
  If LigneLuePaquet = #False Or Ligne$ <> #ProjetMarque$
    ErreurProjet$ = Tr("projetInconnu")
    ProcedureReturn #False
  EndIf
  NomPaquet$ = LigneSuivantePaquet(*Paquet, Taille)
  If LigneLuePaquet = #False Or NomProjetValide(NomPaquet$) = #False
    ErreurProjet$ = TrF("projetNomInterdit", NomPaquet$)
    NomPaquet$ = ""
    ProcedureReturn #False
  EndIf
  Ligne$ = LigneSuivantePaquet(*Paquet, Taille)
  If LigneLuePaquet = #False Or EstNombre(Ligne$) = #False
    ErreurProjet$ = Tr("projetAbime")
    ProcedureReturn #False
  EndIf
  Nb = Val(Ligne$)
  If Nb < 1 Or Nb > #ProjetMaxEntrees
    ErreurProjet$ = Tr("projetAbime")
    ProcedureReturn #False
  EndIf

  For i = 1 To Nb
    Ligne$ = LigneSuivantePaquet(*Paquet, Taille)
    If LigneLuePaquet = #False Or CountString(Ligne$, #TAB$) <> 1
      ErreurProjet$ = Tr("projetAbime")
      ProcedureReturn #False
    EndIf
    Champ$ = StringField(Ligne$, 1, #TAB$)
    Chemin$ = StringField(Ligne$, 2, #TAB$)
    If CheminProjetValide(Chemin$) = #False
      ErreurProjet$ = TrF("projetCheminInterdit", Chemin$)
      ProcedureReturn #False
    EndIf
    ; chaque dossier parent ne doit pas être aussi un fichier (majuscules
    ; ignorées, comme dans Windows)
    n = CountString(Chemin$, "/")
    Cle$ = ""
    For k = 1 To n
      If k > 1
        Cle$ = Cle$ + "/"
      EndIf
      Cle$ = Cle$ + LCase(StringField(Chemin$, k, "/"))
      If FindMapElement(Genre(), Cle$)
        If Genre() = "F"
          ErreurProjet$ = TrF("projetDoublon", Chemin$)
          ProcedureReturn #False
        EndIf
      Else
        Genre(Cle$) = "D"
      EndIf
    Next
    ; et l'entrée elle-même ne doit pas déjà exister
    Cle$ = LCase(Chemin$)
    If FindMapElement(Genre(), Cle$)
      ErreurProjet$ = TrF("projetDoublon", Chemin$)
      ProcedureReturn #False
    EndIf
    If Champ$ = "D"
      Genre(Cle$) = "D"
      Octets = -1
    ElseIf EstNombre(Champ$)
      Genre(Cle$) = "F"
      Octets = Val(Champ$)
      Total = Total + Octets
      If Octets > Taille Or Total > Taille
        ErreurProjet$ = Tr("projetAbime")
        ProcedureReturn #False
      EndIf
    Else
      ErreurProjet$ = Tr("projetAbime")
      ProcedureReturn #False
    EndIf
    AddElement(EntreesProjet())
    EntreesProjet()\Chemin$ = Chemin$
    EntreesProjet()\Taille = Octets
  Next

  ; le contenu des fichiers occupe exactement la fin du paquet
  If PositionPaquet + Total <> Taille
    LibererEntreesProjet()
    ErreurProjet$ = Tr("projetAbime")
    ProcedureReturn #False
  EndIf
  Position = PositionPaquet
  ForEach EntreesProjet()
    If EntreesProjet()\Taille >= 0
      EntreesProjet()\Position = Position
      Position = Position + EntreesProjet()\Taille
    EndIf
  Next
  ProcedureReturn #True
EndProcedure

; ----------------------------------------------------------------------------
;  Dossier à créer pour recréer le projet: Destination$ + Nom$, ou, si ce nom
;  est déjà pris, « Nom (2) », « Nom (3) »... ("" si tout est pris)
; ----------------------------------------------------------------------------
Procedure.s RacineLibreProjet(Destination$, Nom$)
  Protected i, Essai$

  If Right(Destination$, 1) <> #PS$
    Destination$ = Destination$ + #PS$
  EndIf
  Essai$ = Destination$ + Nom$
  i = 2
  While FileSize(Essai$) <> -1
    If i > 999
      ProcedureReturn ""
    EndIf
    Essai$ = Destination$ + Nom$ + " (" + Str(i) + ")"
    i = i + 1
  Wend
  ProcedureReturn Essai$
EndProcedure

; ----------------------------------------------------------------------------
;  Recrée le projet lu par LirePaquet dans le dossier Racine$ (chemin complet,
;  sans séparateur à la fin), qui ne doit pas exister: il est créé ici. Rien
;  n'est jamais écrit par-dessus un fichier qui existe. Chaque fichier écrit
;  est ensuite relu et comparé au paquet.
;  Renvoie le nombre de fichiers écrits, ou -1 (ErreurProjet$ dit pourquoi).
; ----------------------------------------------------------------------------
Procedure ExtrairePaquet(*Paquet, Racine$)
  Protected Dossier$, Chemin$, Fichier, *Relu, i, n, Ecrits, Identique
  Protected.q Ecrit, Lu

  ErreurProjet$ = ""
  If FileSize(Racine$) <> -1
    ErreurProjet$ = TrF("projetExisteDeja", Racine$)
    ProcedureReturn -1
  EndIf
  If CreateDirectory(Racine$) = 0 Or FileSize(Racine$) <> -2
    ErreurProjet$ = TrF("projetDossierImpossible", Racine$)
    ProcedureReturn -1
  EndIf

  ForEach EntreesProjet()
    ; les dossiers du chemin (pour un dossier vide: lui aussi)
    n = CountString(EntreesProjet()\Chemin$, "/") + 1
    If EntreesProjet()\Taille >= 0
      n = n - 1
    EndIf
    Dossier$ = Racine$
    For i = 1 To n
      Dossier$ = Dossier$ + #PS$ + StringField(EntreesProjet()\Chemin$, i, "/")
      Select FileSize(Dossier$)
        Case -2
          ; déjà créé par ce projet
        Case -1
          If CreateDirectory(Dossier$) = 0 Or FileSize(Dossier$) <> -2
            ErreurProjet$ = TrF("projetDossierImpossible", Dossier$)
            ProcedureReturn -1
          EndIf
        Default
          ErreurProjet$ = TrF("projetConflit", Dossier$)
          ProcedureReturn -1
      EndSelect
    Next
    If EntreesProjet()\Taille >= 0
      Chemin$ = Racine$ + #PS$ + ReplaceString(EntreesProjet()\Chemin$, "/", #PS$)
      If FileSize(Chemin$) <> -1
        ; un autre nom du même fichier pour Windows: on n'écrase rien
        ErreurProjet$ = TrF("projetConflit", Chemin$)
        ProcedureReturn -1
      EndIf
      Fichier = CreateFile(#PB_Any, Chemin$)
      If Fichier = 0
        ErreurProjet$ = TrF("creationImpossible", Chemin$)
        ProcedureReturn -1
      EndIf
      Ecrit = 0
      If EntreesProjet()\Taille > 0
        Ecrit = WriteData(Fichier, *Paquet + EntreesProjet()\Position, EntreesProjet()\Taille)
      EndIf
      CloseFile(Fichier)
      If Ecrit <> EntreesProjet()\Taille
        ErreurProjet$ = TrF("projetEcritureImpossible", Chemin$)
        ProcedureReturn -1
      EndIf
      Ecrits = Ecrits + 1
    EndIf
  Next

  ; Contrôle: chaque fichier est relu et comparé au paquet
  ForEach EntreesProjet()
    If EntreesProjet()\Taille >= 0
      Chemin$ = Racine$ + #PS$ + ReplaceString(EntreesProjet()\Chemin$, "/", #PS$)
      If FileSize(Chemin$) <> EntreesProjet()\Taille
        ErreurProjet$ = TrF("projetRelectureRatee", Chemin$)
        ProcedureReturn -1
      EndIf
      If EntreesProjet()\Taille > 0
        Identique = #False
        *Relu = AllocateMemory(EntreesProjet()\Taille, #PB_Memory_NoClear)
        If *Relu
          Fichier = ReadFile(#PB_Any, Chemin$, #PB_File_SharedRead)
          If Fichier
            Lu = ReadData(Fichier, *Relu, EntreesProjet()\Taille)
            CloseFile(Fichier)
            If Lu = EntreesProjet()\Taille
              Identique = Bool(CompareMemory(*Relu, *Paquet + EntreesProjet()\Position, EntreesProjet()\Taille) <> 0)
            EndIf
          EndIf
          FreeMemory(*Relu)
        EndIf
        If Identique = #False
          ErreurProjet$ = TrF("projetRelectureRatee", Chemin$)
          ProcedureReturn -1
        EndIf
      EndIf
    EndIf
  Next
  ProcedureReturn Ecrits
EndProcedure

; ----------------------------------------------------------------------------
;  Texte d'un projet pour un onglet: l'arbre des dossiers et des fichiers
;  (comme la commande « tree » de Windows), avec la taille de chaque fichier,
;  puis les fichiers laissés de côté (AvecIgnores). D'après la liste des
;  entrées, déjà triée. Compte aussi NbFichiersProjet, NbVidesProjet et
;  OctetsProjet.
; ----------------------------------------------------------------------------
Procedure.s JoindreLignes(List Lignes.s())
  Protected *Memoire, Texte$
  Protected.q Taille, Position

  ForEach Lignes()
    Taille = Taille + StringByteLength(Lignes(), #PB_Unicode) + 4
  Next
  *Memoire = AllocateMemory(Taille + 8)
  If *Memoire = 0
    ProcedureReturn ""
  EndIf
  ForEach Lignes()
    Position = Position + PokeS(*Memoire + Position, Lignes() + #CRLF$, -1, #PB_Unicode | #PB_String_NoZero)
  Next
  Texte$ = PeekS(*Memoire, Position / 2, #PB_Unicode)
  FreeMemory(*Memoire)
  ProcedureReturn Texte$
EndProcedure

Procedure.s RaisonIgnore(Raison)
  Select Raison
    Case #IgnoreBinaire
      ProcedureReturn Tr("ignoreBinaire")
    Case #IgnoreIllisible
      ProcedureReturn Tr("ignoreIllisible")
    Case #IgnoreDepot
      ProcedureReturn Tr("ignoreDepot")
  EndSelect
  ProcedureReturn Tr("ignoreNom")
EndProcedure

Procedure.s TexteProjet(Nom$, Titre$, AvecIgnores)
  Protected NewList Noeuds.NoeudProjet()
  Protected NewList Lignes.s()
  Protected Dim Ouverts$(#ProjetMaxProfondeur + 2)
  Protected Dim Vu(#ProjetMaxProfondeur + 2)
  Protected Dim DernierA(#ProjetMaxProfondeur + 2)
  Protected NbOuverts, NbDossiers, Commun, n, k, i, Largeur, LargeurTaille, Montres
  Protected Prefixe$, Ligne$, Taille$

  ; 1. Les nœuds de l'arbre, dans l'ordre: chaque dossier avant son contenu
  NbFichiersProjet = 0
  NbVidesProjet = 0
  OctetsProjet = 0
  ForEach EntreesProjet()
    n = CountString(EntreesProjet()\Chemin$, "/") + 1
    NbDossiers = n
    If EntreesProjet()\Taille >= 0
      NbDossiers = n - 1
      NbFichiersProjet = NbFichiersProjet + 1
      OctetsProjet = OctetsProjet + EntreesProjet()\Taille
    Else
      NbVidesProjet = NbVidesProjet + 1
    EndIf
    If n > #ProjetMaxProfondeur
      Continue                     ; impossible: les chemins sont contrôlés
    EndIf
    ; dossiers déjà ouverts en commun avec ce chemin
    Commun = 0
    While Commun < NbOuverts And Commun < NbDossiers
      If LCase(Ouverts$(Commun + 1)) <> LCase(StringField(EntreesProjet()\Chemin$, Commun + 1, "/"))
        Break
      EndIf
      Commun = Commun + 1
    Wend
    NbOuverts = Commun
    For k = Commun + 1 To NbDossiers
      Ouverts$(k) = StringField(EntreesProjet()\Chemin$, k, "/")
      AddElement(Noeuds())
      Noeuds()\Profondeur = k
      Noeuds()\Nom$ = Ouverts$(k)
      Noeuds()\Dossier = #True
      NbOuverts = k
    Next
    If EntreesProjet()\Taille >= 0
      AddElement(Noeuds())
      Noeuds()\Profondeur = n
      Noeuds()\Nom$ = StringField(EntreesProjet()\Chemin$, n, "/")
      Noeuds()\Taille = EntreesProjet()\Taille
    EndIf
  Next

  ; 2. Le dernier élément de chaque dossier (en partant de la fin)
  If LastElement(Noeuds())
    Repeat
      k = Noeuds()\Profondeur
      Noeuds()\Dernier = Bool(Vu(k) = #False)
      Vu(k) = #True
      For i = k + 1 To #ProjetMaxProfondeur + 2
        Vu(i) = #False
      Next
    Until PreviousElement(Noeuds()) = 0
  EndIf

  ; 3. Largeurs, pour aligner les tailles à droite
  ForEach Noeuds()
    If Noeuds()\Dossier = #False
      Largeur = Maxi(Largeur, (Noeuds()\Profondeur * 4) + Len(Noeuds()\Nom$))
      LargeurTaille = Maxi(LargeurTaille, Len(FormaterNombre(Noeuds()\Taille)))
    EndIf
  Next
  Largeur = Mini(Largeur, 72)

  ; 4. Les lignes
  AddElement(Lignes())
  Lignes() = "; " + Titre$
  AddElement(Lignes())
  Lignes() = "; " + TrF("projetResume", FormaterNombre(NbFichiersProjet), FormaterNombre(NbVidesProjet), FormaterNombre(OctetsProjet))
  AddElement(Lignes())
  Lignes() = ""
  AddElement(Lignes())
  Lignes() = Nom$ + "/"
  ForEach Noeuds()
    k = Noeuds()\Profondeur
    Prefixe$ = ""
    For i = 1 To k - 1
      If DernierA(i)
        Prefixe$ = Prefixe$ + "    "
      Else
        Prefixe$ = Prefixe$ + "│   "
      EndIf
    Next
    If Noeuds()\Dernier
      Prefixe$ = Prefixe$ + "└── "
    Else
      Prefixe$ = Prefixe$ + "├── "
    EndIf
    DernierA(k) = Noeuds()\Dernier
    If Noeuds()\Dossier
      Ligne$ = Prefixe$ + Noeuds()\Nom$ + "/"
    Else
      Ligne$ = Prefixe$ + Noeuds()\Nom$
      Taille$ = FormaterNombre(Noeuds()\Taille)
      Ligne$ = Ligne$ + Space(Maxi(2, Largeur + 3 - Len(Ligne$)) + LargeurTaille - Len(Taille$)) + Taille$ + " " + Tr("unitOctets")
    EndIf
    AddElement(Lignes())
    Lignes() = Ligne$
  Next

  ; 5. Ce qui a été laissé de côté
  If AvecIgnores And ListSize(IgnoresProjet()) > 0
    SortStructuredList(IgnoresProjet(), #PB_Sort_Ascending, OffsetOf(IgnoreProjet\Chemin$), #PB_String)
    AddElement(Lignes())
    Lignes() = ""
    AddElement(Lignes())
    Lignes() = "; " + TrF("projetIgnores", FormaterNombre(ListSize(IgnoresProjet())))
    ForEach IgnoresProjet()
      If Montres >= #ProjetMaxIgnores
        AddElement(Lignes())
        Lignes() = ";   " + TrF("projetIgnoresAutres", FormaterNombre(ListSize(IgnoresProjet()) - Montres))
        Break
      EndIf
      AddElement(Lignes())
      Lignes() = ";   " + IgnoresProjet()\Chemin$ + " (" + RaisonIgnore(IgnoresProjet()\Raison) + ")"
      Montres = Montres + 1
    Next
  EndIf

  ProcedureReturn JoindreLignes(Lignes())
EndProcedure

; Vérifie un bloc de projet: sa lecture (exactement ce que fera le lecteur)
; doit redonner le paquet, octet pour octet
Procedure VerifierSortieProjet(Sortie$, *Attendu, Taille.q)
  Protected Ok
  If DecompresserBloc(Sortie$) <> "" And BlocProjet And *OctetsBloc And TailleOctetsBloc = Taille
    Ok = Bool(CompareMemory(*OctetsBloc, *Attendu, Taille) <> 0)
  EndIf
  LibererOctetsBloc()
  ProcedureReturn Ok
EndProcedure

; ============================================================================
;  INTERFACE (v7.1) - 5. Le programme: charger, coller, décompresser,
;  compresser, réglages, disposition de la fenêtre, événements
; ============================================================================

Global DepotEnCours                ; un fichier est glissé au-dessus de la fenêtre
Global EnDisposition               ; Disposer() est en cours (évite de s'appeler lui-même)
Global FenetreMaximisee            ; réglage: fenêtre agrandie au dernier lancement
Global FenetreGauche, FenetreHaut, FenetreLargeur, FenetreHauteur   ; pixels, 0 = par défaut

Procedure.s TexteOnglet(Onglet)
  Select Onglet
    Case 1
      ProcedureReturn DernierResultat$
    Case 2
      ProcedureReturn CodeDecompresse$
  EndSelect
  ProcedureReturn CodeOriginal$
EndProcedure

; L'onglet est-il vide ? (sans copier le texte, qui peut être très long)
Procedure OngletEstVide(Onglet)
  Select Onglet
    Case 1
      ProcedureReturn Bool(DernierResultat$ = "")
    Case 2
      ProcedureReturn Bool(CodeDecompresse$ = "")
  EndSelect
  ProcedureReturn Bool(CodeOriginal$ = "")
EndProcedure

; Textes de la barre d'état (1 code, 2 résultat, 3 limite, 4 niveau, 5 position)
Procedure.s TexteEtat(Numero)
  Select Numero
    Case 1
      If ProjetCharge
        ProcedureReturn TrF("etatProjet", FormaterNombre(NbFichiersSource))
      ElseIf CodeOriginal$ <> ""
        ProcedureReturn TrF("etatCode", FormaterNombre(Len(CodeOriginal$)))
      EndIf
    Case 2
      If DerniereTailleForum > 0
        ProcedureReturn TrF("etatResultat", FormaterNombre(DerniereTailleForum))
      EndIf
    Case 3
      If Reglage\Limite > 0
        ProcedureReturn TrF("etatLimite", FormaterNombre(Reglage\Limite))
      EndIf
    Case 4
      If NiveauActif()
        ProcedureReturn TrF("etatNiveau", Str(Reglage\Niveau))
      EndIf
      ProcedureReturn TrF("etatNiveau", "–")
    Case 5
      ProcedureReturn TrF("etatPosition", FormaterNombre(CaretLigne), FormaterNombre(CaretColonne))
  EndSelect
  ProcedureReturn ""
EndProcedure

; ----------------------------------------------------------------------------
;  Estimations (catégorie « Estimation » de la grille) et place sur le disque
; ----------------------------------------------------------------------------
Procedure MettreAJourEstimations()
  Protected Texte$, *Source, *Z, Niveau, Bas, Haut
  Protected.q Place

  ; 1. Taille du code et taille avec LZMA (refaites seulement si le code a changé)
  If EstimationAJour = #False
    EstimationTaille = 0
    EstimationLZMA = 0
    If ProjetCharge
      ; un projet: son paquet, tel quel
      If *PaquetSource And TaillePaquetSource > 0
        EstimationTaille = TaillePaquetSource
        Place = EstimationTaille + (EstimationTaille / 4) + 1024
        *Z = AllocateMemory(Place)
        If *Z
          EstimationLZMA = CompressMemory(*PaquetSource, EstimationTaille, *Z, Place, #PB_PackerPlugin_Lzma, 9)
          FreeMemory(*Z)
        EndIf
      EndIf
    Else
      Texte$ = CodeOriginal$
      If Reglage\GarderIDE = #False
        Texte$ = RetirerOptionsIDE(Texte$)
      EndIf
    EndIf
    If Texte$ <> ""
      EstimationTaille = StringByteLength(Texte$, #PB_UTF8)
      Place = EstimationTaille + (EstimationTaille / 4) + 1024
      *Source = AllocateMemory(EstimationTaille + 1)
      *Z = AllocateMemory(Place)
      If *Source And *Z
        PokeS(*Source, Texte$, -1, #PB_UTF8)
        EstimationLZMA = CompressMemory(*Source, EstimationTaille, *Z, Place, #PB_PackerPlugin_Lzma, 9)
      EndIf
      If *Source
        FreeMemory(*Source)
      EndIf
      If *Z
        FreeMemory(*Z)
      EndIf
    EndIf
    EstimationAJour = #True
  EndIf

  Niveau = NiveauChoisi()
  If EstimationLZMA <= 0
    EstimationTexte$(#ProEstTaille) = Tr("estAucunCode")
    EstimationTexte$(#ProEstComp) = "—"
    EstimationTexte$(#ProEstDec) = "—"
  ElseIf NiveauActif()
    If RapportNiveau(Niveau) > 0
      EstimationTexte$(#ProEstTaille) = TrF("estUneTaille", FormaterNombre(CaracteresForum((EstimationLZMA * RapportNiveau(Niveau)) / 1000)))
    Else
      Bas = CaracteresForum((EstimationLZMA * RapportBas(Niveau)) / 1000)
      Haut = CaracteresForum((EstimationLZMA * RapportHaut(Niveau)) / 1000)
      EstimationTexte$(#ProEstTaille) = TrF("estDeuxTailles", FormaterNombre(Bas), FormaterNombre(Haut))
    EndIf
    EstimationTexte$(#ProEstComp) = DureeApprox(DureeCompression5(EstimationTaille, Niveau))
    EstimationTexte$(#ProEstDec) = DureeApprox(DureeLecteur5(EstimationTaille, Niveau))
  ElseIf FormatEffectif() = #FormatBloc
    ; LZMA seule
    EstimationTexte$(#ProEstTaille) = TrF("estUneTaille", FormaterNombre(CaracteresForum(EstimationLZMA)))
    EstimationTexte$(#ProEstComp) = DureeApprox(0)
    EstimationTexte$(#ProEstDec) = DureeApprox(0)
  Else
    EstimationTexte$(#ProEstTaille) = Tr("estSeulementBloc")
    EstimationTexte$(#ProEstComp) = DureeApprox(0)
    EstimationTexte$(#ProEstDec) = DureeApprox(0)
  EndIf
  If NiveauActif()
    EstimationTexte$(#ProEstMem) = Decimal(GoMethode(MethodeNiveau(Niveau)), 1) + " " + Tr("unitGo")
    ; compression: un modèle (1,7 Go, 1,2 Go au niveau 3), ou deux si la
    ; vérification se fait en même temps sur un second thread (s'il y a assez
    ; de mémoire libre)
    If ParalleleDisponible5(#False, MethodeNiveau(Niveau))
      EstimationTexte$(#ProEstMemComp) = TrF("memCompDeux", Decimal(GoMethode(MethodeNiveau(Niveau), 2), 1) + " " + Tr("unitGo"))
    Else
      EstimationTexte$(#ProEstMemComp) = TrF("memCompUn", Decimal(GoMethode(MethodeNiveau(Niveau)), 1) + " " + Tr("unitGo"))
    EndIf
  Else
    EstimationTexte$(#ProEstMem) = Tr("memoireFaible")
    EstimationTexte$(#ProEstMemComp) = Tr("memoireFaible")
  EndIf
  If NiveauActif() And Niveau >= 2
    EstimationTexte$(#ProEstReseau) = TexteFilsReseau(Niveau - 1)
  Else
    EstimationTexte$(#ProEstReseau) = Tr("reseauNonUtilise")
  EndIf
  Place = PlaceEtats()
  If Place > 0
    EstimationTexte$(#ProPlace) = FormaterOctets(Place)
  Else
    EstimationTexte$(#ProPlace) = "0 " + Tr("unitMo")
  EndIf
EndProcedure

; ----------------------------------------------------------------------------
;  Disposition de la fenêtre (unités des gadgets)
; ----------------------------------------------------------------------------
Procedure MontrerGadget(Gadget, X, Y, L, H)
  ResizeGadget(Gadget, X, Y, Maxi(L, 1), Maxi(H, 1))
  HideGadget(Gadget, #False)
EndProcedure

Procedure Disposer()
  Protected W, H, Haut, Bas, YSortie, HautZone, LDoc, XProp, Y0, H0, YEd, HEd, Ed, i, HD
  Protected VisibleV, VisibleH, VisibleJ, Essai, Vide, LP, HS

  If EnDisposition Or IsGadget(#CanvasEtat) = 0
    ProcedureReturn
  EndIf
  If GetWindowState(#FenetrePrincipale) = #PB_Window_Minimize
    ProcedureReturn                   ; réduite: rien à disposer (et les tailles restent)
  EndIf
  W = WindowWidth(#FenetrePrincipale)
  H = WindowHeight(#FenetrePrincipale)
  If W < 200 Or H < 200
    ProcedureReturn
  EndIf
  EnDisposition = #True

  ; tailles des panneaux, dans des limites raisonnables pour cette fenêtre
  ; (les tailles voulues restent gardées pour quand elle sera plus grande)
  LP = LimiterLargeurProprietes(LargeurProprietes)
  HS = LimiterHauteurSortie(HauteurSortie)
  LargeurProprietesAffichee = LP
  HauteurSortieAffichee = HS

  ResizeGadget(#CanvasTitre, 0, 0, W, #HauteurTitre)
  ResizeGadget(#CanvasMenus, 0, #HauteurTitre, W, #HauteurMenus)
  ResizeGadget(#CanvasOutils, 0, #HauteurTitre + #HauteurMenus, W, #HauteurOutils)
  Haut = #HauteurTitre + #HauteurMenus + #HauteurOutils
  Bas = H - #HauteurEtat
  ResizeGadget(#CanvasEtat, 0, Bas, W, #HauteurEtat)

  YSortie = Bas - HS
  ResizeGadget(#SeparateurBas, 0, YSortie - #TailleSeparateur, W, #TailleSeparateur)
  HautZone = YSortie - #TailleSeparateur - Haut
  LDoc = W - LP - #TailleSeparateur
  XProp = LDoc + #TailleSeparateur
  ResizeGadget(#SeparateurDroit, LDoc, Haut, #TailleSeparateur, HautZone)

  ; Propriétés: onglet, grille, description (sa hauteur suit son texte)
  ResizeGadget(#CanvasOngletsProp, XProp, Haut, LP, #HauteurOnglets)
  HD = Logique(HauteurDescription(Pix(LP)))
  ResizeGadget(#CanvasGrille, XProp, Haut + #HauteurOnglets, LP, Maxi(HautZone - #HauteurOnglets - HD, 1))
  ResizeGadget(#CanvasDescription, XProp, Haut + HautZone - HD, LP, HD)

  ; Documents
  ResizeGadget(#CanvasOngletsDoc, 0, Haut, LDoc, #HauteurOnglets)
  Y0 = Haut + #HauteurOnglets
  H0 = HautZone - #HauteurOnglets
  Ed = EditeurDeOnglet(OngletActif)
  Defil(0)\Cible = Ed
  Defil(1)\Cible = Ed
  For i = 0 To 2
    If EditeurDeOnglet(i) <> Ed
      HideGadget(EditeurDeOnglet(i), #True)
    EndIf
  Next
  Vide = OngletEstVide(OngletActif)
  If DepotEnCours
    HideGadget(Ed, #True)
    HideGadget(#CanvasVide, #True)
    HideGadget(#CanvasBandeau, #True)
    HideGadget(#DefilDocV, #True)
    HideGadget(#DefilDocH, #True)
    HideGadget(#CoinDoc, #True)
    MontrerGadget(#CanvasDepot, 0, Y0, LDoc, H0)
  ElseIf Vide
    HideGadget(Ed, #True)
    HideGadget(#CanvasDepot, #True)
    HideGadget(#CanvasBandeau, #True)
    HideGadget(#DefilDocV, #True)
    HideGadget(#DefilDocH, #True)
    HideGadget(#CoinDoc, #True)
    MontrerGadget(#CanvasVide, 0, Y0, LDoc, H0)
  Else
    HideGadget(#CanvasDepot, #True)
    HideGadget(#CanvasVide, #True)
    YEd = Y0
    HEd = H0
    If OngletActif = 1
      MontrerGadget(#CanvasBandeau, 0, Y0, LDoc, #HauteurBandeau)
      YEd = Y0 + #HauteurBandeau
      HEd = H0 - #HauteurBandeau
    Else
      HideGadget(#CanvasBandeau, #True)
    EndIf
    ; les barres de défilement n'apparaissent que si le texte dépasse ; leur
    ; place change la taille de l'éditeur: on essaie deux fois au plus
    For Essai = 1 To 2
      VisibleV = Defil(0)\Visible
      VisibleH = Defil(1)\Visible
      ResizeGadget(Ed, 0, YEd, Maxi(LDoc - (VisibleV * #LargeurDefil), 1), Maxi(HEd - (VisibleH * #LargeurDefil), 1))
      LireDefilement(0)
      LireDefilement(1)
      If Defil(0)\Visible = VisibleV And Defil(1)\Visible = VisibleH
        Break
      EndIf
    Next
    HideGadget(Ed, #False)
    If Defil(0)\Visible
      MontrerGadget(#DefilDocV, LDoc - #LargeurDefil, YEd, #LargeurDefil, HEd - (Defil(1)\Visible * #LargeurDefil))
    Else
      HideGadget(#DefilDocV, #True)
    EndIf
    If Defil(1)\Visible
      MontrerGadget(#DefilDocH, 0, YEd + HEd - #LargeurDefil, LDoc - (Defil(0)\Visible * #LargeurDefil), #LargeurDefil)
    Else
      HideGadget(#DefilDocH, #True)
    EndIf
    If Defil(0)\Visible And Defil(1)\Visible
      MontrerGadget(#CoinDoc, LDoc - #LargeurDefil, YEd + HEd - #LargeurDefil, #LargeurDefil, #LargeurDefil)
    Else
      HideGadget(#CoinDoc, #True)
    EndIf
  EndIf

  ; Sortie
  ResizeGadget(#CanvasOngletsSortie, 0, YSortie, W, #HauteurOnglets)
  For Essai = 1 To 2
    VisibleJ = Defil(2)\Visible
    ResizeGadget(#EditeurJournal, 0, YSortie + #HauteurOnglets, Maxi(W - (VisibleJ * #LargeurDefil), 1), Maxi(HS - #HauteurOnglets, 1))
    LireDefilement(2)
    If Defil(2)\Visible = VisibleJ
      Break
    EndIf
  Next
  If Defil(2)\Visible
    MontrerGadget(#DefilJournal, W - #LargeurDefil, YSortie + #HauteurOnglets, #LargeurDefil, HS - #HauteurOnglets)
  Else
    HideGadget(#DefilJournal, #True)
  EndIf

  EnDisposition = #False
  RedessinerTout()
EndProcedure

Procedure RedessinerTout()
  Protected i
  If IsGadget(#CanvasEtat) = 0
    ProcedureReturn
  EndIf
  DessinerTitre()
  DessinerMenus()
  DessinerOutils()
  DessinerOngletsDoc()
  DessinerOngletsFixes()
  DessinerGrille()
  DessinerDescription()
  DessinerEtat()
  DessinerSeparateur(#SeparateurDroit, Bool(SeparateurSurvol = 0 Or SeparateurGlisse = 0))
  DessinerSeparateur(#SeparateurBas, Bool(SeparateurSurvol = 1 Or SeparateurGlisse = 1))
  If IsGadget(#CanvasBandeau) And OngletActif = 1
    DessinerBandeau()
  EndIf
  If DepotEnCours
    DessinerDepot()
  ElseIf OngletEstVide(OngletActif)
    DessinerVide()
  EndIf
  For i = 0 To 2
    If Defil(i)\Visible
      DessinerDefil(i)
    EndIf
  Next
  If Defil(0)\Visible And Defil(1)\Visible
    DessinerCoin()
  EndIf
EndProcedure

; Les barres de défilement suivent les éditeurs (appelée par Scintilla)
Procedure MettreAJourDefilements()
  Protected i, Avant
  Protected Dim Etat(2)

  If EnDisposition
    ProcedureReturn
  EndIf
  For i = 0 To 2
    Etat(i) = Defil(i)\Visible
    LireDefilement(i)
  Next
  If OngletEstVide(OngletActif)
    Defil(0)\Visible = #False
    Defil(1)\Visible = #False
  EndIf
  For i = 0 To 2
    If Defil(i)\Visible <> Etat(i)
      Avant = #True
    EndIf
  Next
  If Avant
    Disposer()
  Else
    For i = 0 To 2
      If Defil(i)\Visible
        If Defil(i)\Total <> Defil(i)\TotalDessine Or Defil(i)\Page <> Defil(i)\PageDessinee Or Defil(i)\Position <> Defil(i)\PositionDessinee
          DessinerDefil(i)
        EndIf
      EndIf
    Next
  EndIf
EndProcedure

; Événements de Scintilla: défilement, zoom, position du curseur
Procedure RappelScintilla(Gadget, *n.SCNotification)
  Protected Code, Position, Ligne, Colonne
  Code = *n\nmhdr\code
  If Code = #Scin_Painted
    ; la largeur des lignes n'est connue qu'après l'affichage: la barre de
    ; défilement horizontale peut apparaître à ce moment
    MettreAJourDefilements()
    ProcedureReturn
  EndIf
  If Code = #Scin_DoubleClick
    If TexteBloc(Gadget)
      ; un bloc compressé n'a pas de « mots »: un double-clic sélectionne
      ; tout le bloc (et la souris ne peut plus changer cette sélection)
      ScintillaSendMessage(Gadget, #Scin_SelectAll)
      ReleaseCapture_()
    EndIf
    ProcedureReturn
  EndIf
  If Code = #Scin_UpdateUI Or Code = #Scin_Zoom
    If Code = #Scin_Zoom And Gadget <> #EditeurJournal
      If Gadget <> #EditeurSortie Or ScintillaSendMessage(#EditeurSortie, #Scin_GetMarginWidthN, 0) > 0
        MargeNumeros(Gadget)
      EndIf
      LargeurLignes(Gadget)          ; les lignes changent de largeur avec le zoom
    EndIf
    If Gadget = EditeurDeOnglet(OngletActif) Or Gadget = #EditeurJournal
      MettreAJourDefilements()
    EndIf
    If Gadget = EditeurDeOnglet(OngletActif)
      Position = ScintillaSendMessage(Gadget, #Scin_GetCurrentPos)
      Ligne = ScintillaSendMessage(Gadget, #Scin_LineFromPosition, Position) + 1
      Colonne = ScintillaSendMessage(Gadget, #Scin_GetColumn, Position) + 1
      If Ligne <> CaretLigne Or Colonne <> CaretColonne
        CaretLigne = Ligne
        CaretColonne = Colonne
        DessinerEtat()
      EndIf
    EndIf
  EndIf
EndProcedure

Procedure MontrerOnglet(Onglet)
  Protected Ed
  OngletActif = Onglet
  Ed = EditeurDeOnglet(Onglet)
  Defil(0)\Cible = Ed
  Defil(1)\Cible = Ed
  LireDefilement(0)
  LireDefilement(1)
  CaretLigne = ScintillaSendMessage(Ed, #Scin_LineFromPosition, ScintillaSendMessage(Ed, #Scin_GetCurrentPos)) + 1
  CaretColonne = ScintillaSendMessage(Ed, #Scin_GetColumn, ScintillaSendMessage(Ed, #Scin_GetCurrentPos)) + 1
  Disposer()
EndProcedure

; Le résultat est un bloc Unicode compact (retour à la ligne, sans numéros)
; ou un texte de plusieurs lignes (code coloré, numéros)
Procedure ModeResultat(Code)
  If Code
    ScintillaSendMessage(#EditeurSortie, #Scin_SetWrapMode, 0)
    ScintillaSendMessage(#EditeurSortie, #Scin_SetMarginWidthN, 1, Bord())
  Else
    ScintillaSendMessage(#EditeurSortie, #Scin_SetWrapMode, 2)
    ScintillaSendMessage(#EditeurSortie, #Scin_SetMarginWidthN, 0, 0)
    ScintillaSendMessage(#EditeurSortie, #Scin_SetMarginWidthN, 1, 0)
  EndIf
EndProcedure

; ----------------------------------------------------------------------------
;  Charger un code, coller, ouvrir, déposer
; ----------------------------------------------------------------------------
Procedure ChangerTitreFenetre()
  If CodeOriginal$ = ""
    ChangerTitre(Tr("nomProgramme"))
  ElseIf FichierCharge$ <> ""
    ChangerTitre(FichierCharge$ + " - " + Tr("nomProgramme"))
  Else
    ChangerTitre(Tr("nomPressePapiers") + " - " + Tr("nomProgramme"))
  EndIf
EndProcedure

; ----------------------------------------------------------------------------
;  Projets (v7.2): charger un dossier, montrer un projet décompressé, et le
;  recréer dans un dossier choisi
; ----------------------------------------------------------------------------
Global DossierExtraction$          ; dernier dossier choisi pour recréer un projet (pendant la séance)

; Le projet de l'onglet « Code d'origine » est oublié
Procedure OublierProjetSource()
  If *PaquetSource
    FreeMemory(*PaquetSource)
    *PaquetSource = 0
  EndIf
  TaillePaquetSource = 0
  NbFichiersSource = 0
  ProjetCharge = #False
EndProcedure

; Le projet de l'onglet « Code décompressé » est oublié
Procedure OublierProjetLu()
  If *PaquetLu
    FreeMemory(*PaquetLu)
    *PaquetLu = 0
  EndIf
  TaillePaquetLu = 0
EndProcedure

; Couleurs de l'arbre d'un projet: commentaires en vert, dossiers en bleu,
; traits de l'arbre et tailles en gris, noms de fichiers en noir
Procedure ColorerProjet(Gadget)
  Protected Longueur, *t, *s, i, j, k, c, FinNom

  Longueur = ScintillaSendMessage(Gadget, #Scin_GetLength)
  If Longueur <= 0
    ProcedureReturn
  EndIf
  *t = ScintillaSendMessage(Gadget, #Scin_GetCharacterPointer)
  *s = AllocateMemory(Longueur + 1)
  If *t = 0 Or *s = 0
    If *s
      FreeMemory(*s)
    EndIf
    ProcedureReturn
  EndIf
  i = 0
  While i < Longueur
    ; fin de la ligne
    j = i
    While j < Longueur
      c = PeekA(*t + j)
      If c = 10 Or c = 13
        Break
      EndIf
      j = j + 1
    Wend
    If j > i
      If PeekA(*t + i) = 59                    ; ; commentaire
        FillMemory(*s + i, j - i, 2)
      Else
        ; traits de l'arbre (│ ├ └ ─, de U+2500 à U+257F: E2 94 xx ou E2 95 xx en UTF-8) et espaces
        k = i
        While k < j
          c = PeekA(*t + k)
          If c = 32
            k = k + 1
          ElseIf c = $E2 And k + 2 < j
            If PeekA(*t + k + 1) = $94 Or PeekA(*t + k + 1) = $95
              k = k + 3
            Else
              Break
            EndIf
          Else
            Break
          EndIf
        Wend
        FillMemory(*s + i, k - i, 10)
        If PeekA(*t + j - 1) = 47                ; / : un dossier
          FillMemory(*s + k, j - k, 1)
        Else
          ; un fichier: son nom, puis (après deux espaces) sa taille
          FinNom = k
          While FinNom < j
            If PeekA(*t + FinNom) = 32 And FinNom + 1 < j
              If PeekA(*t + FinNom + 1) = 32
                Break
              EndIf
            EndIf
            FinNom = FinNom + 1
          Wend
          FillMemory(*s + FinNom, j - FinNom, 10)
        EndIf
      EndIf
    EndIf
    ; retours à la ligne
    i = j
    While i < Longueur
      c = PeekA(*t + i)
      If c <> 10 And c <> 13
        Break
      EndIf
      i = i + 1
    Wend
  Wend
  ScintillaSendMessage(Gadget, #Scin_StartStyling, 0, 0)
  ScintillaSendMessage(Gadget, #Scin_SetStylingEx, Longueur, *s)
  FreeMemory(*s)
EndProcedure

; Montre l'arbre d'un projet dans un éditeur (sans numéros de ligne)
Procedure AfficherProjet(Gadget, Texte$)
  EditeurTexte(Gadget, Texte$, #False)
  ScintillaSendMessage(Gadget, #Scin_SetMarginWidthN, 0, 0)
  ColorerProjet(Gadget)
EndProcedure

; ----------------------------------------------------------------------------
;  Un dossier glissé ou ouvert: tous ses fichiers texte, sous-dossiers
;  compris, deviennent le « code d'origine » à compresser
; ----------------------------------------------------------------------------
Procedure ChargerDossier(Dossier$)
  Protected Nom$, n, NbFichiers, Liste$, Titre$, *Paquet

  If Occupe
    ProcedureReturn
  EndIf
  If Right(Dossier$, 1) <> #PS$
    Dossier$ = Dossier$ + #PS$
  EndIf
  Nom$ = GetFilePart(Left(Dossier$, Len(Dossier$) - 1))
  If NomProjetValide(Nom$) = #False
    Nom$ = Tr("nomProjetDefaut")              ; un disque entier (« D:\ »)
  EndIf
  Journal(#JournalInfo, TrF("journalLectureDossier", Guillemets(Nom$)))

  LibererEntreesProjet()
  ClearList(IgnoresProjet())
  ErreurProjet$ = ""
  OctetsLusProjet = 0
  VusProjet = 0
  n = LireDossierProjet(Dossier$, "", 0)
  If n < 0
    LibererEntreesProjet()
    ClearList(IgnoresProjet())
    Journal(#JournalErreur, ErreurProjet$)
    MessageDialogue(#DlgErreur, Tr("titreOuvrirDossier"), ErreurProjet$)
    ProcedureReturn
  EndIf
  ForEach EntreesProjet()
    If EntreesProjet()\Taille >= 0
      NbFichiers = NbFichiers + 1
    EndIf
  Next
  If NbFichiers = 0
    LibererEntreesProjet()
    ClearList(IgnoresProjet())
    Journal(#JournalAttention, TrF("projetSansTexte", Guillemets(Nom$)))
    MessageDialogue(#DlgAttention, Tr("titreOuvrirDossier"), TrF("projetSansTexte", Guillemets(Nom$)))
    ProcedureReturn
  EndIf
  *Paquet = ConstruirePaquet(Nom$)
  If *Paquet = 0
    LibererEntreesProjet()
    ClearList(IgnoresProjet())
    MessageDialogue(#DlgErreur, Tr("titreErreur"), Tr("memoireInsuffisante"))
    ProcedureReturn
  EndIf
  Titre$ = TrF("projetTitreSource", Guillemets(Nom$), Left(Dossier$, Len(Dossier$) - 1))
  Liste$ = TexteProjet(Nom$, Titre$, #True)
  LibererEntreesProjet()

  ; Le projet remplace le code chargé
  OublierProjetSource()
  *PaquetSource = *Paquet
  TaillePaquetSource = TailleNouveauPaquet
  NbFichiersSource = NbFichiersProjet
  ProjetCharge = #True
  CodeOriginal$ = Liste$
  FichierCharge$ = Nom$
  EstimationAJour = #False
  AfficherProjet(#EditeurEntree, Liste$)
  DernierResultat$ = ""
  EditeurTexte(#EditeurSortie, "", #False)
  DerniereTailleForum = 0

  Journal(#JournalOk, TrF("journalProjetCharge", Guillemets(Nom$), FormaterNombre(NbFichiersProjet), FormaterNombre(NbVidesProjet), FormaterNombre(OctetsProjet)))
  If ListSize(IgnoresProjet()) > 0
    Journal(#JournalAttention, TrF("journalProjetIgnores", FormaterNombre(ListSize(IgnoresProjet()))))
  EndIf
  ClearList(IgnoresProjet())
  If Reglage\Format <> #FormatBloc
    Journal(#JournalInfo, Tr("journalProjetDonneesSeules"))
  EndIf
  MettreAJourEstimations()
  ChangerTitreFenetre()
  MontrerOnglet(0)
EndProcedure

Procedure OuvrirDossier()
  Protected Dossier$
  If Occupe
    ProcedureReturn
  EndIf
  Dossier$ = PathRequester(Tr("titreOuvrirDossier"), "")
  If Dossier$ <> ""
    ChargerDossier(Dossier$)
  EndIf
EndProcedure

; ----------------------------------------------------------------------------
;  Recrée le projet décompressé: on choisit un dossier, le projet y est
;  recréé dans un sous-dossier NEUF à son nom (« Nom (2) » si le nom est
;  déjà pris). Rien n'est jamais écrasé.
; ----------------------------------------------------------------------------
Procedure ExtraireProjet()
  Protected Destination$, Racine$, Nom$, Message$, n

  If *PaquetLu = 0 Or Occupe
    ProcedureReturn
  EndIf
  If LirePaquet(*PaquetLu, TaillePaquetLu) = #False
    Journal(#JournalErreur, ErreurProjet$)
    MessageDialogue(#DlgErreur, Tr("titreRecreer"), ErreurProjet$)
    ProcedureReturn
  EndIf
  Nom$ = NomPaquet$
  Destination$ = PathRequester(TrF("titreChoisirDestination", Guillemets(Nom$)), DossierExtraction$)
  If Destination$ = ""
    LibererEntreesProjet()
    Journal(#JournalInfo, Tr("journalRecreationAnnulee"))
    ProcedureReturn
  EndIf
  DossierExtraction$ = Destination$
  Racine$ = RacineLibreProjet(Destination$, Nom$)
  If Racine$ = ""
    LibererEntreesProjet()
    Message$ = TrF("projetPlusDeNom", Guillemets(Nom$), Destination$)
    Journal(#JournalErreur, Message$)
    MessageDialogue(#DlgErreur, Tr("titreRecreer"), Message$)
    ProcedureReturn
  EndIf
  If GetFilePart(Racine$) <> Nom$
    ; le nom est déjà pris dans ce dossier: on le dit avant d'écrire
    If Dialogue(#DlgQuestion, Tr("titreRecreer"), TrF("questionNomPris", Guillemets(Nom$), Guillemets(GetFilePart(Racine$))), Tr("boutonContinuer") + Chr(10) + Tr("boutonAnnuler")) <> 0
      LibererEntreesProjet()
      Journal(#JournalInfo, Tr("journalRecreationAnnulee"))
      ProcedureReturn
    EndIf
  EndIf
  n = ExtrairePaquet(*PaquetLu, Racine$)
  LibererEntreesProjet()
  If n < 0
    Message$ = ErreurProjet$
    If FileSize(Racine$) = -2
      Message$ = Message$ + #LF$ + TrF("projetIncomplet", Racine$)
    EndIf
    Journal(#JournalErreur, Message$)
    MessageDialogue(#DlgErreur, Tr("titreRecreer"), Message$)
  Else
    Journal(#JournalOk, TrF("journalProjetRecree", FormaterNombre(n), Racine$))
  EndIf
EndProcedure

; Après la décompression d'un bloc de projet: les octets du paquet, gardés
; par DecompresserBloc, deviennent le projet de l'onglet « Code décompressé ».
; Renvoie #False si le paquet est abîmé ou piégé (ErreurProjet$).
Procedure AfficherProjetLu()
  Protected Liste$

  OublierProjetLu()
  *PaquetLu = *OctetsBloc
  TaillePaquetLu = TailleOctetsBloc
  *OctetsBloc = 0
  TailleOctetsBloc = 0
  If LirePaquet(*PaquetLu, TaillePaquetLu) = #False
    OublierProjetLu()
    ProcedureReturn #False
  EndIf
  Liste$ = TexteProjet(NomPaquet$, TrF("projetTitreLu", Guillemets(NomPaquet$)), #False)
  LibererEntreesProjet()
  CodeDecompresse$ = Liste$
  AfficherProjet(#EditeurDec, Liste$)
  ProcedureReturn #True
EndProcedure

Procedure ChargerCode(Texte$, Origine$, NomFichier$)
  Protected TailleSurForum

  OublierProjetSource()                      ; un code remplace un projet chargé
  CodeOriginal$ = Texte$
  FichierCharge$ = NomFichier$
  EstimationAJour = #False
  EditeurTexte(#EditeurEntree, Texte$, #True)
  DernierResultat$ = ""
  EditeurTexte(#EditeurSortie, "", #False)
  DerniereTailleForum = 0

  TailleSurForum = TailleForum(Texte$)
  Journal(#JournalInfo, TrF("journalCharge", Origine$, FormaterNombre(Len(Texte$)), FormaterNombre(TailleSurForum)))
  If Reglage\Limite > 0 And TailleSurForum <= Reglage\Limite
    Journal(#JournalOk, Tr("journalPasseDeja"))
  EndIf
  MettreAJourEstimations()
  ChangerTitreFenetre()
  MontrerOnglet(0)
EndProcedure

; Le texte est-il un bloc compressé ? (format compact Unicode, même un peu
; abîmé, ou format texte avec un en-tête PBC en début de ligne)
Procedure EstBlocCompresse(Texte$)
  Protected *c.Character, n, Total, Dans, Debut

  If EstBlocCompactPur(Texte$)
    ProcedureReturn #True
  EndIf
  *c = @Texte$
  While *c\c
    n = *c\c
    If n <> 32 And n <> 9 And n <> 10 And n <> 13
      Total = Total + 1
      If (n >= #DebutPlage1 And n <= #FinPlage1) Or (n >= #DebutPlage2 And n <= #FinPlage2)
        Dans = Dans + 1
      EndIf
    EndIf
    *c + SizeOf(Character)
  Wend
  If Dans > 8 And Dans * 10 >= Total * 9
    ProcedureReturn #True
  EndIf
  Debut = FindString(#LF$ + Texte$, #LF$ + "PBC")
  While Debut
    If EnTeteTexteValide(Mid(#LF$ + Texte$, Debut + 1, 200))
      ProcedureReturn #True
    EndIf
    Debut = FindString(#LF$ + Texte$, #LF$ + "PBC", Debut + 1)
  Wend
  ProcedureReturn #False
EndProcedure

; Le texte ressemble-t-il à un bloc ? (vrai bloc, ou texte presque
; entièrement fait d'idéogrammes: on essaie alors de le décompresser, ce qui
; dit clairement ce qui ne va pas, au lieu de le prendre pour un code)
Procedure RessembleABloc(Texte$)
  If Texte$ = ""
    ProcedureReturn #False
  EndIf
  ProcedureReturn Bool(EstBlocCompresse(Texte$) Or ProportionLarge(Texte$) >= 90)
EndProcedure

Procedure EstLanceur(Texte$)
  If FindString(#LF$ + Texte$, #LF$ + "; Code PureBasic compressé - lancez-le") Or FindString(#LF$ + Texte$, #LF$ + "; Compressed PureBasic code - run it") Or FindString(#LF$ + Texte$, #LF$ + "; Komprimierter PureBasic-Code - starte ihn")
    ProcedureReturn #True
  EndIf
  ProcedureReturn #False
EndProcedure

Declare FinOperation()

; Copier: le code obtenu est mis dans le presse-papiers (pas quand on
; décompresse le résultat qu'on vient de faire: il garde alors le bloc)
Procedure DecompresserTexte(Texte$, Copier = #True)
  Protected Resultat$, Infos$, Erreur$, Arrete, Projet

  Journal(#JournalInfo, Tr("journalDecompression"))
  ViderEvenements()
  EtatCree = #False
  EtatRelu = #False
  EtatMaximalPrepare = #False
  EtatMaximalRefuse = #False
  ReferenceDecompressee = 0
  ReseauCalibre = #False

  Resultat$ = DecompresserBloc(Texte$)
  Projet = BlocProjet
  Arrete = ArretDemande               ; (FinOperation l'efface)
  FinOperation()
  If Arrete
    ; bouton Stop: rien n'est gardé, et ce n'est pas une erreur
    Journal(#JournalAttention, Tr("journalArrete"))
    ProcedureReturn
  EndIf
  If Resultat$ = ""
    If BlocReconnu
      ; Un bloc est là, mais il n'a pas pu être lu: c'est une vraie erreur
      Journal(#JournalErreur, ErreurDecompression$)
      MessageDialogue(#DlgErreur, Tr("titreDecompresser"), ErreurDecompression$)
    Else
      Erreur$ = ErreurDecompression$
      If ProportionLarge(Texte$) >= 90
        ; idéogrammes, mais pas un bloc de ce programme
        Erreur$ = Tr("pasUnBlocLarge")
      EndIf
      Journal(#JournalAttention, Erreur$)
      MessageDialogue(#DlgInfo, Tr("titreDecompresser"), Erreur$)
    EndIf
  Else
    If Projet
      ; un projet: son arbre dans l'onglet, puis on le recrée (plus bas)
      If AfficherProjetLu() = #False
        Erreur$ = Tr("projetPiege") + #LF$ + ErreurProjet$
        Journal(#JournalErreur, Erreur$)
        MessageDialogue(#DlgErreur, Tr("titreDecompresser"), Erreur$)
        ProcedureReturn
      EndIf
      Infos$ = TrF("journalProjetDecompresse", Guillemets(NomPaquet$), FormaterNombre(NbFichiersProjet), FormaterNombre(NbVidesProjet), FormaterNombre(OctetsProjet))
    Else
      OublierProjetLu()
      CodeDecompresse$ = Resultat$
      EditeurTexte(#EditeurDec, Resultat$, #True)
      ; comme pour la compression, le résultat est copié tout de suite: il n'y a
      ; plus qu'à le coller dans PureBasic
      If Copier
        SetClipboardText(Resultat$)
      EndIf
      Infos$ = TrF("journalDecompresse", FormaterNombre(Len(Resultat$)))
    EndIf
    If CompteRenduProtection() <> ""
      Infos$ = Infos$ + " " + Trim(CompteRenduProtection())
    EndIf
    Journal(#JournalOk, Infos$)
    If Copier And Projet = #False
      Journal(#JournalOk, Tr("journalCodeCopie"))
    EndIf
    If EtatCree
      Journal(#JournalInfo, Tr("journalEtatEcrit"))
    ElseIf EtatRelu And EtatMaximalPrepare = #False
      Journal(#JournalInfo, Tr("journalEtatRelu"))
    EndIf
    If ReseauCalibre
      Journal(#JournalInfo, Tr("journalReseauMesure"))
    EndIf
    If CompteRenduReference() <> ""
      If EtatMaximalRefuse
        Journal(#JournalAttention, CompteRenduReference())
      Else
        Journal(#JournalInfo, CompteRenduReference())
      EndIf
    EndIf
    MettreAJourEstimations()
    MontrerOnglet(2)
    If Projet
      If Copier
        ExtraireProjet()               ; un bloc venu d'ailleurs: on le recrée tout de suite
      Else
        Journal(#JournalInfo, Tr("journalProjetPourRecreer"))
      EndIf
    EndIf
  EndIf
EndProcedure

; Un texte arrive (collé, ouvert, déposé): bloc compressé ou code ?
Procedure ChargerTexte(Texte$, Origine$, NomFichier$)
  If Occupe
    ProcedureReturn
  EndIf
  If RessembleABloc(Texte$)
    DecompresserTexte(Texte$)
  Else
    If EstLanceur(Texte$)
      Journal(#JournalInfo, Tr("journalLanceur"))
    EndIf
    ChargerCode(Texte$, Origine$, NomFichier$)
  EndIf
EndProcedure

; Bouton « Décompresser »: le bloc de l'onglet affiché (code d'origine ou
; résultat), sinon celui du presse-papiers
Procedure Decompresser()
  Protected Texte$
  If OngletActif = 0 And RessembleABloc(CodeOriginal$)
    Texte$ = CodeOriginal$
  ElseIf OngletActif = 1 And RessembleABloc(DernierResultat$)
    DecompresserTexte(DernierResultat$, #False)
    ProcedureReturn
  Else
    Texte$ = GetClipboardText()
    If RessembleABloc(Texte$) = #False
      MessageDialogue(#DlgInfo, Tr("titreDecompresser"), TrF("aucunBloc", TexteRaccourci("Ctrl+V")))
      ProcedureReturn
    EndIf
  EndIf
  DecompresserTexte(Texte$)
EndProcedure

Procedure Coller()
  Protected Texte$ = GetClipboardText()
  If Texte$ = ""
    MessageDialogue(#DlgAttention, Tr("titreColler"), Tr("pressePapiersVide"))
  Else
    ChargerTexte(Texte$, Tr("originePressePapiers"), "")
  EndIf
EndProcedure

Procedure ChargerFichier(NomFichier$)
  Protected Texte$
  Texte$ = LireFichier(NomFichier$)
  If Texte$ = ""
    MessageDialogue(#DlgAttention, Tr("titreOuvrir"), TrF("fichierIllisible", NomFichier$))
  Else
    ChargerTexte(Texte$, Guillemets(GetFilePart(NomFichier$)), GetFilePart(NomFichier$))
  EndIf
EndProcedure

Procedure OuvrirFichier()
  Protected NomFichier$
  NomFichier$ = OpenFileRequester(Tr("titreOuvrirFichier"), "", Tr("filtreOuvrir"), 0)
  If NomFichier$ <> ""
    ChargerFichier(NomFichier$)
  EndIf
EndProcedure

Procedure EnregistrerOnglet()
  Protected Texte$, Nom$, Filtre$, NomFichier$, Fichier

  ; Un projet décompressé s'enregistre en le recréant ; un projet chargé
  ; n'est pas un code à enregistrer
  If OngletActif = 2 And *PaquetLu
    ExtraireProjet()
    ProcedureReturn
  EndIf
  If OngletActif = 0 And ProjetCharge
    ProcedureReturn
  EndIf
  Texte$ = TexteOnglet(OngletActif)
  If Texte$ = ""
    ProcedureReturn
  EndIf
  Select OngletActif
    Case 1
      If DernierFormat = #FormatLanceur
        Nom$ = Tr("nomFichierLanceur")
        Filtre$ = Tr("filtrePB")
      Else
        Nom$ = Tr("nomFichierBloc")
        Filtre$ = Tr("filtreTXT")
      EndIf
    Case 2
      Nom$ = "Code.pb"
      Filtre$ = Tr("filtrePB")
    Default
      Nom$ = FichierCharge$
      If Nom$ = ""
        Nom$ = "Code.pb"
      EndIf
      Filtre$ = Tr("filtrePB")
  EndSelect
  NomFichier$ = SaveFileRequester(Tr("titreEnregistrer"), Nom$, Filtre$, 0)
  If NomFichier$ <> ""
    If GetExtensionPart(NomFichier$) = ""
      NomFichier$ = NomFichier$ + "." + GetExtensionPart(Nom$)
    EndIf
    Fichier = CreateFile(#PB_Any, NomFichier$)
    If Fichier
      ; UTF-8 avec marque: le format normal de l'éditeur PureBasic
      WriteStringFormat(Fichier, #PB_UTF8)
      WriteString(Fichier, Texte$, #PB_UTF8)
      CloseFile(Fichier)
      Journal(#JournalOk, TrF("journalEnregistre", NomFichier$))
    Else
      MessageDialogue(#DlgErreur, Tr("titreEnregistrer"), TrF("creationImpossible", NomFichier$))
    EndIf
  EndIf
EndProcedure

Procedure.s TitreOnglet(Onglet)
  Select Onglet
    Case 1
      ProcedureReturn Tr("ongletResultat")
    Case 2
      ProcedureReturn Tr("ongletDecompresse")
  EndSelect
  ProcedureReturn Tr("ongletOrigine")
EndProcedure

Procedure CopierOnglet()
  Protected Texte$ = TexteOnglet(OngletActif)
  If Texte$ <> ""
    SetClipboardText(Texte$)
    Journal(#JournalOk, TrF("journalOngletCopie", Guillemets(TitreOnglet(OngletActif))))
  EndIf
EndProcedure

; Éditeur qui a le clavier (sinon celui de l'onglet affiché)
Procedure EditeurCible()
  Protected g = GetActiveGadget()
  If g = #EditeurEntree Or g = #EditeurSortie Or g = #EditeurDec Or g = #EditeurJournal
    ProcedureReturn g
  EndIf
  ProcedureReturn EditeurDeOnglet(OngletActif)
EndProcedure

; Texte complet d'un éditeur (il peut n'en montrer que le début)
Procedure.s TexteCompletEditeur(Gadget)
  Select Gadget
    Case #EditeurSortie
      ProcedureReturn DernierResultat$
    Case #EditeurDec
      ProcedureReturn CodeDecompresse$
  EndSelect
  ProcedureReturn CodeOriginal$
EndProcedure

Procedure CopierSelection()
  Protected g
  If GetActiveGadget() = #ChampLimite
    SendMessage_(GadgetID(#ChampLimite), #W_WM_COPY, 0, 0)
    ProcedureReturn
  EndIf
  g = EditeurCible()
  ; tout est sélectionné dans un texte montré en partie: tout le texte est copié
  If TexteTronque(g) And ScintillaSendMessage(g, #Scin_GetSelectionStart) = 0 And ScintillaSendMessage(g, #Scin_GetSelectionEnd) >= ScintillaSendMessage(g, #Scin_GetLength)
    SetClipboardText(TexteCompletEditeur(g))
  Else
    ScintillaSendMessage(g, #Scin_Copy)
  EndIf
EndProcedure

Procedure ToutSelectionner()
  Protected g
  If GetActiveGadget() = #ChampLimite
    SendMessage_(GadgetID(#ChampLimite), #W_EM_SETSEL, 0, -1)
    ProcedureReturn
  EndIf
  g = EditeurCible()
  SetActiveGadget(g)
  ScintillaSendMessage(g, #Scin_SelectAll)
EndProcedure

Procedure EffacerSortie()
  ScintillaSendMessage(#EditeurJournal, #Scin_SetReadOnly, 0)
  ScintillaSendMessage(#EditeurJournal, #Scin_ClearAll)
  ScintillaSendMessage(#EditeurJournal, #Scin_SetReadOnly, 1)
  MettreAJourDefilements()
EndProcedure

; ----------------------------------------------------------------------------
;  Réglages: changement d'une propriété, langue
; ----------------------------------------------------------------------------
Procedure ChangerPropriete(p, Valeur)
  Select p
    Case #ProFormat
      Reglage\Format = Valeur
    Case #ProEncodage
      Reglage\Encodage = Valeur
    Case #ProLangue
      Reglage\LangueResultat = Valeur
    Case #ProIDE
      Reglage\GarderIDE = Valeur
      EstimationAJour = #False
    Case #ProMethode
      Reglage\Methode = Valeur
    Case #ProNiveau
      Reglage\Niveau = Valeur
    Case #ProProtection
      Reglage\Protection = Valeur
    Case #ProGarderEtat
      GarderEtat = Valeur
  EndSelect
  MettreAJourEstimations()
  DessinerGrille()
  DessinerOutils()
  DessinerEtat()
  If OngletActif = 1
    DessinerBandeau()
  EndIf
EndProcedure

Procedure ChoisirDansListe(Cible, Valeur)
  If Cible = -2
    ChangerPropriete(#ProNiveau, Valeur)
  ElseIf Cible >= 0
    ChangerPropriete(Cible, Valeur)
  EndIf
EndProcedure

Procedure ChangerLangue(Nouvelle)
  If Nouvelle < #LangueFr Or Nouvelle > #LangueDe
    ProcedureReturn
  EndIf
  Langue = Nouvelle
  MettreAJourEstimations()
  ChangerTitreFenetre()
  RaccourcisMenus()
  Disposer()
  Journal(#JournalInfo, Tr("journalLangue"))
EndProcedure

; ----------------------------------------------------------------------------
;  Effacer ce qui est gardé sur le disque
; ----------------------------------------------------------------------------
Procedure EffacerEtats()
  Protected i, Place$

  Place$ = FormaterOctets(PlaceEtats())
  If Dialogue(#DlgQuestion, Tr("titreEffacer"), TrF("questionEffacer", Place$), Tr("boutonOui") + Chr(10) + Tr("boutonNon")) <> 0
    ProcedureReturn
  EndIf
  ; Depuis la v6.4, le texte de référence décompressé est effacé aussi: il
  ; faudra redécompresser le fichier de référence (quelques minutes)
  For i = #NiveauMoyen To #NiveauMaximal
    DeleteFile(FichierEtat(i))
    DeleteFile(FichierEtat(i) + ".tmp")
  Next
  DeleteFile(FichierTexteReference())
  DeleteFile(FichierTexteReference() + ".tmp")
  Journal(#JournalOk, TrF("journalEfface", Place$))
  MettreAJourEstimations()
  DessinerGrille()
EndProcedure

; ----------------------------------------------------------------------------
;  Bouton Stop (ou Échap): l'opération en cours s'arrête au prochain point
;  d'avancement du moteur (quelques millisecondes), et son résultat est jeté.
; ----------------------------------------------------------------------------
Procedure Arreter()
  If Occupe And ArretDemande = #False
    ArretDemande = #True
    OutilAppui = -1
    BarreEtatTexte(Tr("arretEnCours"))
    DessinerOutils()
  EndIf
EndProcedure

; Pendant une opération, la boucle principale ne tourne pas (le moteur vide
; les événements lui-même): ces deux procédures, liées par BindGadgetEvent et
; BindEvent, gardent le bouton Stop et la touche Échap vivants.
Procedure EvenementOutilsOccupe()
  Protected p.POINT, i

  If Occupe = #False
    ProcedureReturn                   ; hors opération: voir EvenementGadget
  EndIf
  SourisDans(#CanvasOutils, @p)
  i = OutilSous(p\x, p\y)
  If i >= 0 And OutilCmd(i) <> #CmdArreter
    i = -1                            ; seul Stop répond pendant le calcul
  EndIf
  Select EventType()
    Case #PB_EventType_MouseMove
      If i <> OutilSurvol
        OutilSurvol = i
        BulleOutil(i)
        DessinerOutils()
      EndIf
    Case #PB_EventType_MouseLeave
      OutilSurvol = -1
      OutilAppui = -1
      DessinerOutils()
    Case #PB_EventType_LeftButtonDown
      If i >= 0 And OutilInactif(i) = #False
        OutilAppui = i
        DessinerOutils()
      EndIf
    Case #PB_EventType_LeftButtonUp
      If OutilAppui >= 0 And OutilAppui = i
        Arreter()
      Else
        OutilAppui = -1
        DessinerOutils()
      EndIf
  EndSelect
EndProcedure

Procedure EvenementMenuOccupe()
  If Occupe And EventMenu() = #CmdArreter
    Arreter()
  EndIf
EndProcedure

; ----------------------------------------------------------------------------
;  Fin d'une opération (compression ou décompression): les clics faits pendant
;  le calcul sont ignorés, puis tout est remis dans le bon état.
; ----------------------------------------------------------------------------
Procedure FinOperation()
  ViderEvenements()
  InterfaceOccupee(#False)
  MettreAJourEstimations()
  RedessinerTout()
EndProcedure

; ----------------------------------------------------------------------------
;  Compression complète
; ----------------------------------------------------------------------------
Procedure Compresser()
  Protected Texte$, Format, Methode, LangueSortie, Encodage$, Pourcentage$, Etapes$, Details$, Niveau, Modele, Reseau, MethodeV
  Protected.q Taille, K, ZL, ZM, Debut, PoidsR, PoidsC
  Protected *Source, *ZL, *ZM, *Avec, *NNP
  Protected SortieL$, SortieM$, Sortie$, Retenue$, TailleL, TailleM, TailleForumOriginal, TailleForumSortie
  Protected OkL, OkM, NiveauProtection, OkProtection, BrutL$, BrutM$, Brut$, NomMaximal$
  Protected Parallele, VerifOk, ReseauOk, Etape$, Raison$, Erreur$, FilsReseau, MaximalImpossible
  Protected *Verif, VersionL$, Decalage

  If Occupe
    ProcedureReturn
  EndIf
  If ProjetCharge
    ; un projet: son paquet est compressé tel quel (chaque fichier revient à
    ; l'identique, bloc « IDE Options » compris)
    If *PaquetSource = 0 Or TaillePaquetSource <= 0
      MessageDialogue(#DlgAttention, Tr("titreCompresser"), Tr("aucunCode"))
      ProcedureReturn
    EndIf
  Else
    Texte$ = CodeOriginal$
    If Reglage\GarderIDE = #False
      Texte$ = RetirerOptionsIDE(Texte$)
    EndIf
    If Texte$ = ""
      MessageDialogue(#DlgAttention, Tr("titreCompresser"), Tr("aucunCode"))
      ProcedureReturn
    EndIf
  EndIf

  Format = FormatEffectif()
  Niveau = NiveauChoisi()
  Modele = Niveau - 1                       ; réseau des niveaux 2 (1) et 3 (2)
  Reseau = Bool(Niveau >= 2)
  MethodeV = MethodeNiveau(Niveau)          ; méthode v6 du niveau (8, ou 9 au niveau 3)
  Methode = Reglage\Methode
  LangueSortie = Reglage\LangueResultat
  If Reglage\Encodage = #EncodageBase64
    Encodage$ = "B"
  Else
    Encodage$ = "U"
  EndIf

  ; Protection contre les erreurs: seulement en données seules + Unicode
  If Format = #FormatBloc And Encodage$ = "U"
    NiveauProtection = NiveauProtectionChoisi()
  EndIf

  If Format = #FormatBloc And Methode <> #MethodeLZMA
    ; Ce qui va se passer, dit avant de commencer
    Parallele = ParalleleDisponible5(#True, MethodeV)
    If Parallele = #False
      Raison$ = RaisonSansParallele(MethodeV)        ; gardée pour le résumé final
    EndIf
    If TravailReference(#NiveauFaible) > 0
      Etapes$ = Tr("pDebutReference") + ", "
    EndIf
    If Reseau
      If NNCoeurs < 1
        NNCoeursPhysiques()
      EndIf
      If ReseauMesure(Modele) = #False
        Etapes$ = Etapes$ + Tr("pMesureReseau") + ", "
      EndIf
      Etapes$ = Etapes$ + TrF("pReseauCoeurs", Str(NNCoeurs)) + ", "
    EndIf
    If Parallele
      Etapes$ = Etapes$ + Tr("pCompressionParallele")
    Else
      Etapes$ = Etapes$ + TrF("pCompressionPuisVerif", Raison$)
    EndIf
    Journal(#JournalInfo, TrF("journalCompressionNiveau", Str(Niveau), Etapes$))
  Else
    Journal(#JournalInfo, Tr("journalCompression"))
  EndIf
  ViderEvenements()

  ; Boutons et réglages grisés pendant toute l'opération (voir FinOperation)
  ActiverBoutons(#False)
  EtatCree = #False
  EtatRelu = #False
  EtatMaximalPrepare = #False
  EtatMaximalRefuse = #False
  ReferenceDecompressee = 0
  ReseauCalibre = #False

  ; 1. Texte -> octets UTF-8 (projet: son paquet)
  If ProjetCharge
    Taille = TaillePaquetSource
  Else
    Taille = StringByteLength(Texte$, #PB_UTF8)
  EndIf
  *Source = AllocateMemory(Taille + 1)
  If *Source = 0
    FinOperation()
    MessageDialogue(#DlgErreur, Tr("titreErreur"), Tr("memoireInsuffisante"))
    ProcedureReturn
  EndIf
  If ProjetCharge
    CopyMemory(*PaquetSource, *Source, Taille)
    TailleForumOriginal = TailleForum(PeekS(*Source, Taille, #PB_UTF8 | #PB_ByteLength))
    ; formats d'un projet: PBC12 (LZMA), PBC19 à PBC21 (Maximal v6)
    VersionL$ = "PBC12"
    Decalage = 3
  Else
    PokeS(*Source, Texte$, -1, #PB_UTF8)
    TailleForumOriginal = TailleForum(Texte$)
    VersionL$ = "PBC1"
  EndIf
  K = Controle(*Source, Taille)

  ; Barre de progression: la méthode Maximal v5 calcule le réseau (niveaux 2
  ; et 3), lit le texte de référence, compresse et vérifie (en même temps si
  ; un second thread est possible). Voir TravailCompression5.
  If Format = #FormatBloc And Methode <> #MethodeLZMA
    DebutProgression(TravailCompression5(Taille, Niveau, Parallele))
  EndIf

  ; 2. Méthode LZMA
  If Methode = #MethodeAuto Or Methode = #MethodeLZMA
    *ZL = AllocateMemory(Taille + Taille / 4 + 1024)
    If *ZL
      ZL = CompressMemory(*Source, Taille, *ZL, Taille + Taille / 4 + 1024, #PB_PackerPlugin_Lzma, 9)
      If ZL > 0
        If Format = #FormatBloc
          SortieL$ = GenererBloc(EncoderDonnees(*ZL, ZL, Encodage$), Taille, ZL, K, "L", Encodage$, LangueSortie, VersionL$)
          If NiveauProtection > 0
            BrutL$ = SortieL$
            SortieL$ = ProtegerBloc(SortieL$, NiveauProtection)
          EndIf
        Else
          SortieL$ = GenererLanceur(EncoderDonnees(*ZL, ZL, Encodage$), Taille, ZL, K, "L", Encodage$, LangueSortie)
        EndIf
        TailleL = TailleForum(SortieL$)
      EndIf
      FreeMemory(*ZL)
    EndIf
  EndIf

  ; 3. Méthode Maximal
  If Methode = #MethodeAuto Or Methode = #MethodeMaximal
    *ZM = AllocateMemory(Taille + Taille / 2 + 1024)
    If *ZM
      If Format = #FormatBloc
        ; Version 6 (PBC16 à PBC18 selon le niveau, PBC19 à PBC21 pour un
        ; projet): le segment 0 du texte de référence est placé devant le
        ; code, avec les listes de mots ; aux niveaux 2 et 3, les
        ; probabilités du réseau sont calculées d'avance pour tout le code
        Erreur$ = ""
        If MemoireMethode5(MethodeV) = #False
          Erreur$ = TrF("memoireMaximal5", Decimal(GoMethode(MethodeV), 1))
        ElseIf ConstruireReference(#NiveauFaible) = #False
          Erreur$ = ErreurReference$
        ElseIf ChargerDictionnaires() = #False
          Erreur$ = ErreurReference$
        ElseIf Reseau
          AfficherEtape(TrF("chargementReseau", Str(Niveau)))
          If PreparerReseau(Modele) = #False
            Erreur$ = ErreurReference$
          Else
            ; le travail qui reste, d'après les vitesses (peut-être tout juste mesurées)
            ProgresTotal = ProgresFait + TravailCompression5(Taille, Niveau, Parallele)
          EndIf
        EndIf
        If Erreur$ = ""
          *Avec = AllocateMemory(TailleReference + Taille + 16)
          If Reseau
            *NNP = AllocateMemory((Taille * 16) + 16)
          EndIf
          If *Avec = 0 Or (Reseau And *NNP = 0)
            Erreur$ = Tr("memoireInsuffisante")
          EndIf
        EndIf
        If Erreur$ <> ""
          MaximalImpossible = #True
          If ArretDemande = #False
            Journal(#JournalErreur, Erreur$ + " " + Tr("maximalDesactive"))
            MessageDialogue(#DlgErreur, Tr("titreErreur"), Erreur$ + #LF$ + Tr("maximalDesactive"))
          EndIf
        Else
          CopyMemory(*Reference, *Avec, TailleReference)
          CopyMemory(*Source, *Avec + TailleReference, Taille)
          Etape$ = TrF("etapeCompressionNiveau", Str(Niveau))
          ReseauOk = #True

          ; a) Réseau: probabilités de tout le code, calculées par morceaux sur
          ;    tous les cœurs ; puis contrôle du début du code par le calcul de la
          ;    décompression (octet par octet, avec les fils choisis pour ce PC,
          ;    comme chez le lecteur). Ce temps n'entre pas dans la mesure de la
          ;    vitesse de la méthode.
          If Reseau
            Debut = ElapsedMilliseconds()
            PoidsR = PoidsReseau(VitesseReseauComp(Modele, Taille))
            PoidsC = PoidsReseau(VitesseReseauDec(Modele))
            CommencerPasse(TrF("etapeReseau", Str(NNCoeurs)), PoidsR)
            FilsReseau = ReseauMorceaux(*Source, Taille, *NNP)
            TerminerPasse(Taille)
            CommencerPasse(TrF("etapeControleReseau", Str(NNCalFils(Modele))), PoidsC)
            ReseauOk = ReseauControle(*Source, *NNP, OctetsControleReseau(Taille), NNCalFils(Modele), NNCalVariante(Modele))
            TerminerPasse(OctetsControleReseau(Taille))
            ProgresHorsTemps = ProgresHorsTemps + (ElapsedMilliseconds() - Debut)
            ProgresHorsUnites = ProgresHorsUnites + (Taille * PoidsR) + (OctetsControleReseau(Taille) * PoidsC)
          EndIf

          If ArretDemande
            ; bouton Stop pendant le réseau: la compression ne commence pas
          ElseIf ReseauOk = #False
            ; ne devrait jamais arriver: le calcul par morceaux et celui de la
            ; décompression doivent donner exactement les mêmes nombres
            MaximalImpossible = #True
            Journal(#JournalErreur, Tr("controleReseauRate"))
            MessageDialogue(#DlgErreur, Tr("titreErreur"), Tr("controleReseauRate") + #LF$ + Tr("maximalDesactiveSignale"))
          Else
            ZM = -1
            ; b) Compression, avec la vérification en même temps si possible
            CompilerIf #PB_Compiler_Thread
              If Parallele
                *Verif = AllocateMemory(TailleReference + Taille + 16)
                If *Verif
                  ZM = CompresserEnParallele(*Avec, Taille, *ZM, *Verif, *NNP, Reseau, K, Etape$ + " " + Tr("etVerification"), MethodeV)
                  FreeMemory(*Verif)
                  VerifOk = VerifParalleleOk
                EndIf
              EndIf
            CompilerEndIf
            If ZM < 0
              ; c) Sinon: compression, puis vérification par le même vérificateur
              Parallele = #False
              CommencerPasse(Etape$, PoidsMethode(MethodeV))
              ZM = EncoderMethode(MethodeV, *Avec, Taille, *ZM, TailleReference, *NNP, Reseau)
              TerminerPasse(TailleReference + Taille)
              VerifOk = VerifierModele5(*ZM, ZM, Taille, *Source, *NNP, Reseau, K, MethodeV)
            EndIf

            If ArretDemande = #False
              SortieM$ = GenererBloc(EncoderDonnees(*ZM, ZM, Encodage$), Taille, ZM, K, "M", Encodage$, LangueSortie, "PBC" + Str(15 + Decalage + Niveau))
              If NiveauProtection > 0
                BrutM$ = SortieM$
                SortieM$ = ProtegerBloc(SortieM$, NiveauProtection)
              EndIf
              TailleM = TailleForum(SortieM$)
            EndIf
          EndIf
        EndIf
        If *Avec
          FreeMemory(*Avec)
          *Avec = 0
        EndIf
        If *NNP
          FreeMemory(*NNP)
          *NNP = 0
        EndIf
      Else
        ; Lanceur auto-extractible: version 1, sans texte de référence
        ZM = EncoderCM(*Source, Taille, *ZM)
        SortieM$ = GenererLanceur(EncoderDonnees(*ZM, ZM, Encodage$), Taille, ZM, K, "M", Encodage$, LangueSortie)
        TailleM = TailleForum(SortieM$)
      EndIf
      ; (*ZM est gardé jusqu'au contrôle du texte du bloc, plus bas)
    EndIf
  EndIf

  ; 4. Vérification de chaque candidat, puis choix du plus court
  If ArretDemande
    SortieL$ = ""
    SortieM$ = ""
  EndIf
  If SortieL$ <> ""
    If ProjetCharge
      OkL = VerifierSortieProjet(SortieL$, *Source, Taille)
    Else
      OkL = VerifierSortie(SortieL$, Format, Texte$, Taille, ZL, K, "L", Encodage$)
    EndIf
  EndIf
  If SortieM$ <> ""
    If Format = #FormatBloc
      ; Méthode v6: le modèle vient d'être vérifié par une décompression complète
      ; (VerifOk). Il reste à contrôler le texte du bloc lui-même: il doit
      ; redonner exactement ces octets compressés, donc ce code.
      If VerifOk
        *VerifOctets = *ZM
        VerifZ = ZM
        *VerifCode = *Source
        VerifT = Taille
        VerifVersion = 15 + Niveau         ; (un projet se lit comme PBC16 à PBC18)
        If ProjetCharge
          OkM = VerifierSortieProjet(SortieM$, *Source, Taille)
        Else
          OkM = VerifierSortie(SortieM$, Format, Texte$, Taille, ZM, K, "M", Encodage$)
        EndIf
        *VerifOctets = 0
        *VerifCode = 0
        VerifZ = 0
        VerifT = 0
      EndIf
    Else
      OkM = VerifierSortie(SortieM$, Format, Texte$, Taille, ZM, K, "M", Encodage$)
    EndIf
  EndIf
  If *ZM
    FreeMemory(*ZM)
  EndIf
  FreeMemory(*Source)
  FinProgression()

  ; Bouton Stop: tout est jeté, le résultat précédent reste affiché
  If ArretDemande
    FinOperation()
    Journal(#JournalAttention, Tr("journalArrete"))
    ProcedureReturn
  EndIf

  ; Nom affiché, et rapport Maximal / LZMA retenu pour les estimations suivantes
  NomMaximal$ = "Maximal"
  If Format = #FormatBloc
    NomMaximal$ = TrF("maximalNiveau", Str(Niveau))
    If OkM And EstimationAJour And EstimationTaille = Taille And EstimationLZMA > 0
      If RapportNiveau(Niveau) > 0
        RapportNiveau(Niveau) = (RapportNiveau(Niveau) + ((ZM * 1000) / EstimationLZMA)) / 2
      Else
        RapportNiveau(Niveau) = (ZM * 1000) / EstimationLZMA
      EndIf
    EndIf
  EndIf

  If OkL And OkM
    If TailleM < TailleL
      Sortie$ = SortieM$: Retenue$ = NomMaximal$: Brut$ = BrutM$
    Else
      Sortie$ = SortieL$: Retenue$ = "LZMA": Brut$ = BrutL$
    EndIf
  ElseIf OkL
    Sortie$ = SortieL$: Retenue$ = "LZMA": Brut$ = BrutL$
  ElseIf OkM
    Sortie$ = SortieM$: Retenue$ = NomMaximal$: Brut$ = BrutM$
  EndIf

  If Sortie$ = ""
    DernierResultat$ = ""
    EditeurTexte(#EditeurSortie, "", #False)
    DerniereTailleForum = 0
    FinOperation()
    MontrerOnglet(1)
    If MaximalImpossible And SortieL$ = "" And SortieM$ = ""
      ; rien n'a pu être fait (le message de la méthode Maximal est déjà
      ; passé): ce n'est pas un échec de la vérification
      Journal(#JournalAttention, Tr("aucunResultatMaximal"))
    Else
      Journal(#JournalErreur, Tr("journalEchecVerification"))
      MessageDialogue(#DlgErreur, Tr("titreErreur"), Tr("echecVerification"))
    EndIf
    ProcedureReturn
  EndIf

  ; 5. Bloc protégé: on vérifie aussi la réparation, sur des copies
  ;    abîmées exprès
  If NiveauProtection > 0
    OkProtection = TesterProtection(Sortie$, Brut$)
    If ArretDemande                   ; Stop pendant le test de la réparation
      FinOperation()
      Journal(#JournalAttention, Tr("journalArrete"))
      ProcedureReturn
    EndIf
  EndIf

  ; 6. Résultat
  DernierResultat$ = Sortie$
  If Format = #FormatBloc And Encodage$ = "U"
    ModeResultat(#False)
    EditeurTexte(#EditeurSortie, Sortie$, #False)
  Else
    ModeResultat(#True)
    EditeurTexte(#EditeurSortie, Sortie$, #True)
  EndIf
  TexteBloc(#EditeurSortie) = Bool(Format = #FormatBloc)
  SetClipboardText(Sortie$)

  TailleForumSortie = TailleForum(Sortie$)
  Pourcentage$ = Decimal(TailleForumSortie * 100.0 / TailleForumOriginal, 1)

  Journal(#JournalOk, TrF("journalCompresse", FormaterNombre(TailleForumSortie), Pourcentage$, Retenue$))
  Details$ = ""
  If SortieL$ <> ""
    Details$ = TrF("detailMethode", "LZMA", FormaterNombre(TailleL))
    If OkL = #False
      Details$ = Details$ + " " + Tr("detailRatee")
    EndIf
  EndIf
  If SortieM$ <> ""
    If Details$ <> ""
      Details$ = Details$ + " · "
    EndIf
    Details$ = Details$ + TrF("detailMethode", NomMaximal$, FormaterNombre(TailleM))
    If OkM = #False
      Details$ = Details$ + " " + Tr("detailRatee")
    EndIf
  EndIf
  Details$ = Details$ + " · " + TrF("detailOriginal", FormaterNombre(TailleForumOriginal))
  Journal(#JournalInfo, Details$)
  If ProjetCharge = #False And Len(Texte$) < Len(CodeOriginal$)
    Journal(#JournalInfo, TrF("journalIDERetire", FormaterNombre(Len(CodeOriginal$) - Len(Texte$))))
  EndIf
  If NiveauProtection > 0
    If OkProtection
      Journal(#JournalOk, TrF("journalProtectionTestee", NomNiveauProtection(NiveauProtection)))
    Else
      Journal(#JournalErreur, TrF("journalProtectionRatee", NomNiveauProtection(NiveauProtection)))
    EndIf
  EndIf
  If Format = #FormatBloc And SortieM$ <> "" And Retenue$ = NomMaximal$
    If Parallele
      Journal(#JournalInfo, Tr("journalVerifParallele"))
    Else
      If Raison$ = ""                        ; prévu en parallèle, mais le second thread n'a pas pu partir
        Raison$ = Tr("raisonThreadCompression")
      EndIf
      Journal(#JournalInfo, TrF("journalVerifApres", Raison$))
    EndIf
    If Reseau
      Journal(#JournalInfo, TrF("journalReseau", Str(FilsReseau), TexteFilsReseau(Modele)))
    EndIf
  EndIf
  If ReseauCalibre
    Journal(#JournalInfo, Tr("journalReseauMesure"))
  EndIf
  If CompteRenduReference() <> ""
    If EtatMaximalRefuse
      Journal(#JournalAttention, CompteRenduReference())
    Else
      Journal(#JournalInfo, CompteRenduReference())
    EndIf
  EndIf
  Journal(#JournalOk, Tr("journalCopie"))

  DerniereTailleForum = TailleForumSortie
  DernierModeBase64 = Bool(Encodage$ = "B")
  DernierFormat = Format
  FinOperation()
  MontrerOnglet(1)

  If (SortieL$ <> "" And OkL = #False) Or (SortieM$ <> "" And OkM = #False)
    MessageDialogue(#DlgAttention, Tr("titreAttention"), Tr("uneMethodeEcartee"))
  ElseIf NiveauProtection > 0 And OkProtection = #False
    MessageDialogue(#DlgAttention, Tr("titreAttention"), Tr("testReparationRate"))
  ElseIf TailleForumSortie >= TailleForumOriginal
    MessageDialogue(#DlgAttention, Tr("titreAttention"), Tr("codeTropPetit"))
  EndIf
EndProcedure

; ----------------------------------------------------------------------------
;  Dialogues d'aide
; ----------------------------------------------------------------------------
Procedure DialogueAPropos()
  Protected Corps$
  Corps$ = "#T " + Tr("nomProgramme") + #LF$ + Tr("aproposTexte") + #LF$ + TrF("aproposVersion", "7.3") + " " + Tr("aproposLicence") + #LF$
  Corps$ = Corps$ + "#C github.com/DieppedalleDavid/Compresseur-de-Code-PB" + #LF$ + "#M Copyright (c) 2026 Shadow (Dieppedalle David)"
  Dialogue(#DlgSimple, Tr("titreAPropos"), Corps$, Tr("boutonOK"))
EndProcedure

Procedure DialogueAide()
  Protected Corps$
  Corps$ = "#1 " + TrF("aide1", TexteRaccourci("Ctrl+V"), TexteRaccourci("Ctrl+O")) + #LF$ + "#1 " + Tr("aide2") + #LF$ + "#1 " + Tr("aide3") + #LF$ + "#1 " + TrF("aide4", TexteRaccourci("Ctrl+V")) + #LF$ + "#1 " + TrF("aide5", TexteRaccourci("Ctrl+Shift+O"))
  Dialogue(#DlgSimple, Tr("titreAide"), Corps$, Tr("boutonOK"))
EndProcedure

Procedure DialogueCredits()
  Protected Corps$
  Corps$ = Tr("credits1") + #LF$ + Tr("credits2") + #LF$ + "#M SicroAtGit/PureBasic-CodeArchiv-Rebirth · Hoeppner1867/PureBasic · codeprof/small-PureBasic-projects · deseven/pbsamples · tajmone/purebasic-archives" + #LF$
  Corps$ = Corps$ + Tr("credits4") + #LF$ + "#M " + Tr("credits5") + #LF$ + "#M " + Tr("credits3")
  Dialogue(#DlgSimple, Tr("titreCredits"), Corps$, Tr("boutonOK"))
EndProcedure

; ----------------------------------------------------------------------------
;  Commandes (menus, barre d'outils, raccourcis clavier)
; ----------------------------------------------------------------------------
Procedure ExecuterCommande(Commande)
  If Commande = #CmdArreter
    Arreter()
    ProcedureReturn
  EndIf
  If Occupe
    ProcedureReturn
  EndIf
  Select Commande
    Case #CmdOuvrir
      OuvrirFichier()
    Case #CmdOuvrirDossier
      OuvrirDossier()
    Case #CmdRecreerProjet
      ExtraireProjet()
    Case #CmdEnregistrer
      EnregistrerOnglet()
    Case #CmdQuitter
      PostEvent(#PB_Event_CloseWindow, #FenetrePrincipale, 0)
    Case #CmdColler
      If GetActiveGadget() = #ChampLimite
        SendMessage_(GadgetID(#ChampLimite), #W_WM_PASTE, 0, 0)
      Else
        Coller()
      EndIf
    Case #CmdCopierSelection
      CopierSelection()
    Case #CmdCopierOnglet
      CopierOnglet()
    Case #CmdToutSelectionner
      ToutSelectionner()
    Case #CmdCompresser
      Compresser()
    Case #CmdNiveau1, #CmdNiveau2, #CmdNiveau3
      If NiveauActif()
        ChangerPropriete(#ProNiveau, Commande - #CmdNiveau1 + 1)
      EndIf
    Case #CmdLangueFr, #CmdLangueEn, #CmdLangueDe
      ChangerLangue(Commande - #CmdLangueFr)
    Case #CmdEffacerDisque
      EffacerEtats()
    Case #CmdAide
      DialogueAide()
    Case #CmdCredits
      DialogueCredits()
    Case #CmdAPropos
      DialogueAPropos()
    Case #CmdDecompresser
      Decompresser()
    Case #CmdOngletSuivant
      MontrerOnglet((OngletActif + 1) % 3)
    Case #CmdOngletPrecedent
      MontrerOnglet((OngletActif + 2) % 3)
    Case #CmdEffacerSortie
      EffacerSortie()
    Case #CmdMenu0 To #CmdMenu4
      OuvrirMenuClavier(Commande - #CmdMenu0)
  EndSelect
EndProcedure

; ----------------------------------------------------------------------------
;  Réglages mémorisés d'une utilisation à l'autre
; ----------------------------------------------------------------------------
Prototype.i ProtoLangueWindows()

; Langue de Windows (au premier lancement): français, allemand, sinon anglais
Procedure LangueDeWindows()
  Protected Bibliotheque, Fonction.ProtoLangueWindows, Code, Resultat = #LangueEn
  Bibliotheque = OpenLibrary(#PB_Any, "kernel32.dll")
  If Bibliotheque
    Fonction = GetFunction(Bibliotheque, "GetUserDefaultUILanguage")
    If Fonction
      Code = Fonction() & $3FF
      Select Code
        Case $0C
          Resultat = #LangueFr
        Case $07
          Resultat = #LangueDe
      EndSelect
    EndIf
    CloseLibrary(Bibliotheque)
  EndIf
  ProcedureReturn Resultat
EndProcedure

Procedure ChargerReglages()
  Protected i, Mesure$, Categories

  Reglage\Format = #FormatLanceur
  Reglage\Methode = #MethodeAuto
  Reglage\Encodage = #EncodageUnicode
  Reglage\LangueResultat = 0
  Reglage\GarderIDE = #False
  Reglage\Limite = #LimiteParDefaut
  Reglage\Protection = 2
  Reglage\Niveau = #NiveauV7Defaut
  Langue = -1

  If OpenPreferences(FichierReglages$)
    Reglage\Format = ReadPreferenceInteger("Format", #FormatLanceur)
    Reglage\Methode = ReadPreferenceInteger("Methode", #MethodeAuto)
    Reglage\Encodage = ReadPreferenceInteger("Encodage", ReadPreferenceInteger("Mode", #EncodageUnicode))
    Reglage\LangueResultat = ReadPreferenceInteger("Langue", 0)
    Reglage\Limite = ReadPreferenceInteger("Limite", #LimiteParDefaut)
    Reglage\GarderIDE = Bool(ReadPreferenceInteger("GarderOptionsIDE", 0) <> 0)
    Reglage\Protection = ReadPreferenceInteger("NiveauProtection", 2)
    Reglage\Niveau = ReadPreferenceInteger("NiveauV7", #NiveauV7Defaut)
    VitesseCM = ReadPreferenceInteger("VitesseCM", VitesseCM)
    GarderEtat = Bool(ReadPreferenceInteger("GarderEtat", 1) <> 0)
    CheminReferenceChoisi$ = ReadPreferenceString("FichierReference", "")
    For i = #NiveauV7Min To #NiveauV7Max
      RapportNiveau(i) = ReadPreferenceInteger("RapportNiveau73_" + Str(i), 0)       ; (v7.3: nouvelle méthode, nouvelle mesure)
      If RapportNiveau(i) < 0 Or RapportNiveau(i) > 2000
        RapportNiveau(i) = 0
      EndIf
    Next
    ; Mesure du réseau sur ce PC (voir CalibrerReseau): fils, façon, vitesses, cœurs
    ; (à part quand le programme tourne avec le débogueur, qui change les vitesses)
    For i = 1 To 2
      MesureAutre$(i) = ReadPreferenceString("Reseau" + Str(i) + CleAutre(), "")
      Mesure$ = ReadPreferenceString("Reseau" + Str(i) + CleReseau(), "")
      If CountString(Mesure$, ",") = 4
        NNCalFils(i) = Val(StringField(Mesure$, 1, ","))
        NNCalVariante(i) = Val(StringField(Mesure$, 2, ","))
        NNCalVitesse(i) = Val(StringField(Mesure$, 3, ","))
        NNCalCoeur(i) = Val(StringField(Mesure$, 4, ","))
        NNCalCoeurs(i) = Val(StringField(Mesure$, 5, ","))
      EndIf
    Next
    ; Interface (v7.1)
    Langue = ReadPreferenceInteger("LangueInterface", -1)
    LargeurProprietes = ReadPreferenceInteger("LargeurProprietes", 340)
    HauteurSortie = ReadPreferenceInteger("HauteurSortie", 150)
    FenetreGauche = ReadPreferenceInteger("FenetreGauche", 0)
    FenetreHaut = ReadPreferenceInteger("FenetreHaut", 0)
    FenetreLargeur = ReadPreferenceInteger("FenetreLargeur", 0)
    FenetreHauteur = ReadPreferenceInteger("FenetreHauteur", 0)
    FenetreMaximisee = Bool(ReadPreferenceInteger("FenetreMaximisee", 0) <> 0)
    Categories = ReadPreferenceInteger("CategoriesRepliees", 0)
    For i = 0 To #NbCategories - 1
      CatRepliee(i) = Bool(Categories & (1 << i))
    Next
    ClosePreferences()
  EndIf

  If Reglage\Format <> #FormatLanceur And Reglage\Format <> #FormatBloc
    Reglage\Format = #FormatLanceur
  EndIf
  If Reglage\Methode < #MethodeAuto Or Reglage\Methode > #MethodeMaximal
    Reglage\Methode = #MethodeAuto
  EndIf
  If Reglage\Encodage <> #EncodageUnicode And Reglage\Encodage <> #EncodageBase64
    Reglage\Encodage = #EncodageUnicode
  EndIf
  If Reglage\LangueResultat < 0 Or Reglage\LangueResultat > 2
    Reglage\LangueResultat = 0
  EndIf
  If Reglage\Limite < 0
    Reglage\Limite = #LimiteParDefaut
  EndIf
  If Reglage\Protection < 0 Or Reglage\Protection > 5
    Reglage\Protection = 2
  EndIf
  If Reglage\Niveau < #NiveauV7Min Or Reglage\Niveau > #NiveauV7Max
    Reglage\Niveau = #NiveauV7Defaut
  EndIf
  If VitesseCM < 1000
    VitesseCM = 120000
  EndIf
  If Langue < #LangueFr Or Langue > #LangueDe
    Langue = LangueDeWindows()
  EndIf
EndProcedure

Procedure SauverReglages()
  Protected i, Categories, r.RECT

  If CreatePreferences(FichierReglages$)
    WritePreferenceInteger("Format", Reglage\Format)
    WritePreferenceInteger("Methode", Reglage\Methode)
    WritePreferenceInteger("Encodage", Reglage\Encodage)
    WritePreferenceInteger("Langue", Reglage\LangueResultat)
    WritePreferenceInteger("Limite", Reglage\Limite)
    WritePreferenceInteger("GarderOptionsIDE", Reglage\GarderIDE)
    WritePreferenceInteger("NiveauProtection", Reglage\Protection)
    WritePreferenceInteger("NiveauV7", NiveauChoisi())
    WritePreferenceInteger("VitesseCM", VitesseCM)
    WritePreferenceInteger("GarderEtat", GarderEtat)
    WritePreferenceString("FichierReference", CheminReferenceChoisi$)
    For i = #NiveauV7Min To #NiveauV7Max
      WritePreferenceInteger("RapportNiveau73_" + Str(i), RapportNiveau(i))
    Next
    For i = 1 To 2
      If MesureAutre$(i) <> ""
        WritePreferenceString("Reseau" + Str(i) + CleAutre(), MesureAutre$(i))
      EndIf
      If NNCalCoeurs(i) > 0
        WritePreferenceString("Reseau" + Str(i) + CleReseau(), Str(NNCalFils(i)) + "," + Str(NNCalVariante(i)) + "," + Str(NNCalVitesse(i)) + "," + Str(NNCalCoeur(i)) + "," + Str(NNCalCoeurs(i)))
      EndIf
    Next
    ; Interface (v7.1)
    WritePreferenceInteger("LangueInterface", Langue)
    WritePreferenceInteger("LargeurProprietes", LargeurProprietes)
    WritePreferenceInteger("HauteurSortie", HauteurSortie)
    If IsWindow(#FenetrePrincipale)
      FenetreMaximisee = Bool(GetWindowState(#FenetrePrincipale) = #PB_Window_Maximize)
      If GetWindowState(#FenetrePrincipale) = #PB_Window_Normal
        GetWindowRect_(WindowID(#FenetrePrincipale), @r)
        FenetreGauche = r\left
        FenetreHaut = r\top
        FenetreLargeur = r\right - r\left
        FenetreHauteur = r\bottom - r\top
      EndIf
    EndIf
    WritePreferenceInteger("FenetreGauche", FenetreGauche)
    WritePreferenceInteger("FenetreHaut", FenetreHaut)
    WritePreferenceInteger("FenetreLargeur", FenetreLargeur)
    WritePreferenceInteger("FenetreHauteur", FenetreHauteur)
    WritePreferenceInteger("FenetreMaximisee", FenetreMaximisee)
    For i = 0 To #NbCategories - 1
      If CatRepliee(i)
        Categories = Categories | (1 << i)
      EndIf
    Next
    WritePreferenceInteger("CategoriesRepliees", Categories)
    ClosePreferences()
  EndIf
EndProcedure

; ----------------------------------------------------------------------------
;  Fenêtre sans la barre de titre de Windows (comme la maquette): le haut du
;  cadre est retiré, les bords gauche, droit et bas restent (redimensionner,
;  ombre, coins arrondis de Windows 11 et ancrage sur les côtés de l'écran).
; ----------------------------------------------------------------------------
Structure CalculTaille
  rgrc.RECT[3]
  *lppos
EndStructure

Procedure RappelFenetre(hWnd, uMsg, wParam, lParam)
  Protected *Calcul.CalculTaille, Haut, X, Y, Cible
  Select uMsg
    Case #W_WM_NCCALCSIZE
      If wParam
        *Calcul = lParam
        Haut = *Calcul\rgrc[0]\top
        DefWindowProc_(hWnd, uMsg, wParam, lParam)
        *Calcul\rgrc[0]\top = Haut
        If IsZoomed_(hWnd)
          ; agrandie, la fenêtre déborde de l'écran de l'épaisseur du cadre
          *Calcul\rgrc[0]\top = Haut + GetSystemMetrics_(#W_SM_CYFRAME) + GetSystemMetrics_(#W_SM_CXPADDEDBORDER)
        EndIf
        ProcedureReturn 0
      EndIf
    Case #W_WM_CONTEXTMENU
      Cible = -1
      If wParam = GadgetID(#EditeurEntree)
        Cible = #EditeurEntree
      ElseIf wParam = GadgetID(#EditeurSortie)
        Cible = #EditeurSortie
      ElseIf wParam = GadgetID(#EditeurDec)
        Cible = #EditeurDec
      ElseIf wParam = GadgetID(#EditeurJournal)
        Cible = #EditeurJournal
      EndIf
      If Cible >= 0
        X = lParam & $FFFF
        Y = (lParam >> 16) & $FFFF
        If X > 32767
          X = X - 65536
        EndIf
        If Y > 32767
          Y = Y - 65536
        EndIf
        PostEvent(#EvContexte, #FenetrePrincipale, Cible, 0, (Y << 16) | (X & $FFFF))
        ProcedureReturn 0
      EndIf
  EndSelect
  ProcedureReturn #PB_ProcessPureBasicEvents
EndProcedure

; Glisser-déposer: zone bleue tant qu'un fichier passe au-dessus
Procedure RappelDepot(Cible, Etat, Format, Action, X, Y)
  If Occupe Or IsWindow(#FenetreDialogue)
    ProcedureReturn #False
  EndIf
  Select Etat
    Case #PB_Drag_Enter
      If DepotEnCours = #False
        DepotEnCours = #True
        FermerPopups()
        Disposer()
      EndIf
    Case #PB_Drag_Leave, #PB_Drag_Finish
      If DepotEnCours
        DepotEnCours = #False
        Disposer()
      EndIf
  EndSelect
  ProcedureReturn #True
EndProcedure

; Les éditeurs Scintilla acceptent eux-mêmes le texte qu'on y dépose: on le
; leur retire, pour que la fenêtre reçoive les fichiers déposés n'importe où
Prototype.i ProtoRevokeDragDrop(hWnd)

Procedure RetirerDepotEditeurs()
  Protected Bibliotheque, Revoke.ProtoRevokeDragDrop
  Bibliotheque = OpenLibrary(#PB_Any, "ole32.dll")
  If Bibliotheque
    Revoke = GetFunction(Bibliotheque, "RevokeDragDrop")
    If Revoke
      Revoke(GadgetID(#EditeurEntree))
      Revoke(GadgetID(#EditeurSortie))
      Revoke(GadgetID(#EditeurDec))
      Revoke(GadgetID(#EditeurJournal))
    EndIf
    CloseLibrary(Bibliotheque)
  EndIf
EndProcedure

Procedure EvenementTaille()
  FermerPopups()
  Disposer()
EndProcedure

; ----------------------------------------------------------------------------
;  Création des gadgets
; ----------------------------------------------------------------------------
Procedure CreerInterface()
  CanvasGadget(#CanvasTitre, 0, 0, 10, 10)
  CanvasGadget(#CanvasMenus, 0, 0, 10, 10)
  CanvasGadget(#CanvasOutils, 0, 0, 10, 10)
  CanvasGadget(#CanvasOngletsDoc, 0, 0, 10, 10)
  ScintillaGadget(#EditeurEntree, 0, 0, 10, 10, @RappelScintilla())
  ScintillaGadget(#EditeurSortie, 0, 0, 10, 10, @RappelScintilla())
  ScintillaGadget(#EditeurDec, 0, 0, 10, 10, @RappelScintilla())
  CanvasGadget(#CanvasBandeau, 0, 0, 10, 10)
  CanvasGadget(#CanvasVide, 0, 0, 10, 10)
  CanvasGadget(#CanvasDepot, 0, 0, 10, 10)
  CanvasGadget(#DefilDocV, 0, 0, 10, 10)
  CanvasGadget(#DefilDocH, 0, 0, 10, 10)
  CanvasGadget(#CoinDoc, 0, 0, 10, 10)
  CanvasGadget(#SeparateurDroit, 0, 0, 10, 10)
  CanvasGadget(#SeparateurBas, 0, 0, 10, 10)
  CanvasGadget(#CanvasOngletsProp, 0, 0, 10, 10)
  CanvasGadget(#CanvasGrille, 0, 0, 10, 10, #PB_Canvas_Container)
  StringGadget(#ChampLimite, 0, 0, 10, 10, Str(Reglage\Limite), #PB_String_Numeric | #PB_String_BorderLess)
  CloseGadgetList()
  CanvasGadget(#CanvasDescription, 0, 0, 10, 10)
  CanvasGadget(#CanvasOngletsSortie, 0, 0, 10, 10)
  ScintillaGadget(#EditeurJournal, 0, 0, 10, 10, @RappelScintilla())
  CanvasGadget(#DefilJournal, 0, 0, 10, 10)
  CanvasGadget(#CanvasEtat, 0, 0, 10, 10)

  ConfigurerEditeur(#EditeurEntree, 0)
  ConfigurerEditeur(#EditeurSortie, 1)
  ConfigurerEditeur(#EditeurDec, 0)
  ConfigurerEditeur(#EditeurJournal, 2)
  ModeResultat(#False)
  HideGadget(#CanvasDepot, #True)
  HideGadget(#CanvasVide, #True)

  SetGadgetFont(#ChampLimite, PolicePetite)
  SetGadgetColor(#ChampLimite, #PB_Gadget_FrontColor, #C_TextePrincipal)
  SetGadgetColor(#ChampLimite, #PB_Gadget_BackColor, #C_Contenu)
  SetGadgetAttribute(#ChampLimite, #PB_String_MaximumLength, 7)

  SetGadgetAttribute(#SeparateurDroit, #PB_Canvas_Cursor, #PB_Cursor_LeftRight)
  SetGadgetAttribute(#SeparateurBas, #PB_Canvas_Cursor, #PB_Cursor_UpDown)

  Defil(0)\Gadget = #DefilDocV
  Defil(0)\Vertical = #True
  Defil(0)\Cible = #EditeurEntree
  Defil(1)\Gadget = #DefilDocH
  Defil(1)\Vertical = #False
  Defil(1)\Cible = #EditeurEntree
  Defil(2)\Gadget = #DefilJournal
  Defil(2)\Vertical = #True
  Defil(2)\Cible = #EditeurJournal
  Defil(3)\Gadget = #CanvasGrille
  Defil(3)\Vertical = #True
  Defil(3)\Cible = -1
  Defil(0)\Pas = 1                   ; flèches: une ligne...
  Defil(1)\Pas = Pix(24)             ; ... ou 24 pixels en horizontal
  Defil(2)\Pas = 1
  Defil(3)\Pas = Pix(#LigneGrille)   ; une ligne de la grille

  ; Ces gadgets marchent aussi pendant un long calcul (déplacer la fenêtre,
  ; la fermer, agrandir un panneau, faire défiler un texte)
  BindGadgetEvent(#CanvasTitre, @EvenementTitre())
  BindGadgetEvent(#SeparateurDroit, @EvenementSeparateur())
  BindGadgetEvent(#SeparateurBas, @EvenementSeparateur())
  BindGadgetEvent(#DefilDocV, @EvenementDefil())
  BindGadgetEvent(#DefilDocH, @EvenementDefil())
  BindGadgetEvent(#DefilJournal, @EvenementDefil())
  BindEvent(#PB_Event_Timer, @EvenementMinuterie(), #FenetrePrincipale)
  ; bouton Stop et touche Échap pendant une opération (voir EvenementOutilsOccupe)
  BindGadgetEvent(#CanvasOutils, @EvenementOutilsOccupe())
  BindEvent(#PB_Event_Menu, @EvenementMenuOccupe(), #FenetrePrincipale)

  RetirerDepotEditeurs()
EndProcedure

; Alt + lettre: ouvre un menu (la lettre dépend de la langue: Alt+F pour
; Fichier, Alt+D pour Datei...)
Global LettresMenus$

Procedure RaccourcisMenus()
  Protected i, Lettre
  For i = 1 To Len(LettresMenus$)
    RemoveKeyboardShortcut(#FenetrePrincipale, #PB_Shortcut_Alt | Asc(Mid(LettresMenus$, i, 1)))
  Next
  LettresMenus$ = UCase(Tr("menuLettres"))
  For i = 1 To Mini(Len(LettresMenus$), #NbMenus)
    Lettre = Asc(Mid(LettresMenus$, i, 1))
    If Lettre >= 65 And Lettre <= 90
      AddKeyboardShortcut(#FenetrePrincipale, #PB_Shortcut_Alt | Lettre, #CmdMenu0 + i - 1)
    EndIf
  Next
EndProcedure

Procedure AjouterRaccourcis()
  AddKeyboardShortcut(#FenetrePrincipale, #PB_Shortcut_F5, #CmdCompresser)
  AddKeyboardShortcut(#FenetrePrincipale, #PB_Shortcut_F6, #CmdDecompresser)
  AddKeyboardShortcut(#FenetrePrincipale, #PB_Shortcut_Control | #PB_Shortcut_A, #CmdToutSelectionner)
  AddKeyboardShortcut(#FenetrePrincipale, #PB_Shortcut_Control | #PB_Shortcut_C, #CmdCopierSelection)
  AddKeyboardShortcut(#FenetrePrincipale, #PB_Shortcut_Control | #PB_Shortcut_Tab, #CmdOngletSuivant)
  AddKeyboardShortcut(#FenetrePrincipale, #PB_Shortcut_Control | #PB_Shortcut_Shift | #PB_Shortcut_Tab, #CmdOngletPrecedent)
  RaccourcisMenus()
  AddKeyboardShortcut(#FenetrePrincipale, #PB_Shortcut_F1, #CmdAide)
  AddKeyboardShortcut(#FenetrePrincipale, #PB_Shortcut_Control | #PB_Shortcut_O, #CmdOuvrir)
  AddKeyboardShortcut(#FenetrePrincipale, #PB_Shortcut_Control | #PB_Shortcut_Shift | #PB_Shortcut_O, #CmdOuvrirDossier)
  AddKeyboardShortcut(#FenetrePrincipale, #PB_Shortcut_Control | #PB_Shortcut_S, #CmdEnregistrer)
  AddKeyboardShortcut(#FenetrePrincipale, #PB_Shortcut_Control | #PB_Shortcut_V, #CmdColler)
  AddKeyboardShortcut(#FenetrePrincipale, #PB_Shortcut_Control | #PB_Shortcut_Shift | #PB_Shortcut_C, #CmdCopierOnglet)
EndProcedure

; ----------------------------------------------------------------------------
;  Événements des gadgets (boucle principale)
; ----------------------------------------------------------------------------
Procedure EvenementGadget(Gadget, Type)
  Protected p.POINT, i, r.RECT

  Select Gadget
    Case #CanvasMenus
      SourisDans(#CanvasMenus, @p)
      i = MenuSous(p\x, p\y)
      Select Type
        Case #PB_EventType_MouseMove
          If i <> MenuSurvol
            MenuSurvol = i
            DessinerMenus()
          EndIf
        Case #PB_EventType_MouseLeave
          MenuSurvol = -1
          DessinerMenus()
        Case #PB_EventType_LeftButtonDown
          If i >= 0 And Occupe = #False
            OuvrirMenu(i)
          EndIf
      EndSelect

    Case #CanvasOutils
      SourisDans(#CanvasOutils, @p)
      i = OutilSous(p\x, p\y)
      Select Type
        Case #PB_EventType_MouseMove
          If i <> OutilSurvol
            OutilSurvol = i
            BulleOutil(i)
            DessinerOutils()
          EndIf
        Case #PB_EventType_MouseLeave
          OutilSurvol = -1
          OutilAppui = -1
          DessinerOutils()
        Case #PB_EventType_LeftButtonDown
          If i >= 0 And OutilInactif(i) = #False
            If OutilGenre(i) = #OutilListe
              GetWindowRect_(GadgetID(#CanvasOutils), @r)
              OuvrirListe(-2, r\left + OutilX(i), r\top + OutilY(i), OutilL(i), OutilH(i), ChoixListe(#ProNiveau), Reglage\Niveau)
            Else
              OutilAppui = i
              DessinerOutils()
            EndIf
          EndIf
        Case #PB_EventType_LeftButtonUp
          If OutilAppui >= 0 And OutilAppui = i
            OutilAppui = -1
            DessinerOutils()
            ExecuterCommande(OutilCmd(i))
          Else
            OutilAppui = -1
            DessinerOutils()
          EndIf
      EndSelect

    Case #CanvasOngletsDoc
      SourisDans(#CanvasOngletsDoc, @p)
      i = OngletDocSous(p\x, p\y)
      Select Type
        Case #PB_EventType_MouseMove
          If i <> OngletSurvol
            OngletSurvol = i
            DessinerOngletsDoc()
          EndIf
        Case #PB_EventType_MouseLeave
          OngletSurvol = -1
          DessinerOngletsDoc()
        Case #PB_EventType_LeftButtonDown
          FermerPopups()
          If i >= 0 And i <> OngletActif
            MontrerOnglet(i)
          EndIf
      EndSelect

    Case #CanvasGrille
      EvenementGrille(Type)

    Case #ChampLimite
      Select Type
        Case #PB_EventType_Change
          Reglage\Limite = Val(GetGadgetText(#ChampLimite))
          DessinerEtat()
          If OngletActif = 1
            DessinerBandeau()
          EndIf
        Case #PB_EventType_Focus, #PB_EventType_LostFocus
          If Type = #PB_EventType_Focus
            ProSelection = #ProLimite
            DessinerDescription()
          EndIf
          DessinerGrille()
      EndSelect

    Case #CanvasPopup0, #CanvasPopup1
      EvenementPopup(Type)
  EndSelect
EndProcedure

Procedure DeposerFichiers()
  Protected Fichiers$, Premier$, Nb
  Select EventDropType()
    Case #PB_Drop_Files
      Fichiers$ = EventDropFiles()
      Nb = CountString(Fichiers$, Chr(10)) + 1
      Premier$ = StringField(Fichiers$, 1, Chr(10))
      If Nb > 1
        Journal(#JournalInfo, TrF("journalPlusieursFichiers", Str(Nb), Guillemets(GetFilePart(Premier$))))
      EndIf
      If FileSize(Premier$) = -2
        ChargerDossier(Premier$)               ; un dossier: un projet (v7.2)
      ElseIf FileSize(Premier$) >= 0
        ChargerFichier(Premier$)
      EndIf
    Case #PB_Drop_Text
      ChargerTexte(EventDropText(), Tr("origineDepot"), "")
  EndSelect
EndProcedure

; Position de la fenêtre au premier lancement ou d'après les réglages
Procedure PlacerFenetre()
  Protected Zone.RECT, L, H, X, Y, Ok
  ZoneEcran(@Zone)
  L = FenetreLargeur
  H = FenetreHauteur
  X = FenetreGauche
  Y = FenetreHaut
  If L >= Pix(900) And H >= Pix(560)
    ; encore visible sur un des écrans ?
    If X + L > GetSystemMetrics_(76) + Pix(100) And X < GetSystemMetrics_(76) + GetSystemMetrics_(78) - Pix(100)
      If Y >= GetSystemMetrics_(77) - Pix(8) And Y < GetSystemMetrics_(77) + GetSystemMetrics_(79) - Pix(100)
        Ok = #True
      EndIf
    EndIf
  EndIf
  If Ok = #False
    L = Mini(Pix(1280), (Zone\right - Zone\left) - Pix(40))
    H = Mini(Pix(820), (Zone\bottom - Zone\top) - Pix(40))
    X = Zone\left + ((Zone\right - Zone\left) - L) / 2
    Y = Zone\top + ((Zone\bottom - Zone\top) - H) / 2
  EndIf
  SetWindowPos_(WindowID(#FenetrePrincipale), 0, X, Y, L, H, #W_SWP_NOZORDER | #W_SWP_NOACTIVATE)
EndProcedure

; ============================================================================
;  Programme principal
; ============================================================================
Define Evenement, Presse$, Parametre$, X, Y, Zone.RECT, Cible

ChargerTraductions()
InitialiserMotsCles()
InitialiserProprietes()
InitialiserOutils()
ChargerFonctionsWindows()
ChargerReglages()

Ech = DesktopResolutionX()
If Ech <= 0
  Ech = 1.0
EndIf
CreerPolices()
CreerIcones()
ImageMesure = CreateImage(#PB_Any, 8, 8)

If OpenWindow(#FenetrePrincipale, 0, 0, 1280, 820, Tr("nomProgramme"), #PB_Window_SystemMenu | #PB_Window_MinimizeGadget | #PB_Window_MaximizeGadget | #PB_Window_SizeGadget | #PB_Window_Invisible)
  SetWindowCallback(@RappelFenetre(), #FenetrePrincipale)
  ; le haut du cadre de Windows (sa barre de titre) disparaît
  SetWindowPos_(WindowID(#FenetrePrincipale), 0, 0, 0, 0, 0, #W_SWP_FRAMECHANGED | #W_SWP_NOMOVE | #W_SWP_NOSIZE | #W_SWP_NOZORDER | #W_SWP_NOACTIVATE)
  PlacerFenetre()
  WindowBounds(#FenetrePrincipale, 900, 560, #PB_Ignore, #PB_Ignore)
  SetWindowColor(#FenetrePrincipale, #C_Panneau)

  CreerInterface()
  CreerFenetresPopups()
  AjouterRaccourcis()
  EnableWindowDrop(#FenetrePrincipale, #PB_Drop_Files, #PB_Drag_Copy)
  EnableWindowDrop(#FenetrePrincipale, #PB_Drop_Text, #PB_Drag_Copy)
  SetDropCallback(@RappelDepot())

  ; Vérification en parallèle (option « thread-safe » du compilateur)
  CompilerIf #PB_Compiler_Thread
    MutexCM4 = CreateMutex()
  CompilerEndIf

  ; Cœurs et processeurs de ce PC (pour le réseau de neurones)
  NNCoeursPhysiques()

  MettreAJourEstimations()
  ChangerTitreFenetre()
  BindEvent(#PB_Event_SizeWindow, @EvenementTaille(), #FenetrePrincipale)
  Disposer()
  If FenetreMaximisee
    SetWindowState(#FenetrePrincipale, #PB_Window_Maximize)
  EndIf
  HideWindow(#FenetrePrincipale, #False)
  Disposer()

  If TrouverFichierReference() <> ""
    Journal(#JournalOk, Tr("journalPret"))
  Else
    Journal(#JournalAttention, Tr("journalSansReference"))
  EndIf

  ; Un fichier déposé sur l'icône du programme (ou « Ouvrir avec »)
  Parametre$ = ProgramParameter(0)
  If Parametre$ <> "" And FileSize(Parametre$) = -2
    ChargerDossier(Parametre$)
  ElseIf Parametre$ <> "" And FileSize(Parametre$) >= 0
    ChargerFichier(Parametre$)
  Else
    ; Le presse-papiers contient un bloc compressé ? On demande s'il faut le
    ; décompresser. Sinon, on ne fait rien du tout (pas de message).
    Presse$ = GetClipboardText()
    If EstBlocCompresse(Presse$)
      If Dialogue(#DlgQuestion, Tr("titreDecompresser"), Tr("questionBlocDemarrage"), Tr("boutonOui") + Chr(10) + Tr("boutonNon")) = 0
        DecompresserTexte(Presse$)
      EndIf
    EndIf
  EndIf

  Repeat
    Evenement = WaitWindowEvent()
    Select Evenement
      Case #PB_Event_Gadget
        EvenementGadget(EventGadget(), EventType())

      Case #PB_Event_Menu
        Select EventMenu()
          Case #CmdMenuHaut, #CmdMenuBas, #CmdMenuGauche, #CmdMenuDroite, #CmdMenuEntree, #CmdMenuEchap
            If Pop(0)\Ouvert
              ClavierPopup(EventMenu())
            EndIf
          Default
            If EventWindow() = #FenetrePrincipale
              FermerPopups()
              ExecuterCommande(EventMenu())
            EndIf
        EndSelect

      Case #PB_Event_WindowDrop
        If DepotEnCours
          DepotEnCours = #False
          Disposer()
        EndIf
        If EventWindow() = #FenetrePrincipale And Occupe = #False
          DeposerFichiers()
        EndIf

      Case #EvContexte
        If Occupe = #False
          Cible = EventGadget()
          X = EventData() & $FFFF
          Y = (EventData() >> 16) & $FFFF
          If X > 32767
            X = X - 65536
          EndIf
          If Y > 32767
            Y = Y - 65536
          EndIf
          If X = -1 And Y = -1
            ; touche « menu » du clavier: sous la barre d'onglets
            GetWindowRect_(GadgetID(Cible), @Zone)
            X = Zone\left + Pix(20)
            Y = Zone\top + Pix(20)
          EndIf
          SetActiveGadget(Cible)
          OuvrirContexte(X, Y, Bool(Cible = #EditeurJournal))
        EndIf

      Case #PB_Event_DeactivateWindow
        If EventWindow() = #FenetrePrincipale
          FermerPopups()
        EndIf

      Case #PB_Event_MoveWindow
        If EventWindow() = #FenetrePrincipale
          FermerPopups()
        EndIf

      Case #PB_Event_CloseWindow
        If EventWindow() = #FenetrePrincipale
          FermerPopups()
          SauverReglages()
          Break
        EndIf
    EndSelect
  ForEver

EndIf


; ============================================================================
;  Données: table de la méthode Maximal, et lignes du décompresseur Maximal
;  telles qu'elles sont écrites dans les lanceurs (identiques à DecoderCM).
; ============================================================================
DataSection
  Sq33:
  Data.q 1,2,3,6,10,16,27,45,73,120,194,310,488,747,1101,1546,2047,2549,2994,3348,3607,3785,3901,3975,4022,4050,4068,4079,4085,4089,4092,4093,4094

  LanceurCM:
  Data.s "Dim T33.q(32)"
  Data.s "Restore Sq33"
  Data.s "For i = 0 To 32"
  Data.s "Read.q u"
  Data.s "T33(i) = u"
  Data.s "Next"
  Data.s "Dim Sq.q(4094)"
  Data.s "For i = 0 To 4094"
  Data.s "u = (i + 1) % 128"
  Data.s "v = (i + 1) / 128"
  Data.s "Sq(i) = ((T33(v) * (128 - u)) + (T33(v + 1) * u) + 64) / 128"
  Data.s "Next"
  Data.s "Dim St.q(4095)"
  Data.s "v = 0"
  Data.s "For i = 0 To 4094"
  Data.s "While v <= Sq(i)"
  Data.s "St(v) = i - 2047"
  Data.s "v = v + 1"
  Data.s "Wend"
  Data.s "Next"
  Data.s "While v <= 4095"
  Data.s "St(v) = 2047"
  Data.s "v = v + 1"
  Data.s "Wend"
  Data.s "Dim Kr.q(255)"
  Data.s "For i = 0 To 255"
  Data.s "Kr(i) = 8192 / ((2 * i) + 3)"
  Data.s "Next"
  Data.s "Dim P2.q(8)"
  Data.s "P2(0) = 1"
  Data.s "For i = 1 To 8"
  Data.s "P2(i) = P2(i - 1) * 2"
  Data.s "Next"
  Data.s "Dim M.l(12582911)"
  Data.s "For i = 0 To 12582911"
  Data.s "M(i) = 8388608"
  Data.s "Next"
  Data.s "Dim MT.l(1048575)"
  Data.s "Dim MS.q(63)"
  Data.s "For i = 0 To 63"
  Data.s "MS(i) = 8388608"
  Data.s "Next"
  Data.s "Dim W.q(2047)"
  Data.s "For i = 0 To 2047"
  Data.s "W(i) = 16384"
  Data.s "Next"
  Data.s "Dim Ap.q(2162687)"
  Data.s "For i = 0 To 2162687"
  Data.s "u = ((i % 33) * 128) - 1"
  Data.s "If u < 0: u = 0: EndIf"
  Data.s "If u > 4094: u = 4094: EndIf"
  Data.s "Ap(i) = Sq(u) * 16"
  Data.s "Next"
  Data.s "Dim Hi.q(4)"
  Data.s "Dim Hc.q(5)"
  Data.s "Dim Ix.q(6)"
  Data.s "Dim Sv.q(6)"
  Data.s "x = 0: ip = 0"
  Data.s "For k = 1 To 4"
  Data.s "x = x * 256"
  Data.s "If ip < Z: x = x + PeekA(*C + ip): EndIf"
  Data.s "ip = ip + 1"
  Data.s "Next"
  Data.s "x1 = 0: x2 = 4294967295: wh = 0: ls = 0: pl = 0: ml = 0: mp = 0: chk = 0"
  Data.s "For pos = 0 To T - 1"
  Data.s "h = 0"
  Data.s "For k = 0 To 4"
  Data.s "h = ((((h + Hi(k)) + 1) * $6F4F2B) / 256) % $1000000"
  Data.s "If k < 4: Hc(k) = h: EndIf"
  Data.s "Next"
  Data.s "hm = h % $100000"
  Data.s "Hc(4) = (((((wh * 256) + Hi(0)) + 1) * $6F4F2B) / 256) % $1000000"
  Data.s "ab = 0"
  Data.s "If pl + pos - ls < ls: ab = PeekA(*D + pl + pos - ls): EndIf"
  Data.s "Hc(5) = (((((ab * 256) + Hi(0)) + 1048577) * $6F4F2B) / 256) % $1000000"
  Data.s "If ml > 0 And PeekA(*D + mp) = Hi(0)"
  Data.s "If ml < 65535: ml = ml + 1: EndIf"
  Data.s "mp = mp + 1"
  Data.s "Else"
  Data.s "ml = 0"
  Data.s "EndIf"
  Data.s "If ml = 0 And pos >= 5"
  Data.s "mp = MT(hm)"
  Data.s "While mp > 0 And ml < 124 And ml < mp"
  Data.s "If PeekA(*D + mp - ml - 1) <> PeekA(*D + pos - ml - 1): Break: EndIf"
  Data.s "ml = ml + 1"
  Data.s "Wend"
  Data.s "EndIf"
  Data.s "MT(hm) = pos"
  Data.s "ma = Bool(ml > 0)"
  Data.s "c0 = 1"
  Data.s "For j = 0 To 7"
  Data.s "ws = c0 * 8"
  Data.s "dot = 0"
  Data.s "For k = 0 To 5"
  Data.s "Ix(k) = (((((((Hc(k) * 256) + c0) * $2E8BA3) / 1024) % $200000)) + (k * $200000))"
  Data.s "Sv(k) = St(M(Ix(k)) / 4096)"
  Data.s "dot = dot + (W(ws + k) * Sv(k))"
  Data.s "Next"
  Data.s "Sv(6) = 0"
  Data.s "If ma"
  Data.s "pb = PeekA(*D + mp) + 256"
  Data.s "If pb / P2(8 - j) = c0"
  Data.s "u = ml"
  Data.s "If u > 31: u = 31: EndIf"
  Data.s "Ix(6) = (u * 2) + ((pb / P2(7 - j)) % 2)"
  Data.s "Sv(6) = St(MS(Ix(6)) / 4096)"
  Data.s "Else"
  Data.s "ma = 0"
  Data.s "EndIf"
  Data.s "EndIf"
  Data.s "dot = dot + (W(ws + 6) * 256) + (W(ws + 7) * Sv(6))"
  Data.s "e = dot / 65536"
  Data.s "If e > 2047: e = 2047: EndIf"
  Data.s "If e < -2047: e = -2047: EndIf"
  Data.s "pm = Sq(e + 2047)"
  Data.s "px = pm"
  Data.s "s = St(pm) + 2048"
  Data.s "aw = s % 128"
  Data.s "ai = (((Hi(0) * 256) + c0) * 33) + (s / 128)"
  Data.s "pm = (pm + (3 * (((Ap(ai) * (128 - aw)) + (Ap(ai + 1) * aw)) / 2048))) / 4"
  Data.s "If pm < 1: pm = 1: EndIf"
  Data.s "If pm > 4095: pm = 4095: EndIf"
  Data.s "xm = x1 + (((x2 - x1) / 4096) * pm)"
  Data.s "y = Bool(x <= xm)"
  Data.s "If y: x2 = xm: Else: x1 = xm + 1: EndIf"
  Data.s "er = ((y * 4096) - px) * 2"
  Data.s "For k = 0 To 5"
  Data.s "W(ws + k) = W(ws + k) + ((Sv(k) * er) / 1024)"
  Data.s "u = M(Ix(k)) / 256"
  Data.s "v = M(Ix(k)) % 256"
  Data.s "If y: u = u + (((65536 - u) * Kr(v)) / 4096): Else: u = u - ((u * Kr(v)) / 4096): EndIf"
  Data.s "If v < 127: v = v + 1: EndIf"
  Data.s "M(Ix(k)) = (u * 256) + v"
  Data.s "Next"
  Data.s "W(ws + 6) = W(ws + 6) + ((256 * er) / 1024)"
  Data.s "W(ws + 7) = W(ws + 7) + ((Sv(6) * er) / 1024)"
  Data.s "If ma"
  Data.s "u = MS(Ix(6)) / 256"
  Data.s "v = MS(Ix(6)) % 256"
  Data.s "If y: u = u + (((65536 - u) * Kr(v)) / 4096): Else: u = u - ((u * Kr(v)) / 4096): EndIf"
  Data.s "If v < 127: v = v + 1: EndIf"
  Data.s "MS(Ix(6)) = (u * 256) + v"
  Data.s "EndIf"
  Data.s "g = (y * 65536) + (y * 64) - (2 * y)"
  Data.s "Ap(ai) = Ap(ai) + (((g - Ap(ai)) * (128 - aw)) / 8192)"
  Data.s "Ap(ai + 1) = Ap(ai + 1) + (((g - Ap(ai + 1)) * aw) / 8192)"
  Data.s "c0 = (c0 * 2) + y"
  Data.s "While x1 / 16777216 = x2 / 16777216"
  Data.s "x1 = (x1 % 16777216) * 256"
  Data.s "x2 = ((x2 % 16777216) * 256) + 255"
  Data.s "x = (x % 16777216) * 256"
  Data.s "If ip < Z: x = x + PeekA(*C + ip): EndIf"
  Data.s "ip = ip + 1"
  Data.s "Wend"
  Data.s "Next"
  Data.s "c = c0 - 256"
  Data.s "PokeA(*D + pos, c)"
  Data.s "chk = ((chk * 33) + c) % 1000000007"
  Data.s "For k = 4 To 1 Step -1"
  Data.s "Hi(k) = Hi(k - 1)"
  Data.s "Next"
  Data.s "Hi(0) = c"
  Data.s "If c = 10: pl = ls: ls = pos + 1: EndIf"
  Data.s "If (c >= 48 And c <= 57) Or (c >= 65 And c <= 90) Or (c >= 97 And c <= 122) Or c = 95"
  Data.s "wh = ((((wh + c) + 1) * $6F4F2B) / 256) % $1000000"
  Data.s "Else"
  Data.s "wh = 0"
  Data.s "EndIf"
  Data.s "Next"
  Data.s ""

  ; Table des segments du texte de référence: taille, somme de contrôle.
  ; Le texte lui-même est dans le fichier de référence, à côté du programme
  ; (#NomFichierReference$), compressé d'un seul tenant par la méthode v4.
  ; NE JAMAIS MODIFIER les segments utilisés par des blocs déjà postés.
  TableReference:
  Data.q 52985, 934947225
  Data.q 1545285, 263948469
  Data.q 828346, 727537064
  Data.q 3303511, 299593164
  Data.q 5557076, 536586336
EndDataSection


