EnableExplicit

UseLZMAPacker()

; Nombre de caractères de données par ligne dans le résultat
#LongueurLigne = 1000

; Limite par défaut de phpBB pour la taille d'un message
#LimiteParDefaut = 60000

; Les balises codes comptent aussi dans la limite du forum
#TailleBalisesCode = 13

; Table de 33 valeurs utilisée par la méthode Maximal (copiée dans les lanceurs)
#DonneesSq33$ = "1,2,3,6,10,16,27,45,73,120,194,310,488,747,1101,1546,2047,2549,2994,3348,3607,3785,3901,3975,4022,4050,4068,4079,4085,4089,4092,4093,4094"

; ============================================================================
;  INTERFACE (v7.1): fenêtres, gadgets, couleurs et réglages
;  Le thème reprend à l'identique celui de la maquette VOH « VS2010 Dockable »
;  (fichier dock-config.css): mêmes couleurs, mêmes dégradés, mêmes tailles.
;  Tout est dessiné par le programme (CanvasGadget), sauf les zones de texte
;  (Scintilla, l'éditeur de l'IDE PureBasic) et le champ de la limite du forum.
;  Les tailles sont en pixels « à 100 % » ; Pix() les met à l'échelle de l'écran.
; ============================================================================

Enumeration Fenetres
  #FenetrePrincipale
  #FenetrePopup0         ; menu, menu contextuel ou liste déroulante
  #FenetrePopup1         ; sous-menu
  #FenetreOmbre0         ; ombre du menu (fenêtre transparente, derrière lui)
  #FenetreOmbre1         ; ombre du sous-menu
  #FenetreVoile          ; voile sombre sur la fenêtre pendant un dialogue
  #FenetreDialogue
  #FenetreOmbreDialogue
EndEnumeration

Enumeration Gadgets
  #CanvasTitre           ; barre de titre (dessinée)
  #CanvasMenus           ; barre de menus
  #CanvasOutils          ; barre d'outils
  #CanvasOngletsDoc      ; onglets Code d'origine / Résultat / Code décompressé
  #EditeurEntree         ; code d'origine (Scintilla)
  #EditeurSortie         ; résultat (Scintilla)
  #EditeurDec            ; code décompressé (Scintilla)
  #CanvasBandeau         ; bandeau du forum, en haut de l'onglet Résultat
  #CanvasVide            ; onglet vide: icône et texte d'aide
  #CanvasDepot           ; pendant le glisser-déposer d'un fichier
  #DefilDocV             ; barres de défilement de l'onglet affiché
  #DefilDocH
  #CoinDoc
  #SeparateurDroit       ; barre entre les documents et les propriétés
  #SeparateurBas         ; barre au-dessus de la sortie
  #CanvasOngletsProp
  #CanvasGrille          ; grille de propriétés (conteneur du champ suivant)
  #ChampLimite           ; limite du forum
  #CanvasDescription     ; description de la propriété choisie
  #CanvasOngletsSortie
  #EditeurJournal        ; sortie (Scintilla)
  #DefilJournal
  #CanvasEtat            ; barre d'état
  #CanvasPopup0
  #CanvasPopup1
  #CanvasDialogue
EndEnumeration

