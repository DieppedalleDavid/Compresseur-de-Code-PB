      a = 0
      If pl + pos - ls < ls
        If PeekA(*D + pl + pos - ls) = c: a = 1: EndIf
      EndIf
      If a: ar = ar + 1: Else: ar = 0: EndIf
    EndIf
    If c = 10: pfw = fw: fw = 0: fwf = 0: nd = 0: bd = 0: EndIf
    If zn = 0
      If c = 40 And bd < 7
        bd = bd + 1
      ElseIf c = 41 And bd > 0
        bd = bd - 1
      EndIf
    EndIf
    If lt
      If wh = 0: g1 = g0: g0 = 0: wlo = 0: EndIf
      wlo = ((((wlo + lc) + 1) * $6F4F2B) / 256) % $1000000
      t0 = ((t0 * 256) + lc) % 1099511627776
    Else
      If wh <> 0
        w4 = w3: w3 = w2: w2 = wp: wlp = wlo
        If c = 61 Or c = 58: kw = wh: EndIf
      EndIf
      If c = 10: a = 32: Else: a = c: EndIf
      g0 = (((((g0 * 256) + a) + 1) * $6F4F2B) / 256) % $1000000
    EndIf
    If lt
      If wh = 0: wc = Hi(1): EndIf
      wh = ((((wh + c) + 1) * $6F4F2B) / 256) % $1000000
    Else
      If wh <> 0: wp = wh: EndIf
      wh = 0
    EndIf
    If c = 32 And fwf = 0 And fw = 0: nd = nd + 1: EndIf
    If fwf = 0
      If lt
        fw = (((((fw * 256) + c) + 1) * $6F4F2B) / 256) % $1000000
      ElseIf fw <> 0
        fwf = 1
      EndIf
    EndIf
    If zn = 0
      If c = 59
        zn = 2
      ElseIf c = 34
        zn = 1
      EndIf
    ElseIf zn = 1
      If c = 34 Or c = 10: zn = 0: EndIf
    ElseIf c = 10
      zn = 0
    EndIf
    xlet = Bool((c >= 65 And c <= 90) Or (c >= 97 And c <= 122))
    xaln = Bool((c >= 48 And c <= 57) Or (c >= 65 And c <= 90) Or (c >= 97 And c <= 122) Or c = 95)
    If xaln
      If xwl = 0: xwgap = xgaplen: xmask2 = 0: EndIf
      xwl = xwl + 1
      If xwl > 31: xwl = 31: EndIf
      xgaplen = 0
    Else
      If xwl <> 0: xwl1 = xwl: xmask2 = 0: EndIf
      xwl = 0
      xgaplen = xgaplen + 1
      If xgaplen > 255: xgaplen = 255: EndIf
    EndIf
    xlc = c
    If c >= 65 And c <= 90: xlc = c + 32: EndIf
    If xlet
      If xlc = 101: xt = 101: ElseIf xlc = 97 Or xlc = 105 Or xlc = 111 Or xlc = 117: xt = 97: ElseIf xlc = 121: xt = 121: Else: xt = 98: EndIf
    ElseIf c >= 48 And c <= 57
      If c = 48: xt = 48: Else: xt = 49: EndIf
    ElseIf c = 46 Or c = 33 Or c = 63
      xt = 33
    ElseIf c = 44 Or c = 59 Or c = 58
      xt = 44
    ElseIf c = 40 Or c = 91 Or c = 123
      xt = 40
    ElseIf c = 41 Or c = 93 Or c = 125
      xt = 41
    Else
      xt = c
    EndIf
    xmask2 = ((xmask2 * 256) + xt) % 4294967296
    If xlet
      xe0 = (((((xe0 * 256) + xlc) + 1) * $6F4F2B) / 256) % $1000000
      xelen = xelen + 1
      If xelen > 31: xelen = 31: EndIf
      xec4 = ((xec4 * 256) + xlc) % 4294967296
    Else
      xelen = 0: xec4 = 0
      If (c = 32 Or c = 10) And ((Hi(1) >= 65 And Hi(1) <= 90) Or (Hi(1) >= 97 And Hi(1) <= 122))
        xe4 = xe3: xe3 = xe2: xe2 = xe1: xe1 = xe0: xe0 = 0
      ElseIf c = 39 Or c = 34 Or c = 13 Or (c = 32 And Hi(1) = 10)
        xe4 = xe4
      Else
        xe0 = 0: xe1 = 0: xe2 = 0: xe3 = 0: xe4 = 0
      EndIf
    EndIf
    If c >= 65 And c <= 90: xlastup = 0: ElseIf xlastup < 255: xlastup = xlastup + 1: EndIf
    If pos + 1 - ls = 1
      xfch = c
      If c >= 128
        If c >= 240: xfch = 1: ElseIf c >= 224: xfch = 2: ElseIf c >= 192: xfch = 3: Else: xfch = 4: EndIf
      ElseIf c >= 48 And c <= 57
        xfch = 48
      ElseIf c >= 97 And c <= 122
        xfch = 97
      ElseIf c >= 65 And c <= 90
        xfch = 65
      ElseIf c < 32 And c <> 10
        xfch = 6
      EndIf
    EndIf
    xa = c
    If c >= 128
      If c >= 240: xa = 1: ElseIf c >= 224: xa = 2: ElseIf c >= 192: xa = 3: Else: xa = 4: EndIf
    ElseIf c >= 48 And c <= 57
      xa = 48
    ElseIf c >= 97 And c <= 122
      xa = 97
    ElseIf c >= 65 And c <= 90
      xa = 65
    ElseIf c < 32 And c <> 10
      xa = 6
    EndIf
    xgr = ((xgr * 256) + xa) % 72057594037927936
    xa = 0
    If c <> 32: xa = c / 16: EndIf
    xf4 = ((xf4 * 16) + xa) % 4294967296
    xfl = 0
    If c <> 0
      If xlet
        xfl = 1
      ElseIf (c >= 33 And c <= 47) Or (c >= 58 And c <= 64) Or (c >= 91 And c <= 96) Or (c >= 123 And c <= 126)
        xfl = 2
      ElseIf c = 32 Or (c >= 9 And c <= 13)
        xfl = 3
      ElseIf c = 255
        xfl = 4
      ElseIf c < 16
        xfl = 5
      ElseIf c < 64
        xfl = 6
      Else
        xfl = 7
      EndIf
    EndIf
    xmk = ((xmk * 8) + xfl) % 281474976710656
    If wh <> 0: xa = wh: Else: xa = g0 + 7: EndIf
    xhtok = XTI(xa % 1048576)
    a = c
    If c >= 48 And c <= 57
      a = 48
    ElseIf c >= 65 And c <= 90
      a = 65
    ElseIf c >= 97 And c <= 122
      a = 97
    ElseIf c >= 128
      a = 128
    EndIf
    cgtc = 0
    If (a = 48 Or a = 65 Or a = 97) And a = cg1 % 256: cgtc = 1: EndIf
    If cgtc = 0
      cg3 = ((cg3 * 256) + (cg2 / 16777216)) % 4294967296
      cg2 = ((cg2 * 256) + (cg1 / 16777216)) % 4294967296
      cg1 = ((cg1 * 256) + a) % 4294967296
    EndIf
    If c >= 48 And c <= 57
      tld = 0
      tnh = (((((tnh * 256) + c) + 1) * $6F4F2B) / 256) % $1000000
      tnl = tnl + 1
      If tnl > 19: tnl = 19: EndIf
    Else
      If tld < 255: tld = tld + 1: EndIf
      tnh = 0: tnl = 0
    EndIf
    If c = 44 Or c = 59 Or c = 58 Or c = 46 Or c = 33 Or c = 63: tlp = 0: ElseIf tlp < 63: tlp = tlp + 1: EndIf
    If c = 44: tcom = tcom + 1: EndIf
    If c = 10: tcom = 0: EndIf
    tsp = ((tsp * 2) + Bool(c = 32 Or c = 9 Or c = 13 Or c = 10)) % 4294967296
    xa = 0
    If xlet: xa = 1: ElseIf c = 44 Or c = 59 Or c = 58 Or c = 46 Or c = 33 Or c = 63: xa = 2: ElseIf c = 32 Or c = 9 Or c = 13 Or c = 10: xa = 3: EndIf
    tm1 = ((tm1 * 4) + xa) % 4294967296
    xd = 0
    If xlet
      xd = 1 + Bool(xlc = 97 Or xlc = 101 Or xlc = 105 Or xlc = 111 Or xlc = 117)
    ElseIf c = 46 Or c = 33 Or c = 63
      xd = 3
    ElseIf c = 44 Or c = 59 Or c = 58
      xd = 4
    ElseIf c = 32 Or c = 10 Or c = 13 Or c = 9
      xd = 5
    ElseIf c = 40
      xd = 6
    ElseIf c >= 48 And c <= 57
      xd = 7
    EndIf
    tm3 = ((tm3 * 8) + xd) % 1073741824
    If c = 40: tnest = tnest + 31: ElseIf c = 41: tnest = tnest - 31: ElseIf c = 91: tnest = tnest + 11: ElseIf c = 93: tnest = tnest - 11: ElseIf c = 123: tnest = tnest + 17: ElseIf c = 125: tnest = tnest - 17: ElseIf c = 60: tnest = tnest + 23: ElseIf c = 62: tnest = tnest - 23: EndIf
    If xaln And xwl = 1: tfl = xlc: EndIf
    If c >= 65 And c <= 90 And dprev >= 97 And dprev <= 122
      dlen = 0: dnmaj = 0: dnmin = 0: dpc3 = 0
      dlo0 = 0: dhi0 = DicoNb0
      dlo1 = 0: dhi1 = DicoNb1
    EndIf
    dprev = c
    If (c >= 65 And c <= 90) Or (c >= 97 And c <= 122) Or c >= 128
      dlc = c
      If c >= 65 And c <= 90
        dlc = c + 32
        dnmaj = dnmaj + 1
      ElseIf c >= 97 And c <= 122
        dnmin = dnmin + 1
      ElseIf dpc3 <> 0 And c >= 128 And c <= 158 And c <> 151
        dlc = c + 32
      EndIf
      dpc3 = Bool(c = 195)
      If dlen < 60 And dlo0 < dhi0
        dsa = dlo0
        dsb = dhi0
        While dsa < dsb
          dsm = dsa + ((dsb - dsa) / 2)
          If DicoLong0(dsm) > dlen: dkey = PeekA(*DicoTexte0 + DicoDebut0(dsm) + dlen): Else: dkey = -1: EndIf
          If dkey < dlc: dsa = dsm + 1: Else: dsb = dsm: EndIf
        Wend
        dra = dsa
        dsa = dra
        dsb = dhi0
        While dsa < dsb
          dsm = dsa + ((dsb - dsa) / 2)
          If DicoLong0(dsm) > dlen: dkey = PeekA(*DicoTexte0 + DicoDebut0(dsm) + dlen): Else: dkey = -1: EndIf
          If dkey < (dlc + 1): dsa = dsm + 1: Else: dsb = dsm: EndIf
        Wend
        drb = dsa
        dlo0 = dra: dhi0 = drb
      Else
        dlo0 = 0: dhi0 = 0
      EndIf
      If dlen < 60 And dlo1 < dhi1
        dsa = dlo1
        dsb = dhi1
        While dsa < dsb
          dsm = dsa + ((dsb - dsa) / 2)
          If DicoLong1(dsm) > dlen: dkey = PeekA(*DicoTexte1 + DicoDebut1(dsm) + dlen): Else: dkey = -1: EndIf
          If dkey < dlc: dsa = dsm + 1: Else: dsb = dsm: EndIf
        Wend
        dra = dsa
        dsa = dra
        dsb = dhi1
        While dsa < dsb
          dsm = dsa + ((dsb - dsa) / 2)
          If DicoLong1(dsm) > dlen: dkey = PeekA(*DicoTexte1 + DicoDebut1(dsm) + dlen): Else: dkey = -1: EndIf
          If dkey < (dlc + 1): dsa = dsm + 1: Else: dsb = dsm: EndIf
        Wend
        drb = dsa
        dlo1 = dra: dhi1 = drb
      Else
        dlo1 = 0: dhi1 = 0
      EndIf
      dlen = dlen + 1
    Else
      dlen = 0: dnmaj = 0: dnmin = 0: dpc3 = 0
      dlo0 = 0: dhi0 = DicoNb0
      dlo1 = 0: dhi1 = DicoNb1
    EndIf
  Next

  ProcedureReturn chk
EndProcedure
EnableDebugger


; ----------------------------------------------------------------------------
;  Compresseur et vérificateur de la méthode Methode (8 ou 9, voir
;  MethodeNiveau)
; ----------------------------------------------------------------------------
Procedure.q EncoderMethode(Methode, *D, T.q, *O, P.q, *NNP, Reseau.q)
  If Methode = 9
    ProcedureReturn EncoderCM9(*D, T, *O, P, *NNP, Reseau)
  EndIf
  ProcedureReturn EncoderCM8(*D, T, *O, P, *NNP, Reseau)
EndProcedure

Procedure.q VerifierMethode(Methode, *C, T.q, *D, P.q, *NNP, Reseau.q)
  If Methode = 9
    ProcedureReturn VerifierCM9(*C, T, *D, P, *NNP, Reseau)
  EndIf
  ProcedureReturn VerifierCM8(*C, T, *D, P, *NNP, Reseau)
EndProcedure


; ----------------------------------------------------------------------------
;  Compression et vérification en même temps (seulement si le programme est
;  compilé avec l'option « thread-safe »). Le second thread ne touche ni aux
;  chaînes ni à la fenêtre.
; ----------------------------------------------------------------------------
CompilerIf #PB_Compiler_Thread

Structure ParamVerification
  AdresseC.i      ; octets compressés (remplis au fur et à mesure par la compression)
  T.q             ; taille du code
  AdresseD.i      ; texte de référence, puis place pour le code décompressé
  P.q             ; taille du texte de référence
  AdresseNNP.i    ; probabilités du réseau (niveaux 2 et 3), sinon 0
  Reseau.i        ; 1 aux niveaux 2 et 3
  Methode.i       ; 8 ou 9 (voir MethodeNiveau)
  Resultat.q      ; somme de contrôle du code décompressé
EndStructure
Global ParamVerif.ParamVerification
Global VerifParalleleOk

Procedure FilVerification(*Param.ParamVerification)
  EstFilVerification = #True        ; ce thread n'affiche rien (voir AvancementVerif)
  *Param\Resultat = VerifierMethode(*Param\Methode, *Param\AdresseC, *Param\T, *Param\AdresseD, *Param\P, *Param\AdresseNNP, *Param\Reseau)
EndProcedure


; Compresse *Avec (texte de référence + code de Taille octets) dans *ZM, pendant
; que le second thread décompresse dans *Verif. Renvoie la taille compressée, ou
; -1 si le second thread n'a pas pu démarrer (rien n'a été fait).
; VerifParalleleOk = #True si la décompression faite en même temps redonne
; exactement le code.
Procedure.q CompresserEnParallele(*Avec, Taille.q, *ZM, *Verif, *NNP, Reseau, K.q, Etape$, Methode)
  Protected Fil
  Protected.q ZM

  VerifParalleleOk = #False
  CopyMemory(*Reference, *Verif, TailleReference)
  OctetsPublies = 0
  EncodageFini = #False
  ParamVerif\AdresseC = *ZM
  ParamVerif\T = Taille
  ParamVerif\AdresseD = *Verif
  ParamVerif\P = TailleReference
  ParamVerif\AdresseNNP = *NNP
  ParamVerif\Reseau = Reseau
  ParamVerif\Methode = Methode
  ParamVerif\Resultat = -1
  ParalleleActif = #True
  Fil = CreateThread(@FilVerification(), @ParamVerif)
  If Fil = 0
    ParalleleActif = #False
    ProcedureReturn -1
  EndIf

  CommencerPasse(Etape$, PoidsMethode(Methode))
  ZM = EncoderMethode(Methode, *Avec, Taille, *ZM, TailleReference, *NNP, Reseau)
  TerminerPasse(TailleReference + Taille)

  ; Tout est produit: le second thread peut finir
  LockMutex(MutexCM4)
  OctetsPublies = ZM
  EncodageFini = #True
  UnlockMutex(MutexCM4)
  ParalleleActif = #False
  ProgresEtape$ = Tr("etapeFinVerification")
  While WaitThread(Fil, 100) = 0
    AfficherProgression(ProgresFait)
  Wend

  VerifParalleleOk = Bool(ParamVerif\Resultat = K And CompareMemory(*Verif + TailleReference, *Avec + TailleReference, Taille))
  ProcedureReturn ZM
EndProcedure

CompilerEndIf


; ----------------------------------------------------------------------------
;  Y a-t-il assez de mémoire pour deux modèles de la méthode à la fois
;  (compression et vérification en parallèle, environ 3,5 Go ; 2,5 Go au
;  niveau 3) ? Seulement si le programme est compilé avec l'option
;  « thread-safe ». Essai = #False: estimation rapide pour l'affichage, sans
;  essayer de réserver la mémoire.
; ----------------------------------------------------------------------------
Procedure ParalleleDisponible5(Essai, Methode = 8)
  Protected Ok
  CompilerIf #PB_Compiler_Thread
    Protected *Essai

    If MutexCM4 And MemoryStatus(#PB_System_FreePhysical) >= (2 * MemoireDeMethode(Methode)) + (300 * 1024 * 1024)
      Ok = #True
      If Essai
        *Essai = AllocateMemory(2 * MemoireDeMethode(Methode), #PB_Memory_NoClear)
        If *Essai
          FreeMemory(*Essai)
        Else
          Ok = #False
        EndIf
      EndIf
    EndIf
  CompilerEndIf
  ProcedureReturn Ok
EndProcedure


; ----------------------------------------------------------------------------
;  Pourquoi la vérification ne se fait pas en même temps que la compression
;  (texte court, pour l'affichage).
; ----------------------------------------------------------------------------
Procedure.s RaisonSansParallele(Methode = 8)
  Protected Raison$
  CompilerIf #PB_Compiler_Thread
    Protected.q Libre, Besoin

    Libre  = MemoryStatus(#PB_System_FreePhysical)
    Besoin = (2 * MemoireDeMethode(Methode)) + (300 * 1024 * 1024)
    If MutexCM4 = 0
      Raison$ = Tr("raisonThread")
    ElseIf Libre < Besoin
      Raison$ = TrF("raisonMemoire", Str(Libre / (1024 * 1024)), Str(Besoin / (1024 * 1024)))
    Else
      Raison$ = Tr("raisonMemoireRefusee")
    EndIf
  CompilerElse
    Raison$ = Tr("raisonOption")
  CompilerEndIf
  ProcedureReturn Raison$
EndProcedure


; ----------------------------------------------------------------------------
;  Vérification de la méthode v6 après la compression (quand elle n'a pas pu se
;  faire en même temps): le même vérificateur, dans le fil principal. Renvoie
;  #True si la décompression redonne exactement *Attendu (T octets).
; ----------------------------------------------------------------------------
Procedure VerifierModele5(*C, Z.q, T.q, *Attendu, *NNP, Reseau, K.q, Methode)
  Protected Ok
  Protected.q Chk
  Protected *D

  *D = AllocateMemory(TailleReference + T + 16)
  If *D = 0
    ProcedureReturn #False
  EndIf
  CopyMemory(*Reference, *D, TailleReference)
  OctetsPublies = Z                       ; tous les octets compressés sont déjà là
  EncodageFini = #True
  CommencerPasse(Tr("etapeVerification"), PoidsMethode(Methode))
  Chk = VerifierMethode(Methode, *C, T, *D, TailleReference, *NNP, Reseau)
  TerminerPasse(TailleReference + T)
  Ok = Bool(Chk = K And CompareMemory(*D + TailleReference, *Attendu, T))
  FreeMemory(*D)
  ProcedureReturn Ok
EndProcedure


; ----------------------------------------------------------------------------
;  Méthode v6: travail prévu pour une compression (unités de la barre de
;  progression): le réseau (niveaux 2 et 3) et son contrôle, la compression,
;  et la vérification (en même temps si Parallele, sinon après).
; ----------------------------------------------------------------------------
#OctetsControleReseau = 1024     ; octets du début du code recalculés comme chez le lecteur

Procedure.q OctetsControleReseau(T.q)
  If T < #OctetsControleReseau
    ProcedureReturn T
  EndIf
  ProcedureReturn #OctetsControleReseau
EndProcedure

Procedure.q TravailCompression5(T.q, Niveau, Parallele)
  Protected.q Travail, Lecture

  LireTableReference()
  Lecture = (SegmentTaille(0) + T) * PoidsMethode(MethodeNiveau(Niveau))
  Travail = TravailReference(#NiveauFaible) + Lecture
  If Parallele = #False
    Travail = Travail + Lecture
  EndIf
  If Niveau >= 2
    Travail = Travail + (T * PoidsReseau(VitesseReseauComp(Niveau - 1, T)))
    Travail = Travail + (OctetsControleReseau(T) * PoidsReseau(VitesseReseauDec(Niveau - 1)))
  EndIf
  ProcedureReturn Travail
EndProcedure


; Temps estimés sur ce PC (secondes): compression, et décompression ici
Procedure.q DureeCompression5(T.q, Niveau)
  Protected.q Secondes

  Secondes = TravailCompression5(T, Niveau, ParalleleDisponible5(#False, MethodeNiveau(Niveau))) / VitesseCM
  If Niveau >= 2
    If ReseauMesure(Niveau - 1) = #False
      Secondes = Secondes + #DureeCalibrage
    EndIf
  EndIf
  ProcedureReturn Secondes
EndProcedure


; Temps pour un lecteur qui n'a encore rien sur son PC (la première fois), sur
; un PC comme celui-ci: il décompresse le début du fichier de référence, et
; mesure la vitesse du réseau (niveaux 2 et 3)
Procedure.q DureeLecteur5(T.q, Niveau)
  Protected.q Secondes

  LireTableReference()
  Secondes = ((SegmentTaille(0) * 4) + ((SegmentTaille(0) + T) * PoidsMethode(MethodeNiveau(Niveau)))) / VitesseCM
  If Niveau >= 2
    Secondes = Secondes + (T / VitesseReseauDec(Niveau - 1)) + #DureeCalibrage
  EndIf
  ProcedureReturn Secondes
EndProcedure


; ----------------------------------------------------------------------------
;  Écrit un nombre avec des espaces: 30000 -> "30 000"
; ----------------------------------------------------------------------------
Procedure.s FormaterNombre(Nombre)
  Protected Chiffres$, Sortie$, i, n, Separateur$

  ; séparateur des milliers à la façon de la langue de l'interface
  Select Langue
    Case #LangueEn
      Separateur$ = ","
    Case #LangueDe
      Separateur$ = "."
    Default
      Separateur$ = Chr(160)              ; espace insécable
  EndSelect
  Chiffres$ = Str(Nombre)
  n = Len(Chiffres$)
  For i = 1 To n
    Sortie$ = Sortie$ + Mid(Chiffres$, i, 1)
    If i < n And (n - i) % 3 = 0 And Mid(Chiffres$, i, 1) <> "-"
      Sortie$ = Sortie$ + Separateur$
    EndIf
  Next
  ProcedureReturn Sortie$
EndProcedure


; ----------------------------------------------------------------------------
;  Nombre de caractères que le forum (phpBB) comptera pour ce texte posté
;  entre les balise de code. phpBB compte APRÈS avoir:
;   - remplacé chaque retour à la ligne Windows (2 caractères) par 1 seul ;
;   - remplacé  "  &  <  >  par  &quot;  &amp;  &lt;  &gt;  (6, 5, 4, 4 car.)
; ----------------------------------------------------------------------------
Procedure TailleForum(Texte$)
  Protected Taille

  Taille = Len(Texte$) - CountString(Texte$, #CRLF$)
  Taille = Taille + 5 * CountString(Texte$, Chr(34))
  Taille = Taille + 4 * CountString(Texte$, "&")
  Taille = Taille + 3 * CountString(Texte$, "<")
  Taille = Taille + 3 * CountString(Texte$, ">")

  ProcedureReturn Taille + #TailleBalisesCode
EndProcedure


; ----------------------------------------------------------------------------
;  Lit un fichier .pb et renvoie son texte.
;  Gère l'UTF-8 avec marque (format normal de l'éditeur PureBasic),
;  l'UTF-8 sans marque, et l'ancien format ASCII.
; ----------------------------------------------------------------------------
Procedure.s LireFichier(NomFichier$)
  Protected Texte$, Taille, Fichier, *Brut, *Test, AvecMarque = #False

  Fichier = ReadFile(#PB_Any, NomFichier$)
  If Fichier
    Taille = Lof(Fichier)
    If Taille > 0
      *Brut = AllocateMemory(Taille)
      If *Brut
        ReadData(Fichier, *Brut, Taille)

        ; Marque UTF-8 (BOM) en début de fichier ?
        If Taille >= 3
          If PeekA(*Brut) = $EF And PeekA(*Brut + 1) = $BB And PeekA(*Brut + 2) = $BF
            AvecMarque = #True
          EndIf
        EndIf

        If AvecMarque
          ; La marque n'est pas du code: on la saute
          If Taille > 3
            Texte$ = PeekS(*Brut + 3, Taille - 3, #PB_UTF8 | #PB_ByteLength)
          EndIf
        Else
          ; Sans marque: on essaie l'UTF-8, et on vérifie que la relecture
          ; redonne exactement les mêmes octets. Sinon, c'est de l'ASCII.
          Texte$ = PeekS(*Brut, Taille, #PB_UTF8 | #PB_ByteLength)
          If StringByteLength(Texte$, #PB_UTF8) = Taille
            *Test = AllocateMemory(Taille + 1)
            If *Test
              PokeS(*Test, Texte$, -1, #PB_UTF8)
              If CompareMemory(*Brut, *Test, Taille) = 0
                Texte$ = PeekS(*Brut, Taille, #PB_Ascii)
              EndIf
              FreeMemory(*Test)
            EndIf
          Else
            Texte$ = PeekS(*Brut, Taille, #PB_Ascii)
          EndIf
        EndIf

        FreeMemory(*Brut)
      EndIf
    EndIf
    CloseFile(Fichier)
  EndIf

  ProcedureReturn Texte$
EndProcedure


; ----------------------------------------------------------------------------
;  Retire le bloc "; IDE Options = ..." que l'éditeur PureBasic ajoute à la
;  fin des fichiers (réglages de compilation, invisible dans l'éditeur).
;  Comme l'éditeur, on ne le retire que s'il est vraiment À LA FIN: après sa
;  première ligne, il ne doit y avoir que des commentaires (;) ou des lignes
;  vides. Sinon (par exemple plusieurs codes mis bout à bout), il fait partie
;  du code et rien n'est retiré. Jusqu'à la v6.4, tout ce qui suivait la
;  dernière ligne « ; IDE Options » était coupé, même du code.
; ----------------------------------------------------------------------------
Procedure.s RetirerOptionsIDE(Texte$)
  Protected Position = 0, Trouve = 0, Debut, Fin, k, Longueur
  Protected Reste$, Ligne$, Car$

  ; On cherche la DERNIÈRE occurrence
  Repeat
    Trouve = FindString(Texte$, "; IDE Options = ", Position + 1)
    If Trouve
      Position = Trouve
    EndIf
  Until Trouve = 0
  If Position = 0
    ProcedureReturn Texte$
  EndIf

  ; Elle doit être en début de ligne
  If Position > 1
    If Mid(Texte$, Position - 1, 1) <> #LF$ And Mid(Texte$, Position - 1, 1) <> #CR$
      ProcedureReturn Texte$
    EndIf
  EndIf

  ; Et ne doit être suivie que de commentaires ou de lignes vides (une ligne
  ; à la fois ; les fins de ligne CR seules comptent aussi)
  Reste$ = ReplaceString(Mid(Texte$, Position), #CR$, #LF$)
  Longueur = Len(Reste$)
  Debut = 1
  While Debut <= Longueur
    Fin = FindString(Reste$, #LF$, Debut)
    If Fin = 0
      Fin = Longueur + 1
    EndIf
    Ligne$ = Mid(Reste$, Debut, Fin - Debut)
    ; premier caractère qui n'est ni une espace ni une tabulation
    Car$ = ""
    For k = 1 To Len(Ligne$)
      If Mid(Ligne$, k, 1) <> " " And Mid(Ligne$, k, 1) <> #TAB$
        Car$ = Mid(Ligne$, k, 1)
        Break
      EndIf
    Next
    If Car$ <> "" And Car$ <> ";"
      ProcedureReturn Texte$             ; du code après: ce n'est pas le bloc de fin
    EndIf
    Debut = Fin + 1
  Wend

  ProcedureReturn Left(Texte$, Position - 1)
EndProcedure


; ----------------------------------------------------------------------------
;  Mode Unicode: octets -> texte, 15 bits par caractère
; ----------------------------------------------------------------------------
Procedure.s EncoderUnicode(*Donnees, Taille)
  Protected Sortie$, *Ecriture.Unicode, i, Accu, NbBits

  ; 8 bits par octet, 15 bits par caractère, arrondi au-dessus
  Sortie$ = Space((Taille * 8 + 14) / 15)
  *Ecriture = @Sortie$

  For i = 0 To Taille - 1
    Accu = (Accu << 8) | PeekA(*Donnees + i)
    NbBits = NbBits + 8
    If NbBits >= 15
      NbBits = NbBits - 15
      *Ecriture\u = CaractereUnicode((Accu >> NbBits) & $7FFF)
      *Ecriture = *Ecriture + 2
      Accu = Accu & ((1 << NbBits) - 1)
    EndIf
  Next

  ; Derniers bits, complétés par des zéros
  If NbBits > 0
    *Ecriture\u = CaractereUnicode((Accu << (15 - NbBits)) & $7FFF)
  EndIf

  ProcedureReturn Sortie$
EndProcedure


; ----------------------------------------------------------------------------
;  Octets compressés -> texte, selon l'encodage ("U" ou "B")
; ----------------------------------------------------------------------------
Procedure.s EncoderDonnees(*Donnees, Taille, Encodage$)
  If Encodage$ = "B"
    ProcedureReturn Base64Encoder(*Donnees, Taille)
  Else
    ProcedureReturn EncoderUnicode(*Donnees, Taille)
  EndIf
EndProcedure


; ----------------------------------------------------------------------------
;  Format auto-extractible: fabrique le programme à poster sur le forum
; ----------------------------------------------------------------------------
Procedure.s GenererLanceur(Donnees$, TailleOriginale.q, TailleCompressee.q, K.q, Methode$, Encodage$, LangueSortie)
  Protected Q$ = Chr(34), L$, Ligne$, Position, Longueur
  Protected Commentaire$, TitreOK$, MessageOK$, TitreErreur$, MessageErreur$

  Select LangueSortie
    Case 1
      Commentaire$   = "; Compressed PureBasic code - run it (F5): the original code is copied to the clipboard"
      TitreOK$       = "Done"
      MessageOK$     = "The original code is in the clipboard. Paste it now, then click OK."
      TitreErreur$   = "Error"
      MessageErreur$ = "The data is damaged: copy the whole message again."
      If Encodage$ = "U"
        MessageErreur$ = MessageErreur$ + " The source file must be UTF-8."
      EndIf
    Case 2
      Commentaire$   = "; Komprimierter PureBasic-Code - starte ihn (F5): Der Originalcode wird in die Zwischenablage kopiert"
      TitreOK$       = "Fertig"
      MessageOK$     = "Der Originalcode ist in der Zwischenablage. Füge ihn jetzt ein und klicke dann auf OK."
      TitreErreur$   = "Fehler"
      MessageErreur$ = "Die Daten sind beschädigt: Kopiere die ganze Nachricht erneut."
      If Encodage$ = "U"
        MessageErreur$ = MessageErreur$ + " Die Quelldatei muss UTF-8 sein."
      EndIf
    Default
      Commentaire$   = "; Code PureBasic compressé - lancez-le (F5): le code d'origine est copié dans le presse-papiers"
      TitreOK$       = "Terminé"
      MessageOK$     = "Le code d'origine est dans le presse-papiers. Collez-le maintenant, puis cliquez sur OK."
      TitreErreur$   = "Erreur"
      MessageErreur$ = "Les données sont abîmées: recopiez le message en entier."
      If Encodage$ = "U"
        MessageErreur$ = MessageErreur$ + " Le fichier source doit être en UTF-8."
      EndIf
  EndSelect

  L$ = Commentaire$ + #CRLF$
  If Methode$ = "M"
    L$ = L$ + "DisableDebugger" + #CRLF$
    ; Toutes les variables du lanceur en entiers 64 bits, sur tous les PureBasic (32 et 64 bits)
    L$ = L$ + "Define.q T, Z, a, N, i, u, v, x, ip, k, x1, x2, wh, ls, pl, ml, mp, chk, pos, h, hm, ab, ma, c0, j, ws, dot, pb, e, pm, px, s, aw, ai, xm, y, er, g, c" + #CRLF$
  Else
    L$ = L$ + "UseLZMAPacker()" + #CRLF$
  EndIf
  L$ = L$ + "T = " + Str(TailleOriginale) + #CRLF$
  If Encodage$ = "U" Or Methode$ = "M"
    L$ = L$ + "Z = " + Str(TailleCompressee) + #CRLF$
  EndIf
  L$ = L$ + "Restore Donnees" + #CRLF$
  L$ = L$ + "Repeat" + #CRLF$
  L$ = L$ + "  Read.s L$" + #CRLF$
  L$ = L$ + "  B$ = B$ + L$" + #CRLF$
  L$ = L$ + "Until L$ = " + Q$ + Q$ + #CRLF$

  ; 1. Texte -> octets compressés
  If Encodage$ = "B"
    L$ = L$ + "*C = AllocateMemory(Len(B$) + 64)" + #CRLF$
    L$ = L$ + "*D = AllocateMemory(T + 16)" + #CRLF$
    If Methode$ = "M"
      L$ = L$ + "Base64Decoder(B$, *C, Len(B$) + 64)" + #CRLF$
    EndIf
  Else
    L$ = L$ + "*C = AllocateMemory(Len(B$) * 2 + 16)" + #CRLF$
    L$ = L$ + "*D = AllocateMemory(T + 16)" + #CRLF$
    L$ = L$ + "*P.Unicode = @B$" + #CRLF$
    L$ = L$ + "While *P\u" + #CRLF$
    L$ = L$ + "  a = (a << 15) | (*P\u - $3400 - Bool(*P\u >= $AC00) * $C00)" + #CRLF$
    L$ = L$ + "  k = k + 15" + #CRLF$
    L$ = L$ + "  While k >= 8" + #CRLF$
    L$ = L$ + "    k = k - 8" + #CRLF$
    L$ = L$ + "    PokeA(*C + N, (a >> k) & 255)" + #CRLF$
    L$ = L$ + "    N = N + 1" + #CRLF$
    L$ = L$ + "  Wend" + #CRLF$
    L$ = L$ + "  a = a & ((1 << k) - 1)" + #CRLF$
    L$ = L$ + "  *P = *P + 2" + #CRLF$
    L$ = L$ + "Wend" + #CRLF$
  EndIf

  ; 2. Décompression
  If Methode$ = "M"
    ; Le décompresseur Maximal: mêmes lignes que la procédure DecoderCM
    Restore LanceurCM
    Repeat
      Read.s Ligne$
      If Ligne$ <> ""
        L$ = L$ + Ligne$ + #CRLF$
      EndIf
    Until Ligne$ = ""
    L$ = L$ + "If chk = " + Str(K) + #CRLF$
  ElseIf Encodage$ = "B"
    L$ = L$ + "If UncompressMemory(*C, Base64Decoder(B$, *C, Len(B$) + 64), *D, T, #PB_PackerPlugin_Lzma) = T" + #CRLF$
  Else
    L$ = L$ + "If UncompressMemory(*C, Z, *D, T, #PB_PackerPlugin_Lzma) = T" + #CRLF$
  EndIf

  L$ = L$ + "  SetClipboardText(PeekS(*D, T, #PB_UTF8 | #PB_ByteLength))" + #CRLF$
  L$ = L$ + "  MessageRequester(" + Q$ + TitreOK$ + Q$ + ", " + Q$ + MessageOK$ + Q$ + ")" + #CRLF$
  L$ = L$ + "Else" + #CRLF$
  L$ = L$ + "  MessageRequester(" + Q$ + TitreErreur$ + Q$ + ", " + Q$ + MessageErreur$ + Q$ + ")" + #CRLF$
  L$ = L$ + "EndIf" + #CRLF$
  L$ = L$ + "DataSection" + #CRLF$
  L$ = L$ + "  Donnees:" + #CRLF$

  ; Les données, découpées en lignes
  Longueur = Len(Donnees$)
  Position = 1
  While Position <= Longueur
    L$ = L$ + "  Data.s " + Q$ + Mid(Donnees$, Position, #LongueurLigne) + Q$ + #CRLF$
    Position = Position + #LongueurLigne
  Wend

  ; Ligne vide = fin des données
  L$ = L$ + "  Data.s " + Q$ + Q$ + #CRLF$
  If Methode$ = "M"
    L$ = L$ + "  Sq33:" + #CRLF$
    L$ = L$ + "  Data.q " + #DonneesSq33$ + #CRLF$
  EndIf
  L$ = L$ + "EndDataSection" + #CRLF$

  ProcedureReturn L$
EndProcedure


; ----------------------------------------------------------------------------
;  Format données seules: bloc à coller dans le Compresseur
; ----------------------------------------------------------------------------
Procedure.s GenererBloc(Donnees$, TailleOriginale.q, TailleCompressee.q, K.q, Methode$, Encodage$, LangueSortie, Version$)
  Protected B$, Position, Longueur, Code

  ; Unicode: format compact, uniquement des caractères Unicode, sans rien d'autre
  If Encodage$ = "U"
    Code = Val(Mid(Version$, 4))       ; PBC1 à PBC21
    B$ = Chr(CaractereUnicode(#MarqueCompacte)) + Chr(CaractereUnicode(Code))
    B$ = B$ + Chr(CaractereUnicode(TailleOriginale / 32768)) + Chr(CaractereUnicode(TailleOriginale % 32768))
    B$ = B$ + Chr(CaractereUnicode(TailleCompressee / 32768)) + Chr(CaractereUnicode(TailleCompressee % 32768))
    B$ = B$ + Chr(CaractereUnicode(K / 32768)) + Chr(CaractereUnicode(K % 32768))
    ProcedureReturn B$ + Donnees$
  EndIf

  ; Base64: format texte avec en-tête lisible

  ; (cette ligne ne doit jamais contenir « PBC »: c'est la marque de l'en-tête)
  Select LangueSortie
    Case 1
      B$ = "; Compressed PureBasic code - unpack it with PB-SuperCodeCompressor (paste it into the program)" + #CRLF$
    Case 2
      B$ = "; Komprimierter PureBasic-Code - entpacke ihn mit PB-SuperCodeCompressor (in das Programm einfügen)" + #CRLF$
    Default
      B$ = "; Code PureBasic compressé - décompressez-le avec PB-SuperCodeCompressor (collez-le dans le programme)" + #CRLF$
  EndSelect
  B$ = B$ + Version$ + ";" + Methode$ + ";" + Encodage$ + ";" + Str(TailleOriginale) + ";" + Str(TailleCompressee) + ";" + Str(K) + ";" + #CRLF$

  Longueur = Len(Donnees$)
  Position = 1
  While Position <= Longueur
    B$ = B$ + Mid(Donnees$, Position, #LongueurLigne) + #CRLF$
    Position = Position + #LongueurLigne
  Wend

  B$ = B$ + ";FIN" + #CRLF$
  ProcedureReturn B$
EndProcedure


; ----------------------------------------------------------------------------
;  Vérification d'un lanceur: rejoue ce que fera le lanceur chez le lecteur,
;  en relisant les lignes "Data.s" directement dans le texte généré.
;  Renvoie #True si on retrouve exactement le code d'origine.
; ----------------------------------------------------------------------------
Procedure VerifierLanceur(Lanceur$, TexteAttendu$, TailleOriginale.q, TailleCompressee.q, K.q, Methode$, Encodage$)
  Protected NbLignes, i, Ligne$, Donnees$, Debut$, LongueurDebut
  Protected *Compresse, *Decompresse, TailleTampon, TailleDecodee
  Protected Ok = #False

  Debut$ = "Data.s " + Chr(34)
  LongueurDebut = Len(Debut$)

  ; 1. On récupère les données dans les lignes "Data.s"
  NbLignes = CountString(Lanceur$, #LF$) + 1
  For i = 1 To NbLignes
    Ligne$ = Trim(RemoveString(StringField(Lanceur$, i, #LF$), #CR$))
    If Left(Ligne$, LongueurDebut) = Debut$ And Len(Ligne$) > LongueurDebut And Right(Ligne$, 1) = Chr(34)
      Donnees$ = Donnees$ + Mid(Ligne$, LongueurDebut + 1, Len(Ligne$) - LongueurDebut - 1)
    EndIf
  Next

  ; 2. Décodage puis décompression, comme le fera le lanceur
  If Donnees$ <> ""
    TailleTampon = Len(Donnees$) * 2 + 64
    *Compresse = AllocateMemory(TailleTampon)
    *Decompresse = AllocateMemory(TailleOriginale + 16)
    If *Compresse And *Decompresse

      If Encodage$ = "B"
        TailleDecodee = Base64Decoder(Donnees$, *Compresse, TailleTampon)
      Else
        ; Le lanceur décompresse Z = TailleCompressee octets: on fait pareil
        If DecoderUnicode(Donnees$, *Compresse, TailleTampon) >= TailleCompressee
          TailleDecodee = TailleCompressee
        EndIf
      EndIf

      If TailleDecodee >= TailleCompressee And TailleCompressee > 0
        If Methode$ = "M"
          If DecoderCM(*Compresse, TailleCompressee, TailleOriginale, *Decompresse) = K
            Ok = Bool(PeekS(*Decompresse, TailleOriginale, #PB_UTF8 | #PB_ByteLength) = TexteAttendu$)
          EndIf
        Else
          If UncompressMemory(*Compresse, TailleDecodee, *Decompresse, TailleOriginale, #PB_PackerPlugin_Lzma) = TailleOriginale
            Ok = Bool(PeekS(*Decompresse, TailleOriginale, #PB_UTF8 | #PB_ByteLength) = TexteAttendu$)
          EndIf
        EndIf
      EndIf

    EndIf
    If *Compresse
      FreeMemory(*Compresse)
    EndIf
    If *Decompresse
      FreeMemory(*Decompresse)
    EndIf
  EndIf

  ProcedureReturn Ok
EndProcedure


; ----------------------------------------------------------------------------
;  Vérifie une sortie, quel que soit son format
; ----------------------------------------------------------------------------
Procedure VerifierSortie(Sortie$, Format, TexteAttendu$, TailleOriginale.q, TailleCompressee.q, K.q, Methode$, Encodage$)
  If Format = #FormatBloc
    ; Exactement ce que fera l'onglet Décompresser chez le lecteur
    ProcedureReturn Bool(DecompresserBloc(Sortie$) = TexteAttendu$)
  Else
    ProcedureReturn VerifierLanceur(Sortie$, TexteAttendu$, TailleOriginale, TailleCompressee, K, Methode$, Encodage$)
  EndIf
EndProcedure


; ============================================================================
;  Réglages et estimations (sans fenêtre): niveau, protection, taille sur le
;  forum, temps estimés, place sur le disque
; ============================================================================

Global DernierResultat$            ; dernier résultat, en entier
Global FichierCharge$              ; nom du fichier du code d'origine ("" = presse-papiers)

; ----------------------------------------------------------------------------
;  Niveau de protection choisi (0 = aucune, sinon 1, 2, 4, 8, 16)
; ----------------------------------------------------------------------------
Procedure NiveauProtectionChoisi()
  Select Reglage\Protection
    Case 1
      ProcedureReturn 1
    Case 2
      ProcedureReturn 2
    Case 3
      ProcedureReturn 4
    Case 4
      ProcedureReturn 8
    Case 5
      ProcedureReturn 16
  EndSelect
  ProcedureReturn 0
EndProcedure

; ----------------------------------------------------------------------------
;  Niveau de compression: temps et taille estimés
; ----------------------------------------------------------------------------
Procedure.s DureeApprox(Secondes.q)
  If Secondes < 10
    ProcedureReturn "< 10 " + Tr("unitS")
  ElseIf Secondes < 60
    ProcedureReturn "≈ " + Str(((Secondes + 4) / 5) * 5) + " " + Tr("unitS")
  EndIf
  ProcedureReturn "≈ " + Decimal(Secondes / 60.0, 1) + " " + Tr("unitMin")
EndProcedure

; Surcoût de la protection contre les erreurs, pour mille
Procedure SurcoutProtection()
  Select NiveauProtectionChoisi()
    Case 1
      ProcedureReturn 1035
    Case 2
      ProcedureReturn 1050
    Case 4
      ProcedureReturn 1090
    Case 8
      ProcedureReturn 1160
    Case 16
      ProcedureReturn 1300
  EndSelect
  ProcedureReturn 1000
EndProcedure

; Rapports Maximal / LZMA (pour mille) mesurés sur 8 codes qui ne sont pas
; dans le texte de référence (5 codes publics, 3 codes de Shadow): les plus
; bas et les plus hauts habituels (v7.3: environ 4 % de mieux au niveau 1,
; 1 % au niveau 2 et 3 % au niveau 3 qu'avec la v7.0)
Procedure RapportBas(Niveau)
  Select Niveau
    Case 1
      ProcedureReturn 450
    Case 3
      ProcedureReturn 340
  EndSelect
  ProcedureReturn 355
EndProcedure

Procedure RapportHaut(Niveau)
  Select Niveau
    Case 1
      ProcedureReturn 535
    Case 3
      ProcedureReturn 450
  EndSelect
  ProcedureReturn 465
EndProcedure

; Niveau choisi (1 à 3)
Procedure NiveauChoisi()
  If Reglage\Niveau < #NiveauV7Min Or Reglage\Niveau > #NiveauV7Max
    Reglage\Niveau = #NiveauV7Defaut
  EndIf
  ProcedureReturn Reglage\Niveau
EndProcedure

; Fils du réseau sur ce PC (texte court pour l'affichage)
Procedure.s TexteFilsReseau(Modele)
  If NNCoeurs < 1
    NNCoeursPhysiques()
  EndIf
  If ReseauMesure(Modele)
    ProcedureReturn TrF("filsReseau", Str(NNCalFils(Modele)), Str(NNCoeurs), Str(NNProcesseurs))
  EndIf
  ProcedureReturn TrF("filsReseauInconnu", Str(NNCoeurs), Str(NNProcesseurs))
EndProcedure

; Caractères comptés par le forum pour Z octets compressés
Procedure CaracteresForum(Z.q)
  Protected.q Caracteres

  If Reglage\Encodage = #EncodageBase64
    ; Base64: 4 caractères pour 3 octets, plus l'en-tête lisible
    ProcedureReturn (((Z + 2) / 3) * 4) + 150 + #TailleBalisesCode
  EndIf
  ; Unicode, format compact: 15 bits par caractère, 8 caractères d'en-tête
  Caracteres = (((Z * 8) + 14) / 15) + 8
  ProcedureReturn ((Caracteres * SurcoutProtection()) / 1000) + #TailleBalisesCode
EndProcedure

; ----------------------------------------------------------------------------
;  Ce qui est gardé sur le disque: place utilisée
; ----------------------------------------------------------------------------
Procedure.q PlaceEtats()
  Protected i
  Protected.q Total, Taille

  For i = #NiveauMoyen To #NiveauMaximal
    Taille = FileSize(FichierEtat(i))
    If Taille > 0
      Total = Total + Taille
    EndIf
    Taille = FileSize(FichierEtat(i) + ".tmp")
    If Taille > 0
      Total = Total + Taille
    EndIf
  Next
  Taille = FileSize(FichierTexteReference())          ; texte de référence décompressé
  If Taille > 0
    Total = Total + Taille
  EndIf
  ProcedureReturn Total
EndProcedure

Procedure.s FormaterOctets(Taille.q)
  If Taille >= 1024 * 1024 * 1024
    ProcedureReturn Decimal(Taille / (1024.0 * 1024.0 * 1024.0), 1) + " " + Tr("unitGo")
  EndIf
  ProcedureReturn Str((Taille + (512 * 1024)) / (1024 * 1024)) + " " + Tr("unitMo")
EndProcedure

; ----------------------------------------------------------------------------
;  Ce qui s'est passé avec le fichier de référence pendant l'opération (texte à
;  ajouter au compte rendu, "" si rien)
; ----------------------------------------------------------------------------
Procedure.s CompteRenduReference()
  If EtatMaximalRefuse
    ProcedureReturn Tr("crEtatRefuse")
  ElseIf EtatMaximalPrepare
    ProcedureReturn Tr("crReferenceEtEtat")
  ElseIf ReferenceDecompressee = 2
    ProcedureReturn Tr("crReference")
  EndIf
  ProcedureReturn ""
EndProcedure

; ----------------------------------------------------------------------------
;  Teste la réparation d'un bloc protégé sur 3 copies abîmées exprès:
;  un caractère retiré au milieu, un caractère remplacé au début, la fin
;  coupée de 20 caractères. Chacune doit redonner exactement Brut$.
; ----------------------------------------------------------------------------
Procedure TesterProtection(Bloc$, Brut$)
  Protected Abime$, Milieu, Ok

  Ok = #True
  Milieu = Len(Bloc$) / 2
  Abime$ = Left(Bloc$, Milieu) + Mid(Bloc$, Milieu + 2)
  If ReparerBloc(Abime$) <> Brut$ Or InfZones = 0
    Ok = #False
  EndIf
  Abime$ = Left(Bloc$, 19) + Chr(CaractereUnicode((ValeurUnicode(Asc(Mid(Bloc$, 20, 1))) + 1) % 32768)) + Mid(Bloc$, 21)
  If ReparerBloc(Abime$) <> Brut$ Or InfZones = 0
    Ok = #False
  EndIf
  Abime$ = Left(Bloc$, Len(Bloc$) - 20)
  If ReparerBloc(Abime$) <> Brut$ Or InfZones = 0
    Ok = #False
  EndIf
  ProcedureReturn Ok
EndProcedure

; ----------------------------------------------------------------------------
;  Mesures du réseau: clés à part pour le programme lancé avec le débogueur
;  (CleReseau), et mesures de l'autre façon de lancer le programme, gardées
;  telles quelles (CleAutre)
; ----------------------------------------------------------------------------
Global Dim MesureAutre$(2)

Procedure.s CleReseau()
  CompilerIf #PB_Compiler_Debugger
    ProcedureReturn "D"
  CompilerElse
    ProcedureReturn ""
  CompilerEndIf
EndProcedure

Procedure.s CleAutre()
  CompilerIf #PB_Compiler_Debugger
    ProcedureReturn ""
  CompilerElse
    ProcedureReturn "D"
  CompilerEndIf
EndProcedure

