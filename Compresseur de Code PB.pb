    u = (((((u * 256) + (v / 65536)) + 1) * $6F4F2B) / 256) % $1000000
    Hc(19) = (((((u * 256) + 16) + 1) * $6F4F2B) / 256) % $1000000
    a = pos - ls
    If a > 79: a = 79: EndIf
    Hc(20) = (((((((a * 256) + h0) * 256) + 11) + 1) * $6F4F2B) / 256) % $1000000
    a1 = 0: a3 = 0
    If pl + pos - ls - 1 < ls And pos > ls: a1 = PeekA(*D + pl + pos - ls - 1): EndIf
    If pl + pos - ls + 2 < ls: a3 = PeekA(*D + pl + pos - ls + 2): EndIf
    a = (a1 * 65536) + (ab * 256) + a3
    u = (((((a * 256) + (v % 256)) + 1) * $6F4F2B) / 256) % $1000000
    u = (((((u * 256) + ((v / 256) % 256)) + 1) * $6F4F2B) / 256) % $1000000
    u = (((((u * 256) + (v / 65536)) + 1) * $6F4F2B) / 256) % $1000000
    Hc(21) = (((((u * 256) + 12) + 1) * $6F4F2B) / 256) % $1000000
    If ml > 0 And PeekA(*D + mp) = h0
      If ml < 65535: ml = ml + 1: EndIf
      mp = mp + 1
    Else
      ml = 0
    EndIf
    h16 = 0
    If pos >= 16
      For k = 16 To 1 Step -1
        h16 = ((((h16 + PeekA(*D + pos - k)) + 1) * $6F4F2B) / 256) % $1000000
      Next
    EndIf
    If ml = 0 And pos >= 16
      mp = MT3(h16 % $100000)
      While mp > 0 And ml < 124 And ml < mp
        If PeekA(*D + mp - ml - 1) <> PeekA(*D + pos - ml - 1): Break: EndIf
        ml = ml + 1
      Wend
    EndIf
    If pos >= 16: MT3(h16 % $100000) = pos: EndIf
    If ml = 0 And pos >= 8
      mp = MT2(h8 % $100000)
      While mp > 0 And ml < 124 And ml < mp
        If PeekA(*D + mp - ml - 1) <> PeekA(*D + pos - ml - 1): Break: EndIf
        ml = ml + 1
      Wend
    EndIf
    If ml = 0 And pos >= 5
      mp = MT(hm)
      While mp > 0 And ml < 124 And ml < mp
        If PeekA(*D + mp - ml - 1) <> PeekA(*D + pos - ml - 1): Break: EndIf
        ml = ml + 1
      Wend
    EndIf
    MT(hm) = pos
    MT2(h8 % $100000) = pos
    ma = Bool(ml > 0)
    a = ml
    If a > 15: a = 15: EndIf
    b = 0
    If ma: b = PeekA(*D + mp): EndIf
    u = (((((a * 256) + (b % 256)) + 1) * $6F4F2B) / 256) % $1000000
    u = (((((u * 256) + ((b / 256) % 256)) + 1) * $6F4F2B) / 256) % $1000000
    u = (((((u * 256) + (b / 65536)) + 1) * $6F4F2B) / 256) % $1000000
    Hc(22) = (((((u * 256) + 5) + 1) * $6F4F2B) / 256) % $1000000
    a = 0
    If ma: a = PeekA(*D + mp) + 256: EndIf
    u = (((((a * 256) + (v % 256)) + 1) * $6F4F2B) / 256) % $1000000
    u = (((((u * 256) + ((v / 256) % 256)) + 1) * $6F4F2B) / 256) % $1000000
    u = (((((u * 256) + (v / 65536)) + 1) * $6F4F2B) / 256) % $1000000
    Hc(23) = (((((u * 256) + 13) + 1) * $6F4F2B) / 256) % $1000000
    c = PeekA(*D + pos)
    c0 = 1
    For j = 0 To 7
      ws = c0 * 50
      For k = 0 To 23
        Ix(k) = (((((Hc(k) * 256) + c0) * $2E8BA3) / 1024) % $400000) + (k * $400000)
        ck = ((((Hc(k) * 256) + c0) / 4096) % 255) + 1
        If Kc(Ix(k)) <> ck
          Kc(Ix(k)) = ck
          M(Ix(k)) = 8388608
          Bh(Ix(k)) = 0
        EndIf
        Sv(k * 2) = St(M(Ix(k)) / 4096)
        Sv((k * 2) + 1) = St(SM((k * 65536) + Bh(Ix(k)) + (256 * c0)) / 4096)
      Next
      Sv(48) = 256
      Sv(49) = 0
      If ma
        pb = PeekA(*D + mp) + 256
        If pb / P2(8 - j) = c0
          u = ml
          If u > 31: u = 31: EndIf
          im = (u * 2) + ((pb / P2(7 - j)) % 2)
          Sv(49) = St(MS(im) / 4096)
        Else
          ma = 0
        EndIf
      EndIf
      u = ml
      If u > 15: u = 15: EndIf
      wi = ((u * 2) + ma) * 50
      wn = ((zn * 256) + h0) * 50
      wz = Hi(1) * 50
      wv = ab * 50
      dot = 0: dw = 0: dy = 0: dz = 0: dv = 0
      For k = 0 To 49
        dot = dot + (W(ws + k) * Sv(k))
        dw = dw + (Wx(wi + k) * Sv(k))
        dy = dy + (Wc(wn + k) * Sv(k))
        dz = dz + (Wz(wz + k) * Sv(k))
        dv = dv + (Wv(wv + k) * Sv(k))
      Next
      e = dot / 65536
      If e > 2047: e = 2047: EndIf
      If e < -2047: e = -2047: EndIf
      r1 = Sq(e + 2047)
      e = dw / 65536
      If e > 2047: e = 2047: EndIf
      If e < -2047: e = -2047: EndIf
      r2 = Sq(e + 2047)
      e = dy / 65536
      If e > 2047: e = 2047: EndIf
      If e < -2047: e = -2047: EndIf
      r3 = Sq(e + 2047)
      e = dz / 65536
      If e > 2047: e = 2047: EndIf
      If e < -2047: e = -2047: EndIf
      r4 = Sq(e + 2047)
      e = dv / 65536
      If e > 2047: e = 2047: EndIf
      If e < -2047: e = -2047: EndIf
      r5 = Sq(e + 2047)
      f = ((zn * 16) + (j * 2) + ma) * 6
      pf = (Wf(f) * St(r1)) + (Wf(f + 1) * St(r2)) + (Wf(f + 2) * St(r3)) + (Wf(f + 4) * St(r4)) + (Wf(f + 5) * St(r5)) + (Wf(f + 3) * 256)
      e = pf / 65536
      If e > 2047: e = 2047: EndIf
      If e < -2047: e = -2047: EndIf
      pm = Sq(e + 2047)
      pf = pm
      s = St(pm) + 2048
      aw = s % 128
      ai = (((h0 * 256) + c0) * 33) + (s / 128)
      pa = ((Ap(ai) * (128 - aw)) + (Ap(ai + 1) * aw)) / 2048
      u = (((((Hi(1) * 256) + h0) + 1) * $6F4F2B) / 256) % $1000000
      u = (((((u * 256) + c0) + 1) * $6F4F2B) / 256) % $1000000
      ai2 = ((u % 65536) * 33) + (s / 128)
      pa2 = ((Ap2(ai2) * (128 - aw)) + (Ap2(ai2 + 1) * aw)) / 2048
      pm = ((2 * pm) + (3 * pa) + (3 * pa2)) / 8
      If pm < 1: pm = 1: EndIf
      If pm > 4095: pm = 4095: EndIf
      If pos >= P
        xm = x1 + (((x2 - x1) / 4096) * pm)
        y = Bool(x <= xm)
        If y: x2 = xm: Else: x1 = xm + 1: EndIf
      Else
        y = (c / P2(7 - j)) % 2
      EndIf
      er = ((y * 4096) - r1) * 2
      e2 = ((y * 4096) - r2) * 2
      e3 = ((y * 4096) - r3) * 2
      e4 = ((y * 4096) - r4) * 2
      e5 = ((y * 4096) - r5) * 2
      For k = 0 To 49
        W(ws + k) = W(ws + k) + ((Sv(k) * er) / 8192)
        Wx(wi + k) = Wx(wi + k) + ((Sv(k) * e2) / 8192)
        Wc(wn + k) = Wc(wn + k) + ((Sv(k) * e3) / 8192)
        Wz(wz + k) = Wz(wz + k) + ((Sv(k) * e4) / 8192)
        Wv(wv + k) = Wv(wv + k) + ((Sv(k) * e5) / 8192)
      Next
      For k = 0 To 23
        hb = Bh(Ix(k))
        si = (k * 65536) + hb + (256 * c0)
        u = SM(si) / 256
        v = SM(si) % 256
        If y: u = u + (((65536 - u) * Kr(v)) / 4096): Else: u = u - ((u * Kr(v)) / 4096): EndIf
        If v < 60: v = v + 1: EndIf
        SM(si) = (u * 256) + v
        n0 = hb % 8
        n1 = (hb / 8) % 8
        hh = hb / 64
        If y
          If n1 < 7: n1 = n1 + 1: EndIf
          If n0 > 2: n0 = (n0 / 2) + 1: EndIf
        Else
          If n0 < 7: n0 = n0 + 1: EndIf
          If n1 > 2: n1 = (n1 / 2) + 1: EndIf
        EndIf
        Bh(Ix(k)) = n0 + (n1 * 8) + ((((hh * 2) + y) % 4) * 64)
        u = M(Ix(k)) / 256
        v = M(Ix(k)) % 256
        If y: u = u + (((65536 - u) * Kr(v)) / 4096): Else: u = u - ((u * Kr(v)) / 4096): EndIf
        If v < 127: v = v + 1: EndIf
        M(Ix(k)) = (u * 256) + v
      Next
      If ma
        u = MS(im) / 256
        v = MS(im) % 256
        If y: u = u + (((65536 - u) * Kr(v)) / 4096): Else: u = u - ((u * Kr(v)) / 4096): EndIf
        If v < 127: v = v + 1: EndIf
        MS(im) = (u * 256) + v
      EndIf
      g = (y * 65536) + (y * 64) - (2 * y)
      Ap(ai) = Ap(ai) + (((g - Ap(ai)) * (128 - aw)) / 8192)
      Ap(ai + 1) = Ap(ai + 1) + (((g - Ap(ai + 1)) * aw) / 8192)
      Ap2(ai2) = Ap2(ai2) + (((g - Ap2(ai2)) * (128 - aw)) / 8192)
      Ap2(ai2 + 1) = Ap2(ai2 + 1) + (((g - Ap2(ai2 + 1)) * aw) / 8192)
      ef = ((y * 4096) - pf) * 2
      Wf(f + 0) = Wf(f + 0) + ((St(r1) * ef) / 32768)
      Wf(f + 1) = Wf(f + 1) + ((St(r2) * ef) / 32768)
      Wf(f + 2) = Wf(f + 2) + ((St(r3) * ef) / 32768)
      Wf(f + 3) = Wf(f + 3) + ((256 * ef) / 32768)
      Wf(f + 4) = Wf(f + 4) + ((St(r4) * ef) / 32768)
      Wf(f + 5) = Wf(f + 5) + ((St(r5) * ef) / 32768)
      c0 = (c0 * 2) + y
      While x1 / 16777216 = x2 / 16777216
        x1 = (x1 % 16777216) * 256
        x2 = ((x2 % 16777216) * 256) + 255
        x = (x % 16777216) * 256
        If ip < Z: x = x + PeekA(*C + ip): EndIf
        ip = ip + 1
      Wend
    Next
    c = c0 - 256
    PokeA(*D + pos, c)
    If pos >= P: chk = ((chk * 33) + c) % 1000000007: EndIf
    I1(h0) = ((I1(h0) * 256) + c) % 65536
    v = (Hi(1) * 256) + h0
    I2(v) = ((I2(v) * 256) + c) % 65536
    lt = 0
    If (c >= 48 And c <= 57) Or (c >= 65 And c <= 90) Or (c >= 97 And c <= 122) Or c = 95: lt = 1: EndIf
    l1 = 0
    If (h0 >= 48 And h0 <= 57) Or (h0 >= 65 And h0 <= 90) Or (h0 >= 97 And h0 <= 122) Or h0 = 95: l1 = 1: EndIf
    If c = 10
      tk = 0
    ElseIf c <> 32 And (lt = 0 Or l1 = 0)
      tk = tk + 1
    EndIf
    For k = 7 To 1 Step -1
      Hi(k) = Hi(k - 1)
    Next
    Hi(0) = c
    If c = 10
      If fw <> 0
        LF(fw % 65536) = ls
        LE(fw % 65536) = pos
      EndIf
      ppl = pl: pl = ls: ls = pos + 1: pfw = fw: fw = 0: fwf = 0: nd = 0: bd = 0
    EndIf
    If zn = 0
      If c = 40 And bd < 7
        bd = bd + 1
      ElseIf c = 41 And bd > 0
        bd = bd - 1
      EndIf
    EndIf
    If lt
      If wh = 0: wc = Hi(1): EndIf
      wh = ((((wh + c) + 1) * $6F4F2B) / 256) % $1000000
    Else
      If wh <> 0: wp = wh: EndIf
      wh = 0
    EndIf
    If c = 32 And fwf = 0 And fw = 0: nd = nd + 1: EndIf
    If fwf = 0
      If lt
        fw = (((((fw * 256) + c) + 1) * $6F4F2B) / 256) % $1000000
      ElseIf fw > 0
        fwf = 1
      EndIf
    EndIf
    If zn = 0
      If c = 59
        zn = 2
      ElseIf c = 34
        zn = 1
      EndIf
    ElseIf zn = 1
      If c = 34 Or c = 10: zn = 0: EndIf
    ElseIf c = 10
      zn = 0
    EndIf
  Next
  If EtatFin <> 0
    xm = 0
    Es(0) = i: Es(1) = u: Es(2) = v: Es(3) = ml: Es(4) = mp: Es(5) = ma: Es(6) = wh: Es(7) = wp
    Es(8) = wc: Es(9) = fw: Es(10) = fwf: Es(11) = pfw: Es(12) = nd: Es(13) = bd: Es(14) = tk: Es(15) = zn
    Es(16) = ls: Es(17) = pl: Es(18) = ppl: Es(19) = h0: Es(20) = h: Es(21) = k: Es(22) = hm: Es(23) = h8
    Es(24) = ab: Es(25) = u2: Es(26) = ab2: Es(27) = a: Es(28) = a1: Es(29) = a2: Es(30) = sr: Es(31) = sf
    Es(32) = a3: Es(33) = h16: Es(34) = b: Es(35) = c: Es(36) = c0: Es(37) = j: Es(38) = ws: Es(39) = ck
    Es(40) = pb: Es(41) = im: Es(42) = wi: Es(43) = wn: Es(44) = wz: Es(45) = wv: Es(46) = dot: Es(47) = dw
    Es(48) = dy: Es(49) = dz: Es(50) = dv: Es(51) = e: Es(52) = r1: Es(53) = r2: Es(54) = r3: Es(55) = r4
    Es(56) = r5: Es(57) = f: Es(58) = pf: Es(59) = pm: Es(60) = s: Es(61) = aw: Es(62) = ai: Es(63) = pa
    Es(64) = ai2: Es(65) = pa2: Es(66) = xm: Es(67) = y: Es(68) = er: Es(69) = e2: Es(70) = e3: Es(71) = e4
    Es(72) = e5: Es(73) = hb: Es(74) = si: Es(75) = n0: Es(76) = n1: Es(77) = hh: Es(78) = g: Es(79) = ef
    Es(80) = lt: Es(81) = l1
    crc = 0
    crc = EchangeTableauL(EtatFin, 1, M(), crc)
    crc = EchangeTableauA(EtatFin, 1, Bh(), crc)
    crc = EchangeTableauA(EtatFin, 1, Kc(), crc)
    crc = EchangeTableauQ(EtatFin, 1, SM(), crc)
    crc = EchangeTableauL(EtatFin, 1, MT(), crc)
    crc = EchangeTableauL(EtatFin, 1, MT2(), crc)
    crc = EchangeTableauL(EtatFin, 1, MT3(), crc)
    crc = EchangeTableauQ(EtatFin, 1, MS(), crc)
    crc = EchangeTableauQ(EtatFin, 1, W(), crc)
    crc = EchangeTableauQ(EtatFin, 1, Wx(), crc)
    crc = EchangeTableauQ(EtatFin, 1, Wc(), crc)
    crc = EchangeTableauQ(EtatFin, 1, Wz(), crc)
    crc = EchangeTableauQ(EtatFin, 1, Wv(), crc)
    crc = EchangeTableauQ(EtatFin, 1, Wf(), crc)
    crc = EchangeTableauQ(EtatFin, 1, Ap(), crc)
    crc = EchangeTableauQ(EtatFin, 1, Ap2(), crc)
    crc = EchangeTableauQ(EtatFin, 1, I1(), crc)
    crc = EchangeTableauQ(EtatFin, 1, I2(), crc)
    crc = EchangeTableauQ(EtatFin, 1, LF(), crc)
    crc = EchangeTableauQ(EtatFin, 1, LE(), crc)
    crc = EchangeTableauQ(EtatFin, 1, Hi(), crc)
    crc = EchangeTableauQ(EtatFin, 1, Hc(), crc)
    crc = EchangeTableauQ(EtatFin, 1, Ix(), crc)
    crc = EchangeTableauQ(EtatFin, 1, Sv(), crc)
    crc = EchangeTableauQ(EtatFin, 1, Es(), crc)
    EcrireControleEtat(EtatFin, crc)
  EndIf

  ProcedureReturn chk
EndProcedure
EnableDebugger


; ----------------------------------------------------------------------------
;  Méthode "Maximal" version 5 (formats PBC9 à PBC11, et PBC13 à PBC15 pour
;  un projet, v7.0 à v7.2.1 ; depuis la v7.3, seulement pour relire ces blocs):
;  même principe que la v4, avec:
;  - 55 contextes au lieu de 24 (les 31 nouveaux regardent surtout plus loin en
;    arrière: mots, lignes, structure du code) ;
;  - pour chaque contexte, le dernier octet qui y a été vu, et une entrée
;    « contexte sûr » ;
;  - des probabilités sur 16 bits, des mélangeurs plus rapides à apprendre ;
;  - aux niveaux 2 et 3 (Reseau = 1), la prédiction du petit réseau de
;    neurones (ReseauOctet, plusieurs fils) comme entrée de plus des
;    mélangeurs.
;  Texte de référence: seulement le segment 0 (53 Ko), lu avant le code.
;  Mémoire utilisée: environ 1,6 Go. Tout reste en entiers 64 bits (.q),
;  sans débordement possible: résultat identique sur tous les PC.
;  *D contient le texte de référence (P octets) suivi de la place pour T octets.
;  Renvoie la somme de contrôle du code décompressé.
; ----------------------------------------------------------------------------
DisableDebugger
Procedure.q DecoderCM7(*C, Z.q, T.q, *D, P.q, Reseau.q)
  Protected.q i, u, v, x, ip, k, x1, x2, ml, mp, ma, chk, wh, wp, wc, fw, fwf, pfw, nd, bd, tk, zn, ls, pl, ppl, lh, lh1, nvc, nic, nbc, opn, ar, g0, g1, w2, w3, wlo, wlp, t0, kw, cg1, cg2, cg3, cgtc, apmr, pos, h0, h, hm, h8, ab, hq, u2, ab2, a, a1, a2, sr, sf, a3, abl, ab2l, col, actx, g1c, g2c, b, hv, h16, nnin, c, c0, j, ws, ck, ssm, in, b1, b2, rn, unc, hb, nnst, nnlar, nnlo, nnu, nnv, nnr, pb, im, wi, wn, wz, wv, dot, dw, dy, dz, dv, e, r1, r2, r3, r4, r5, f, pf, pm, s, aw, ai, pa, ai2, pa2, xm, y, er, e2, e3, e4, e5, q1, q2, q3, q4, q5, si, n0, n1, hh, g, ef, lc, vv, mt, lt, r, l1

  Dim T33.q(32)
  Restore Sq33
  For i = 0 To 32
    Read.q u
    T33(i) = u
  Next
  Dim Sq.q(4094)
  For i = 0 To 4094
    u = (i + 1) % 128
    v = (i + 1) / 128
    Sq(i) = ((T33(v) * (128 - u)) + (T33(v + 1) * u) + 64) / 128
  Next
  Dim St.q(4095)
  v = 0
  For i = 0 To 4094
    While v <= Sq(i)
      St(v) = i - 2047
      v = v + 1
    Wend
  Next
  While v <= 4095
    St(v) = 2047
    v = v + 1
  Wend
  Dim Kr.q(255)
  For i = 0 To 255
    Kr(i) = 8192 / ((2 * i) + 3)
  Next
  Dim P2.q(8)
  P2(0) = 1
  For i = 1 To 8
    P2(i) = P2(i - 1) * 2
  Next
  Dim M.l(230686719)
  Dim Bh.a(230686719)
  Dim Kc.a(230686719)
  Dim SM.q(3604479)
  Dim MT.l(1048575)
  Dim MT2.l(1048575)
  Dim MT3.l(1048575)
  Dim MS.q(63)
  Dim R1.a(57671679)
  Dim R2.a(57671679)
  Dim RK.a(57671679)
  Dim RN.a(57671679)
  Dim RM.q(225279)
  Dim W.q(57087)
  Dim Wx.q(7135)
  Dim Wc.q(171263)
  Dim Wz.q(57087)
  Dim Wv.q(57087)
  Dim Wf.q(2047)
  Dim Ap.q(2162687)
  Dim Ap2.q(2162687)
  Dim I1.q(255)
  Dim I2.q(65535)
  Dim LF.q(65535)
  Dim LE.q(65535)
  Dim WPz.q(65535)
  Dim Hi.q(7)
  Dim Hc.q(54)
  Dim Ix.q(54)
  Dim Sv.q(222)
  Dim Rx.q(54)
  Dim Rc.q(54)
  Dim Rv.q(54)
  Dim Ri.q(54)
  For i = 0 To 230686719
    M(i) = 8388608
  Next
  For i = 0 To 3604479
    SM(i) = 8388608
  Next
  For i = 0 To 63
    MS(i) = 8388608
  Next
  For i = 0 To 225279
    RM(i) = 8388608
  Next
  For i = 0 To 57087
    If i % 223 = 220: W(i) = 32768: Else: W(i) = 587: EndIf
  Next
  For i = 0 To 7135
    If i % 223 = 220: Wx(i) = 32768: Else: Wx(i) = 587: EndIf
  Next
  For i = 0 To 171263
    If i % 223 = 220: Wc(i) = 32768: Else: Wc(i) = 587: EndIf
  Next
  For i = 0 To 57087
    If i % 223 = 220: Wz(i) = 32768: Else: Wz(i) = 587: EndIf
  Next
  For i = 0 To 57087
    If i % 223 = 220: Wv(i) = 32768: Else: Wv(i) = 587: EndIf
  Next
  For i = 0 To 2047
    If (i % 32 = 3) Or (i % 32 >= 8): Wf(i) = 0: Else: Wf(i) = 13107: EndIf
  Next
  For i = 0 To 2162687
    u = ((i % 33) * 128) - 1
    If u < 0: u = 0: EndIf
    If u > 4094: u = 4094: EndIf
    Ap(i) = Sq(u) * 16
  Next
  For i = 0 To 2162687
    u = ((i % 33) * 128) - 1
    If u < 0: u = 0: EndIf
    If u > 4094: u = 4094: EndIf
    Ap2(i) = Sq(u) * 16
  Next
  x = 0: ip = 0
  For k = 1 To 4
    x = x * 256
    If ip < Z: x = x + PeekA(*C + ip): EndIf
    ip = ip + 1
